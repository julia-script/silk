//! Recoverable parsing from lexer tokens into one flat abstract syntax tree.
//!
//! # When to use
//!
//! Use [`parse`] after lexing one complete source file. The result supports later compiler passes
//! and tools that must inspect valid regions after a syntax problem.
//!
//! # Details
//!
//! The parser retains the complete token array. It stores significant tokens in node elements by
//! token index. Whitespace and comments stay in the token array for source-oriented tools.
//!
//! The parser appends each child node before its parent node. Each node identity is its index in
//! the final node array. The source-file root is the last node.
//!
//! Syntax problems do not fail the parse effect. The parser records diagnostics and inserts error
//! nodes or missing-token elements. The allocator can still fail while the parser grows an array.
//!
//! # Gotchas
//!
//! This parser version recognizes import declarations only. Other top-level regions become error
//! nodes until the parser finds the start of another import declaration.

import lexer.Token {Token, TokenKind}
import parser.Element {Element}
import parser.Import {parseImportDeclaration}
import parser.Node {NodeKind}
import parser.ParseState {ElementsResult, NodeResult, State}
import parser.ParseState as Parsing
import parser.SyntaxTree {SyntaxTree}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.vector {Vector}

fn isImportStart(tokenKind: TokenKind) -> bool {
  return tokenKind == TokenKind.ImportKeyword || tokenKind == TokenKind.PubKeyword
}

effect fn parseErrorRegion(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let start = Parsing.insertionSpan(&initial)
  let first = run Parsing.unexpected(Parsing.begin(move initial))
  let ElementsResult {state: afterFirst, elements: firstElements} = move first
  let mut state = move afterFirst
  let mut elements = move firstElements
  while Parsing.currentKind(&state) != TokenKind.EndOfFile && !isImportStart(
    Parsing.currentKind(&state),
  ) {
    let consumed = run Parsing.consume(ElementsResult {state: move state, elements: move elements})
    let ElementsResult {state: afterToken, elements: afterTokenElements} = move consumed
    state = move afterToken
    elements = move afterTokenElements
  }
  return run Parsing.finish(
    ElementsResult {state: move state, elements: move elements},
    NodeKind.Error,
    start,
  )
}

effect fn parseTopLevelDeclaration(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  if isImportStart(Parsing.currentKind(&initial)) {
    return run parseImportDeclaration(move initial)
  }
  return run parseErrorRegion(move initial)
}

/// Parses one complete token array into a recoverable flat abstract syntax tree.
///
/// # When to use
///
/// Use after the lexer has produced the tokens for one source file. Use the returned diagnostics
/// to decide whether compilation can continue.
///
/// # Details
///
/// The result owns the input tokens. It also owns a flat node array, one source-file root, and all
/// syntax diagnostics. Child node identities refer to earlier entries in the node array.
///
/// The parser skips trivia when it applies grammar rules. It does not remove trivia from the token
/// array. Elements for significant source tokens refer to their original token indices.
///
/// A missing token adds a zero-width element and a diagnostic. An unexpected top-level region adds
/// an error node. Parsing then continues at the next import start.
///
/// # Gotchas
///
/// Syntax problems are values in the result, not effect failures. Allocation failure is the only
/// declared effect failure.
///
/// The current grammar recognizes `import` and `pub import` declarations only. It preserves other
/// top-level source in error nodes.
pub effect fn parse(tokens: Vector<Token>) -> SyntaxTree ! OutOfMemoryError ? &mut Allocator {
  let mut state = Parsing.make(move tokens)
  let mut elements = Vector.make<Element>()
  while Parsing.currentKind(&state) != TokenKind.EndOfFile {
    let result = run parseTopLevelDeclaration(move state)
    let NodeResult {state: afterDeclaration, node} = move result
    state = move afterDeclaration
    run Vector.append<Element>(&mut elements, Element.Node {id: node})
  }
  let endOfFile = run Parsing.expect(
    ElementsResult {state: move state, elements: move elements},
    TokenKind.EndOfFile,
  )
  let sourceFile = run Parsing.finishSourceFile(move endOfFile)
  return Parsing.intoSyntaxTree(move sourceFile)
}
