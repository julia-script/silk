//! Compact references to the direct contents of parser nodes.
//!
//! # Details
//!
//! An [`Element`] refers to a node or token by its stable index. A missing token stores the
//! expected category and insertion span directly because it has no source token.

import lexer.Span {Span}
import lexer.Token {TokenKind}
import parser.NodeId {NodeId}

/// The stable index of one token in a parser token vector.
///
/// # Gotchas
///
/// The index is valid only for the syntax tree that created the identity.
pub struct TokenId {
  /// The position of the token in its owning token vector.
  pub index: usize
}

impl Copy for TokenId {}

/// One direct node element stored as a compact identity.
pub union Element {
  /// A child node.
  Node {
    /// The identity of the child node.
    pub id: NodeId,
  },
  /// A token that occurs in the source.
  Token {
    /// The identity of the source token.
    pub id: TokenId,
  },
  /// An expected token that does not occur in the source.
  MissingToken {
    /// The lexical category expected at the insertion point.
    pub expected: TokenKind,
    /// The zero-width source span of the insertion point.
    pub span: Span,
  },
}

impl Copy for Element {}
