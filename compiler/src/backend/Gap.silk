//! Explicit backend coverage failures for reached programs.

import lexer.Span {Span}
import semantic.DeclarationId {DeclarationId}
import semantic.ModuleId {ModuleId}
import semantic.Rejection {Rejection, RejectionCode}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.option {Option}
import silk.shared {Shared}
import silk.usize

/// One stable reason code for a reached but unimplemented backend form.
pub enum Code {
  ScalarLayout,
  CAbiTarget,
  CAbiAggregate,
  CAbiCallback,
  CAbiVariadic,
  ForeignContract,
  ForeignExport,
  ForeignAbi,
  ForeignStatic,
  IntegerLiteral,
  FloatLiteral,
  MissingCallArgument,
  TypedForm,
  UnionForm,
  BoundMethod,
  PipelineInterface,
  IntrinsicMember,
  ProfileInput,
  ExpectedExpression,
  ExpectedPlace,
  PlaceProjection,
  FieldProjection,
  IndexProjection,
  SliceLayout,
  BreakOutsideLoop,
  ContinueOutsideLoop,
  MissingBlockStatement,
  SignatureForm,
  StaticResidualization,
  ArithmeticTrap,
  UnitParameter,
  EntrySignature,
  CalleeModule,
  OpenInstance,
  EffectForm,
  NestedEffectJoin,
  InterfaceEffectWitness,
  /// A failure type the origin-only report cannot name yet (failure observer note §4).
  FailureIdentity,
  /// An observer callback that is not a direct function (failure observer note N1).
  ObserverCallback,
  Suspension,
  CoreType,
  BodyLifetimeElision,
  IntrinsicWitness,
  CallTargetDiscovery,
  ProviderSection,
  SectionResultInference,
  NestedUnionPattern,
  MutableParameter,
  InlineStorage,
  GenericOperation,
  WitnessOperand,
  Cleanup,
  CleanupB1201,
  CleanupB1485,
  CleanupB1495,
  CleanupB1679,
  CleanupB1693,
  CleanupB1798,
  CleanupB1814,
  CleanupB1836,
  CleanupB1857,
  CleanupB1864,
  CleanupB2057,
  CleanupB2062,
  CleanupB2103,
  CleanupB2120,
  CleanupB2149,
  CleanupB2160,
  CleanupB2169,
  CleanupB2245,
  CleanupB2247,
  CleanupB2259,
  CleanupB2273,
  CleanupB2283,
  CleanupB2288,
  CleanupB2345,
  CleanupB2360,
  CleanupB2378,
  CleanupB4041,
  CleanupB4229,
  CleanupS43274,
  CleanupS43289,
  CleanupS43492,
  CleanupS43865,
  CleanupS43938,
  CleanupS46419,
  CleanupS46488,
  CleanupS46555,
  CleanupS46565,
  CleanupS46886,
  CleanupS46934,
}

/// Exact source evidence, independent of the reached instance that reports it.
pub union Source {
  Declaration {pub declaration: Shared<DeclarationId>, pub span: Span},
  Diagnostic {pub diagnostic: Shared<Rejection>},
}

/// A reached form that the current backend cannot compile.
pub struct Gap {
  pub code: Code
  pub owner: Shared<DeclarationId>
  pub source: Source
}

impl Gap {
  pub fn make(code: Code, owner: &Shared<DeclarationId>, span: Span) -> Gap {
    return Gap {code: code, owner: Shared.clone<DeclarationId>(owner),
      source: Source.Declaration {declaration: Shared.clone<DeclarationId>(owner), span: span}}
  }
  /// Retains a propagated rejection's module and span without attributing them to its caller.
  pub fn fromRejection(code: Code, owner: &Shared<DeclarationId>, diagnostic: &Shared<Rejection>) -> Gap {
    return Gap {code: code, owner: Shared.clone<DeclarationId>(owner),
      source: Source.Diagnostic {diagnostic: Shared.clone<Rejection>(diagnostic)}}
  }
  pub fn copy(self: &Self) -> Gap {
    let source = match &self.source {
      Source.Declaration {declaration, span} => Source.Declaration {
        declaration: Shared.clone<DeclarationId>(&declaration), span: span,
      }
      Source.Diagnostic {diagnostic} => Source.Diagnostic {diagnostic: Shared.clone<Rejection>(&diagnostic)}
    }
    return Gap {code: self.code, owner: Shared.clone<DeclarationId>(&self.owner), source: move source}
  }
  pub fn span(self: &Self) -> Span {
    return match &self.source {
      Source.Declaration {span, ..} => span
      Source.Diagnostic {diagnostic} => Shared.with<Rejection, Span>(&diagnostic,
        fn(value: &Rejection) -> Span { return value.span })
    }
  }
  pub fn moduleMatches(self: &Self, module: &ModuleId) -> bool {
    return match &self.source {
      Source.Declaration {declaration, ..} => Shared.with<DeclarationId, bool>(&declaration,
        fn(value: &DeclarationId) -> bool { return ModuleId.equals(DeclarationId.moduleId(value), module) })
      Source.Diagnostic {diagnostic} => Shared.with<Rejection, bool>(&diagnostic,
        fn(value: &Rejection) -> bool { return ModuleId.equals(&value.module, module) })
    }
  }
  /// Copies the authored logical path for machine-readable reporting; no borrow escapes Shared.
  pub effect fn sourcePath(self: &Self) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    match &self.source {
      Source.Declaration {declaration, ..} => {
        let copied = run DeclarationId.copyShared(&declaration)
        return run Bytes.copy(ModuleId.logicalPath(DeclarationId.moduleId(&copied)))
      }
      Source.Diagnostic {diagnostic} => {
        let length = Shared.with<Rejection, usize>(&diagnostic,
          fn(value: &Rejection) -> usize { return ModuleId.logicalPath(&value.module).length })
        let mut path = run Bytes.zeroed(length)
        let target = Bytes.asMutSlice(&mut path)
        let mut at = usize.ZERO
        while at < length {
          target[at] = Shared.with<Rejection, u8>(&diagnostic,
            fn(value: &Rejection) -> u8 { return ModuleId.logicalPath(&value.module)[at] })
          at = at + usize.ONE
        }
        return move path
      }
    }
  }
  pub fn name(code: Code) -> &'static [u8] {
    return match code {
      Code.CAbiTarget => b"c-abi-target"
      Code.CAbiAggregate => b"c-abi-aggregate"
      Code.CAbiCallback => b"c-abi-callback"
      Code.CAbiVariadic => b"c-abi-variadic"
      Code.ForeignContract => b"foreign-contract"
      Code.ForeignExport => b"foreign-export"
      Code.ForeignAbi => b"foreign-abi"
      Code.ForeignStatic => b"foreign-static"
      Code.ScalarLayout => b"scalar-layout"
      Code.FloatLiteral => b"float-literal"
      Code.IntegerLiteral => b"integer-literal"
      Code.MissingCallArgument => b"missing-call-argument"
      Code.TypedForm => b"typed-form"
      Code.UnionForm => b"union-form"
      Code.BoundMethod => b"bound-method"
      Code.PipelineInterface => b"pipeline-interface"
      Code.IntrinsicMember => b"intrinsic-member"
      Code.ProfileInput => b"profile-input"
      Code.ExpectedExpression => b"expected-expression"
      Code.ExpectedPlace => b"expected-place"
      Code.PlaceProjection => b"place-projection"
      Code.FieldProjection => b"field-projection"
      Code.IndexProjection => b"index-projection"
      Code.SliceLayout => b"slice-layout"
      Code.BreakOutsideLoop => b"break-outside-loop"
      Code.ContinueOutsideLoop => b"continue-outside-loop"
      Code.MissingBlockStatement => b"missing-block-statement"
      Code.SignatureForm => b"signature-form"
      Code.StaticResidualization => b"static-residualization"
      Code.ArithmeticTrap => b"arithmetic-trap"
      Code.UnitParameter => b"unit-parameter"
      Code.EntrySignature => b"entry-signature"
      Code.CalleeModule => b"callee-module"
      Code.OpenInstance => b"open-instance"
      Code.EffectForm => b"effect-form"
      Code.NestedEffectJoin => b"nested-effect-join"
      Code.InterfaceEffectWitness => b"interface-effect-witness"
      Code.FailureIdentity => b"failure-identity"
      Code.ObserverCallback => b"observer-callback"
      Code.Suspension => b"suspension"
      Code.CoreType => b"core-type"
      Code.BodyLifetimeElision => b"body-lifetime-elision"
      Code.IntrinsicWitness => b"intrinsic-witness"
      Code.CallTargetDiscovery => b"call-target-discovery"
      Code.ProviderSection => b"provider-section"
      Code.SectionResultInference => b"section-result-inference"
      Code.NestedUnionPattern => b"nested-union-pattern"
      Code.MutableParameter => b"mutable-parameter-binding"
      Code.InlineStorage => b"inline-storage-recursion"
      Code.GenericOperation => b"generic-operation"
      Code.WitnessOperand => b"witness-operand"
      Code.Cleanup => b"cleanup"
      Code.CleanupB1201 => b"cleanupb1201"
      Code.CleanupB1485 => b"cleanupb1485"
      Code.CleanupB1495 => b"cleanupb1495"
      Code.CleanupB1679 => b"cleanupb1679"
      Code.CleanupB1693 => b"cleanupb1693"
      Code.CleanupB1798 => b"cleanupb1798"
      Code.CleanupB1814 => b"cleanupb1814"
      Code.CleanupB1836 => b"cleanupb1836"
      Code.CleanupB1857 => b"cleanupb1857"
      Code.CleanupB1864 => b"cleanupb1864"
      Code.CleanupB2057 => b"cleanupb2057"
      Code.CleanupB2062 => b"cleanupb2062"
      Code.CleanupB2103 => b"cleanupb2103"
      Code.CleanupB2120 => b"cleanupb2120"
      Code.CleanupB2149 => b"cleanupb2149"
      Code.CleanupB2160 => b"cleanupb2160"
      Code.CleanupB2169 => b"cleanupb2169"
      Code.CleanupB2245 => b"cleanupb2245"
      Code.CleanupB2247 => b"cleanupb2247"
      Code.CleanupB2259 => b"cleanupb2259"
      Code.CleanupB2273 => b"cleanupb2273"
      Code.CleanupB2283 => b"cleanupb2283"
      Code.CleanupB2288 => b"cleanupb2288"
      Code.CleanupB2345 => b"cleanupb2345"
      Code.CleanupB2360 => b"cleanupb2360"
      Code.CleanupB2378 => b"cleanupb2378"
      Code.CleanupB4041 => b"cleanupb4041"
      Code.CleanupB4229 => b"cleanupb4229"
      Code.CleanupS43274 => b"cleanups43274"
      Code.CleanupS43289 => b"cleanups43289"
      Code.CleanupS43492 => b"cleanups43492"
      Code.CleanupS43865 => b"cleanups43865"
      Code.CleanupS43938 => b"cleanups43938"
      Code.CleanupS46419 => b"cleanups46419"
      Code.CleanupS46488 => b"cleanups46488"
      Code.CleanupS46555 => b"cleanups46555"
      Code.CleanupS46565 => b"cleanups46565"
      Code.CleanupS46886 => b"cleanups46886"
      Code.CleanupS46934 => b"cleanups46934"
    }
  }
  /// Classifies a precise semantic deferral without replacing its authored source evidence.
  pub fn forRejection(code: RejectionCode) -> Option<Code> {
    return match code {
      RejectionCode.UnionFormUnavailable => Option.some<Code>(Code.UnionForm)
      RejectionCode.BoundMethodUnavailable => Option.some<Code>(Code.BoundMethod)
      RejectionCode.EffectFormUnavailable => Option.some<Code>(Code.EffectForm)
      RejectionCode.NestedEffectJoinUnavailable => Option.some<Code>(Code.NestedEffectJoin)
      RejectionCode.InterfaceEffectUnavailable => Option.some<Code>(Code.InterfaceEffectWitness)
      RejectionCode.SuspensionUnavailable => Option.some<Code>(Code.Suspension)
      RejectionCode.CoreTypeUnavailable => Option.some<Code>(Code.CoreType)
      RejectionCode.PipelineInterfaceUnavailable => Option.some<Code>(Code.PipelineInterface)
      RejectionCode.CaptureAvailabilityUnavailable => Option.some<Code>(Code.Cleanup)
      RejectionCode.IntrinsicUnavailable => Option.some<Code>(Code.IntrinsicMember)
      RejectionCode.ForeignStaticUnavailable => Option.some<Code>(Code.ForeignStatic)
      RejectionCode.ForeignAggregate => Option.some<Code>(Code.CAbiAggregate)
      RejectionCode.ForeignCallback => Option.some<Code>(Code.CAbiCallback)
      RejectionCode.ForeignVariadic => Option.some<Code>(Code.CAbiVariadic)
      RejectionCode.BodyLifetimeElisionUnavailable => Option.some<Code>(Code.BodyLifetimeElision)
      RejectionCode.IntrinsicWitnessUnavailable => Option.some<Code>(Code.IntrinsicWitness)
      RejectionCode.CallTargetUnavailable => Option.some<Code>(Code.CallTargetDiscovery)
      RejectionCode.ProviderSectionUnavailable => Option.some<Code>(Code.ProviderSection)
      RejectionCode.SectionResultInferenceUnavailable => Option.some<Code>(Code.SectionResultInference)
      RejectionCode.NestedUnionPatternUnavailable => Option.some<Code>(Code.NestedUnionPattern)
      RejectionCode.MutableParameterUnavailable => Option.some<Code>(Code.MutableParameter)
      RejectionCode.InlineStorageUnavailable => Option.some<Code>(Code.InlineStorage)
      _ => Option.none<Code>()
    }
  }
}
