//! Focused source tests for lazy semantic demands and their retained evidence.

import semantic.ModuleId {InvalidModulePath, ModuleId}
import semantic.Query {Cycle}
import semantic.Semantic {
  Answer,
  Dependency,
  Event as SemanticEvent,
  EventKind,
  Family,
  Outcome,
  Rejection,
  RejectionCode,
  ResolvedType,
  Semantic,
  Value,
}
import semantic.SourceIndex {
  Event as SourceEvent,
  EventKind as SourceEventKind,
  NoRejection,
  RevisionMismatch,
}
import semantic.SourceRevision {Revision}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.effect {Effect}
import silk.option {Option}
import silk.result {Result}
import silk.shared {Shared}
import silk.string {String}
import silk.testing {AssertionError, Testing}
import silk.usize
import silk.vector {Vector}

struct AnswerView {
  success: bool
  dependencies: usize
  sources: usize
}

fn inspect(answer: &Result<Answer, NoRejection>) -> AnswerView {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: _} => AnswerView {
        success: true,
        dependencies: Vector.length(&value.dependencies),
        sources: Vector.length(&value.sources),
      }
      Outcome.Rejected {diagnostic: _} => AnswerView {
        success: false,
        dependencies: Vector.length(&value.dependencies),
        sources: Vector.length(&value.sources),
      }
    }
    Result<Answer, NoRejection>.Failure {error: _} => AnswerView {
      success: false,
      dependencies: usize.ZERO,
      sources: usize.ZERO,
    }
  }
}

fn rejection(answer: &Result<Answer, NoRejection>) -> Option<Shared<Rejection>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Rejected {diagnostic} => Option.some<Shared<Rejection>>(
        Shared.clone<Rejection>(&diagnostic),
      )
      Outcome.Success {value: _} => Option.none<Shared<Rejection>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Rejection>>()
  }
}

fn isUnknownName(value: &Rejection) -> bool {
  return value.code == RejectionCode.UnknownName
}

fn isMissingModule(value: &Rejection) -> bool {
  return value.code == RejectionCode.MissingModule && value.span.end > value.span.start
}

fn isPrivateExposure(value: &Rejection) -> bool {
  return value.code == RejectionCode.PrivateTypeExposure && value.span.end > value.span.start
}

fn isCollision(value: &Rejection) -> bool {
  return value.code == RejectionCode.Collision
}

fn isUnsupported(value: &Rejection) -> bool {
  return value.code == RejectionCode.Unsupported && value.span.end > value.span.start
}

fn isCycle(value: &Rejection) -> bool {
  return value.code == RejectionCode.Cycle
}

fn cyclePathLength(value: &Rejection) -> usize {
  return Vector.length(&value.path)
}

fn aliasCycleAnchor(value: &Rejection) -> bool {
  return value.span.start == 20 && value.span.end == 21
}

fn importCycleAnchor(value: &Rejection) -> bool {
  return value.span.end > value.span.start
}

fn isNominal(resolved: &ResolvedType) -> bool {
  return match & resolved.* {
    ResolvedType.Nominal {..} => true
    _ => false
  }
}

fn signatureResult(answer: &Result<Answer, NoRejection>) -> Option<Shared<ResolvedType>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: fact} => match & fact {
        Value.Signature {signature} => Option.some<Shared<ResolvedType>>(
          Shared.clone<ResolvedType>(&signature.result),
        )
        _ => Option.none<Shared<ResolvedType>>()
      }
      Outcome.Rejected {diagnostic: _} => Option.none<Shared<ResolvedType>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<ResolvedType>>()
  }
}

fn importedSignatureHasDependencies(answer: &Result<Answer, NoRejection>) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => {
      let dependencies = Vector.asSlice<Dependency>(&value.dependencies)
      let mut selected = false
      let mut namespace = false
      let mut publicName = false
      let mut alias = false
      let mut identity = false
      let mut at = usize.ZERO
      while at < dependencies.length {
        let item = &dependencies[at]
        if item.family == Family.Import {
          match & item.member {
            Option<usize>.Some {value: ordinal} => {
              if ordinal == usize.ZERO {
                selected = true
              }
            }
            Option<usize>.None => {
              namespace = true
            }
          }
        }
        if item.family == Family.Name && item.external {
          publicName = true
        }
        if item.family == Family.Alias {
          alias = true
        }
        if item.family == Family.Identity {
          identity = true
        }
        at = at + usize.ONE
      }
      return selected && namespace && publicName && alias && identity
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn reads(events: &[SourceEvent], module: &ModuleId) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < events.length {
    if events[at].kind == SourceEventKind.SourceRead && ModuleId.equals(&events[at].module, module) {
      count = count + usize.ONE
    }
    at = at + usize.ONE
  }
  return count
}

fn starts(events: &[SemanticEvent], family: Family) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < events.length {
    if events[at].kind == EventKind.Start && events[at].family == family {
      count = count + usize.ONE
    }
    at = at + usize.ONE
  }
  return count
}

effect fn module(path: string) -> ModuleId ! InvalidModulePath | OutOfMemoryError ? &mut Allocator {
  return run ModuleId.make(b"memory", b"example", String.utf8Bytes(path))
}

effect fn present(text: string) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  return Option.some<Bytes>(run Bytes.copy(String.utf8Bytes(text)))
}

effect fn lazyClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("entry.silk")
  let missing = run module("missing.silk")
  let source = run present(
    "import missing as Ghost\ntype Broken = Unknown\nfn entry() -> i32 { return unknown() }\nfn missing(value: Ghost.Thing) -> i32 { return 0 }\n",
  )
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
  let mut semantic = Semantic.make(move revision)
  let signature = run Semantic.demandSignature(&mut semantic, &entry, b"entry")
  let first = Shared.with<Result<Answer, NoRejection>, AnswerView>(&signature, inspect)
  run Testing.expect(
    first.success && first.sources == 1,
    "written signature needs entry source only",
  )
  run Testing.expect(
    reads(Semantic.sourceEvents(&semantic), &entry) == 1 && reads(
      Semantic.sourceEvents(&semantic),
      &missing,
    ) == 0,
    "unused import target stays unread",
  )
  run Testing.expect(
    starts(Semantic.eventLog(&semantic), Family.Import) == 0 && starts(
      Semantic.eventLog(&semantic),
      Family.Alias,
    ) == 0,
    "unused import and bad alias stay undemanded",
  )
  let broken = run Semantic.demandAlias(&mut semantic, &entry, b"Broken")
  let rejected = Shared.with<Result<Answer, NoRejection>, AnswerView>(&broken, inspect)
  let diagnostic = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &broken,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move diagnostic {
    run Testing.expect(
      !rejected.success && Shared.with<Rejection, bool>(&value, isUnknownName) && rejected.dependencies > 0 && rejected.sources == 1,
      "demanded bad alias records negative name dependency",
    )
  } else {
    run Testing.expect(false, "demanded bad alias has a typed rejection")
  }
  let again = run Semantic.demandSignature(&mut semantic, &entry, b"entry")
  let hit = Shared.with<Result<Answer, NoRejection>, AnswerView>(&again, inspect)
  run Testing.expect(
    hit.success && hit.sources == first.sources && reads(Semantic.sourceEvents(&semantic), &entry) == 1,
    "memo hit retains evidence without another source read",
  )
  let demanded = run Semantic.demandSignature(&mut semantic, &entry, b"missing")
  let missingDiagnostic = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &demanded,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move missingDiagnostic {
    run Testing.expect(
      Shared.with<Rejection, bool>(&value, isMissingModule),
      "demanded import target absence is anchored",
    )
  } else {
    run Testing.expect(false, "demanded missing import has a typed rejection")
  }
  run Testing.expect(
    reads(Semantic.sourceEvents(&semantic), &missing) == 1,
    "missing target is read only on demand",
  )
  return ()
}

test effect fn defersUnusedDeclarationsAndReusesWrittenSignature() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run lazyClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn importClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("entry.silk")
  let library = run module("library.silk")
  let librarySource = run present(
    "pub struct Thing { field: Missing }\npub type PublicAlias = Thing\n",
  )
  let first = run Revision.publish(&Revision.make(), &library, &librarySource)
  let entrySource = run present(
    "import library as Library { PublicAlias as Alias }\nfn entry(value: Alias) -> Library.Thing { return move value }\n",
  )
  let revision = run Revision.publish(&first, &entry, &entrySource)
  let mut semantic = Semantic.make(move revision)
  let signature = run Semantic.demandSignature(&mut semantic, &entry, b"entry")
  let result = Shared.with<Result<Answer, NoRejection>, AnswerView>(&signature, inspect)
  run Testing.expect(result.success, "imported alias resolves from written signature")
  run Testing.expect(result.dependencies > 0, "imported alias records nested demands")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&signature, importedSignatureHasDependencies),
    "signature keeps selected import ordinal, namespace, public name, alias, and identity edges",
  )
  run Testing.expect(result.sources == 2, "signature records each directly inspected source")
  let writtenResult = Shared.with<Result<Answer, NoRejection>, Option<Shared<ResolvedType>>>(
    &signature,
    signatureResult,
  )
  if let Option<Shared<ResolvedType>>.Some {value} = move writtenResult {
    run Testing.expect(
      Shared.with<ResolvedType, bool>(&value, isNominal),
      "alias result retains nominal identity",
    )
  } else {
    run Testing.expect(false, "signature has a written result")
  }
  run Testing.expect(
    reads(Semantic.sourceEvents(&semantic), &entry) == 1 && reads(
      Semantic.sourceEvents(&semantic),
      &library,
    ) == 1,
    "import target is read only when alias is used",
  )
  run Testing.expect(
    starts(Semantic.eventLog(&semantic), Family.Import) == 2 && starts(
      Semantic.eventLog(&semantic),
      Family.Alias,
    ) == 1 && starts(Semantic.eventLog(&semantic), Family.Identity) == 1,
    "hybrid namespace and selected alias share nominal identity",
  )
  let again = run Semantic.demandSignature(&mut semantic, &entry, b"entry")
  let cached = Shared.with<Result<Answer, NoRejection>, AnswerView>(&again, inspect)
  run Testing.expect(
    cached.success && cached.dependencies == result.dependencies && cached.sources == result.sources,
    "imported signature memo hit keeps fact and dependency evidence",
  )
  run Testing.expect(
    reads(Semantic.sourceEvents(&semantic), &entry) == 1 && reads(
      Semantic.sourceEvents(&semantic),
      &library,
    ) == 1,
    "imported signature memo hit does not reread sources",
  )
  return ()
}

test effect fn resolvesImportedAliasWithoutFieldsOrBodies() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run importClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn cycleClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("entry.silk")
  let source = run present(
    "type A = B\ntype B = A\nfn f() -> i32 { return g() }\nfn g() -> i32 { return f() }\n",
  )
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
  let mut semantic = Semantic.make(move revision)
  let function = run Semantic.demandSignature(&mut semantic, &entry, b"f")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&function, inspect).success && starts(
      Semantic.eventLog(&semantic),
      Family.Signature,
    ) == 1,
    "recursive bodies do not demand another signature",
  )
  let alias = run Semantic.demandAlias(&mut semantic, &entry, b"A")
  let diagnostic = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &alias,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move diagnostic {
    run Testing.expect(
      Shared.with<Rejection, bool>(&value, isCycle),
      "alias cycle has a typed code",
    )
    run Testing.expect(
      Shared.with<Rejection, usize>(&value, cyclePathLength) == 3,
      "alias cycle has a declaration path",
    )
    run Testing.expect(
      Shared.with<Rejection, bool>(&value, aliasCycleAnchor),
      "alias cycle is anchored",
    )
  } else {
    run Testing.expect(false, "alias cycle has a typed rejection")
  }
  return ()
}

test effect fn separatesSignatureRecursionFromAliasCycles() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run cycleClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn visibilityClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("entry.silk")
  let source = run present(
    "struct Hidden { field: Missing }\npub fn reveal() -> Hidden { return () }\ntype Clash = i32\nstruct Clash {}\npub type NotReady = never\n",
  )
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
  let mut semantic = Semantic.make(move revision)
  let revealed = run Semantic.demandSignature(&mut semantic, &entry, b"reveal")
  let privateType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &revealed,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move privateType {
    run Testing.expect(
      Shared.with<Rejection, bool>(&value, isPrivateExposure),
      "public written signature rejects private nominal type at its use",
    )
  } else {
    run Testing.expect(false, "private type exposure has a typed rejection")
  }
  let clash = run Semantic.demandAlias(&mut semantic, &entry, b"Clash")
  let collision = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &clash,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move collision {
    run Testing.expect(
      Shared.with<Rejection, bool>(&value, isCollision),
      "complete name bucket rejects collision without winner",
    )
  } else {
    run Testing.expect(false, "colliding name has a typed rejection")
  }
  let unsupported = run Semantic.demandAlias(&mut semantic, &entry, b"NotReady")
  let diagnostic = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &unsupported,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move diagnostic {
    run Testing.expect(
      Shared.with<Rejection, bool>(&value, isUnsupported),
      "demanded unsupported type is anchored",
    )
  } else {
    run Testing.expect(false, "unsupported type has a typed rejection")
  }
  return ()
}

test effect fn rejectsPrivateExposureCollisionsAndDemandedUnsupportedType() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run visibilityClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn importCycleClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("entry.silk")
  let firstModule = run module("first.silk")
  let secondModule = run module("second.silk")
  let firstSource = run present("pub import second { Alias }\n")
  let first = run Revision.publish(&Revision.make(), &firstModule, &firstSource)
  let secondSource = run present("pub import first { Alias }\n")
  let second = run Revision.publish(&first, &secondModule, &secondSource)
  let entrySource = run present("import first { Alias }\nfn entry() -> Alias { return () }\n")
  let revision = run Revision.publish(&second, &entry, &entrySource)
  let mut semantic = Semantic.make(move revision)
  let signature = run Semantic.demandSignature(&mut semantic, &entry, b"entry")
  let diagnostic = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &signature,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move diagnostic {
    run Testing.expect(
      Shared.with<Rejection, bool>(&value, isCycle),
      "public import-name cycle has a typed code",
    )
    run Testing.expect(
      Shared.with<Rejection, usize>(&value, cyclePathLength) == 3,
      "public import-name cycle has a declaration path",
    )
    run Testing.expect(
      Shared.with<Rejection, bool>(&value, importCycleAnchor),
      "public import-name cycle is anchored",
    )
  } else {
    run Testing.expect(false, "public import-name cycle has a typed rejection")
  }
  run Testing.expect(
    reads(Semantic.sourceEvents(&semantic), &firstModule) == 1 && reads(
      Semantic.sourceEvents(&semantic),
      &secondModule,
    ) == 1,
    "import-name cycle opens each target once",
  )
  return ()
}

test effect fn rejectsPublicImportNameCycle() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run importCycleClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}
