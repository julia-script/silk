{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "docs",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@silklang/docs", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "docs-next",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@silklang/docs", "exec", "next", "dev"],
      "port": 3000,
      "autoPort": true
    }
  ]
}
