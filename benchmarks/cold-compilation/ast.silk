// Matched in-memory benchmark: see ast.rs, ast.zig, and README.md.
import silk.allocator {Allocator, OutOfMemoryError}
import silk.effect {Effect}
import silk.i32
import silk.string {String}
import silk.u8
import silk.vector {Vector}

// Token kinds: EOF=0, number=1, name=2, + =3, - =4, * =5,
// ( =6, ) =7, ; =8, = =9, invalid=10. Names are single ASCII letters.
struct Token {
  kind: i32
  value: i32
  start: usize
  end: usize
}

struct Diagnostic {
  code: i32
  start: usize
  end: usize
}

union Kind {
  Number {value: i32},
  Name {index: usize},
  Negate {child: usize},
  Binary {operator: i32, left: usize, right: usize},
  Assign {index: usize, child: usize},
  Error,
}

struct Node {
  kind: Kind
  start: usize
  end: usize
}

struct Parser {
  tokens: Vector<Token>
  nodes: Vector<Node>
  roots: Vector<usize>
  diagnostics: Vector<Diagnostic>
  position: usize
}

impl Copy for Token {}

impl Copy for Diagnostic {}

impl Copy for Kind {}

impl Copy for Node {}

fn digit(byte: u8) -> bool {
  return byte >= 48 && byte <= 57
}

fn punctuation(byte: u8) -> i32 {
  if byte == 43 {
    return 3
  }
  if byte == 45 {
    return 4
  }
  if byte == 42 {
    return 5
  }
  if byte == 40 {
    return 6
  }
  if byte == 41 {
    return 7
  }
  if byte == 59 {
    return 8
  }
  if byte == 61 {
    return 9
  }
  return 10
}

effect fn report(parser: &mut Parser, code: i32, start: usize, end: usize)
! OutOfMemoryError
? &mut Allocator {
  run Vector.append<Diagnostic>(
    &mut parser.diagnostics,
    Diagnostic {code: code, start: start, end: end},
  )
}

effect fn lex(source: string) -> Parser ! OutOfMemoryError ? &mut Allocator {
  let bytes = String.utf8Bytes(source)
  let mut parser = Parser {
    tokens: Vector.make<Token>(),
    nodes: Vector.make<Node>(),
    roots: Vector.make<usize>(),
    diagnostics: Vector.make<Diagnostic>(),
    position: 0,
  }
  let mut position: usize = 0
  while position < bytes.length {
    let byte = bytes[position]
    if byte == 32 || byte == 9 || byte == 10 || byte == 13 {
      position = position + 1
    } else if byte == 35 {
      while position < bytes.length && bytes[position] != 10 {
        position = position + 1
      }
    } else {
      let start = position
      let mut kind = punctuation(byte)
      let mut value: i32 = 0
      if digit(byte) {
        kind = 1
        while position < bytes.length && digit(bytes[position]) {
          value = value * 10 + u8.toI32(bytes[position]) - 48
          position = position + 1
        }
      } else {
        position = position + 1
        if byte >= 97 && byte <= 122 {
          kind = 2
          value = u8.toI32(byte) - 97
        }
        if kind == 10 {
          run report(&mut parser, 1, start, position)
        }
      }
      run Vector.append<Token>(
        &mut parser.tokens,
        Token {kind: kind, value: value, start: start, end: position},
      )
    }
  }
  run Vector.append<Token>(
    &mut parser.tokens,
    Token {kind: 0, value: 0, start: position, end: position},
  )
  return move parser
}

fn current(parser: &Parser) -> Token {
  let position = parser.position
  return Vector.get<Token>(&parser.tokens, position)
}

fn advance(parser: &mut Parser) -> Token {
  let token = current(&parser)
  if token.kind != 0 {
    parser.position = parser.position + 1
  }
  return token
}

effect fn append(parser: &mut Parser, kind: Kind, start: usize, end: usize) -> usize
! OutOfMemoryError
? &mut Allocator {
  let id = Vector.length<Node>(&parser.nodes)
  run Vector.append<Node>(&mut parser.nodes, Node {kind: kind, start: start, end: end})
  return id
}

effect fn primary(parser: &mut Parser) -> usize ! OutOfMemoryError ? &mut Allocator {
  let token = current(&parser)
  if token.kind == 1 {
    drop advance(&mut parser)
    return run append(&mut parser, Kind.Number {value: token.value}, token.start, token.end)
  }
  if token.kind == 2 {
    drop advance(&mut parser)
    return run append(
      &mut parser,
      Kind.Name {index: i32.toUsize(token.value)},
      token.start,
      token.end,
    )
  }
  if token.kind == 4 {
    drop advance(&mut parser)
    let child = run primary(&mut parser)
    let end = Vector.get<Node>(&parser.nodes, child).end
    return run append(&mut parser, Kind.Negate {child: child}, token.start, end)
  }
  if token.kind == 6 {
    drop advance(&mut parser)
    let child = run expression(&mut parser)
    let closing = current(&parser)
    if closing.kind == 7 {
      drop advance(&mut parser)
    } else {
      run report(&mut parser, 3, closing.start, closing.end)
    }
    return child
  }
  run report(&mut parser, 2, token.start, token.end)
  if token.kind != 0 && token.kind != 8 && token.kind != 7 {
    drop advance(&mut parser)
  }
  return run append(&mut parser, Kind.Error, token.start, token.end)
}

effect fn binary(parser: &mut Parser, operator: i32, left: usize, right: usize) -> usize
! OutOfMemoryError
? &mut Allocator {
  let start = Vector.get<Node>(&parser.nodes, left).start
  let end = Vector.get<Node>(&parser.nodes, right).end
  return run append(
    &mut parser,
    Kind.Binary {operator: operator, left: left, right: right},
    start,
    end,
  )
}

effect fn term(parser: &mut Parser) -> usize ! OutOfMemoryError ? &mut Allocator {
  let mut left = run primary(&mut parser)
  while current(&parser).kind == 5 {
    let operator = advance(&mut parser).kind
    let right = run primary(&mut parser)
    let next = run binary(&mut parser, operator, left, right)
    left = next
  }
  return left
}

effect fn expression(parser: &mut Parser) -> usize ! OutOfMemoryError ? &mut Allocator {
  let mut left = run term(&mut parser)
  while current(&parser).kind == 3 || current(&parser).kind == 4 {
    let operator = advance(&mut parser).kind
    let right = run term(&mut parser)
    let next = run binary(&mut parser, operator, left, right)
    left = next
  }
  return left
}

effect fn statement(parser: &mut Parser) -> usize ! OutOfMemoryError ? &mut Allocator {
  let token = current(&parser)
  if token.kind == 2 && Vector.get<Token>(&parser.tokens, parser.position + 1).kind == 9 {
    drop advance(&mut parser)
    drop advance(&mut parser)
    let child = run expression(&mut parser)
    let end = Vector.get<Node>(&parser.nodes, child).end
    return run append(
      &mut parser,
      Kind.Assign {index: i32.toUsize(token.value), child: child},
      token.start,
      end,
    )
  }
  return run expression(&mut parser)
}

effect fn parse(source: string) -> Parser ! OutOfMemoryError ? &mut Allocator {
  let mut parser = run lex(source)
  while current(&parser).kind != 0 {
    let root = run statement(&mut parser)
    run Vector.append<usize>(&mut parser.roots, root)
    let token = current(&parser)
    if token.kind != 8 {
      run report(&mut parser, 4, token.start, token.end)
      while current(&parser).kind != 0 && current(&parser).kind != 8 {
        drop advance(&mut parser)
      }
    }
    if current(&parser).kind == 8 {
      drop advance(&mut parser)
    }
  }
  return move parser
}

fn operation(operator: i32, left: i32, right: i32) -> i32 {
  if operator == 3 {
    return left + right
  }
  if operator == 4 {
    return left - right
  }
  return left * right
}

fn assign(bindings: &mut Vector<i32>, index: usize, value: i32) -> i32 {
  Vector.set<i32>(&mut bindings, index, value)
  return value
}

// Postorder evaluation also checks that every child ID precedes its parent.
effect fn evaluate(parser: &Parser) -> i32 ! OutOfMemoryError ? &mut Allocator {
  let mut values = Vector.make<i32>()
  let mut bindings = Vector.make<i32>()
  let mut index: usize = 0
  while index < 26 {
    run Vector.append<i32>(&mut bindings, 0)
    index = index + 1
  }
  index = 0
  while index < Vector.length<Node>(&parser.nodes) {
    let node = Vector.get<Node>(&parser.nodes, index)
    let value = match node.kind {
      Kind.Number {value} => value
      Kind.Name {index: name} => Vector.get<i32>(&bindings, name)
      Kind.Negate {child} => 0 - Vector.get<i32>(&values, child)
      Kind.Binary {operator, left, right} => operation(
        operator,
        Vector.get<i32>(&values, left),
        Vector.get<i32>(&values, right),
      )
      Kind.Assign {index: name, child} => assign(
        &mut bindings,
        name,
        Vector.get<i32>(&values, child),
      )
      Kind.Error => 0
    }
    run Vector.append<i32>(&mut values, value)
    index = index + 1
  }
  let mut total: i32 = 0
  index = 0
  while index < Vector.length<usize>(&parser.roots) {
    total = total + Vector.get<i32>(&values, Vector.get<usize>(&parser.roots, index))
    index = index + 1
  }
  return total
}

effect fn check(
  source: string,
  total: i32,
  nodes: usize,
  roots: usize,
  diagnostics: usize,
  locations: usize,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  let parser = run parse(source)
  if Vector.length<Node>(&parser.nodes) != nodes || Vector.length<usize>(&parser.roots) != roots || Vector.length<
    Diagnostic,
  >(&parser.diagnostics) != diagnostics {
    return false
  }
  let mut index: usize = 0
  let mut positions: usize = 0
  while index < diagnostics {
    let diagnostic = Vector.get<Diagnostic>(&parser.diagnostics, index)
    positions = positions + diagnostic.start + diagnostic.end + i32.toUsize(diagnostic.code)
    index = index + 1
  }
  if positions != locations {
    return false
  }
  index = 0
  while index < nodes {
    let node = Vector.get<Node>(&parser.nodes, index)
    if node.start > node.end || node.end > String.byteLength(source) {
      return false
    }
    index = index + 1
  }
  let actual = run evaluate(&parser)
  return actual == total
}

effect fn suite() -> i32 ! OutOfMemoryError ? &mut Allocator {
  if !(run check("a = 12; b = (a + 3) * 9; b - a * 2; -b + 140;", 263, 17, 4, 0, 0)) {
    return 1
  }
  if !(run check("1 + ; 2 * 3; (4 + 5; 6;", 22, 10, 4, 2, 53)) {
    return 2
  }
  if !(run check("@; 7;", 7, 2, 2, 2, 5)) {
    return 3
  }
  if !(run check("1 2; 3;", 4, 2, 2, 1, 9)) {
    return 4
  }
  if !(run check("# comment\n", 0, 0, 0, 0, 0)) {
    return 5
  }
  let mut source = String.make()
  let mut index: usize = 0
  while index < 64 {
    run String.append(&mut source, "a = 12; b = (a + 3) * 9; b - a * 2; -b + 140; # loop\n")
    index = index + 1
  }
  if !(run check(String.view(&source), 16832, 1088, 256, 0, 0)) {
    return 6
  }
  return 0
}

/// A failed benchmark self-check, identified by its one-based corpus case.
pub struct CheckFailure {
  case: i32
}

pub effect fn main() -> () ! OutOfMemoryError | CheckFailure {
  let mut allocator = Allocator.systemAllocatorProvider()
  let result = run suite()
    |> Effect.provideMut<Allocator>(&mut allocator)
  if result != 0 {
    fail CheckFailure {case: result}
  }
}
