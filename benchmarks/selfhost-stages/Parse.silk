import bench.Support
import bench.Support {CheckFailure}
import bench.TreeCheck
import parser.Parser
import silk.allocator {Allocator, OutOfMemoryError}
import silk.effect {Effect}

effect fn program() -> () ! OutOfMemoryError | CheckFailure ? &mut Allocator {
  let source = run Support.source()
  let tokens = run Support.lex(&source)
  let tree = run Parser.parse(move source, move tokens)
  return run TreeCheck.check(&tree)
}

pub effect fn main() -> () ! OutOfMemoryError | CheckFailure {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run program() |> Effect.provideMut<Allocator>(&mut allocator)
}
