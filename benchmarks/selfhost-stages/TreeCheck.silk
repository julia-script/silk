// Kept separate so the lexer-only stage does not import the parser.
import bench.Input
import bench.Support {CheckFailure}
import parser.Diagnostic {Diagnostic}
import parser.Element {Element}
import parser.Node {Node, NodeKind}
import parser.SyntaxTree {SyntaxTree}
import silk.bytes {Bytes}
import silk.vector {Vector}

fn valid(tree: &SyntaxTree) -> bool {
  let count = Vector.length<Node>(&tree.nodes)
  if count != Input.nodeCount() || tree.root.index + 1 != count {
    return false
  }
  if Vector.length<Diagnostic>(&tree.diagnostics) != 0 {
    return false
  }
  let rootIndex = tree.root.index
  let sourceLength = Bytes.length(&tree.source)
  let nodes = Vector.asSlice<Node>(&tree.nodes)
  if nodes[rootIndex].kind != NodeKind.SourceFile || nodes[rootIndex].span.start != 0 || nodes[rootIndex].span.end != sourceLength {
    return false
  }
  let mut index: usize = 0
  while index < count {
    let span = nodes[index].span
    if span.start > span.end || span.end > sourceLength {
      return false
    }
    let mut childIndex: usize = 0
    let elements = Vector.asSlice<Element>(&nodes[index].elements)
    while childIndex < elements.length {
      let element = elements[childIndex]
      let ordered = match element {
        Element.Node {id} => id.index < index
        Element.Token {id} => id.index < Input.tokenCount()
        Element.MissingToken {expected: ignoredExpected, span: ignoredSpan} => false
      }
      if !ordered {return false}
      childIndex = childIndex + 1
    }
    index = index + 1
  }
  return true
}

pub effect fn check(tree: &SyntaxTree) -> () ! CheckFailure {
  if !valid(tree) {fail CheckFailure {}}
}
