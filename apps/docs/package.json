{
  "name": "@silk-effect/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api": "typedoc && node scripts/label-api-folders.mjs",
    "build": "pnpm api && next build",
    "clean": "node -e \"require('node:fs').rmSync('.next', { recursive: true, force: true })\"",
    "dev": "pnpm api && next dev",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "pnpm api && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@effect/atom-react": "4.0.0-beta.102",
    "@lezer/highlight": "^1.2.3",
    "@silk-effect/compiler": "workspace:*",
    "@silk-effect/language": "workspace:*",
    "@silk-effect/lsp": "workspace:*",
    "dockview": "^7.0.4",
    "dockview-react": "^7.0.4",
    "effect": "catalog:",
    "fumadocs-core": "^16.14.0",
    "fumadocs-mdx": "^15.2.2",
    "fumadocs-ui": "^16.14.0",
    "mdast-util-from-markdown": "^2.0.3",
    "next": "16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@silk-effect/llvm": "workspace:*",
    "@silk-effect/wasm": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.24",
    "tailwindcss": "^4.3.3",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "5.9.3"
  }
}
