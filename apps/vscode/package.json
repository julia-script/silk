{
  "name": "silk-language",
  "displayName": "Silk Language",
  "version": "0.0.0",
  "private": true,
  "description": "Syntax highlighting and language server support for Silk Effect source files.",
  "categories": [
    "Programming Languages"
  ],
  "license": "MIT",
  "publisher": "silklang",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "install:cursor": "node scripts/install-local.mjs",
    "install:code": "node scripts/install-local.mjs --vscode-only",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@silklang/lsp": "workspace:*",
    "effect": "catalog:",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "^24.10.1",
    "@types/vscode": "^1.90.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "silk.restartLanguageServer",
        "title": "Silk: Restart Language Server"
      },
      {
        "command": "silk.openInspector",
        "title": "Silk: Open Inspector"
      }
    ],
    "languages": [
      {
        "id": "silk",
        "aliases": [
          "Silk"
        ],
        "extensions": [
          ".silk"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "silk",
        "scopeName": "source.silk",
        "path": "./syntaxes/silk.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Silk",
      "properties": {
        "silk.analysis": {
          "type": "object",
          "default": {},
          "description": "Analysis profile selection: profile name, target triple, or a complete profileInput override. Empty uses the project default and then host target.",
          "additionalProperties": false,
          "properties": {
            "profile": {
              "type": "string"
            },
            "target": {
              "type": "string"
            },
            "profileInput": {
              "type": "object"
            }
          }
        }
      }
    },
    "semanticTokenModifiers": [
      {
        "id": "inactive",
        "description": "Source excluded by the selected compilation profile"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "silk",
        "scopes": {
          "*.inactive": [
            "comment.block.silk"
          ]
        }
      }
    ]
  },
  "activationEvents": [
    "onLanguage:silk"
  ],
  "engines": {
    "vscode": "^1.90.0"
  }
}
