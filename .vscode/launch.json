{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Silk: Run current file",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "command": "out=$(mktemp -t silk-run) && node \"${workspaceFolder}/packages/cli/dist/bin.js\" build-exe \"${file}\" --source-root \"${fileDirname}\" --output \"$out\" && \"$out\"; echo \"exit: $?\"; rm -f \"$out\""
    },
    {
      "name": "Silk: Extension Development Host",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/apps/vscode"],
      "preLaunchTask": "Silk: Build extension host deps",
      "outFiles": [
        "${workspaceFolder}/apps/vscode/dist/**/*.js",
        "${workspaceFolder}/packages/lsp/dist/**/*.js"
      ]
    },
    {
      "name": "Silk: LSP Acceptance Host (manual)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/apps/vscode",
        "${workspaceFolder}/apps/vscode/test/fixtures/lsp-acceptance"
      ],
      "preLaunchTask": "Silk: Build extension host deps",
      "outFiles": [
        "${workspaceFolder}/apps/vscode/dist/**/*.js",
        "${workspaceFolder}/packages/lsp/dist/**/*.js"
      ]
    },
    {
      "name": "Silk: LSP Extension Host Test",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--disable-extensions",
        "--extensionDevelopmentPath=${workspaceFolder}/apps/vscode",
        "--extensionTestsPath=${workspaceFolder}/apps/vscode/test/extension-host/index.cjs",
        "${workspaceFolder}/apps/vscode/test/fixtures/lsp-acceptance"
      ],
      "preLaunchTask": "Silk: Build extension host deps",
      "outFiles": [
        "${workspaceFolder}/apps/vscode/dist/**/*.js",
        "${workspaceFolder}/packages/lsp/dist/**/*.js"
      ]
    }
  ]
}
