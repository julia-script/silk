{
  "name": "@silk-effect/snippet",
  "version": "0.0.0",
  "description": "Embeddable framework-free <silk-snippet> custom element: compiler-driven highlighting with opt-in diagnostics, hover, and inlay hints.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julia-script/silk-effect.git",
    "directory": "packages/snippet"
  },
  "homepage": "https://github.com/julia-script/silk-effect#readme",
  "bugs": {
    "url": "https://github.com/julia-script/silk-effect/issues"
  },
  "keywords": [
    "silk",
    "custom-element",
    "web-component",
    "syntax-highlighting",
    "diagnostics"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./Element": {
      "types": "./dist/Element.d.ts",
      "import": "./dist/Element.js"
    },
    "./Editor": {
      "types": "./dist/Editor.d.ts",
      "import": "./dist/Editor.js"
    },
    "./HoverContent": {
      "types": "./dist/HoverContent.d.ts",
      "import": "./dist/HoverContent.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    },
    "./bundle": "./dist/silk-snippet.bundle.js"
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.json && node scripts/bundle.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@lezer/highlight": "^1.2.3",
    "@silk-effect/compiler": "workspace:*",
    "@silk-effect/language": "workspace:*",
    "@silk-effect/lsp": "workspace:*",
    "effect": "catalog:",
    "mdast-util-from-markdown": "^2.0.3",
    "vscode-languageserver-types": "3.17.5"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.10.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1"
  }
}
