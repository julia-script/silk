{
  "name": "@silklang/wasm",
  "version": "0.0.0",
  "description": "Effect-native WebAssembly module construction with deterministic text and binary emission.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julia-script/silk-effect.git",
    "directory": "packages/wasm"
  },
  "homepage": "https://github.com/julia-script/silk-effect#readme",
  "bugs": {
    "url": "https://github.com/julia-script/silk-effect/issues"
  },
  "keywords": [
    "webassembly",
    "wasm",
    "effect",
    "typescript"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "UPSTREAM.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./Binary": {
      "types": "./dist/Binary.d.ts",
      "import": "./dist/Binary.js"
    },
    "./Builder": {
      "types": "./dist/Builder.d.ts",
      "import": "./dist/Builder.js"
    },
    "./ConstExpr": {
      "types": "./dist/ConstExpr.d.ts",
      "import": "./dist/ConstExpr.js"
    },
    "./Data": {
      "types": "./dist/Data.d.ts",
      "import": "./dist/Data.js"
    },
    "./Elem": {
      "types": "./dist/Elem.d.ts",
      "import": "./dist/Elem.js"
    },
    "./Export": {
      "types": "./dist/Export.d.ts",
      "import": "./dist/Export.js"
    },
    "./Func": {
      "types": "./dist/Func.d.ts",
      "import": "./dist/Func.js"
    },
    "./Global": {
      "types": "./dist/Global.d.ts",
      "import": "./dist/Global.js"
    },
    "./Import": {
      "types": "./dist/Import.d.ts",
      "import": "./dist/Import.js"
    },
    "./Instr": {
      "types": "./dist/Instr.d.ts",
      "import": "./dist/Instr.js"
    },
    "./Limits": {
      "types": "./dist/Limits.d.ts",
      "import": "./dist/Limits.js"
    },
    "./Memory": {
      "types": "./dist/Memory.d.ts",
      "import": "./dist/Memory.js"
    },
    "./Table": {
      "types": "./dist/Table.d.ts",
      "import": "./dist/Table.js"
    },
    "./Tag": {
      "types": "./dist/Tag.d.ts",
      "import": "./dist/Tag.js"
    },
    "./Type": {
      "types": "./dist/Type.d.ts",
      "import": "./dist/Type.js"
    },
    "./ValType": {
      "types": "./dist/ValType.d.ts",
      "import": "./dist/ValType.js"
    },
    "./Validate": {
      "types": "./dist/Validate.d.ts",
      "import": "./dist/Validate.js"
    },
    "./WasmError": {
      "types": "./dist/WasmError.d.ts",
      "import": "./dist/WasmError.js"
    },
    "./WatText": {
      "types": "./dist/WatText.d.ts",
      "import": "./dist/WatText.js"
    }
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "fixtures:regenerate": "pnpm build && node scripts/fixtures.mjs regenerate",
    "fixtures:verify": "node scripts/fixtures.mjs verify",
    "parity:oracle": "node scripts/oracle.mjs",
    "test": "vitest run --passWithNoTests && node scripts/fixtures.mjs verify",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:"
  }
}
