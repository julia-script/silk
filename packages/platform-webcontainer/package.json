{
  "name": "@silklang/platform-webcontainer",
  "version": "0.0.0",
  "description": "Effect-native WebContainer runtime, filesystem, process, and event services.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julia-script/silk-effect.git",
    "directory": "packages/platform-webcontainer"
  },
  "homepage": "https://github.com/julia-script/silk-effect#readme",
  "bugs": {
    "url": "https://github.com/julia-script/silk-effect/issues"
  },
  "keywords": [
    "webcontainer",
    "browser",
    "effect",
    "typescript"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./WebContainer": {
      "types": "./dist/WebContainer.d.ts",
      "import": "./dist/WebContainer.js"
    },
    "./WebContainerError": {
      "types": "./dist/WebContainerError.d.ts",
      "import": "./dist/WebContainerError.js"
    },
    "./WebContainerEvent": {
      "types": "./dist/WebContainerEvent.d.ts",
      "import": "./dist/WebContainerEvent.js"
    },
    "./WebContainerFileSystem": {
      "types": "./dist/WebContainerFileSystem.d.ts",
      "import": "./dist/WebContainerFileSystem.js"
    },
    "./WebContainerProcess": {
      "types": "./dist/WebContainerProcess.d.ts",
      "import": "./dist/WebContainerProcess.js"
    }
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "vitest run --passWithNoTests --exclude 'test/browser/**'",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@webcontainer/api": "^1.6.4",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "^24.10.1",
    "@vitest/browser-playwright": "4.1.10",
    "playwright": "1.62.1"
  }
}
