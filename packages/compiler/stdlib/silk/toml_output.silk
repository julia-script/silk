//! TOML document and value output through the ambient Writer.
//!
//! # When to use
//! Use [`TomlOutput.write`] for an owned TOML document. Unsupported scalar spellings and
//! container shapes fail before the first write. Writer failures may leave an accepted prefix.

import silk.allocator { Allocator, OutOfMemoryError }
import silk.box { Box }
import silk.option { Option }
import silk.slice { Slice }
import silk.string { String }
import silk.toml_scanner { TomlError, TomlReason, TomlScalarKind, TomlScanner, TomlSpan }
import silk.toml_value { TomlChild, Value }
import silk.u8
import silk.usize
import silk.vector { Vector }
import silk.writer { Writer, WriterError }

/// Output operations for an owned document or a value inside an assignment.
pub struct TomlOutput {}

impl TomlOutput {
  /// Writes a complete document, preserving table and array-of-tables structure.
  pub effect fn write(document: &Value)
    -> () ! TomlError | OutOfMemoryError | WriterError ? &mut Allocator | &mut Writer {
    run check(document, usize.ZERO, true)
    let mut path = Vector.make<String>()
    return run writeTable(document, &mut path, true)
  }

  /// Writes a quoted TOML basic string.
  pub effect fn writeString(value: string) -> () ! WriterError ? &mut Writer {
    let bytes = String.utf8Bytes(value)
    run Writer.writeAll(b"\"")
    let mut at = usize.ZERO
    let mut start = usize.ZERO
    while at < bytes.length {
      let byte = bytes[at]
      if byte < 32 || byte == 34 || byte == 92 || byte == 127 {
        if start < at { run Writer.writeAll(Slice.view<u8>(bytes, start, at - start)) }
        if byte == 34 { run Writer.writeAll(b"\\\"") }
        else if byte == 92 { run Writer.writeAll(b"\\\\") }
        else if byte == 8 { run Writer.writeAll(b"\\b") }
        else if byte == 12 { run Writer.writeAll(b"\\f") }
        else if byte == 10 { run Writer.writeAll(b"\\n") }
        else if byte == 13 { run Writer.writeAll(b"\\r") }
        else if byte == 9 { run Writer.writeAll(b"\\t") }
        else {
          let escaped = [u8.toU8(92), u8.toU8(117), u8.toU8(48), u8.toU8(48),
            digit(byte / u8.toU8(16)), digit(byte % u8.toU8(16))]
          run Writer.writeAll(&escaped)
        }
        start = at + usize.ONE
      }
      at = at + usize.ONE
    }
    if start < bytes.length { run Writer.writeAll(Slice.view<u8>(bytes, start, bytes.length - start)) }
    return run Writer.writeAll(b"\"")
  }

  /// Writes one decoded key with bare spelling when possible.
  pub effect fn writeKey(value: string) -> () ! WriterError ? &mut Writer {
    let bytes = String.utf8Bytes(value)
    let mut bare = bytes.length > usize.ZERO
    let mut at = usize.ZERO
    while at < bytes.length {
      let byte = bytes[at]
      if !((byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) ||
        (byte >= 48 && byte <= 57) || byte == 45 || byte == 95) { bare = false }
      at = at + usize.ONE
    }
    if bare { return run Writer.writeAll(bytes) }
    return run TomlOutput.writeString(value)
  }
}

fn digit(value: u8) -> u8 {
  if value < 10 { return value + u8.toU8(48) }
  return value - u8.toU8(10) + u8.toU8(65)
}

fn invalid(reason: TomlReason) -> TomlError { return TomlError { reason: move reason, offset: usize.ZERO } }

fn isTable(value: &Value) -> bool {
  return match &value.* {
    Value.Table { entries: tableEntries, kind: tableKind } => true
    _ => false
  }
}

fn isTableArray(value: &Value) -> bool {
  return match &value.* {
    Value.Array { values: arrayValues, tables } => tables
    _ => false
  }
}

fn childCount(value: &Value) -> usize {
  return match &value.* {
    Value.Array { values, tables: arrayTables } => {
      let boxed = Box.get<Vector<TomlChild>>(&values)
      return Vector.length<TomlChild>(&boxed[0])
    }
    Value.Table { entries, kind: tableKind } => {
      let boxed = Box.get<Vector<TomlChild>>(&entries)
      return Vector.length<TomlChild>(&boxed[0])
    }
    _ => usize.ZERO
  }
}

fn childAt<'a>(value: &'a Value, index: usize) -> Option<&'a TomlChild> {
  return match &value.* {
    Value.Array { values, tables: arrayTables } => {
      let boxed = Box.get<Vector<TomlChild>>(&values)
      let children = Vector.asSlice<TomlChild>(&boxed[0])
      if index < children.length { return Option.some<&'a TomlChild>(&children[index]) }
      return Option.none<&'a TomlChild>()
    }
    Value.Table { entries, kind: tableKind } => {
      let boxed = Box.get<Vector<TomlChild>>(&entries)
      let children = Vector.asSlice<TomlChild>(&boxed[0])
      if index < children.length { return Option.some<&'a TomlChild>(&children[index]) }
      return Option.none<&'a TomlChild>()
    }
    _ => Option.none<&'a TomlChild>()
  }
}

effect fn writeRaw(text: &String) -> () ! WriterError ? &mut Writer {
  let value = String.view(text)
  return run Writer.writeAll(String.utf8Bytes(value))
}

fn validScalar(text: &String, expected: TomlScalarKind) -> bool {
  let view = String.view(text)
  let bytes = String.utf8Bytes(view)
  let scanner = TomlScanner.make(bytes)
  let found = TomlScanner.scalarKind(&scanner, TomlSpan { offset: usize.ZERO, length: bytes.length })
  return match move found {
    Option<TomlScalarKind>.None => false
    Option<TomlScalarKind>.Some { value } => match move value {
      TomlScalarKind.Integer => match move expected { TomlScalarKind.Integer => true _ => false }
      TomlScalarKind.Float => match move expected { TomlScalarKind.Float => true _ => false }
      TomlScalarKind.OffsetDateTime => match move expected { TomlScalarKind.OffsetDateTime => true _ => false }
      TomlScalarKind.LocalDateTime => match move expected { TomlScalarKind.LocalDateTime => true _ => false }
      TomlScalarKind.LocalDate => match move expected { TomlScalarKind.LocalDate => true _ => false }
      TomlScalarKind.LocalTime => match move expected { TomlScalarKind.LocalTime => true _ => false }
      _ => false
    }
  }
}

effect fn check(value: &Value, depth: usize, root: bool) -> () ! TomlError {
  if depth > 64 { fail invalid(TomlReason.DepthExceeded) }
  match &value.* {
    Value.Integer { text } => { if !validScalar(&text, TomlScalarKind.Integer) { fail invalid(TomlReason.InvalidNumber) } }
    Value.Float { text } => { if !validScalar(&text, TomlScalarKind.Float) { fail invalid(TomlReason.InvalidNumber) } }
    Value.OffsetDateTime { text } => { if !validScalar(&text, TomlScalarKind.OffsetDateTime) { fail invalid(TomlReason.InvalidDateTime) } }
    Value.LocalDateTime { text } => { if !validScalar(&text, TomlScalarKind.LocalDateTime) { fail invalid(TomlReason.InvalidDateTime) } }
    Value.LocalDate { text } => { if !validScalar(&text, TomlScalarKind.LocalDate) { fail invalid(TomlReason.InvalidDateTime) } }
    Value.LocalTime { text } => { if !validScalar(&text, TomlScalarKind.LocalTime) { fail invalid(TomlReason.InvalidDateTime) } }
    Value.Array { values, tables } => {
      if root { fail invalid(TomlReason.TableConflict) }
      let length = childCount(value)
      if tables && length == usize.ZERO { fail invalid(TomlReason.TableConflict) }
      let mut at = usize.ZERO
      while at < length {
        let found = childAt(value, at)
        match move found {
          Option<&TomlChild>.Some { value: item } => match &item.* {
            TomlChild.Item { value: child } => {
              if tables && !isTable(&child) { fail invalid(TomlReason.TableConflict) }
              run check(&child, depth + usize.ONE, false)
            }
            _ => { fail invalid(TomlReason.TableConflict) }
          }
          Option<&TomlChild>.None => { fail invalid(TomlReason.TableConflict) }
        }
        at = at + usize.ONE
      }
    }
    Value.Table { entries, kind: _ } => {
      let length = childCount(value)
      let mut at = usize.ZERO
      while at < length {
        let found = childAt(value, at)
        match move found {
          Option<&TomlChild>.Some { value: item } => match &item.* {
            TomlChild.Member { entry } => {
              let mut previous = usize.ZERO
              while previous < at {
                let earlier = childAt(value, previous)
                match move earlier {
                  Option<&TomlChild>.Some { value: prior } => match &prior.* {
                    TomlChild.Member { entry: priorEntry } => {
                      if String.view(&entry.key) == String.view(&priorEntry.key) {
                        fail invalid(TomlReason.DuplicateKey)
                      }
                    }
                    _ => { fail invalid(TomlReason.TableConflict) }
                  }
                  Option<&TomlChild>.None => { fail invalid(TomlReason.TableConflict) }
                }
                previous = previous + usize.ONE
              }
              run check(&entry.value, depth + usize.ONE, false)
            }
            _ => { fail invalid(TomlReason.TableConflict) }
          }
          Option<&TomlChild>.None => { fail invalid(TomlReason.TableConflict) }
        }
        at = at + usize.ONE
      }
    }
    _ => { if root { fail invalid(TomlReason.TableConflict) } }
  }
  return ()
}

effect fn writePath(path: &Vector<String>) -> () ! WriterError ? &mut Writer {
  let parts = Vector.asSlice<String>(path)
  let mut at = usize.ZERO
  while at < parts.length {
    if at > usize.ZERO { run Writer.writeAll(b".") }
    run TomlOutput.writeKey(String.view(&parts[at]))
    at = at + usize.ONE
  }
  return ()
}

effect fn writeTable(value: &Value, path: &mut Vector<String>, root: bool)
  -> () ! TomlError | OutOfMemoryError | WriterError ? &mut Allocator | &mut Writer {
  return match &value.* {
    Value.Table { entries, kind: _ } => {
      if !root {
        run Writer.writeAll(b"[")
        run writePath(&path.*)
        run Writer.writeAll(b"]\n")
      }
      let length = childCount(value)
      let mut at = usize.ZERO
      while at < length {
        let found = childAt(value, at)
        match move found {
          Option<&TomlChild>.Some { value: item } => match &item.* {
            TomlChild.Member { entry } => {
              let nested = isTable(&entry.value) || isTableArray(&entry.value)
              if !nested {
                run TomlOutput.writeKey(String.view(&entry.key))
                run Writer.writeAll(b" = ")
                run writeValue(&entry.value)
                run Writer.writeAll(b"\n")
              }
            }
            _ => { fail invalid(TomlReason.TableConflict) }
          }
          Option<&TomlChild>.None => { fail invalid(TomlReason.TableConflict) }
        }
        at = at + usize.ONE
      }
      at = usize.ZERO
      while at < length {
        let found = childAt(value, at)
        match move found {
          Option<&TomlChild>.Some { value: item } => match &item.* {
            TomlChild.Member { entry } => {
              let nested = isTable(&entry.value) || isTableArray(&entry.value)
              if nested {
                let name = run String.copy(String.view(&entry.key))
                run Vector.append<String>(&mut path.*, move name)
                if isTable(&entry.value) { run writeTable(&entry.value, &mut path.*, false) }
                else { run writeArrayTables(&entry.value, &mut path.*) }
                let last = Vector.length<String>(&path.*) - usize.ONE
                let removed = Vector.remove<String>(&mut path.*, last)
                drop removed
              }
            }
            _ => { fail invalid(TomlReason.TableConflict) }
          }
          Option<&TomlChild>.None => { fail invalid(TomlReason.TableConflict) }
        }
        at = at + usize.ONE
      }
      return ()
    }
    _ => { fail invalid(TomlReason.TableConflict) }
  }
}

effect fn writeArrayTables(value: &Value, path: &mut Vector<String>)
  -> () ! TomlError | OutOfMemoryError | WriterError ? &mut Allocator | &mut Writer {
  let length = childCount(value)
  let mut at = usize.ZERO
  while at < length {
    run Writer.writeAll(b"[[")
    run writePath(&path.*)
    run Writer.writeAll(b"]]\n")
    let found = childAt(value, at)
    match move found {
      Option<&TomlChild>.Some { value: item } => match &item.* {
        TomlChild.Item { value: table } => { run writeTable(&table, &mut path.*, true) }
        _ => { fail invalid(TomlReason.TableConflict) }
      }
      Option<&TomlChild>.None => { fail invalid(TomlReason.TableConflict) }
    }
    at = at + usize.ONE
  }
  return ()
}

effect fn writeValue(value: &Value) -> () ! TomlError | WriterError ? &mut Writer {
  return match &value.* {
    Value.Integer { text } => run writeRaw(&text)
    Value.Float { text } => run writeRaw(&text)
    Value.OffsetDateTime { text } => run writeRaw(&text)
    Value.LocalDateTime { text } => run writeRaw(&text)
    Value.LocalDate { text } => run writeRaw(&text)
    Value.LocalTime { text } => run writeRaw(&text)
    Value.Boolean { value: yes } => {
      if yes { return run Writer.writeAll(b"true") }
      return run Writer.writeAll(b"false")
    }
    Value.String { text } => run TomlOutput.writeString(String.view(&text))
    Value.Array { values, tables: _ } => {
      let length = childCount(value)
      run Writer.writeAll(b"[")
      let mut at = usize.ZERO
      while at < length {
        if at > usize.ZERO { run Writer.writeAll(b", ") }
        let found = childAt(value, at)
        match move found {
          Option<&TomlChild>.Some { value: item } => match &item.* {
            TomlChild.Item { value: child } => { run writeValue(&child) }
            _ => { fail invalid(TomlReason.TableConflict) }
          }
          Option<&TomlChild>.None => { fail invalid(TomlReason.TableConflict) }
        }
        at = at + usize.ONE
      }
      return run Writer.writeAll(b"]")
    }
    Value.Table { entries, kind: _ } => {
      let length = childCount(value)
      run Writer.writeAll(b"{")
      let mut at = usize.ZERO
      while at < length {
        if at > usize.ZERO { run Writer.writeAll(b", ") }
        let found = childAt(value, at)
        match move found {
          Option<&TomlChild>.Some { value: item } => match &item.* {
            TomlChild.Member { entry } => {
              run TomlOutput.writeKey(String.view(&entry.key))
              run Writer.writeAll(b" = ")
              run writeValue(&entry.value)
            }
            _ => { fail invalid(TomlReason.TableConflict) }
          }
          Option<&TomlChild>.None => { fail invalid(TomlReason.TableConflict) }
        }
        at = at + usize.ONE
      }
      return run Writer.writeAll(b"}")
    }
  }
}
