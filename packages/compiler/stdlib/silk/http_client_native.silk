  /// Returns the typed unsupported-target result before allocation or provider dispatch.
  pub fn preflight(origin: &Origin, options: &Options) -> Result<(), NativeClientError> {
    drop origin
    drop options
    return Result.failResult<(), NativeClientError>(NativeClientError.UnsupportedTarget)
  }
  /// Returns unsupported-target before route inspection or provider dispatch.
  pub fn preflightProxyRoute<'configuration>(
    route: &Route<'configuration>,
    options: &Options,
  ) -> Result<Origin, ProxyError | NativeClientError> {
    drop route
    drop options
    return Result.failResult<Origin, ProxyError | NativeClientError>(
      NativeClientError.UnsupportedTarget,
    )
  }
  /// Rejects native HTTP acquisition before allocation or provider dispatch on this target.
  pub effect fn withConnection<A, E, ?R, H: ConnectionHandler<NativeTransport, A, E ? R>>(
    origin: Origin,
    options: Options,
    limits: Limits,
    handler: H,
  ) -> A ! E | NativeClientError ? R {
    drop origin
    drop options
    drop limits
    drop handler
    fail NativeClientError.UnsupportedTarget
  }
  /// Rejects Unix HTTP acquisition before allocation or provider dispatch on this target.
  pub effect fn withUnixConnection<A, E, ?R, H: ConnectionHandler<NativeTransport, A, E ? R>>(
    path: &[u8],
    origin: Origin,
    options: Options,
    limits: Limits,
    handler: H,
  ) -> A ! E | NativeClientError ? R {
    drop path
    drop origin
    drop options
    drop limits
    drop handler
    fail NativeClientError.UnsupportedTarget
  }
  /// Rejects routed native acquisition before allocation or provider dispatch on this target.
  pub effect fn withProxyRoute<
    'configuration,
    A,
    E,
    ?R,
    H: RouteHandler<'configuration, NativeRouteProvider, A, E ? R>,
  >(
    route: Route<'configuration>,
    options: Options,
    limits: Limits,
    preparedTrust: Option<TrustSnapshot>,
    handler: H,
  ) -> A ! E | NativeClientError ? R
  where R in Without<R, ByteDuplex>,
    R in Without<R, HttpTransport> {
    drop route
    drop options
    drop limits
    drop preparedTrust
    drop handler
    fail NativeClientError.UnsupportedTarget
  }
}

/// Rebuildable native route acquisition for bounded redirect operations.
///
/// # Details
///
/// The initial sealed route retains the immutable proxy configuration. On supported native
/// targets, every attempt recomputes policy for its current URI, completes method, target, header,
/// and native-route preflight before destination contact, and replaces the stored option deadline
/// with the operation's unchanged absolute deadline. Secure attempts load a fresh trust snapshot
/// before acquisition; tunneled TLS continues to authenticate the original origin through
/// [`withProxyRoute`]. Other targets fail with `UnsupportedTarget` before inspecting the request.
pub struct NativeRedirectClient<'configuration> {
  routeValue: Route<'configuration>
  optionsValue: Options
  limitsValue: Limits
}

impl<'configuration> NativeRedirectClient<'configuration> {
  /// Creates a reusable redirect attempt client from one policy-selected route.
  pub fn make(
    route: Route<'configuration>,
    options: Options,
    limits: Limits,
  ) -> NativeRedirectClient<'configuration> {
    return NativeRedirectClient<'configuration> {
      routeValue: route,
      optionsValue: move options,
      limitsValue: limits,
    }
  }
}

fn copyRedirectInstant(value: &Instant) -> Instant {
  return SystemClock.make(SystemClock.seconds(value), SystemClock.nanoseconds(value))
}

fn copyRedirectDeadline(value: &Option<Instant>) -> Option<Instant> {
  return match & value.* {
    Option.None => Option.none<Instant>()
    Option.Some {value: present} => Option.some<Instant>(copyRedirectInstant(&present))
  }
}

fn copyRedirectContinuePolicy(value: &ContinuePolicy) -> ContinuePolicy {
  return match value {
    ContinuePolicy.Disabled => ContinuePolicy.Disabled
    ContinuePolicy.Require100 {deadline} => ContinuePolicy.Require100 {
      deadline: copyRedirectInstant(&deadline),
    }
  }
}

fn redirectRequiresContinue(value: &ContinuePolicy) -> bool {
  return match value {
    ContinuePolicy.Disabled => false
    ContinuePolicy.Require100 {deadline} => true
  }
}

fn redirectOptions(options: &Options, deadline: &Option<Instant>) -> Options {
  return Options {
    maximumAddresses: options.maximumAddresses,
    family: options.family,
    noDelay: options.noDelay,
    pollIntervalNanoseconds: options.pollIntervalNanoseconds,
    maximumAttempts: options.maximumAttempts,
    deadline: copyRedirectDeadline(deadline),
    handshakeNanoseconds: options.handshakeNanoseconds,
    tls: options.tls,
    trust: options.trust,
    alpn: options.alpn,
  }
}

struct NativeRedirectRouteHandler<'request, 'policy, H> {
  request: &'request AttemptRequest<'policy>
  method: Method<'request>
  prepared: PreparedRequest
  options: RequestOptions
  handler: H
}

impl<
  'request,
  'policy,
  A,
  HandlerError,
  ?HandlerRequirements,
  H: AttemptHandler<'policy, NativeRouteProvider, A, HandlerError ? HandlerRequirements>,
> NativeRedirectRouteHandler<'request, 'policy, H> {
  effect<
    'call,
    'transport: 'call,
    'provider: 'transport,
    'tunnel: 'provider,
  > fn handle<
    'configuration,
    'call,
    'transport: 'call,
    'provider: 'transport,
    'tunnel: 'provider,
  >(
    bridge: Self,
    route: Route<'configuration>,
    connection: &'call mut Connection<
      RouteTransport<'transport, 'provider, 'tunnel, NativeRouteProvider>
    >,
  ) -> A
  ! HandlerError | ClientError | OutOfMemoryError
  ? HandlerRequirements | &mut Allocator {
    let NativeRedirectRouteHandler<'request, 'policy, H> {
      request,
      method,
      prepared,
      options,
      handler,
    } = move bridge
    drop route
    let use = effect<'exchangeCall, 'exchangeView: 'exchangeCall> fn(
      exchange: &'exchangeCall mut Exchange<
        'exchangeView,
        RouteTransport<'transport, 'provider, 'tunnel, NativeRouteProvider>
      >,
    ) -> A ! HandlerError ? HandlerRequirements {
      return run AttemptHandler<
        'policy,
        NativeRouteProvider,
        A,
        HandlerError ? HandlerRequirements,
      >.handle(move handler, request, method, move exchange)
    }
    return run withExchange(move connection, &prepared, move options, move use)
  }
}

impl<
  'configuration,
  'request,
  'policy,
  A,
  HandlerError,
  ?HandlerRequirements,
  H: AttemptHandler<'policy, NativeRouteProvider, A, HandlerError ? HandlerRequirements>,
> RouteHandler<
  'configuration,
  NativeRouteProvider,
  A,
  HandlerError | ClientError | OutOfMemoryError
  ? HandlerRequirements | &mut Allocator
> for NativeRedirectRouteHandler<'request, 'policy, H> {
  handle: NativeRedirectRouteHandler.handle
}

static if (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText(
  "libc",
) == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText(
  "libc",
) == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
  import silk.native_socket {NativeSocketError}

  impl<
    'configuration,
    'policy,
    A,
    HandlerError,
    ?HandlerRequirements,
    H: AttemptHandler<'policy, NativeRouteProvider, A, HandlerError ? HandlerRequirements>,
  > NativeRedirectClient<'configuration> {
    effect fn withAttempt(
      client: &mut Self,
      request: AttemptRequest<'policy>,
      deadline: Option<Instant>,
      handler: H,
    ) -> A
    ! HandlerError
      | ProxyError
      | RequestError
      | ValueError
      | OriginError
      | ClientError
      | NativeClientError
      | ResolverError
      | NativeSocketError
      | ConnectionError
      | IdentityError
      | TrustSourceError
      | OutOfMemoryError
    ? HandlerRequirements
      | &mut Allocator
      | &mut MonotonicClock
      | &mut SystemClock
      | &mut Random
      | &mut TrustSource
    where HandlerRequirements in Without<HandlerRequirements, ByteDuplex>,
      HandlerRequirements in Without<HandlerRequirements, HttpTransport> {
      let uri = request.uri.view()
      let origin = match move Origin.fromUri(&uri) {
        Result.Failure {error} => { fail move error }
        Result.Success {value} => value
      }
      let secure = Origin.secure(&origin)
      let route = Route.recompute(&client.routeValue, origin)
      let options = redirectOptions(&client.optionsValue, &deadline)
      match move preflightProxyRoute(&route, &options) {
        Result.Failure {error} => { fail move error }
        Result.Success {value} => { drop value }
      }
      let method = match move Method.parse(
        String.view(&request.method),
        request.requestLimits.maxMethodBytes,
      ) {
        Result.Failure {error} => { fail move error }
        Result.Success {value} => value
      }
      let headers = request.headers.view()
      let require100 = redirectRequiresContinue(&request.continuePolicy)
      let prepared = if Route.mode(&route) == RouteMode.Forward {
        run Request.prepareForward(
          &route,
          &uri,
          request.version,
          method,
          &headers,
          &request.headerPolicy,
          request.bodyMode,
          require100,
          request.requestLimits,
          request.maxHeadBytes,
          request.maxCredentialBytes,
        )
      } else {
        run Request.fromUri(
          &uri,
          request.version,
          method,
          &headers,
          &request.headerPolicy,
          request.bodyMode,
          require100,
          request.requestLimits,
          request.maxHeadBytes,
          request.maxCredentialBytes,
        )
      }
      let trust = if secure {
        Option.some<TrustSnapshot>(run TrustSource.load(options.trust))
      } else {
        Option.none<TrustSnapshot>()
      }
      let requestOptions = RequestOptions {
        deadline: copyRedirectDeadline(&deadline),
        continuePolicy: copyRedirectContinuePolicy(&request.continuePolicy),
      }
      let bridge = NativeRedirectRouteHandler {
        request: &request,
        method: method,
        prepared: move prepared,
        options: move requestOptions,
        handler: move handler,
      }
      return run withProxyRoute(
        route,
        move options,
        client.limitsValue,
        move trust,
        move bridge,
      )
    }
  }

  impl<
    'configuration,
    'policy,
    A,
    HandlerError,
    ?HandlerRequirements,
    H: AttemptHandler<'policy, NativeRouteProvider, A, HandlerError ? HandlerRequirements>,
  > AttemptClient<
    'policy,
    NativeRouteProvider,
    A,
    HandlerError,
    ProxyError
      | RequestError
      | ValueError
      | OriginError
      | ClientError
      | NativeClientError
      | ResolverError
      | NativeSocketError
      | ConnectionError
      | IdentityError
      | TrustSourceError
      | OutOfMemoryError,
    HandlerRequirements,
    &mut Allocator
      | &mut MonotonicClock
      | &mut SystemClock
      | &mut Random
      | &mut TrustSource,
    H
  > for NativeRedirectClient<'configuration> {
    withAttempt: NativeRedirectClient.withAttempt
  }
} else {
  impl<
    'configuration,
    'policy,
    A,
    HandlerError,
    ?HandlerRequirements,
    H: AttemptHandler<'policy, NativeRouteProvider, A, HandlerError ? HandlerRequirements>,
  > NativeRedirectClient<'configuration> {
    effect fn withAttemptUnsupported(
      client: &mut Self,
      request: AttemptRequest<'policy>,
      deadline: Option<Instant>,
      handler: H,
    ) -> A ! HandlerError | NativeClientError ? HandlerRequirements
    where HandlerRequirements in Without<HandlerRequirements, ByteDuplex>,
      HandlerRequirements in Without<HandlerRequirements, HttpTransport> {
      drop client
      drop request
      drop deadline
      drop handler
      fail NativeClientError.UnsupportedTarget
    }
  }

  impl<
    'configuration,
    'policy,
    A,
    HandlerError,
    ?HandlerRequirements,
    H: AttemptHandler<'policy, NativeRouteProvider, A, HandlerError ? HandlerRequirements>,
  > AttemptClient<
    'policy,
    NativeRouteProvider,
    A,
    HandlerError,
    NativeClientError,
    HandlerRequirements,
    never,
    H
  > for NativeRedirectClient<'configuration> {
    withAttempt: NativeRedirectClient.withAttemptUnsupported
  }
}

/// Returns immutable native route metadata from an owned HTTP session without lending its transport mutably.
pub fn route(connection: &Connection<NativeTransport>) -> NativeRoute {
  let context = connection.transportContext()
  return NativeTransport.route(&context.transport.*)
}
