//! Native connection acquisition for one HTTP origin and one serial client scope.
//!
//! # Details
//!
//! HTTPS authenticates the original origin with explicit trust. Absolute deadlines are unchanged
//! through resolution, connection, and TLS authentication. Synchronous hostname resolution rejects
//! an overall deadline before dispatch. Cleanup closes without a flush or TLS shutdown.

import silk.allocator {Allocator, OutOfMemoryError}
import silk.byte_duplex {ByteDuplex, ByteIoOperation, ReadTransfer}
import silk.effect {Effect}
import silk.http_client {Connection, ConnectionHandler, ClientError, Limits, withOwned}
import silk.http_origin {Origin}
import silk.http_transport as Transport {HttpTransport, TransportError}
import silk.https_identity {HttpsIdentity, OriginHost, ReferenceIdentity, IdentityError}
import silk.monotonic_clock {MonotonicClock}
import silk.network_address {Host, DomainHost, Ipv4Address, Ipv6Address}
import silk.option {Option}
import silk.random {Random}
import silk.resolver {Resolver, ResolveRequest, ResolvedEndpoints, ResolverError, FamilySelection}
import silk.result {Result}
import silk.system_clock {Instant, SystemClock}
import silk.tls_client {AlpnProtocol, AlpnConfig, ClientConfig, ClientLimits, TlsError}
import silk.tls_connection as Tls {OwnedConnection, ConnectionError, ConnectionOptions}
import silk.trust_source {TrustSource}
import silk.trust_snapshot {TrustLoadLimits, TrustSourceError, TrustSnapshot}
import silk.slice {Slice}
import silk.u64
import silk.usize
import silk.http {Version}

/// The immutable transport route retained independently of the HTTP origin.
pub struct NativeRoute {
  bytes: [u8; 108]
  length: usize
  unix: bool
}

impl Copy for NativeRoute {}

impl NativeRoute {
  /// Returns whether this route uses an explicit Unix socket path.
  pub fn isUnix(self: &Self) -> bool {
    return self.unix
  }
  /// Borrows the exact owned Unix path, or an empty slice for direct TCP.
  pub fn path<'a>(self: &'a Self) -> &'a [u8] {
    return Slice.view<u8>(&self.bytes, usize.ZERO, self.length)
  }
}

fn directRoute() -> NativeRoute {
