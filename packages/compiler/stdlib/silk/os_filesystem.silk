//! Native [`FileSystem`] provider confined beneath one explicitly owned platform root.
//!
//! # When to use
//! Construct [`OsFileSystem`] at a native application edge and provide it to portable filesystem
//! code. Supply an in-memory [`FileSystem`] in tests or on targets without native OS access.
//!
//! # Details
//! Portable `/` denotes the provider root rather than the host filesystem root. The native boundary
//! rejects malformed paths, root escape, and symlink traversal outside that confinement. Whole-FileSystem.file
//! reads and writes own or commit complete contents, FileSystem.directory listings retry oversized entries and
//! sort complete child paths deterministically. Low-level failures become portable [`FileError`]
//! values with retained native codes.
//!
//! [`make`] copies its root. The root must be an absolute, non-empty, NUL-free native path. A root
//! that violates this precondition traps. Open handles close on success and failure. If an
//! operation and close both fail, the operation's original typed failure remains the reported
//! result.
//!
//! Constructing the provider performs no filesystem operation beyond owning the root bytes.
//! Portable code uses `FileSystem` operations after the application supplies `&mut OsFileSystem`
//! for the `&mut FileSystem` requirement.
//!
//! # Gotchas
//! Reachable OS filesystem operations are native-only. Direct WebAssembly compilation rejects them
//! rather than inventing filesystem imports; evaluator execution requires an injected adapter.
//!
//! # Examples
//! ## Construct a provider without accessing the filesystem
//!
//! ```silk
//! import silk.allocator { Allocator, OutOfMemoryError }
//!
//! import silk.effect { Effect }
//!
//! import silk.os_filesystem { OsFileSystem }
//!
//! effect fn program() -> i32
//! ! OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let provider = run OsFileSystem.make("/tmp")
//!     |> Effect.provideMut<Allocator>(&mut allocator)
//!   drop provider
//!   return 42
//! }
//!
//! effect fn recover(error: OutOfMemoryError) -> i32 {
//!   return 0
//! }
//!
//! pub fn main() -> i32 {
//!   return run Effect.catchAll(program(), recover)
//! }
//! ```

import silk.bool as bool
import silk.effect { Effect }
import silk.bytes { Bytes }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.allocator { OutOfMemoryError }
import silk.filesystem { DirectoryEntry, DirectoryInfo, FileError, FileInfo, FileOperation, FileReason, FileSystem, Path }
import silk.i32 as i32
import silk.option { Option }
import silk.result { Result }
import silk.string { String }
import silk.u32 as u32
import silk.u8 as u8
import silk.usize as usize
import silk.vector { Vector }

/// A native [`FileSystem`] provider confined beneath one independently owned platform root.
///
/// # Details
///
/// Portable absolute paths resolve inside this root. The provider never exposes the root as a
/// [`Path`], and operations reject lexical or symbolic-link escape from the root.
pub struct OsFileSystem {
  root: Bytes
}

impl OsFileSystem {
  effect fn readFile(
    self: &mut Self,
    path: &Path
  ) -> Bytes ! FileError | OutOfMemoryError ? &mut Allocator {
    let mut handle = run openFile(move self, path, 0, FileSystem.readFileOperation())
    let attempted = run Effect.result(readLoop(&mut handle))
    let closed = run Effect.result(close(move handle, FileSystem.readFileOperation()))
    return match move attempted {
      Result<Bytes, FileError | OutOfMemoryError>.Success { value: bytes } => match move closed {
        Result<(), FileError>.Success { value: completed } => move bytes
        Result<(), FileError>.Failure { error: closeFailure } => run discardThenReroute<Bytes>(move bytes, move closeFailure)
      }
      Result<Bytes, FileError | OutOfMemoryError>.Failure { error: primary } => match move primary {
        FileError failure => run preserveFile(move failure, move closed)
        OutOfMemoryError exhausted => run preserveOutOfMemory(move exhausted, move closed)
      }
    }
  }

  effect fn writeFile(self: &mut Self, path: &Path, bytes: &[u8]) -> () ! FileError {
    let mut handle = run openFile(move self, path, 1, FileSystem.writeFileOperation())
    let attempted = run Effect.result(writeLoop(&mut handle, bytes))
    let closed = run Effect.result(close(move handle, FileSystem.writeFileOperation()))
    return match move attempted {
      Result<(), FileError>.Success { value: completed } => match move closed {
        Result<(), FileError>.Success { value: closedValue } => ()
        Result<(), FileError>.Failure { error: closeFailure } => run rerouteFile(move closeFailure)
      }
      Result<(), FileError>.Failure { error: primary } => run preserveFile(move primary, move closed)
    }
  }

  effect fn stat(self: &mut Self, path: &Path) -> FileInfo | DirectoryInfo ! FileError {
    let mut kind = 0
    let mut byteLength = usize.ZERO
    let mut lowReason = 0
    let mut nativeCode = u32.toU32(0)
    let inspected = run rawInspect(Bytes.asSlice(&self.root), pathBytes(path), &mut kind, &mut byteLength, &mut lowReason, &mut nativeCode)
    if inspected == false { return run raise(FileSystem.statOperation(), lowReason, nativeCode) }
    if kind == 0 { return FileSystem.fileInfo(byteLength) }
    return FileSystem.directoryInfo()
  }

  effect fn listDirectory(
    self: &mut Self,
    path: &Path
  ) -> Vector<DirectoryEntry> ! FileError | OutOfMemoryError ? &mut Allocator {
    let mut handle = run openDirectory(move self, path, FileSystem.listDirectoryOperation())
    let attempted = run Effect.result(listLoop(&mut handle, path))
    let closed = run Effect.result(close(move handle, FileSystem.listDirectoryOperation()))
    return match move attempted {
      Result<Vector<DirectoryEntry>, FileError | OutOfMemoryError>.Success { value: entries } => match move closed {
        Result<(), FileError>.Success { value: completed } => move entries
        Result<(), FileError>.Failure { error: closeFailure } => run discardThenReroute<Vector<DirectoryEntry>>(move entries, move closeFailure)
      }
      Result<Vector<DirectoryEntry>, FileError | OutOfMemoryError>.Failure { error: primary } => match move primary {
        FileError failure => run preserveFile(move failure, move closed)
        OutOfMemoryError exhausted => run preserveOutOfMemory(move exhausted, move closed)
      }
    }
  }

  /// Creates one uniquely named FileSystem.directory under `parent` and returns its complete Path.
  ///
  /// The provider chooses the name's unique part, so the created name comes back rather than going
  /// in. A buffer too small for that name creates nothing and reports the capacity it needs, which
  /// is why the retry below is safe to take.
  effect fn createTemporaryDirectory(
    self: &mut Self,
    parent: &Path,
    prefix: &[u8]
  ) -> Path ! FileError | OutOfMemoryError ? &mut Allocator {
    let mut buffer = run Bytes.zeroed(64)
    let mut created = Option.none<Path>()
    let mut complete = false
    while complete == false {
      let mut required = usize.ZERO
      let mut lowReason = 0
      let mut nativeCode = u32.toU32(0)
      let mut output = Bytes.asMutSlice(&mut buffer)
      let mut length = usize.ZERO
      let chosen = run rawCreateUnique(
        Bytes.asSlice(&self.root),
        pathBytes(parent),
        prefix,
        move output,
        &mut length,
        &mut required,
        &mut lowReason,
        &mut nativeCode
      )
      if chosen == false {
        if lowReason == 8 {
          let resized = Bytes.zeroed(required)
          buffer = run resized
        } else {
          return run raise(FileSystem.createTemporaryDirectoryOperation(), lowReason, nativeCode)
        }
      } else {
        let view = Bytes.asSlice(&buffer)
        let mut name = Bytes.make()
        let mut index = usize.ZERO
        while index < length {
          let one = [view[index]]
          let appended = run Bytes.append(&mut name, &one)
          index = index + usize.ONE
        }
        let child = run Path.joinUtf8(parent, Bytes.asSlice(&name))
        created = Option.some<Path>(move child)
        complete = true
      }
    }
    return match move created {
      Option<Path>.Some { value: path } => move path
      Option<Path>.None => run raise(FileSystem.createTemporaryDirectoryOperation(), 10, u32.toU32(0))
    }
  }

  effect fn createDirectory(self: &mut Self, path: &Path) -> () ! FileError {
    return run command(move self, path, FileSystem.createDirectoryOperation(), 0)
  }

  effect fn removeFile(self: &mut Self, path: &Path) -> () ! FileError {
    return run command(move self, path, FileSystem.removeFileOperation(), 1)
  }

  effect fn removeDirectory(self: &mut Self, path: &Path) -> () ! FileError {
    return run command(move self, path, FileSystem.removeDirectoryOperation(), 2)
  }
}

impl OsFileSystem {
  /// Copies one absolute native root and creates a confined filesystem provider.
  ///
  /// # When to use
  ///
  /// Use this function at a native application edge. Provide the result as `&mut FileSystem` to code
  /// that uses the portable filesystem service.
  ///
  /// # Details
  ///
  /// Construction owns the root bytes but does not open the FileSystem.directory. Portable `/` then denotes
  /// this provider root instead of the host filesystem root.
  ///
  /// # Gotchas
  ///
  /// `root` must be non-empty, absolute, and NUL-free. A value that violates this precondition traps.
  /// Allocation failure leaves no provider value.
  pub effect fn make(root: string) -> OsFileSystem ! OutOfMemoryError ? &mut Allocator {
    let rootBytes = String.utf8Bytes(root)
    if rootBytes.length == usize.ZERO { let invalid = 1 / 0 }
    if rootBytes[usize.ZERO] != u8.toU8(47) { let invalid = 1 / 0 }
    let mut index = usize.ZERO
    while index < rootBytes.length {
      if rootBytes[index] == u8.toU8(0) { let invalid = 1 / 0 }
      index = index + usize.ONE
    }
    let owned = run Bytes.copy(rootBytes)
    return OsFileSystem { root: move owned }
  }
}

fn pathBytes(path: &Path) -> &[u8] {
  return String.utf8Bytes(Path.view(path))
}

fn reason(value: i32) -> FileReason {
  if value == 0 { return FileSystem.notFound() }
  if value == 1 { return FileSystem.alreadyExists() }
  if value == 2 { return FileSystem.permissionDenied() }
  if value == 3 { return FileSystem.invalidPath() }
  if value == 4 { return FileSystem.wrongType() }
  if value == 5 { return FileSystem.notEmpty() }
  if value == 6 { return FileSystem.noSpace() }
  if value == 7 { return FileSystem.tooLarge() }
  if value == 9 { return FileSystem.unsupported() }
  return FileSystem.other()
}

effect fn raise(operation: FileOperation, lowReason: i32, nativeCode: u32) -> never ! FileError {
  fail FileSystem.errorWithCode(move operation, reason(lowReason), u32.toI32(nativeCode))
}

effect fn rawFileOpen(root: &[u8], path: &[u8], mode: i32, lowReason: &mut i32, nativeCode: &mut u32) -> Option<OsHandle> {
  unsafe { return run Intrinsic.osFileOpen<Option<OsHandle>>(root, path, mode, lowReason, nativeCode, Option.some, Option.none) }
  let impossible = 1 / 0
  return Option.none<OsHandle>()
}

effect fn rawDirectoryOpen(root: &[u8], path: &[u8], lowReason: &mut i32, nativeCode: &mut u32) -> Option<OsHandle> {
  unsafe { return run Intrinsic.osDirectoryOpen<Option<OsHandle>>(root, path, lowReason, nativeCode, Option.some, Option.none) }
  let impossible = 1 / 0
  return Option.none<OsHandle>()
}

effect fn rawClose(handle: OsHandle, lowReason: &mut i32, nativeCode: &mut u32) -> bool {
  unsafe { return run Intrinsic.osHandleClose(move handle, lowReason, nativeCode) }
  return false
}

effect fn rawInspect(root: &[u8], path: &[u8], kind: &mut i32, byteLength: &mut usize, lowReason: &mut i32, nativeCode: &mut u32) -> bool {
  unsafe { return run Intrinsic.osPathInspect(root, path, kind, byteLength, lowReason, nativeCode) }
  return false
}

effect fn rawCreate(root: &[u8], path: &[u8], lowReason: &mut i32, nativeCode: &mut u32) -> bool {
  unsafe { return run Intrinsic.osDirectoryCreate(root, path, lowReason, nativeCode) }
  return false
}
effect fn rawRemoveFile(root: &[u8], path: &[u8], lowReason: &mut i32, nativeCode: &mut u32) -> bool {
  unsafe { return run Intrinsic.osFileRemove(root, path, lowReason, nativeCode) }
  return false
}
effect fn rawRemoveDirectory(root: &[u8], path: &[u8], lowReason: &mut i32, nativeCode: &mut u32) -> bool {
  unsafe { return run Intrinsic.osDirectoryRemove(root, path, lowReason, nativeCode) }
  return false
}

effect fn openFile(
  self: &mut OsFileSystem,
  path: &Path,
  mode: i32,
  operation: FileOperation
) -> OsHandle ! FileError {
  let mut lowReason = 0
  let mut nativeCode = u32.toU32(0)
  let opened = run rawFileOpen(Bytes.asSlice(&self.root), pathBytes(path), mode, &mut lowReason, &mut nativeCode)
  return match move opened {
    Option<OsHandle>.Some { value: handle } => move handle
    Option<OsHandle>.None => run raise(move operation, lowReason, nativeCode)
  }
}

effect fn openDirectory(
  self: &mut OsFileSystem,
  path: &Path,
  operation: FileOperation
) -> OsHandle ! FileError {
  let mut lowReason = 0
  let mut nativeCode = u32.toU32(0)
  let opened = run rawDirectoryOpen(Bytes.asSlice(&self.root), pathBytes(path), &mut lowReason, &mut nativeCode)
  return match move opened {
    Option<OsHandle>.Some { value: handle } => move handle
    Option<OsHandle>.None => run raise(move operation, lowReason, nativeCode)
  }
}

effect fn close(handle: OsHandle, operation: FileOperation) -> () ! FileError {
  let mut lowReason = 0
  let mut nativeCode = u32.toU32(0)
  let closed = run rawClose(move handle, &mut lowReason, &mut nativeCode)
  if closed == false { return run raise(move operation, lowReason, nativeCode) }
  return ()
}

fn ignoreClose(result: Result<(), FileError>) -> () {
  return match move result {
    Result<(), FileError>.Success { value: completed } => ()
    Result<(), FileError>.Failure { error: failure } => ()
  }
}

effect fn rerouteFile(error: FileError) -> never ! FileError { fail move error }
effect fn rerouteOutOfMemory(error: OutOfMemoryError) -> never ! OutOfMemoryError { fail move error }

effect fn discardThenReroute<T>(value: T, error: FileError) -> never ! FileError {
  drop value
  fail move error
}

effect fn preserveFile(error: FileError, closed: Result<(), FileError>) -> never ! FileError {
  let ignored = ignoreClose(move closed)
  fail move error
}

effect fn preserveOutOfMemory(
  error: OutOfMemoryError,
  closed: Result<(), FileError>
) -> never ! OutOfMemoryError {
  let ignored = ignoreClose(move closed)
  fail move error
}

effect fn readLoop(handle: &mut OsHandle) -> Bytes ! FileError | OutOfMemoryError ? &mut Allocator {
  let mut result = Bytes.make()
  let mut buffer = run Bytes.zeroed(256)
  let mut complete = false
  while complete == false {
    let mut lowReason = 0
    let mut nativeCode = u32.toU32(0)
    let mut output = Bytes.asMutSlice(&mut buffer)
    let mut length = usize.ZERO
    let mut received = false
    unsafe {
      received = run Intrinsic.osFileRead(
        handle,
        output,
        &mut length,
        &mut lowReason,
        &mut nativeCode
      )
    }
    if received == false { return run raise(FileSystem.readFileOperation(), lowReason, nativeCode) }
    if length == usize.ZERO {
      complete = true
    } else {
      let view = Bytes.asSlice(&buffer)
      let mut index = usize.ZERO
      while index < length {
        let one = [view[index]]
        let appended = run Bytes.append(&mut result, &one)
        index = index + usize.ONE
      }
    }
  }
  return move result
}

effect fn writeLoop(handle: &mut OsHandle, bytes: &[u8]) -> () ! FileError {
  let mut offset = usize.ZERO
  while offset < bytes.length {
    let mut lowReason = 0
    let mut nativeCode = u32.toU32(0)
    // The low-level operation may commit a prefix. Re-presenting the remaining bytes is provider policy.
    let mut length = usize.ZERO
    let mut written = false
    unsafe {
      written = run Intrinsic.osFileWrite(
        handle,
        bytes,
        offset,
        &mut length,
        &mut lowReason,
        &mut nativeCode
      )
    }
    if written == false { return run raise(FileSystem.writeFileOperation(), lowReason, nativeCode) }
    if length == usize.ZERO { return run raise(FileSystem.writeFileOperation(), 10, u32.toU32(0)) }
    offset = offset + length
  }
  return ()
}

effect fn listLoop(
  handle: &mut OsHandle,
  parent: &Path
) -> Vector<DirectoryEntry> ! FileError | OutOfMemoryError ? &mut Allocator {
  let mut entries = Vector.make<DirectoryEntry>()
  let initialBuffer = Bytes.zeroed(64)
  let mut buffer = run initialBuffer
  let mut complete = false
  while complete == false {
    let mut kind = 0
    let mut required = usize.ZERO
    let mut lowReason = 0
    let mut nativeCode = u32.toU32(0)
    let mut output = Bytes.asMutSlice(&mut buffer)
    let mut length = usize.ZERO
    let mut next = false
    unsafe {
      next = run Intrinsic.osDirectoryNext(
        handle,
        output,
        &mut length,
        &mut kind,
        &mut required,
        &mut lowReason,
        &mut nativeCode
      )
    }
    if next == false {
      if lowReason == 8 {
        let resized = Bytes.zeroed(required)
        buffer = run resized
      } else {
        return run raise(FileSystem.listDirectoryOperation(), lowReason, nativeCode)
      }
    } else {
      if length == usize.ZERO {
        complete = true
      } else {
        let view = Bytes.asSlice(&buffer)
        let mut name = Bytes.make()
        let mut index = usize.ZERO
        while index < length {
          let one = [view[index]]
          let appended = run Bytes.append(&mut name, &one)
          index = index + usize.ONE
        }
        let child = run Path.joinUtf8(parent, Bytes.asSlice(&name))
        let mut entryKind = FileSystem.directory()
        if kind == 0 { entryKind = FileSystem.file() }
        let insertion = insertionFor(&child, Vector.asSlice<DirectoryEntry>(&entries))
        let inserted = run Vector.insert<DirectoryEntry>(
          &mut entries,
          insertion,
          FileSystem.directoryEntry(move child, move entryKind)
        )
      }
    }
  }
  return move entries
}

fn insertionFor(child: &Path, existing: &[DirectoryEntry]) -> usize {
  let mut insertion = usize.ZERO
  while insertion < existing.length {
    let before = match &existing[insertion] {
      DirectoryEntry { path, kind } => pathLess(child, &path)
    }
    if before { return insertion }
    insertion = insertion + usize.ONE
  }
  return insertion
}

fn pathLess(left: &Path, right: &Path) -> bool {
  let leftBytes = pathBytes(left)
  let rightBytes = pathBytes(right)
  let mut index = usize.ZERO
  while index < leftBytes.length {
    if rightBytes.length <= index { return false }
    if leftBytes[index] < rightBytes[index] { return true }
    if rightBytes[index] < leftBytes[index] { return false }
    index = index + usize.ONE
  }
  if leftBytes.length < rightBytes.length { return true }
  return false
}

effect fn command(
  self: &mut OsFileSystem,
  path: &Path,
  operation: FileOperation,
  selector: i32
) -> () ! FileError {
  let mut lowReason = 0
  let mut nativeCode = u32.toU32(0)
  let mut completed = false
  if selector == 0 {
    completed = run rawCreate(Bytes.asSlice(&self.root), pathBytes(path), &mut lowReason, &mut nativeCode)
  } else {
    if selector == 1 {
      completed = run rawRemoveFile(Bytes.asSlice(&self.root), pathBytes(path), &mut lowReason, &mut nativeCode)
    } else {
      completed = run rawRemoveDirectory(Bytes.asSlice(&self.root), pathBytes(path), &mut lowReason, &mut nativeCode)
    }
  }
  if completed == false { return run raise(move operation, lowReason, nativeCode) }
  return ()
}

effect fn rawCreateUnique(
  root: &[u8],
  parent: &[u8],
  prefix: &[u8],
  output: &mut [u8],
  count: &mut usize,
  required: &mut usize,
  lowReason: &mut i32,
  nativeCode: &mut u32
) -> bool {
  unsafe {
    return run Intrinsic.osDirectoryCreateUnique(
      root,
      parent,
      prefix,
      output,
      count,
      required,
      lowReason,
      nativeCode
    )
  }
  return false
}

impl FileSystem for OsFileSystem {
  readFile: OsFileSystem.readFile
  writeFile: OsFileSystem.writeFile
  stat: OsFileSystem.stat
  listDirectory: OsFileSystem.listDirectory
  createDirectory: OsFileSystem.createDirectory
  removeFile: OsFileSystem.removeFile
  removeDirectory: OsFileSystem.removeDirectory
  createTemporaryDirectory: OsFileSystem.createTemporaryDirectory
}
