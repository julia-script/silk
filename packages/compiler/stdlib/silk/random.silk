//! Provider-replaceable pseudorandom words, booleans, bounded values, and byte filling.
//!
//! # When to use
//! Require [`Random`] when application code needs replaceable pseudorandom values. Use
//! [`Xoshiro256StarStar`] with [`seeded`] when a reproducible sequence is required.
//!
//! # Details
//! [`nextU64`] obtains one word from the active provider. [`nextBool`], [`below`], and [`fillBytes`]
//! define one stable mapping from provider words to their results.
//!
//! The `Xoshiro256StarStar` sequence is identical on all Silk execution engines. Its seed expansion
//! uses SplitMix64, so every `u64` seed is valid, including zero.
//!
//! # Gotchas
//! These APIs are deterministic and non-cryptographic. Do not use them for secrets, credentials,
//! cryptographic keys, nonces, or security tokens.
//!
//! # Examples
//! ## Reproduce the first word from one seed
//! ```silk
//! import silk.effect { Effect }
//!
//! import silk.random as Random
//!
//! pub fn main() -> i32 {
//!   let mut provider = Random.seeded(0)
//!   let first = run Random.nextU64()
//!     |> Effect.provideMut<Random.Random>(&mut provider)
//!   if first != 0x99ec5f36cb75f2b4 {
//!     return 0
//!   }
//!   return 42
//! }
//! ```

import silk.option as Option
import silk.u64 as u64
import silk.u8 as u8
import silk.usize as usize

/// An exclusive source of deterministic pseudorandom `u64` words.
///
/// # Details
///
/// A provider owns its state. Each [`nextU64`] call advances only the provider supplied for the
/// lexical Effect. Derived operations obtain all words through this service.
///
/// # Gotchas
///
/// This service does not provide cryptographic randomness or operating-system entropy. Do not use
/// its values for secrets, credentials, cryptographic keys, nonces, or security tokens.
pub service Random {
  /// Returns the next pseudorandom word and advances the active provider one time.
  ///
  /// # Gotchas
  ///
  /// The result is deterministic provider output, not cryptographic randomness. Do not use it for
  /// secrets, credentials, cryptographic keys, nonces, or security tokens.
  effect fn nextU64() -> u64 ? &mut Random
}

/// Returns one word from the active [`Random`] provider.
///
/// # Details
///
/// This operation advances the active provider exactly one time.
///
/// # Gotchas
///
/// The result is deterministic pseudorandom data. Do not use it for secrets, credentials,
/// cryptographic keys, nonces, or security tokens.
pub effect fn nextU64() -> u64 ? &mut Random {
  return run Random.nextU64()
}

/// A deterministic xoshiro256** provider with four private `u64` state words.
///
/// # When to use
///
/// Use this provider when the same seed must produce the same sequence on every Silk engine.
///
/// # Details
///
/// The provider uses the published xoshiro256** output and transition functions. It is not `Copy`,
/// so one mutable provider has one advancing sequence.
///
/// # Gotchas
///
/// This provider is non-cryptographic. Do not use it for secrets, credentials, cryptographic keys,
/// nonces, or security tokens.
pub struct Xoshiro256StarStar {
  state0: u64
  state1: u64
  state2: u64
  state3: u64
}

struct SplitMix64Step {
  state: u64
  value: u64
}

fn splitMix64(state: u64) -> SplitMix64Step {
  let next = u64.wrappingAdd(state, 0x9e3779b97f4a7c15)
  let first = u64.bitXor(next, u64.shiftRight(next, 30))
  let spread = u64.wrappingMultiply(first, 0xbf58476d1ce4e5b9)
  let second = u64.bitXor(spread, u64.shiftRight(spread, 27))
  let respread = u64.wrappingMultiply(second, 0x94d049bb133111eb)
  return SplitMix64Step {
    state: next,
    value: u64.bitXor(respread, u64.shiftRight(respread, 31)),
  }
}

/// Creates a reproducible [`Xoshiro256StarStar`] provider from one `u64` seed.
///
/// # Details
///
/// Four successive SplitMix64 outputs initialize the provider state. Every `u64` seed is valid,
/// including zero. One seed always produces the same sequence on every Silk engine.
///
/// # Gotchas
///
/// The resulting sequence is non-cryptographic. Do not use it for secrets, credentials,
/// cryptographic keys, nonces, or security tokens.
pub fn seeded(seed: u64) -> Xoshiro256StarStar {
  let first = splitMix64(seed)
  let second = splitMix64(first.state)
  let third = splitMix64(second.state)
  let fourth = splitMix64(third.state)
  return Xoshiro256StarStar {
    state0: first.value,
    state1: second.value,
    state2: third.value,
    state3: fourth.value,
  }
}

effect fn xoshiroNext(self: &mut Xoshiro256StarStar) -> u64 {
  let multiplied = u64.wrappingMultiply(self.state1, 5)
  let result = u64.wrappingMultiply(u64.rotateLeft(multiplied, 7), 9)
  let shifted = u64.shiftLeft(self.state1, 17)

  self.state2 = u64.bitXor(self.state2, self.state0)
  self.state3 = u64.bitXor(self.state3, self.state1)
  self.state1 = u64.bitXor(self.state1, self.state2)
  self.state0 = u64.bitXor(self.state0, self.state3)
  self.state2 = u64.bitXor(self.state2, shifted)
  self.state3 = u64.rotateLeft(self.state3, 45)

  return result
}

impl Random for Xoshiro256StarStar { nextU64: Xoshiro256StarStar.xoshiroNext }

/// Returns whether bit 63 of the next provider word is set.
///
/// # Details
///
/// This operation consumes exactly one word. It does not cache the other bits.
///
/// # Gotchas
///
/// The result is deterministic pseudorandom data. Do not use it for secrets, credentials,
/// cryptographic keys, nonces, or security tokens.
pub effect fn nextBool() -> bool ? &mut Random {
  let word = run Random.nextU64()
  return u64.shiftRight(word, 63) == 1
}

/// Returns a pseudorandom value below `upperExclusive`, or `None` when the bound is zero.
///
/// # Details
///
/// A zero bound consumes no provider word. A positive bound uses remainder rejection, so uniform
/// provider words give each possible result the same probability.
///
/// # Gotchas
///
/// Progress requires the provider to eventually return a word outside the rejection interval. The
/// result is non-cryptographic and must not select secrets, keys, nonces, or security tokens.
pub effect fn below(upperExclusive: u64) -> Option.Option<u64> ? &mut Random {
  if upperExclusive == u64.MIN {
    return Option.none<u64>()
  }

  let threshold = u64.remainder(u64.wrappingSubtract(u64.MIN, upperExclusive), upperExclusive)
  let mut word = run Random.nextU64()
  while word < threshold {
    word = run Random.nextU64()
  }
  return Option.some<u64>(u64.remainder(word, upperExclusive))
}

/// Fills `output` from consecutive provider words in least-significant-byte-first order.
///
/// # Details
///
/// This operation allocates no storage. An empty slice consumes no word. A partial final group
/// consumes one complete word and writes only the bytes that fit.
///
/// # Gotchas
///
/// The bytes are deterministic and non-cryptographic. Do not use them for secrets, credentials,
/// cryptographic keys, nonces, or security tokens.
pub effect fn fillBytes(output: &mut [u8]) -> () ? &mut Random {
  let mut index = usize.ZERO
  while index < output.length {
    let mut word = run Random.nextU64()
    let mut byteIndex = u64.MIN
    while byteIndex < 8 {
      if index == output.length {
        return ()
      }
      output[index] = u64.toU8(u64.bitAnd(word, 255))
      word = u64.shiftRight(word, 8)
      index = index + usize.ONE
      byteIndex = byteIndex + 1
    }
  }
  return ()
}
