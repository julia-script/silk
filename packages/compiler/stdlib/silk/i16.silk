//! Sixteen-bit signed integers with explicit overflow, conversion, and text policies.
//!
//! # When to use
//! Use `i16` for data whose public representation is exactly sixteen signed bits, such as a binary
//! field or compact sample. Use `i32` or `i64` when the range is not itself part of the contract.
//!
//! # Details
//! Ordinary arithmetic, narrowing conversions, division by zero, and invalid shift counts trap.
//! Choose `checked*` to receive [`Option`] on invalid arithmetic, `wrapping*` for arithmetic modulo
//! 2^16, or `saturating*` to clamp at [`MIN`] and [`MAX`]. Signed right shifts preserve the sign bit.
//!
//! Decimal [`parse`] requires a complete, in-range representation; [`toText`] returns newly
//! allocated owned text.
//!
//! # Gotchas
//! [`MIN`] cannot be represented as a positive i16, so ordinary [`negate`] traps for that value.

import silk.bool as bool
import silk.core { Allocator }
import silk.core { OutOfMemoryError }
import silk.f32 as f32
import silk.f64 as f64
import silk.format as Format
import silk.format { ParseError }
import silk.i32 as i32
import silk.i64 as i64
import silk.i8 as i8
import silk.isize as isize
import silk.option { Option }
import silk.result { Result }
import silk.string { String }
import silk.u16 as u16
import silk.u32 as u32
import silk.u64 as u64
import silk.u8 as u8
import silk.usize as usize

/// The largest `i16` value.
pub const MAX: i16 = 32767

/// The smallest `i16` value.
pub const MIN: i16 = -32768

/// The width of i16 in bits.
pub const BITS: u32 = 16

/// Returns the arithmetic negation of `value` and traps when `value` is [`MIN`].
pub fn negate(value: i16) -> i16 {
  return Intrinsic.i16Negate(value)
}

/// Returns the arithmetic negation of `value`, wrapped to the `i16` range.
pub fn wrappingNegate(value: i16) -> i16 {
  return Intrinsic.i16WrappingNegate(value)
}

/// Returns the arithmetic negation of `value`, clamped to the `i16` range.
pub fn saturatingNegate(value: i16) -> i16 {
  return Intrinsic.i16SaturatingNegate(value)
}

/// Converts `value` to `u8` and traps if `u8` cannot represent it.
pub fn toU8(value: i16) -> u8 {
  return Intrinsic.i16ToU8(value)
}

/// Converts `value` to `u8`, or returns `None` if `u8` cannot represent it.
pub fn checkedToU8(value: i16) -> Option<u8> {
  return Intrinsic.i16CheckedToU8(value)
}

/// Converts `value` to `u16` and traps if `u16` cannot represent it.
pub fn toU16(value: i16) -> u16 {
  return Intrinsic.i16ToU16(value)
}

/// Converts `value` to `u16`, or returns `None` if `u16` cannot represent it.
pub fn checkedToU16(value: i16) -> Option<u16> {
  return Intrinsic.i16CheckedToU16(value)
}

/// Converts `value` to `u32` and traps if `u32` cannot represent it.
pub fn toU32(value: i16) -> u32 {
  return Intrinsic.i16ToU32(value)
}

/// Converts `value` to `u32`, or returns `None` if `u32` cannot represent it.
pub fn checkedToU32(value: i16) -> Option<u32> {
  return Intrinsic.i16CheckedToU32(value)
}

/// Converts `value` to `u64` and traps if `u64` cannot represent it.
pub fn toU64(value: i16) -> u64 {
  return Intrinsic.i16ToU64(value)
}

/// Converts `value` to `u64`, or returns `None` if `u64` cannot represent it.
pub fn checkedToU64(value: i16) -> Option<u64> {
  return Intrinsic.i16CheckedToU64(value)
}

/// Converts `value` to `usize` and traps if `usize` cannot represent it.
pub fn toUsize(value: i16) -> usize {
  return Intrinsic.i16ToUsize(value)
}

/// Converts `value` to `usize`, or returns `None` if `usize` cannot represent it.
pub fn checkedToUsize(value: i16) -> Option<usize> {
  return Intrinsic.i16CheckedToUsize(value)
}

/// Converts `value` to `i8` and traps if `i8` cannot represent it.
pub fn toI8(value: i16) -> i8 {
  return Intrinsic.i16ToI8(value)
}

/// Converts `value` to `i8`, or returns `None` if `i8` cannot represent it.
pub fn checkedToI8(value: i16) -> Option<i8> {
  return Intrinsic.i16CheckedToI8(value)
}

/// Returns `value` unchanged as `i16`.
pub fn toI16(value: i16) -> i16 {
  return Intrinsic.i16ToI16(value)
}

/// Returns `Some` with `value` unchanged as `i16`.
pub fn checkedToI16(value: i16) -> Option<i16> {
  return Intrinsic.i16CheckedToI16(value)
}

/// Converts `value` to `i32` and traps if `i32` cannot represent it.
pub fn toI32(value: i16) -> i32 {
  return Intrinsic.i16ToI32(value)
}

/// Converts `value` to `i32`, or returns `None` if `i32` cannot represent it.
pub fn checkedToI32(value: i16) -> Option<i32> {
  return Intrinsic.i16CheckedToI32(value)
}

/// Converts `value` to `i64` and traps if `i64` cannot represent it.
pub fn toI64(value: i16) -> i64 {
  return Intrinsic.i16ToI64(value)
}

/// Converts `value` to `i64`, or returns `None` if `i64` cannot represent it.
pub fn checkedToI64(value: i16) -> Option<i64> {
  return Intrinsic.i16CheckedToI64(value)
}

/// Converts `value` to `isize` and traps if `isize` cannot represent it.
pub fn toIsize(value: i16) -> isize {
  return Intrinsic.i16ToIsize(value)
}

/// Converts `value` to `isize`, or returns `None` if `isize` cannot represent it.
pub fn checkedToIsize(value: i16) -> Option<isize> {
  return Intrinsic.i16CheckedToIsize(value)
}

/// Converts `value` to the nearest `f32` value, with ties to even.
pub fn toF32(value: i16) -> f32 {
  return Intrinsic.i16ToF32(value)
}

/// Converts `value` to the nearest `f64` value, with ties to even.
pub fn toF64(value: i16) -> f64 {
  return Intrinsic.i16ToF64(value)
}

/// Returns `left + right` and traps if the result is outside the `i16` range.
pub fn add(left: i16, right: i16) -> i16 {
  return Intrinsic.i16Add(left, right)
}

/// Returns `left - right` and traps if the result is outside the `i16` range.
pub fn subtract(left: i16, right: i16) -> i16 {
  return Intrinsic.i16Subtract(left, right)
}

/// Returns `left * right` and traps if the result is outside the `i16` range.
pub fn multiply(left: i16, right: i16) -> i16 {
  return Intrinsic.i16Multiply(left, right)
}

/// Returns `left / right`, rounded toward zero. Traps if `right` is zero or division of
/// [`MIN`] by `-1` occurs.
pub fn divide(left: i16, right: i16) -> i16 {
  return Intrinsic.i16Divide(left, right)
}

/// Returns the remainder with the sign of `left`. Traps if `right` is zero or division of
/// [`MIN`] by `-1` occurs.
pub fn remainder(left: i16, right: i16) -> i16 {
  return Intrinsic.i16Remainder(left, right)
}

/// Returns the bitwise AND of `left` and `right`.
pub fn bitAnd(left: i16, right: i16) -> i16 {
  return Intrinsic.i16BitAnd(left, right)
}

/// Returns the bitwise OR of `left` and `right`.
pub fn bitOr(left: i16, right: i16) -> i16 {
  return Intrinsic.i16BitOr(left, right)
}

/// Returns the bitwise exclusive OR of `left` and `right`.
pub fn bitXor(left: i16, right: i16) -> i16 {
  return Intrinsic.i16BitXor(left, right)
}

/// Returns `value` with each bit inverted.
pub fn bitNot(value: i16) -> i16 {
  return Intrinsic.i16BitNot(value)
}

/// Shifts `left` bits left by `right` positions. Traps if `right` is negative or not less than
/// [`BITS`].
pub fn shiftLeft(left: i16, right: i16) -> i16 {
  return Intrinsic.i16ShiftLeft(left, right)
}

/// Shifts `left` bits right by `right` positions and preserves its sign. Traps if `right` is
/// negative or not less than [`BITS`].
pub fn shiftRight(left: i16, right: i16) -> i16 {
  return Intrinsic.i16ShiftRight(left, right)
}

/// Rotates the bits of `left` left by `right` positions.
pub fn rotateLeft(left: i16, right: i16) -> i16 {
  return Intrinsic.i16RotateLeft(left, right)
}

/// Rotates the bits of `left` right by `right` positions.
pub fn rotateRight(left: i16, right: i16) -> i16 {
  return Intrinsic.i16RotateRight(left, right)
}

/// Returns `left + right`, wrapped to the `i16` range.
pub fn wrappingAdd(left: i16, right: i16) -> i16 {
  return Intrinsic.i16WrappingAdd(left, right)
}

/// Returns `left - right`, wrapped to the `i16` range.
pub fn wrappingSubtract(left: i16, right: i16) -> i16 {
  return Intrinsic.i16WrappingSubtract(left, right)
}

/// Returns `left * right`, wrapped to the `i16` range.
pub fn wrappingMultiply(left: i16, right: i16) -> i16 {
  return Intrinsic.i16WrappingMultiply(left, right)
}

/// Returns `left + right`, clamped to [`MIN`] or [`MAX`].
pub fn saturatingAdd(left: i16, right: i16) -> i16 {
  return Intrinsic.i16SaturatingAdd(left, right)
}

/// Returns `left - right`, clamped to [`MIN`] or [`MAX`].
pub fn saturatingSubtract(left: i16, right: i16) -> i16 {
  return Intrinsic.i16SaturatingSubtract(left, right)
}

/// Returns `left * right`, clamped to [`MIN`] or [`MAX`].
pub fn saturatingMultiply(left: i16, right: i16) -> i16 {
  return Intrinsic.i16SaturatingMultiply(left, right)
}

/// Returns `Some` with `left + right`, or `None` if the result is outside the `i16` range.
pub fn checkedAdd(left: i16, right: i16) -> Option<i16> {
  return Intrinsic.i16CheckedAdd(left, right)
}

/// Returns `Some` with `left - right`, or `None` if the result is outside the `i16` range.
pub fn checkedSubtract(left: i16, right: i16) -> Option<i16> {
  return Intrinsic.i16CheckedSubtract(left, right)
}

/// Returns `Some` with `left * right`, or `None` if the result is outside the `i16` range.
pub fn checkedMultiply(left: i16, right: i16) -> Option<i16> {
  return Intrinsic.i16CheckedMultiply(left, right)
}

/// Returns `Some` with `left / right`, or `None` for zero or division of [`MIN`] by `-1`.
pub fn checkedDivide(left: i16, right: i16) -> Option<i16> {
  return Intrinsic.i16CheckedDivide(left, right)
}

/// Returns `Some` with the remainder, or `None` for zero or division of [`MIN`] by `-1`.
pub fn checkedRemainder(left: i16, right: i16) -> Option<i16> {
  return Intrinsic.i16CheckedRemainder(left, right)
}

/// Returns `true` when `left` and `right` are equal.
pub fn equals(left: i16, right: i16) -> bool {
  return Intrinsic.i16Equals(left, right)
}

/// Returns `true` when `left` and `right` are not equal.
pub fn notEquals(left: i16, right: i16) -> bool {
  return Intrinsic.i16NotEquals(left, right)
}

/// Returns `true` when `left` is less than `right`.
pub fn lessThan(left: i16, right: i16) -> bool {
  return Intrinsic.i16LessThan(&left, &right)
}

/// Returns `true` when `left` is less than or equal to `right`.
pub fn lessOrEqual(left: i16, right: i16) -> bool {
  return Intrinsic.i16LessOrEqual(left, right)
}

/// Returns `true` when `left` is greater than `right`.
pub fn greaterThan(left: i16, right: i16) -> bool {
  return Intrinsic.i16GreaterThan(left, right)
}

/// Returns `true` when `left` is greater than or equal to `right`.
pub fn greaterOrEqual(left: i16, right: i16) -> bool {
  return Intrinsic.i16GreaterOrEqual(left, right)
}

/// Renders the value as decimal text in freshly owned storage.
pub effect fn toText(value: i16) -> String ! OutOfMemoryError ? &mut Allocator {
  return run Format.signedText(toI64(value))
}

/// Reads complete decimal text as an `i16`, or reports why the text is not one.
pub fn parse(text: string) -> Result<i16, ParseError> {
  return Format.i16Value(text)
}
