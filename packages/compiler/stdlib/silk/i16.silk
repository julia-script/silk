//! Sixteen-bit signed integers with explicit overflow, conversion, and text policies.
//!
//! # When to use
//! Use `i16` for data whose public representation is exactly sixteen signed bits, such as a binary
//! field or compact sample. Use `i32` or `i64` when the range is not itself part of the contract.
//!
//! # Details
//! Ordinary arithmetic, narrowing conversions, division by zero, and invalid shift counts trap.
//! Choose `checked*` to receive [`Option`] on invalid arithmetic, `wrapping*` for arithmetic modulo
//! 2^16, or `saturating*` to clamp at [`MIN`] and [`MAX`]. Signed right shifts preserve the sign bit.
//!
//! Decimal [`parse`] requires a complete, in-range representation; [`toText`] returns newly
//! allocated owned text.
//!
//! # Gotchas
//! [`MIN`] cannot be represented as a positive i16, so ordinary [`negate`] traps for that value.

import silk.bool as bool
import silk.core { Allocator }
import silk.core { OutOfMemoryError }
import silk.f32 as f32
import silk.f64 as f64
import silk.format as Format
import silk.format { ParseError }
import silk.i32 as i32
import silk.i64 as i64
import silk.i8 as i8
import silk.isize as isize
import silk.option { Option }
import silk.result { Result }
import silk.string { String }
import silk.u16 as u16
import silk.u32 as u32
import silk.u64 as u64
import silk.u8 as u8
import silk.usize as usize

/// The largest i16. The checked arithmetic intrinsics reject every result above this bound.
pub const MAX: i16 = 32767

/// The smallest i16. The checked arithmetic intrinsics reject every result below this bound.
pub const MIN: i16 = -32768

/// The width of i16 in bits.
pub const BITS: u32 = 16

/// Calls the concrete i16 negate primitive.
pub fn negate(value: i16) -> i16 {
  return Intrinsic.i16Negate(value)
}

/// Calls the concrete i16 wrappingNegate primitive.
pub fn wrappingNegate(value: i16) -> i16 {
  return Intrinsic.i16WrappingNegate(value)
}

/// Calls the concrete i16 saturatingNegate primitive.
pub fn saturatingNegate(value: i16) -> i16 {
  return Intrinsic.i16SaturatingNegate(value)
}

/// Calls the concrete i16 toU8 primitive.
pub fn toU8(value: i16) -> u8 {
  return Intrinsic.i16ToU8(value)
}

/// Calls the concrete i16 checkedToU8 primitive.
pub fn checkedToU8(value: i16) -> Option<u8> {
  return Intrinsic.i16CheckedToU8(value)
}

/// Calls the concrete i16 toU16 primitive.
pub fn toU16(value: i16) -> u16 {
