//! Compile-time ordering witnesses and a three-way result derived from strict comparison.
//!
//! # When to use
//! Add an [`Order`] bound when a generic algorithm needs `<`, as sorting and binary search do. Use
//! [`compare`] when all three outcomes matter, or [`less`] and [`equal`] for predicates.
//!
//! # Details
//! An interface witness is selected during specialization; it creates no service requirement or
//! runtime dispatch. [`Equal`] means neither operand orders before the other, so equality cannot
//! disagree with the witness's own strict ordering.
//!
//! # Gotchas
//! A witness must define a strict total order. The module cannot verify this law. If two different
//! values are incomparable, [`compare`] and [`equal`] report them as equal.
//!
//! # Examples
//! ## Classify each comparison result
//! ```silk
//! import silk.order { Order }
//!
//! pub fn main() -> i32 {
//!   let low = Order.compare<i32>(2, 7)
//!   let same = Order.compare<i32>(7, 7)
//!   let high = Order.compare<i32>(9, 7)
//!   if !Order.isLess(&low) {
//!     return 1
//!   }
//!   if !Order.isEqual(&same) {
//!     return 2
//!   }
//!   if !Order.isGreater(&high) {
//!     return 3
//!   }
//!   return 42
//! }
//! ```

// The comparison contract the ordered sequence operations resolve against. Ordinary Silk: the
// interface selects a compiler-known comparison during specialization exactly as `Integer` does, and
// creates no effect requirement, provider slot, or runtime dispatch.
//
// The contract is `lessThan` rather than a three-way `compare` because an interface operation is
// reachable from a generic body only through the operator that spells it. `<` spells `lessThan`, so
// a body bounded by `Order` can compare; no operator spells `compare`, so a `compare` operation
// would be declared and mapped yet uncallable. The three-way result is derived here instead, from
// the two strict comparisons, and is therefore ordinary Silk over the same one-operation bound.

import silk.bool as bool
import silk.i16 as i16
import silk.i32 as i32
import silk.i64 as i64
import silk.i8 as i8
import silk.isize as isize
import silk.u16 as u16
import silk.u32 as u32
import silk.u64 as u64
import silk.u8 as u8
import silk.usize as usize

/// The left value orders before the right value.
pub struct Less {}

/// Neither value orders before the other.
pub struct Equal {}

/// The left value orders after the right value.
pub struct Greater {}

/// A three-way comparison result that contains exactly one of [`Less`], [`Equal`], or [`Greater`].
pub struct Ordering {
  /// The comparison result, which a `match` expression narrows to one outcome type.
  pub value: Less | Equal | Greater
}

/// Static strict-ordering contract for primitive comparable values.
///
/// # When to use
///
/// Use this interface when a generic algorithm needs strict ordering through `<`.
///
/// # Details
///
/// A witness supplies the strict `lessThan` the operator `<` spells. Equality is derived from it
/// rather than declared, so a witness cannot disagree with itself about which values are equal.
///
/// # Gotchas
///
/// An implementation must define a strict total order. If two different values are incomparable,
/// [`compare`] and [`equal`] treat them as equal.
pub interface Order {
  /// Reports whether `left` orders strictly before `right`. An implementation must define a strict
  /// total order so different values are not incomparable.
  operator < fn lessThan(left: &Self, right: &Self) -> bool
}

impl Order for u8 { lessThan: Intrinsic.u8LessThan }
impl Order for u16 { lessThan: Intrinsic.u16LessThan }
impl Order for u32 { lessThan: Intrinsic.u32LessThan }
impl Order for u64 { lessThan: Intrinsic.u64LessThan }
impl Order for usize { lessThan: Intrinsic.usizeLessThan }
impl Order for i8 { lessThan: Intrinsic.i8LessThan }
impl Order for i16 { lessThan: Intrinsic.i16LessThan }
impl Order for i32 { lessThan: Intrinsic.i32LessThan }
impl Order for i64 { lessThan: Intrinsic.i64LessThan }
impl Order for isize { lessThan: Intrinsic.isizeLessThan }

/// Compares two values three ways using the concrete comparison selected during specialization.
///
/// # When to use
///
/// Use this function when the caller needs to distinguish less, equal, and greater outcomes.
///
/// # Details
///
/// Calls the selected strict comparison with `left, right`. If that result is false, it calls the
/// comparison with `right, left`. The function then consumes both owned arguments.
///
/// # Gotchas
///
/// If neither comparison is true, this function returns [`Equal`]. The witness must not leave two
/// different values incomparable.
pub fn compare<T: Order>(left: T, right: T) -> Ordering {
  if (&left) < (&right) {
    return Ordering { value: Less {} }
  }
  if (&right) < (&left) {
    return Ordering { value: Greater {} }
  }
  return Ordering { value: Equal {} }
}

/// Reports whether `left` orders strictly before `right` under the selected [`Order`] witness. The
/// function calls the witness once and then consumes both owned arguments.
pub fn less<T: Order>(left: T, right: T) -> bool {
  return (&left) < (&right)
}

/// Reports whether neither value orders before the other under the selected [`Order`] witness. The
/// function calls the witness once or twice and then consumes both owned arguments.
///
/// # Gotchas
///
/// If the witness leaves different values incomparable, this function reports them as equal.
pub fn equal<T: Order>(left: T, right: T) -> bool {
  if (&left) < (&right) {
    return false
  }
  return !((&right) < (&left))
}

/// Reports whether an ordering is `Less`.
pub fn isLess(ordering: &Ordering) -> bool {
  return match &ordering.value {
    Less {} => true
    Equal {} => false
    Greater {} => false
  }
}

/// Reports whether an ordering is `Equal`.
pub fn isEqual(ordering: &Ordering) -> bool {
  return match &ordering.value {
    Less {} => false
    Equal {} => true
    Greater {} => false
  }
}

/// Reports whether an ordering is `Greater`.
pub fn isGreater(ordering: &Ordering) -> bool {
  return match &ordering.value {
    Less {} => false
    Equal {} => false
    Greater {} => true
  }
}
