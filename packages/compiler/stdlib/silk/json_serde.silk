//! Static JSON conversion contracts for typed values.
//!
//! # When to use
//! Use `Serialize` to write a value through the ambient Writer. Use `Decode` for owned
//! values that need no allocation. Use `Deserialize` when a value can allocate.
//!
//! # Details
//! Each decode consumes one JSON value from a slice scanner. The caller checks for end of input.
//! Integer, Boolean, and finite floating-point values support all three contracts. Nonfinite
//! floating-point values fail with `JsonError` before any bytes are written.
//!
//! # Gotchas
//! The current compiler rejects a hand-written witness that specializes another concrete JSON
//! witness from its body with `SEM0053`. A nested user-struct witness cannot yet delegate to its
//! child through `JsonObject.field` or `JsonSerde.deserializeOne`. Keep the contracts unchanged;
//! a flat struct can still decode directly from `JsonScanner` and serialize with the builders.

import silk.allocator { Allocator, OutOfMemoryError }
import silk.f32
import silk.f64
import silk.format { Format, ParseError, NotANumber, OutOfRange }
import silk.json_output { JsonOptions, JsonOutput }
import silk.json_scanner { JsonError, JsonReason, JsonScanner, JsonToken }
import silk.option { Option }
import silk.result { Result }
import silk.writer { Writer, WriterError }

/// A type that writes one JSON value without allocating JSON-owned storage.
pub interface Serialize {
  /// Writes one value through the ambient Writer with the supplied format policy.
  effect fn serialize(self: &Self, options: &JsonOptions)
    -> () ! JsonError | WriterError ? &mut Writer
}

/// A type that decodes one owned JSON value without an Allocator requirement.
pub interface Decode {
  /// Decodes one value and leaves enclosing array or object delimiters unread.
  fn decode(scanner: &mut JsonScanner) -> Result<Self, JsonError>
}

/// A type that decodes one owned JSON value and can allocate.
pub interface Deserialize {
  /// Decodes one value and leaves enclosing array or object delimiters unread.
  effect fn deserialize(scanner: &mut JsonScanner)
    -> Self ! JsonError | OutOfMemoryError ? &mut Allocator
}

/// Operations that select static JSON witnesses for one value.
pub struct JsonSerde {}

impl JsonSerde {
  /// Decodes one value without requiring an allocator.
  pub fn decodeOne<T: Decode>(scanner: &mut JsonScanner) -> Result<T, JsonError> {
    return Decode.decode(&mut scanner.*)
  }

  /// Deserializes one value with its declared allocator upper bound.
  pub effect fn deserializeOne<T: Deserialize>(scanner: &mut JsonScanner)
    -> T ! JsonError | OutOfMemoryError ? &mut Allocator {
    return run Deserialize.deserialize(&mut scanner.*)
  }

  /// Writes one value through its Serialize witness.
  pub effect fn writeOne<T: Serialize>(value: &T, options: &JsonOptions)
    -> () ! JsonError | WriterError ? &mut Writer {
    return run Serialize.serialize(value, options)
  }
}

fn number<T>(scanner: &mut JsonScanner, parser: fn(string) -> Result<T, ParseError>)
  -> Result<T, JsonError> {
  let token = JsonScanner.next(&mut scanner.*)
  return match move token {
    Result<JsonToken, JsonError>.Failure { error } => Result.failResult<T, JsonError>(move error)
    Result<JsonToken, JsonError>.Success { value } => match move value {
      JsonToken.Number { span } => {
        let start = span.offset
        // The scanner accepts only ASCII bytes in a number token.
        let text = unsafe Intrinsic.stringFromUtf8Unchecked(
          JsonScanner.slice(&scanner.*, move span))
        return match move parser(text) {
          Result<T, ParseError>.Success { value: parsed } => Result.succeed<T, JsonError>(move parsed)
          Result<T, ParseError>.Failure { error } => match move error.reason {
            NotANumber { offset: _ } => Result.failResult<T, JsonError>(
              JsonError.at(JsonReason.TypeMismatch, start))
            OutOfRange {} => Result.failResult<T, JsonError>(
              JsonError.at(JsonReason.NumberOutOfRange, start))
          }
        }
      }
      _ => Result.failResult<T, JsonError>(
        JsonError.at(JsonReason.TypeMismatch, JsonScanner.offset(&scanner.*)))
    }
  }
}

effect fn decoded<T: Decode>(scanner: &mut JsonScanner) -> T ! JsonError {
  return match move Decode.decode(&mut scanner.*) {
    Result<T, JsonError>.Success { value } => move value
    Result<T, JsonError>.Failure { error } => { fail move error }
  }
}

impl Serialize for bool {
  effect fn serialize(self: &Self, options: &JsonOptions)
    -> () ! JsonError | WriterError ? &mut Writer {
    if self.* { return run Writer.writeAll(b"true") }
    return run Writer.writeAll(b"false")
  }
}

impl Decode for bool {
  fn decode(scanner: &mut JsonScanner) -> Result<Self, JsonError> {
    let token = JsonScanner.next(&mut scanner.*)
    return match move token {
      Result<JsonToken, JsonError>.Failure { error } =>
        Result.failResult<bool, JsonError>(move error)
      Result<JsonToken, JsonError>.Success { value } => match move value {
        JsonToken.True => Result.succeed<bool, JsonError>(true)
        JsonToken.False => Result.succeed<bool, JsonError>(false)
        _ => Result.failResult<bool, JsonError>(
          JsonError.at(JsonReason.TypeMismatch, JsonScanner.offset(&scanner.*)))
      }
    }
  }
}

impl Deserialize for bool {
  effect fn deserialize(scanner: &mut JsonScanner)
    -> Self ! JsonError | OutOfMemoryError ? &mut Allocator {
    return run decoded<bool>(&mut scanner.*)
  }
}

impl Serialize for u8 {
  effect fn serialize(self: &Self, options: &JsonOptions)
    -> () ! JsonError | WriterError ? &mut Writer {
    return run Format.display<u8>(self)
  }
}

impl Decode for u8 {
  fn decode(scanner: &mut JsonScanner) -> Result<Self, JsonError> {
    return number<u8>(&mut scanner.*, Format.u8Value)
  }
}

impl Deserialize for u8 {
  effect fn deserialize(scanner: &mut JsonScanner)
    -> Self ! JsonError | OutOfMemoryError ? &mut Allocator {
    return run decoded<u8>(&mut scanner.*)
  }
}

