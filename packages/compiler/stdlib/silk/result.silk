//! Completed success-or-failure values that can be inspected and transformed as ordinary data.
//!
//! # When to use
//! Use [`Result`] after an effectful computation has been reified, or whenever both outcome arms
//! belong in a value. Use [`map`] for success, [`mapError`] for failure, and [`flatMap`] for a
//! success continuation that already returns a result.
//!
//! # Details
//! `Result<A, F>` owns either [`Success`] or [`Failure`]. Its combinators move the selected payload
//! forward and preserve the other arm without inventing a runtime failure-row descriptor.

// Canonical completed typed outcome data. Failure rows project to ordinary value sums through
// E directly; Result itself remains ordinary source-defined data with no runtime row descriptor.

import silk.bool as bool

/// The successful member of a completed outcome.
pub struct Success<A> {
  /// The produced success value.
  value: A
}

/// The failed member of a completed outcome.
pub struct Failure<F> {
  /// The produced failure value.
  error: F
}

/// One completed outcome: either a success carrying `A` or a failure carrying `F`.
///
/// # Details
///
/// `Result` is the reified form of an Effect that has already run. Reifying an Effect turns its
/// failure row into ordinary value data, which is what lets the failure combinators in
/// `silk.effect` be written as ordinary Silk source instead of compiler built-ins.
pub struct Result<A, F> {
  /// The completed outcome, narrowed with `match`.
  value: Success<A> | Failure<F>
}

/// Constructs a completed successful outcome.
pub fn succeed<A, F>(value: A) -> Result<A, F> {
  return Result<A, F> { value: Success<A> { value: move value } }
}

/// Constructs a completed failed outcome.
pub fn failResult<A, F>(error: F) -> Result<A, F> {
  return Result<A, F> { value: Failure<F> { error: move error } }
}

/// Applies a transform to a success value and carries a failure through unchanged.
pub fn map<A, B, F>(self: Result<A, F>, transform: once fn(A) -> B) -> Result<B, F> {
  return match move self {
    Result<A, F> { value: outcome } => match move outcome {
      Success<A> { value } => succeed<B, F>(transform(move value))
      Failure<F> { error } => failResult<B, F>(move error)
    }
  }
}

/// Applies a transform to a failure value and carries a success through unchanged.
pub fn mapError<A, F, G>(self: Result<A, F>, transform: once fn(F) -> G) -> Result<A, G> {
  return match move self {
    Result<A, F> { value: outcome } => match move outcome {
      Success<A> { value } => succeed<A, G>(move value)
      Failure<F> { error } => failResult<A, G>(transform(move error))
    }
  }
}

/// Continues a success with a transform that answers with a Result of its own, so the outcome
/// stays one Result deep instead of nesting.
pub fn flatMap<A, B, F>(self: Result<A, F>, transform: once fn(A) -> Result<B, F>) -> Result<B, F> {
  return match move self {
    Result<A, F> { value: outcome } => match move outcome {
      Success<A> { value } => transform(move value)
      Failure<F> { error } => failResult<B, F>(move error)
    }
  }
}

/// Returns the success value, or the fallback value when the outcome is a failure.
///
/// # Details
///
/// Only the failure arm consumes the fallback. The success arm releases it, and the failure arm
/// releases the error, so exactly one owned value leaves this call and the other drops.
pub fn unwrapOr<A, F>(
  self: Result<A, F>,
  /// The owned alternative consumed only when `self` is a failure.
  fallback: A,
) -> A {
  return match move self {
    Result<A, F> { value: outcome } => match move outcome {
      Success<A> { value } => keepSuccess<A>(move value, move fallback)
      Failure<F> { error } => keepFallback<A, F>(move fallback, move error)
    }
  }
}

/// Answers whether the outcome succeeded, without consuming it.
pub fn isSuccess<A, F>(self: &Result<A, F>) -> bool {
  return match &self.value {
    Success<A> succeeded => true
    Failure<F> failed => false
  }
}

/// Answers whether the outcome failed, without consuming it.
pub fn isFailure<A, F>(self: &Result<A, F>) -> bool {
  return match &self.value {
    Success<A> succeeded => false
    Failure<F> failed => true
  }
}

/// Releases the fallback that a success value never needed. A match arm is one expression, so the
/// arm that must both drop and produce delegates to this helper.
fn keepSuccess<A>(success: A, unused: A) -> A {
  drop unused
  return move success
}

/// Releases the error the failure arm carried, and answers with the fallback it did need.
fn keepFallback<A, F>(fallback: A, error: F) -> A {
  drop error
  return move fallback
}
