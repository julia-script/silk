import silk.option { Option }

/// Calls the concrete u8 toU8 primitive.
pub fn toU8(value: u8) -> u8 {
  return Intrinsic.u8ToU8(value)
}

/// Calls the concrete u8 checkedToU8 primitive.
pub fn checkedToU8(value: u8) -> Option<u8> {
  return Intrinsic.u8CheckedToU8(value)
}

