pub fn equals(left: u16, right: u16) -> bool {
  return Intrinsic.u16Equals(left, right)
}

/// Calls the concrete u16 notEquals primitive.
pub fn notEquals(left: u16, right: u16) -> bool {
  return Intrinsic.u16NotEquals(left, right)
}

/// Calls the concrete u16 lessThan primitive.
pub fn lessThan(left: u16, right: u16) -> bool {
  return Intrinsic.u16LessThan(&left, &right)
}

/// Calls the concrete u16 lessOrEqual primitive.
pub fn lessOrEqual(left: u16, right: u16) -> bool {
  return Intrinsic.u16LessOrEqual(left, right)
}

/// Calls the concrete u16 greaterThan primitive.
