//! Pointer-width unsigned integers for lengths, indices, capacities, and allocation sizes.
//!
//! # When to use
//! Use `usize` for values that index target memory or describe its layout. Use a fixed-width
//! integer for serialized data, protocols, and persistent identifiers whose range must not change
//! between 32-bit and 64-bit targets.
//!
//! # Details
//! [`BITS`] and [`MAX`] follow the selected target. Ordinary arithmetic, narrowing conversions,
//! division by zero, and invalid shift counts trap. `checked*` returns [`Option`], `wrapping*`
//! computes modulo the target width, and `saturating*` clamps at [`MIN`] or [`MAX`].
//!
//! [`ZERO`] and [`ONE`] provide typed values where an uncontextualized literal would be `i32`.
//! Decimal [`parse`] uses the target's range, while [`toText`] allocates owned text.
//!
//! # Gotchas
//! A value valid as usize on a 64-bit target can be out of range on a 32-bit target.

import silk.bool as bool
import silk.core { Allocator }
import silk.core { OutOfMemoryError }
import silk.f32 as f32
import silk.f64 as f64
import silk.format as Format
import silk.format { ParseError }
import silk.i16 as i16
import silk.i32 as i32
import silk.i64 as i64
import silk.i8 as i8
import silk.isize as isize
import silk.option { Option }
import silk.result { Result }
import silk.string { String }
import silk.u16 as u16
import silk.u32 as u32
import silk.u64 as u64
import silk.u8 as u8

/// The largest usize selected for the compilation target.
///
/// # Details
///
/// This is 4294967295 on a 32-bit target and 18446744073709551615 on a 64-bit target. Checked
/// arithmetic rejects results above it.
pub const MAX: usize = Target.usizeMax

/// The smallest usize. An unsigned bound is zero at every pointer width, so this one is a literal.
pub const MIN: usize = 0

/// The width of usize in bits, which is the selected target's pointer width.
pub const BITS: u32 = Target.pointerBits

/// The usize zero. A bare literal defaults to i32, so a count without a typed context names this.
pub const ZERO: usize = 0

/// The usize one. A bare literal defaults to i32, so a step without a typed context names this.
pub const ONE: usize = 1

/// Calls the concrete usize toU8 primitive.
pub fn toU8(value: usize) -> u8 {
  return Intrinsic.usizeToU8(value)
}

/// Calls the concrete usize checkedToU8 primitive.
pub fn checkedToU8(value: usize) -> Option<u8> {
  return Intrinsic.usizeCheckedToU8(value)
}

/// Calls the concrete usize toU16 primitive.
pub fn toU16(value: usize) -> u16 {
