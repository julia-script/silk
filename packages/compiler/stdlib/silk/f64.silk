/// Calls the concrete f64 negate primitive.
pub fn negate(value: f64) -> f64 {
  return Intrinsic.f64Negate(value)
}

/// Calls the concrete f64 add primitive.
pub fn add(left: f64, right: f64) -> f64 {
  return Intrinsic.f64Add(left, right)
}

/// Calls the concrete f64 subtract primitive.
pub fn subtract(left: f64, right: f64) -> f64 {
  return Intrinsic.f64Subtract(left, right)
}

