/// Static addition contract for primitive integer values.
///
/// Interfaces select compiler-known operations during specialization. They do not create
/// effect requirements, provider slots, or runtime dispatch.
pub interface Integer<T> {
  fn add(left: T, right: T) -> T
}

impl Integer<u8> for u8 { add: Intrinsic.u8Add }
impl Integer<u16> for u16 { add: Intrinsic.u16Add }
impl Integer<u32> for u32 { add: Intrinsic.u32Add }
impl Integer<u64> for u64 { add: Intrinsic.u64Add }
impl Integer<usize> for usize { add: Intrinsic.usizeAdd }
impl Integer<i8> for i8 { add: Intrinsic.i8Add }
impl Integer<i16> for i16 { add: Intrinsic.i16Add }
impl Integer<i32> for i32 { add: Intrinsic.i32Add }
impl Integer<i64> for i64 { add: Intrinsic.i64Add }
impl Integer<isize> for isize { add: Intrinsic.isizeAdd }

/// Adds two values using the concrete integer operation selected during specialization.
pub fn add<T: Integer>(left: T, right: T) -> T {
  return left + right
}
