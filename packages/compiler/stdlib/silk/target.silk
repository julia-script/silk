//! Typed compile-time facts for the selected compilation profile.
//!
//! Machine facts and logical build choices are read during static evaluation. The compiler
//! provides primitive facts; this module owns their nominal source representation.

/// The selected Arch domain.
pub enum Arch {
  /// The Aarch64 choice.
  Aarch64,
  /// The Wasm32 choice.
  Wasm32,
  /// The X86_64 choice.
  X86_64
}

/// Returns the selected Arch during static evaluation.
pub static fn arch() -> Arch {
  let selected = Intrinsic.targetArchitecture()
  if selected == "aarch64" { return Arch.Aarch64 }
  if selected == "wasm32" { return Arch.Wasm32 }
  if selected == "x86_64" { return Arch.X86_64 }
  compileError("Unknown Arch fact")
}

/// The selected OperatingSystem domain.
pub enum OperatingSystem {
  /// The Darwin choice.
  Darwin,
  /// The Linux choice.
  Linux,
  /// The Freestanding choice.
  Freestanding
}

/// Returns the selected OperatingSystem during static evaluation.
pub static fn operatingSystem() -> OperatingSystem {
  let selected = Intrinsic.targetOperatingSystem()
  if selected == "darwin" { return OperatingSystem.Darwin }
  if selected == "linux" { return OperatingSystem.Linux }
  if selected == "freestanding" { return OperatingSystem.Freestanding }
  compileError("Unknown OperatingSystem fact")
}

/// The selected Abi domain.
pub enum Abi {
  /// The Apple choice.
  Apple,
  /// The Gnu choice.
  Gnu,
  /// The Wasm choice.
  Wasm
}

/// Returns the selected Abi during static evaluation.
pub static fn abi() -> Abi {
  let selected = Intrinsic.targetAbi()
  if selected == "apple" { return Abi.Apple }
  if selected == "gnu" { return Abi.Gnu }
  if selected == "wasm" { return Abi.Wasm }
  compileError("Unknown Abi fact")
}

/// The selected ObjectFormat domain.
pub enum ObjectFormat {
  /// The MachO choice.
  MachO,
  /// The Elf choice.
  Elf,
  /// The Wasm choice.
  Wasm
}

/// Returns the selected ObjectFormat during static evaluation.
pub static fn objectFormat() -> ObjectFormat {
  let selected = Intrinsic.targetObjectFormat()
  if selected == "macho" { return ObjectFormat.MachO }
  if selected == "elf" { return ObjectFormat.Elf }
  if selected == "wasm" { return ObjectFormat.Wasm }
  compileError("Unknown ObjectFormat fact")
}

/// The selected Endianness domain.
pub enum Endianness {
  /// The Little choice.
  Little
}

/// Returns the selected Endianness during static evaluation.
pub static fn endianness() -> Endianness {
  let selected = Intrinsic.targetEndianness()
  if selected == "little" { return Endianness.Little }
  compileError("Unknown Endianness fact")
}

static fn selectedUsizeMax() -> usize {
  if Intrinsic.targetPointerBits() == 32 { return 4294967295 }
  return 18446744073709551615
}

static fn selectedIsizeMax() -> isize {
  if Intrinsic.targetPointerBits() == 32 { return 2147483647 }
  return 9223372036854775807
}

static fn selectedIsizeMin() -> isize {
  if Intrinsic.targetPointerBits() == 32 { return -2147483648 }
  return -9223372036854775808
}

/// The pointer width of the selected compilation target, in bits.
pub const pointerBits: u32 = Intrinsic.targetPointerBits()

/// The greatest `usize` value supported by the selected compilation target.
pub const usizeMax: usize = selectedUsizeMax()

/// The greatest `isize` value supported by the selected compilation target.
pub const isizeMax: isize = selectedIsizeMax()

/// The least `isize` value supported by the selected compilation target.
pub const isizeMin: isize = selectedIsizeMin()

/// The alignment of a data pointer, in bytes.
pub const pointerAlignment: u32 = Intrinsic.targetPointerAlignment()

/// Returns the logical cpu selection.
pub static fn cpu() -> string<'static> { return Intrinsic.profileText("cpu") }

/// Returns the logical deployment selection.
pub static fn deployment() -> string<'static> { return Intrinsic.profileText("deployment") }

/// Whether debug information is requested.
pub const debug: bool = Intrinsic.profileFlag("debug")

/// Whether a canonical CPU feature is enabled.
pub static fn hasCpuFeature(value: string<'static>) -> bool { return Intrinsic.profileContains("cpu-features", value) }
