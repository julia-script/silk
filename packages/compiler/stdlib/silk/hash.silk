//! Deterministic seeded hashing contracts for hash maps, hash sets, and user-defined key types.
//!
//! # When to use
//! Implement [`HashKey`] when a type will be stored as a hashed key. Use [`mix`] for the first
//! integer field and [`combine`] for further fields, feeding every field that participates in
//! equality. [`Word`] is the ready-made key for one `u64`.
//!
//! # Details
//! A [`HashSeed`] belongs to a collection, not to each key. The same seed, keys, and operations
//! produce the same bucket presentation order on every engine, independent of addresses or ambient
//! state. Interface witnesses are selected during specialization and add no runtime dispatch.
//!
//! # Gotchas
//! Whenever `HashKey.equals` reports two values equal, `HashKey.hash` must return the same value
//! for both under every seed. The collection cannot detect a witness that violates this rule; such
//! a key may become unreachable.

// The hashing contract the hashed collections resolve against, and the seed every hash is computed
// under. Ordinary Silk: no compiler phase computes a hash, recognizes this interface by spelling, or
// treats a conformance to it as anything other than an ordinary conformance.
//
// The contract pairs an equivalence with a hash because a hashed collection needs both and needs
// them to agree. The equivalence is named `equals` rather than `equivalent` for the same reason
// `order.silk` declares `lessThan` rather than a three-way `compare`: an interface operation is
// reachable from a generic body through the operator that spells it, and `==` spells `equals`. The
// hash is reached by naming the bound, which is the one call shape no operator provides.

/// The value every hash in one collection is computed under.
///
/// # Details
///
/// One seed fixes one iteration order. A collection consults nothing else — no allocation address,
/// no clock, no ambient entropy — so two runs of one program over one seed observe one order, and
/// they observe it identically on the evaluator, on the native backend, and on WebAssembly.
pub struct HashSeed {
  /// The seed value handed to every hash the collection computes.
  pub value: u64
}

impl Copy for HashSeed {}

/// Constructs a seed from one value.
pub fn seed(value: u64) -> HashSeed {
  return HashSeed { value: value }
}

/// Static hashing contract for a key of a hashed collection.
///
/// # Details
///
/// A witness supplies two operations over one key type: the equivalence `==` spells, and a hash of
/// one key under one seed. The seed is an operand of the hash rather than state a key carries,
/// because one seed serves the whole collection.
///
/// # Gotchas
///
/// A witness must compute equal hashes for two keys its own `equals` reports equivalent, under every
/// seed. Nothing checks this — a witness that breaks it makes a present key unreachable, and a
/// collection can neither detect the breakage nor recover from it.
pub interface HashKey {
  /// Reports whether two keys name the same collection entry.
  fn equals(left: &Self, right: &Self) -> bool
  /// Computes the key's deterministic 64-bit hash under the collection seed.
  fn hash(value: &Self, seed: &HashSeed) -> u64
}

/// Mixes one value under one seed into a hash spread across the whole 64-bit range.
///
/// # Details
///
/// Every step is a wrapping multiply, a shift, or an exclusive or, so the result is exactly the same
/// on every engine. A witness for a key built from integers can answer `hash` by folding its fields
/// through this function rather than inventing a mixer.
pub fn mix(seed: &HashSeed, value: u64) -> u64 {
  let salted = u64.wrappingAdd(value, seed.value)
  let stepped = u64.wrappingAdd(salted, 11400714819323198485)
  let folded = u64.bitXor(stepped, u64.shiftRight(stepped, 30))
  let spread = u64.wrappingMultiply(folded, 13787848793156543929)
  let refolded = u64.bitXor(spread, u64.shiftRight(spread, 27))
  let respread = u64.wrappingMultiply(refolded, 10723151780598845931)
  return u64.bitXor(respread, u64.shiftRight(respread, 31))
}

/// Continues a hash with one further value, so a key of several fields folds into one hash.
pub fn combine(hashed: u64, value: u64) -> u64 {
  let mingled = u64.bitXor(hashed, u64.wrappingAdd(value, 11400714819323198485))
  let spread = u64.wrappingMultiply(mingled, 13787848793156543929)
  return u64.bitXor(spread, u64.shiftRight(spread, 27))
}

/// A key holding one unsigned integer.
///
/// # Details
///
/// The scalar types cannot carry a `HashKey` witness themselves: a conformance whose provider is a
/// scalar admits a sealed compiler operation and nothing else, and no compiler operation computes a
/// hash — nor may one be added. A key built from an integer is therefore a declared type, and this
/// is the canonical one.
pub struct Word {
  /// The integer this key stands for.
  pub value: u64
}

impl Copy for Word {}

/// Constructs an integer key.
pub fn word(value: u64) -> Word {
  return Word { value: value }
}

fn wordEquals(left: &Word, right: &Word) -> bool {
  return left.value == right.value
}

fn wordHash(value: &Word, seed: &HashSeed) -> u64 {
  return mix(seed, value.value)
}

impl HashKey for Word { equals: Word.wordEquals hash: Word.wordHash }
