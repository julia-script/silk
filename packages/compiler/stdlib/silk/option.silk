//! Optional owned values that distinguish presence from absence without a failure channel.
//!
//! # When to use
//! Use [`Option`] when absence is an expected answer and needs no error payload. Use [`map`] for a
//! pure transform, [`flatMap`] when the transform may also return absence, and [`unwrapOr`] only
//! when the caller is ready to consume the option.
//!
//! # Details
//! `Option<T>` is a nominal union with `Some` and `None` variants. Its combinators preserve affine
//! ownership: a present value moves forward, while an unused fallback or abandoned branch drops.
//!
//! # Examples
//! ## Transform and continue only when a value is present
//! ```silk
//! import silk.option { Option }
//!
//! fn double(value: i32) -> i32 {
//!   return value * 2
//! }
//!
//! fn positive(value: i32) -> Option<i32> {
//!   if value > 0 {
//!     return Option.some<i32>(value)
//!   }
//!   return Option.none<i32>()
//! }
//!
//! pub fn main() -> i32 {
//!   let initial = Option.some<i32>(21)
//!   let doubled = Option.map<i32, i32>(move initial, double)
//!   let answer = Option.flatMap<i32, i32>(move doubled, positive)
//!   let absent = Option.none<i32>()
//!   let missing = Option.map<i32, i32>(move absent, double)
//!   let presentValue = Option.unwrapOr<i32>(move answer, 0)
//!   let absentValue = Option.unwrapOr<i32>(move missing, 0)
//!   return presentValue + absentValue
//! }
//! ```

import silk.allocator { Allocator, OutOfMemoryError }
import silk.json_output { JsonOptions }
import silk.json_scanner { JsonError, JsonScanner, JsonToken }
import silk.json_serde { Decode, Deserialize, Serialize }
import silk.result { Result }
import silk.writer { Writer, WriterError }

/// An owned value that is either [`Some`] or [`None`].
///
/// # Details
///
/// Match on an `Option` when both arms need custom behavior. Prefer [`map`], [`flatMap`], or
/// [`unwrapOr`] for the common transform, continue, and default cases.
pub union Option<T> {
  /// The absent variant; it carries no explanation for the absence.
  None,
  /// The present variant, carrying the available owned value.
  Some {
    /// The value moved through present-only combinator branches.
    pub value: T
  }
}

impl<T> Option<T> {
  /// Constructs an absent optional value of the requested element type.
  pub fn none() -> Option<T> {
    return Option<T>.None
  }

  /// Constructs a present option by moving `value` into it.
  pub fn some(value: T) -> Option<T> {
    return Option.Some { value: move value }
  }

  /// Applies `transform` once to a present value and keeps an absent value absent.
  ///
  /// # Details
  ///
  /// The callback is not called for [`None`]. This operation consumes `self`; use a shared borrow and
  /// `match` instead when the original option must remain available.
  pub fn map<U>(self: Self, transform: once fn(T) -> U) -> Option<U> {
    return match move self {
      Option<T>.Some { value } => Option.some<U>(transform(move value))
      Option<T>.None => Option.none<U>()
    }
  }

  /// Continues a present value with a transform that itself answers with an Option, so the
  /// outcome stays one Option deep instead of nesting.
  ///
  /// # Details
  ///
  /// The callback runs once for [`Some`] and not at all for [`None`]. Use this when the next step may
  /// reject the value without needing to explain why; use a `Result` when rejection needs an error.
  pub fn flatMap<U>(self: Self, transform: once fn(T) -> Option<U>) -> Option<U> {
    return match move self {
      Option<T>.Some { value } => transform(move value)
      Option<T>.None => Option.none<U>()
    }
  }

  /// Returns the present value, or the fallback value when the option is absent.
  ///
  /// # Details
  ///
  /// Only the absent arm consumes the fallback. The present arm releases it, so exactly one of the
  /// two owned values leaves this call and the other drops.
  ///
  /// # Examples
  ///
  /// ## Choose between a present value and a fallback
  ///
  /// ```silk
  /// import silk.option { Option }
  ///
  /// pub fn main() -> i32 {
  ///   let present = Option.some<i32>(7)
  ///   let absent = Option.none<i32>()
  ///   let first = move present
  ///     |> Option.unwrapOr<i32>(0)
  ///   let second = move absent
  ///     |> Option.unwrapOr<i32>(5)
  ///   return first + second
  /// }
  /// ```
  pub fn unwrapOr(
    self: Self,
    /// The owned alternative consumed only when `self` is absent.
    fallback: T,
  ) -> T {
    return match move self {
      Option<T>.Some { value } => keepPresent<T>(move value, move fallback)
      Option<T>.None => move fallback
    }
  }
}

/// Releases the fallback that a present value never needed. A match arm is one expression, so the
/// arm that must both drop and produce delegates to this helper.
fn keepPresent<T>(present: T, unused: T) -> T {
  drop unused
  return move present
}

effect fn jsonToken(scanner: &mut JsonScanner, lookAhead: bool) -> JsonToken ! JsonError {
  if lookAhead {
    return match move JsonScanner.peek(&mut scanner.*) {
      Result<JsonToken, JsonError>.Success { value } => move value
      Result<JsonToken, JsonError>.Failure { error } => { fail move error }
    }
  }
  return match move JsonScanner.next(&mut scanner.*) {
    Result<JsonToken, JsonError>.Success { value } => move value
    Result<JsonToken, JsonError>.Failure { error } => { fail move error }
  }
}

impl<T: Serialize> Serialize for Option<T> {
  effect fn serialize(self: &Self, options: &JsonOptions)
    -> () ! JsonError | WriterError ? &mut Writer {
    return match &self.* {
      Option<T>.None => run Writer.writeAll(b"null")
      Option<T>.Some { value } => run Serialize.serialize(&value, options)
    }
  }
}

impl<T: Decode> Decode for Option<T> {
  fn decode(scanner: &mut JsonScanner) -> Result<Self, JsonError> {
    let peeked = JsonScanner.peek(&mut scanner.*)
    return match move peeked {
      Result<JsonToken, JsonError>.Failure { error } =>
        Result.failResult<Option<T>, JsonError>(move error)
      Result<JsonToken, JsonError>.Success { value } => match move value {
        JsonToken.Null => {
          let consumed = JsonScanner.next(&mut scanner.*)
          return match move consumed {
            Result<JsonToken, JsonError>.Failure { error } =>
              Result.failResult<Option<T>, JsonError>(move error)
            Result<JsonToken, JsonError>.Success { value: _ } =>
              Result.succeed<Option<T>, JsonError>(Option.none<T>())
          }
        }
        _ => match move Decode.decode(&mut scanner.*) {
          Result<T, JsonError>.Success { value: decoded } =>
            Result.succeed<Option<T>, JsonError>(Option.some<T>(move decoded))
          Result<T, JsonError>.Failure { error } =>
            Result.failResult<Option<T>, JsonError>(move error)
        }
      }
    }
  }
}

impl<T: Deserialize> Deserialize for Option<T> {
  effect fn deserialize(scanner: &mut JsonScanner)
    -> Self ! JsonError | OutOfMemoryError ? &mut Allocator {
    let token = run jsonToken(&mut scanner.*, true)
    return match move token {
      JsonToken.Null => {
        let consumed = run jsonToken(&mut scanner.*, false)
        return Option.none<T>()
      }
      _ => Option.some<T>(run Deserialize.deserialize(&mut scanner.*))
    }
  }
}
