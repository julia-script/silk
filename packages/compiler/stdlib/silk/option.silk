// Canonical recoverable outcome members. The compiler's Option<T> is represented transparently by the
// structural union Some<T> | None; the named declaration is its source-navigation anchor.

pub struct Some<T> {
  value: T
}

pub struct None {}

pub struct Option<T> {
  value: Some<T> | None
}

/// Constructs an absent optional value.
pub fn none<T>() -> Option<T> {
  return None {}
}

/// Constructs a present optional value.
pub fn some<T>(value: T) -> Option<T> {
  return Some<T> { value: move value }
}
