//! Sixty-four-bit unsigned integers for wide masks, counters, hashes, and exact interchange values.
//!
//! # When to use
//! Use `u64` when a stable unsigned 64-bit representation matters. It is the representation used
//! for hash output; use `usize` instead for target-sized collection lengths and indices.
//!
//! # Details
//! Ordinary arithmetic, narrowing conversions, division by zero, and invalid shift counts trap.
//! `checked*` returns [`Option`], `wrapping*` computes modulo 2^64, and `saturating*` clamps at
//! [`MIN`] or [`MAX`]. Right shift inserts zero bits.
//!
//! Decimal [`parse`] consumes the complete input and separates malformed text from range overflow.
//! [`toText`] allocates owned text. Conversion to a floating type may round large values.
//!
//! # Gotchas
//! A `u64` can represent values that neither `i64` nor every target's `usize` can hold; use a
//! checked conversion when that boundary is controlled by input.

import silk.bool as bool
import silk.core { Allocator }
import silk.core { OutOfMemoryError }
import silk.f32 as f32
import silk.f64 as f64
import silk.format as Format
import silk.format { ParseError }
import silk.i16 as i16
import silk.i32 as i32
import silk.i64 as i64
import silk.i8 as i8
import silk.isize as isize
import silk.option { Option }
import silk.result { Result }
import silk.string { String }
import silk.u16 as u16
import silk.u32 as u32
import silk.u8 as u8
import silk.usize as usize

/// The largest `u64` value.
pub const MAX: u64 = 18446744073709551615

/// The smallest `u64` value.
pub const MIN: u64 = 0

/// The width of u64 in bits.
pub const BITS: u32 = 64

/// Converts `value` to `u8` and traps if `u8` cannot represent it.
pub fn toU8(value: u64) -> u8 {
  return Intrinsic.u64ToU8(value)
}

/// Converts `value` to `u8`, or returns `None` if `u8` cannot represent it.
pub fn checkedToU8(value: u64) -> Option<u8> {
  return Intrinsic.u64CheckedToU8(value)
}

/// Converts `value` to `u16` and traps if `u16` cannot represent it.
pub fn toU16(value: u64) -> u16 {
  return Intrinsic.u64ToU16(value)
}

/// Converts `value` to `u16`, or returns `None` if `u16` cannot represent it.
pub fn checkedToU16(value: u64) -> Option<u16> {
  return Intrinsic.u64CheckedToU16(value)
}

/// Converts `value` to `u32` and traps if `u32` cannot represent it.
pub fn toU32(value: u64) -> u32 {
  return Intrinsic.u64ToU32(value)
}

/// Converts `value` to `u32`, or returns `None` if `u32` cannot represent it.
pub fn checkedToU32(value: u64) -> Option<u32> {
  return Intrinsic.u64CheckedToU32(value)
}

/// Returns `value` unchanged as `u64`.
pub fn toU64(value: u64) -> u64 {
  return Intrinsic.u64ToU64(value)
}

/// Returns `Some` with `value` unchanged as `u64`.
pub fn checkedToU64(value: u64) -> Option<u64> {
  return Intrinsic.u64CheckedToU64(value)
}

/// Converts `value` to `usize` and traps if `usize` cannot represent it.
pub fn toUsize(value: u64) -> usize {
  return Intrinsic.u64ToUsize(value)
}

/// Converts `value` to `usize`, or returns `None` if `usize` cannot represent it.
pub fn checkedToUsize(value: u64) -> Option<usize> {
  return Intrinsic.u64CheckedToUsize(value)
}

/// Converts `value` to `i8` and traps if `i8` cannot represent it.
pub fn toI8(value: u64) -> i8 {
  return Intrinsic.u64ToI8(value)
}

/// Converts `value` to `i8`, or returns `None` if `i8` cannot represent it.
pub fn checkedToI8(value: u64) -> Option<i8> {
  return Intrinsic.u64CheckedToI8(value)
}

/// Converts `value` to `i16` and traps if `i16` cannot represent it.
pub fn toI16(value: u64) -> i16 {
  return Intrinsic.u64ToI16(value)
}

/// Converts `value` to `i16`, or returns `None` if `i16` cannot represent it.
pub fn checkedToI16(value: u64) -> Option<i16> {
  return Intrinsic.u64CheckedToI16(value)
}

/// Converts `value` to `i32` and traps if `i32` cannot represent it.
pub fn toI32(value: u64) -> i32 {
  return Intrinsic.u64ToI32(value)
}

/// Converts `value` to `i32`, or returns `None` if `i32` cannot represent it.
pub fn checkedToI32(value: u64) -> Option<i32> {
  return Intrinsic.u64CheckedToI32(value)
}

/// Converts `value` to `i64` and traps if `i64` cannot represent it.
pub fn toI64(value: u64) -> i64 {
  return Intrinsic.u64ToI64(value)
}

/// Converts `value` to `i64`, or returns `None` if `i64` cannot represent it.
pub fn checkedToI64(value: u64) -> Option<i64> {
  return Intrinsic.u64CheckedToI64(value)
}

/// Converts `value` to `isize` and traps if `isize` cannot represent it.
pub fn toIsize(value: u64) -> isize {
  return Intrinsic.u64ToIsize(value)
}

/// Converts `value` to `isize`, or returns `None` if `isize` cannot represent it.
pub fn checkedToIsize(value: u64) -> Option<isize> {
  return Intrinsic.u64CheckedToIsize(value)
}

/// Converts `value` to the nearest `f32` value, with ties to even.
pub fn toF32(value: u64) -> f32 {
  return Intrinsic.u64ToF32(value)
}

/// Converts `value` to the nearest `f64` value, with ties to even.
pub fn toF64(value: u64) -> f64 {
  return Intrinsic.u64ToF64(value)
}

/// Returns `left + right` and traps if the result is outside the `u64` range.
pub fn add(left: u64, right: u64) -> u64 {
  return Intrinsic.u64Add(left, right)
}

/// Returns `left - right` and traps if the result is outside the `u64` range.
pub fn subtract(left: u64, right: u64) -> u64 {
  return Intrinsic.u64Subtract(left, right)
}

/// Returns `left * right` and traps if the result is outside the `u64` range.
pub fn multiply(left: u64, right: u64) -> u64 {
  return Intrinsic.u64Multiply(left, right)
}

/// Returns `left / right`. Traps if `right` is zero.
pub fn divide(left: u64, right: u64) -> u64 {
  return Intrinsic.u64Divide(left, right)
}

/// Returns the remainder of `left / right`. Traps if `right` is zero.
pub fn remainder(left: u64, right: u64) -> u64 {
  return Intrinsic.u64Remainder(left, right)
}

/// Returns the bitwise AND of `left` and `right`.
pub fn bitAnd(left: u64, right: u64) -> u64 {
  return Intrinsic.u64BitAnd(left, right)
}

/// Returns the bitwise OR of `left` and `right`.
pub fn bitOr(left: u64, right: u64) -> u64 {
  return Intrinsic.u64BitOr(left, right)
}

/// Returns the bitwise exclusive OR of `left` and `right`.
pub fn bitXor(left: u64, right: u64) -> u64 {
  return Intrinsic.u64BitXor(left, right)
}

/// Returns `value` with each bit inverted.
pub fn bitNot(value: u64) -> u64 {
  return Intrinsic.u64BitNot(value)
}

/// Shifts `left` bits left by `right` positions. Traps if `right` is negative or not less than
/// [`BITS`].
pub fn shiftLeft(left: u64, right: u64) -> u64 {
  return Intrinsic.u64ShiftLeft(left, right)
}

/// Shifts `left` bits right by `right` positions and inserts zero bits. Traps if `right` is
/// not less than [`BITS`].
pub fn shiftRight(left: u64, right: u64) -> u64 {
  return Intrinsic.u64ShiftRight(left, right)
}

/// Rotates the bits of `left` left by `right` positions.
pub fn rotateLeft(left: u64, right: u64) -> u64 {
  return Intrinsic.u64RotateLeft(left, right)
}

/// Rotates the bits of `left` right by `right` positions.
pub fn rotateRight(left: u64, right: u64) -> u64 {
  return Intrinsic.u64RotateRight(left, right)
}

/// Returns `left + right`, wrapped to the `u64` range.
pub fn wrappingAdd(left: u64, right: u64) -> u64 {
  return Intrinsic.u64WrappingAdd(left, right)
}

/// Returns `left - right`, wrapped to the `u64` range.
pub fn wrappingSubtract(left: u64, right: u64) -> u64 {
  return Intrinsic.u64WrappingSubtract(left, right)
}

/// Returns `left * right`, wrapped to the `u64` range.
pub fn wrappingMultiply(left: u64, right: u64) -> u64 {
  return Intrinsic.u64WrappingMultiply(left, right)
}

/// Returns `left + right`, clamped to [`MIN`] or [`MAX`].
pub fn saturatingAdd(left: u64, right: u64) -> u64 {
  return Intrinsic.u64SaturatingAdd(left, right)
}

/// Returns `left - right`, clamped to [`MIN`] or [`MAX`].
pub fn saturatingSubtract(left: u64, right: u64) -> u64 {
  return Intrinsic.u64SaturatingSubtract(left, right)
}

/// Returns `left * right`, clamped to [`MIN`] or [`MAX`].
pub fn saturatingMultiply(left: u64, right: u64) -> u64 {
  return Intrinsic.u64SaturatingMultiply(left, right)
}

/// Returns `Some` with `left + right`, or `None` if the result is outside the `u64` range.
pub fn checkedAdd(left: u64, right: u64) -> Option<u64> {
  return Intrinsic.u64CheckedAdd(left, right)
}

/// Returns `Some` with `left - right`, or `None` if the result is outside the `u64` range.
pub fn checkedSubtract(left: u64, right: u64) -> Option<u64> {
  return Intrinsic.u64CheckedSubtract(left, right)
}

/// Returns `Some` with `left * right`, or `None` if the result is outside the `u64` range.
pub fn checkedMultiply(left: u64, right: u64) -> Option<u64> {
  return Intrinsic.u64CheckedMultiply(left, right)
}

/// Returns `Some` with `left / right`, or `None` if `right` is zero.
pub fn checkedDivide(left: u64, right: u64) -> Option<u64> {
  return Intrinsic.u64CheckedDivide(left, right)
}

/// Returns `Some` with the remainder, or `None` if `right` is zero.
pub fn checkedRemainder(left: u64, right: u64) -> Option<u64> {
  return Intrinsic.u64CheckedRemainder(left, right)
}

/// Returns `true` when `left` and `right` are equal.
pub fn equals(left: u64, right: u64) -> bool {
  return Intrinsic.u64Equals(left, right)
}

/// Returns `true` when `left` and `right` are not equal.
pub fn notEquals(left: u64, right: u64) -> bool {
  return Intrinsic.u64NotEquals(left, right)
}

/// Returns `true` when `left` is less than `right`.
pub fn lessThan(left: u64, right: u64) -> bool {
  return Intrinsic.u64LessThan(&left, &right)
}

/// Returns `true` when `left` is less than or equal to `right`.
pub fn lessOrEqual(left: u64, right: u64) -> bool {
  return Intrinsic.u64LessOrEqual(left, right)
}

/// Returns `true` when `left` is greater than `right`.
pub fn greaterThan(left: u64, right: u64) -> bool {
  return Intrinsic.u64GreaterThan(left, right)
}

/// Returns `true` when `left` is greater than or equal to `right`.
pub fn greaterOrEqual(left: u64, right: u64) -> bool {
  return Intrinsic.u64GreaterOrEqual(left, right)
}

/// Renders the value as decimal text in freshly owned storage.
pub effect fn toText(value: u64) -> String ! OutOfMemoryError ? &mut Allocator {
  return run Format.unsignedText(toU64(value))
}

/// Reads complete decimal text as a `u64`, or reports why the text is not one.
pub fn parse(text: string) -> Result<u64, ParseError> {
  return Format.u64Value(text)
}
