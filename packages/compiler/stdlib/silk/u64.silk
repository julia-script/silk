import silk.option { Option }

/// The largest u64. The checked arithmetic intrinsics reject every result above this bound.
pub const MAX: u64 = 18446744073709551615

/// The smallest u64. The checked arithmetic intrinsics reject every result below this bound.
pub const MIN: u64 = 0

/// The width of u64 in bits.
pub const BITS: u32 = 64

/// Calls the concrete u64 toU8 primitive.
pub fn toU8(value: u64) -> u8 {
  return Intrinsic.u64ToU8(value)
}

/// Calls the concrete u64 checkedToU8 primitive.
pub fn checkedToU8(value: u64) -> Option<u8> {
  return Intrinsic.u64CheckedToU8(value)
}

/// Calls the concrete u64 toU16 primitive.
pub fn toU16(value: u64) -> u16 {
