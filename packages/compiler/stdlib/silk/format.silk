// Decimal text for integer values, in both directions, at radix 10 only.
//
// The whole engine is written twice — once over `u64` and once over `i64` — and every fixed-width
// integer module reaches it by widening to one of those two. Writing it once and generically is not
// available: an interface may only carry operations an operator spells, so `checkedMultiply` and
// friends have no call surface through a bound. Widening is lossless in both directions, so the two
// implementations are the whole truth about every integer type.
//
// Rendering walks digits most-significant first, which is why it computes the leading power of ten
// before it emits anything: `String.append` only appends, and a least-significant-first walk would
// need to prepend. Parsing accumulates *negatively* for signed text, so `i64.MIN` — whose magnitude
// has no positive counterpart — parses like any other value instead of being a special case.

import silk.result { Result, Success, Failure, failResult, succeed }
import silk.option { Option, Some, None }
import silk.string {
  String,
  make as stringMake,
  append as stringAppend,
  utf8Bytes as stringUtf8Bytes
}

const ZERO: u64 = 0
const ONE: u64 = 1
const TEN: u64 = 10

const SIGNED_ZERO: i64 = 0
const SIGNED_ONE: i64 = 1
const SIGNED_TEN: i64 = 10
const NEGATIVE_TEN: i64 = -10

const ASCII_MINUS: u8 = 45
const ASCII_ZERO: u8 = 48
const ASCII_NINE: u8 = 57

/// The byte offset of the first byte that is not part of a decimal number.
pub struct NotANumber {
  /// The offset at which reading stopped. Empty text reports offset zero.
  pub offset: usize
}

/// A well-formed decimal number whose value does not fit the requested type.
pub struct OutOfRange {}

/// Why decimal text did not produce a value, narrowed with `match`.
pub struct ParseFailure {
  /// The reason the text was rejected.
  pub reason: NotANumber | OutOfRange
}

fn reject<A>(reason: NotANumber | OutOfRange) -> Result<A, ParseFailure> {
  return failResult<A, ParseFailure>(ParseFailure { reason: move reason })
}

fn notANumber<A>(offset: usize) -> Result<A, ParseFailure> {
  return reject<A>(NotANumber { offset: offset })
}

fn outOfRange<A>() -> Result<A, ParseFailure> {
  return reject<A>(OutOfRange {})
}

// One decimal digit as its own text. Ten literals rather than arithmetic on bytes, because the
// result must be `string` and no owned byte becomes text without allocating.
fn digitText(digit: i32) -> string {
  if digit == 1 { return "1" }
  if digit == 2 { return "2" }
  if digit == 3 { return "3" }
  if digit == 4 { return "4" }
  if digit == 5 { return "5" }
  if digit == 6 { return "6" }
  if digit == 7 { return "7" }
  if digit == 8 { return "8" }
  if digit == 9 { return "9" }
  return "0"
}

// The value of one ASCII decimal digit, or -1 for any other byte.
fn digitValue(value: u8) -> i32 {
  if value < ASCII_ZERO { return -1 }
  if ASCII_NINE < value { return -1 }
  return u8.toI32(value) - u8.toI32(ASCII_ZERO)
}

/// Renders an unsigned value as decimal text in freshly owned storage.
///
/// Every unsigned integer module reaches this by widening, so the text of a `u8` and the text of the
/// same number as a `u64` are the same bytes.
pub effect fn unsignedText(value: u64) -> String ! OutOfMemory ? &mut Allocator {
  let mut text = stringMake()
  let mut divisor = ONE
  while TEN <= value / divisor { divisor = divisor * TEN }
  while ZERO < divisor {
    let digit = (value / divisor) % TEN
    let appended = run stringAppend(&mut text, digitText(u64.toI32(digit)))
    divisor = divisor / TEN
  }
  return move text
}

/// Renders a signed value as decimal text in freshly owned storage, with a leading `-` when negative.
///
/// The digits are taken from the value's negative form, so `i64.MIN` needs no special case: negating
/// it would overflow, while negating one digit of it never does.
pub effect fn signedText(value: i64) -> String ! OutOfMemory ? &mut Allocator {
  let mut text = stringMake()
  if value < SIGNED_ZERO {
    let sign = run stringAppend(&mut text, "-")
  }
  let mut negated = value
  if SIGNED_ZERO < negated { negated = SIGNED_ZERO - negated }
  let mut divisor = SIGNED_ONE
  while negated / divisor <= NEGATIVE_TEN { divisor = divisor * SIGNED_TEN }
  while SIGNED_ZERO < divisor {
    let digit = SIGNED_ZERO - ((negated / divisor) % SIGNED_TEN)
    let appended = run stringAppend(&mut text, digitText(i64.toI32(digit)))
    divisor = divisor / SIGNED_TEN
  }
  return move text
}

/// Reads complete decimal text as an unsigned value.
///
/// Empty text, a leading sign, and any byte outside `0`–`9` are `NotANumber` at the offset that
/// stopped the read. A value above `u64.MAX` is `OutOfRange`, detected before the overflow rather
/// than after it.
pub fn unsignedValue(text: string) -> Result<u64, ParseFailure> {
  let bytes = stringUtf8Bytes(text)
  if bytes.length == usize.ZERO { return notANumber<u64>(usize.ZERO) }
  let mut index = usize.ZERO
  let mut total = ZERO
  while index < bytes.length {
    let digit = digitValue(bytes[index])
    if digit < 0 { return notANumber<u64>(index) }
    if u64.MAX / TEN < total { return outOfRange<u64>() }
    total = total * TEN
    let addend = i32.toU64(digit)
    if u64.MAX - addend < total { return outOfRange<u64>() }
    total = total + addend
    index = index + usize.ONE
  }
  return succeed<u64, ParseFailure>(total)
}

/// Reads complete decimal text as a signed value, accepting one leading `-`.
///
/// Digits accumulate negatively, so text naming `i64.MIN` reads like any other value. A leading `+`
/// is not accepted. A value outside `i64.MIN`–`i64.MAX` is `OutOfRange`.
pub fn signedValue(text: string) -> Result<i64, ParseFailure> {
  let bytes = stringUtf8Bytes(text)
  let mut index = usize.ZERO
  let mut negative = false
  if usize.ZERO < bytes.length {
    if bytes[usize.ZERO] == ASCII_MINUS {
      negative = true
      index = usize.ONE
    }
  }
  if index == bytes.length { return notANumber<i64>(index) }
  let mut total = SIGNED_ZERO
  while index < bytes.length {
    let digit = digitValue(bytes[index])
    if digit < 0 { return notANumber<i64>(index) }
    if total < i64.MIN / SIGNED_TEN { return outOfRange<i64>() }
    total = total * SIGNED_TEN
    let subtrahend = i32.toI64(digit)
    if total < i64.MIN + subtrahend { return outOfRange<i64>() }
    total = total - subtrahend
    index = index + usize.ONE
  }
  if negative { return succeed<i64, ParseFailure>(total) }
  if total < SIGNED_ZERO - i64.MAX { return outOfRange<i64>() }
  return succeed<i64, ParseFailure>(SIGNED_ZERO - total)
}

// Narrowing is the checked conversion rather than a comparison against the target's MAX, so the two
// pointer-width types read exactly like the eight fixed-width ones. `usize` and `isize` have no
// limit constants to name (#109) and need none here.

fn narrowU8(value: u64) -> Result<u8, ParseFailure> {
  return match move u64.checkedToU8(value) {
    None {} => outOfRange<u8>()
    Some<u8> { value: narrowed } => succeed<u8, ParseFailure>(narrowed)
  }
}

fn narrowU16(value: u64) -> Result<u16, ParseFailure> {
  return match move u64.checkedToU16(value) {
    None {} => outOfRange<u16>()
    Some<u16> { value: narrowed } => succeed<u16, ParseFailure>(narrowed)
  }
}

fn narrowU32(value: u64) -> Result<u32, ParseFailure> {
  return match move u64.checkedToU32(value) {
    None {} => outOfRange<u32>()
    Some<u32> { value: narrowed } => succeed<u32, ParseFailure>(narrowed)
  }
}

fn narrowUsize(value: u64) -> Result<usize, ParseFailure> {
  return match move u64.checkedToUsize(value) {
    None {} => outOfRange<usize>()
    Some<usize> { value: narrowed } => succeed<usize, ParseFailure>(narrowed)
  }
}

fn narrowI8(value: i64) -> Result<i8, ParseFailure> {
  return match move i64.checkedToI8(value) {
    None {} => outOfRange<i8>()
    Some<i8> { value: narrowed } => succeed<i8, ParseFailure>(narrowed)
  }
}

fn narrowI16(value: i64) -> Result<i16, ParseFailure> {
  return match move i64.checkedToI16(value) {
    None {} => outOfRange<i16>()
    Some<i16> { value: narrowed } => succeed<i16, ParseFailure>(narrowed)
  }
}

fn narrowI32(value: i64) -> Result<i32, ParseFailure> {
  return match move i64.checkedToI32(value) {
    None {} => outOfRange<i32>()
    Some<i32> { value: narrowed } => succeed<i32, ParseFailure>(narrowed)
  }
}

fn narrowIsize(value: i64) -> Result<isize, ParseFailure> {
  return match move i64.checkedToIsize(value) {
    None {} => outOfRange<isize>()
    Some<isize> { value: narrowed } => succeed<isize, ParseFailure>(narrowed)
  }
}

/// Reads complete decimal text as a `u8`, rejecting a value above `u8.MAX`.
pub fn u8Value(text: string) -> Result<u8, ParseFailure> {
  return match move unsignedValue(text) {
    Result<u64, ParseFailure> { value: outcome } => match move outcome {
      Success<u64> { value } => narrowU8(value)
      Failure<ParseFailure> { error } => failResult<u8, ParseFailure>(move error)
    }
  }
}

/// Reads complete decimal text as a `u16`, rejecting a value above `u16.MAX`.
pub fn u16Value(text: string) -> Result<u16, ParseFailure> {
  return match move unsignedValue(text) {
    Result<u64, ParseFailure> { value: outcome } => match move outcome {
      Success<u64> { value } => narrowU16(value)
      Failure<ParseFailure> { error } => failResult<u16, ParseFailure>(move error)
    }
  }
}

/// Reads complete decimal text as a `u32`, rejecting a value above `u32.MAX`.
pub fn u32Value(text: string) -> Result<u32, ParseFailure> {
  return match move unsignedValue(text) {
    Result<u64, ParseFailure> { value: outcome } => match move outcome {
      Success<u64> { value } => narrowU32(value)
      Failure<ParseFailure> { error } => failResult<u32, ParseFailure>(move error)
    }
  }
}

/// Reads complete decimal text as a `u64`, rejecting a value above `u64.MAX`.
pub fn u64Value(text: string) -> Result<u64, ParseFailure> {
  return unsignedValue(text)
}

/// Reads complete decimal text as a `usize`, rejecting a value the target's pointer width cannot hold.
pub fn usizeValue(text: string) -> Result<usize, ParseFailure> {
  return match move unsignedValue(text) {
    Result<u64, ParseFailure> { value: outcome } => match move outcome {
      Success<u64> { value } => narrowUsize(value)
      Failure<ParseFailure> { error } => failResult<usize, ParseFailure>(move error)
    }
  }
}

/// Reads complete decimal text as an `i8`, rejecting a value outside `i8.MIN`–`i8.MAX`.
pub fn i8Value(text: string) -> Result<i8, ParseFailure> {
  return match move signedValue(text) {
    Result<i64, ParseFailure> { value: outcome } => match move outcome {
      Success<i64> { value } => narrowI8(value)
      Failure<ParseFailure> { error } => failResult<i8, ParseFailure>(move error)
    }
  }
}

/// Reads complete decimal text as an `i16`, rejecting a value outside `i16.MIN`–`i16.MAX`.
pub fn i16Value(text: string) -> Result<i16, ParseFailure> {
  return match move signedValue(text) {
    Result<i64, ParseFailure> { value: outcome } => match move outcome {
      Success<i64> { value } => narrowI16(value)
      Failure<ParseFailure> { error } => failResult<i16, ParseFailure>(move error)
    }
  }
}

/// Reads complete decimal text as an `i32`, rejecting a value outside `i32.MIN`–`i32.MAX`.
pub fn i32Value(text: string) -> Result<i32, ParseFailure> {
  return match move signedValue(text) {
    Result<i64, ParseFailure> { value: outcome } => match move outcome {
      Success<i64> { value } => narrowI32(value)
      Failure<ParseFailure> { error } => failResult<i32, ParseFailure>(move error)
    }
  }
}

/// Reads complete decimal text as an `i64`, rejecting a value outside `i64.MIN`–`i64.MAX`.
pub fn i64Value(text: string) -> Result<i64, ParseFailure> {
  return signedValue(text)
}

/// Reads complete decimal text as an `isize`, rejecting a value the target's pointer width cannot hold.
pub fn isizeValue(text: string) -> Result<isize, ParseFailure> {
  return match move signedValue(text) {
    Result<i64, ParseFailure> { value: outcome } => match move outcome {
      Success<i64> { value } => narrowIsize(value)
      Failure<ParseFailure> { error } => failResult<isize, ParseFailure>(move error)
    }
  }
}
