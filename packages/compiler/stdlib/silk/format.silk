//! Decimal rendering and complete-text parsing shared by every integer module.
//!
//! # When to use
//! Prefer an integer module's `toText` and `parse` operations when the width is already known. Use
//! [`unsignedText`], [`signedText`], [`unsignedValue`], or [`signedValue`] when intentionally
//! working through the widest integer representation.
//!
//! # Details
//! Rendering uses radix 10 and allocates an owned [`String`]. Parsing is allocation-free and reads
//! the entire input: whitespace, a leading `+`, or trailing characters produce [`NotANumber`],
//! while syntactically valid values outside the destination range produce [`OutOfRange`]. Signed
//! parsing accepts `-0`; unsigned parsing rejects any sign.
//!
//! # Examples
//! ## Parse and render one signed integer
//! ```silk
//! import silk.allocator { Allocator }
//!
//! import silk.effect { Effect }
//!
//! import silk.format as Format
//!
//! import silk.i64 as i64
//!
//! import silk.result as Result
//!
//! import silk.string as String
//!
//! effect fn convert() -> i32
//! ! Allocator.OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let parsed = Format.signedValue("-42")
//!     |> Result.unwrapOr<i64, Format.ParseError>(0)
//!   let rendering = Format.signedText(parsed)
//!     |> Effect.provideMut<Allocator>(&mut allocator)
//!   let rendered = run rendering
//!   let text = String.view(&rendered)
//!   if text == "-42" {} else {
//!     return 0
//!   }
//!   return 0 - parsed
//!     |> i64.toI32
//! }
//!
//! effect fn recover(error: Allocator.OutOfMemoryError) -> i32 {
//!   return 0
//! }
//!
//! pub fn main() -> i32 {
//!   return run Effect.catchAll(convert(), recover)
//! }
//! ```

// Decimal text for integer values, in both directions, at radix 10 only.
//
// The whole engine is written twice — once over `u64` and once over `i64` — and every fixed-width
// integer module reaches it by widening to one of those two. Writing it once and generically is not
// available: an interface may only carry operations an operator spells, so `checkedMultiply` and
// friends have no call surface through a bound. Widening is lossless in both directions, so the two
// implementations are the whole truth about every integer type.
//
// Rendering walks digits most-significant first, which is why it computes the leading power of ten
// before it emits anything: `String.append` only appends, and a least-significant-first walk would
// need to prepend. Parsing accumulates *negatively* for signed text, so `i64.MIN` — whose magnitude
// has no positive counterpart — parses like any other value instead of being a special case.

import silk.allocator { Allocator }
import silk.allocator { OutOfMemoryError }
import silk.i16 as i16
import silk.i32 as i32
import silk.i64 as i64
import silk.i8 as i8
import silk.isize as isize
import silk.option { Option }
import silk.result { Result, failResult, succeed }
import silk.string {
  String,
  make as stringMake,
  append as stringAppend,
  utf8Bytes as stringUtf8Bytes
}
import silk.u16 as u16
import silk.u32 as u32
import silk.u64 as u64
import silk.u8 as u8
import silk.usize as usize

const ZERO: u64 = 0
const ONE: u64 = 1
const TEN: u64 = 10

const SIGNED_ZERO: i64 = 0
const SIGNED_ONE: i64 = 1
const SIGNED_TEN: i64 = 10
const NEGATIVE_TEN: i64 = -10

const ASCII_MINUS: u8 = 45
const ASCII_ZERO: u8 = 48
const ASCII_NINE: u8 = 57

/// The byte offset where complete decimal parsing cannot continue.
pub struct NotANumber {
  /// The offset where reading stopped. It can equal the byte length when a digit was required.
  pub offset: usize
}

/// A well-formed decimal number whose value does not fit the requested type.
pub struct OutOfRange {}

/// Why decimal text did not produce a value, narrowed with `match`.
pub struct ParseError {
  /// The reason the text was rejected.
  pub reason: NotANumber | OutOfRange
}

fn reject<A>(reason: NotANumber | OutOfRange) -> Result<A, ParseError> {
  return failResult<A, ParseError>(ParseError { reason: move reason })
}

fn notANumber<A>(offset: usize) -> Result<A, ParseError> {
  return reject<A>(NotANumber { offset: offset })
}

fn outOfRange<A>() -> Result<A, ParseError> {
  return reject<A>(OutOfRange {})
}

// One decimal digit as its own text. Ten literals rather than arithmetic on bytes, because the
// result must be `string` and no owned byte becomes text without allocating.
fn digitText(digit: i32) -> string {
  if digit == 1 { return "1" }
  if digit == 2 { return "2" }
  if digit == 3 { return "3" }
  if digit == 4 { return "4" }
  if digit == 5 { return "5" }
  if digit == 6 { return "6" }
  if digit == 7 { return "7" }
  if digit == 8 { return "8" }
  if digit == 9 { return "9" }
  return "0"
}

// The value of one ASCII decimal digit, or -1 for any other byte.
fn digitValue(value: u8) -> i32 {
  if value < ASCII_ZERO { return -1 }
  if ASCII_NINE < value { return -1 }
  return u8.toI32(value) - u8.toI32(ASCII_ZERO)
}

/// Renders an unsigned value as decimal text in freshly owned storage.
///
/// # Details
///
/// The result contains ASCII decimal digits without a sign or leading zeroes. Zero produces `"0"`.
pub effect fn unsignedText(value: u64) -> String ! OutOfMemoryError ? &mut Allocator {
  let mut text = stringMake()
  let mut divisor = ONE
  while TEN <= value / divisor { divisor = divisor * TEN }
  while ZERO < divisor {
    let digit = (value / divisor) % TEN
    let appended = run stringAppend(&mut text, digitText(u64.toI32(digit)))
    divisor = divisor / TEN
  }
  return move text
}

/// Renders a signed value as decimal text in freshly owned storage, with a leading `-` when negative.
///
/// # Details
///
/// The result contains ASCII decimal digits without leading zeroes. Zero produces `"0"`.
/// The complete `i64` range, including `i64.MIN`, is supported.
pub effect fn signedText(value: i64) -> String ! OutOfMemoryError ? &mut Allocator {
  let mut text = stringMake()
  if value < SIGNED_ZERO {
    let sign = run stringAppend(&mut text, "-")
  }
  let mut negated = value
  if SIGNED_ZERO < negated { negated = SIGNED_ZERO - negated }
  let mut divisor = SIGNED_ONE
  while negated / divisor <= NEGATIVE_TEN { divisor = divisor * SIGNED_TEN }
  while SIGNED_ZERO < divisor {
    let digit = SIGNED_ZERO - ((negated / divisor) % SIGNED_TEN)
    let appended = run stringAppend(&mut text, digitText(i64.toI32(digit)))
    divisor = divisor / SIGNED_TEN
  }
  return move text
}

/// Reads complete decimal text as an unsigned value.
///
/// # Details
///
/// Empty text, a leading sign, and any byte outside `0`–`9` are `NotANumber` at the offset that
/// stopped the read. A value above `u64.MAX` is `OutOfRange`, detected before the overflow rather
/// than after it.
pub fn unsignedValue(text: string) -> Result<u64, ParseError> {
  let bytes = stringUtf8Bytes(text)
  if bytes.length == usize.ZERO { return notANumber<u64>(usize.ZERO) }
  let mut index = usize.ZERO
  let mut total = ZERO
  while index < bytes.length {
    let digit = digitValue(bytes[index])
    if digit < 0 { return notANumber<u64>(index) }
    if u64.MAX / TEN < total { return outOfRange<u64>() }
    total = total * TEN
    let addend = i32.toU64(digit)
    if u64.MAX - addend < total { return outOfRange<u64>() }
    total = total + addend
    index = index + usize.ONE
  }
  return succeed<u64, ParseError>(total)
}

/// Reads complete decimal text as a signed value, accepting one leading `-`.
///
/// # Details
///
/// Digits accumulate negatively, so text naming `i64.MIN` reads like any other value. A leading `+`
/// is not accepted. A value outside `i64.MIN`–`i64.MAX` is `OutOfRange`.
pub fn signedValue(text: string) -> Result<i64, ParseError> {
  let bytes = stringUtf8Bytes(text)
  let mut index = usize.ZERO
  let mut negative = false
  if usize.ZERO < bytes.length {
    if bytes[usize.ZERO] == ASCII_MINUS {
      negative = true
      index = usize.ONE
    }
  }
  if index == bytes.length { return notANumber<i64>(index) }
  let mut total = SIGNED_ZERO
  while index < bytes.length {
    let digit = digitValue(bytes[index])
    if digit < 0 { return notANumber<i64>(index) }
    if total < i64.MIN / SIGNED_TEN { return outOfRange<i64>() }
    total = total * SIGNED_TEN
    let subtrahend = i32.toI64(digit)
    if total < i64.MIN + subtrahend { return outOfRange<i64>() }
    total = total - subtrahend
    index = index + usize.ONE
  }
  if negative { return succeed<i64, ParseError>(total) }
  if total < SIGNED_ZERO - i64.MAX { return outOfRange<i64>() }
  return succeed<i64, ParseError>(SIGNED_ZERO - total)
}

// Narrowing is the checked conversion rather than a comparison against the target's MAX, so every
// type reads the same way. It is also the only form that works at every width: `usize.MAX` and
// `isize.MAX` are target-dependent, so a comparison against them would be a different comparison
// per target, while the checked conversion is one range test whatever the pointer width.

fn narrowU8(value: u64) -> Result<u8, ParseError> {
  return match move u64.checkedToU8(value) {
    Option<u8>.None => outOfRange<u8>()
    Option<u8>.Some { value: narrowed } => succeed<u8, ParseError>(narrowed)
  }
}

fn narrowU16(value: u64) -> Result<u16, ParseError> {
  return match move u64.checkedToU16(value) {
    Option<u16>.None => outOfRange<u16>()
    Option<u16>.Some { value: narrowed } => succeed<u16, ParseError>(narrowed)
  }
}

fn narrowU32(value: u64) -> Result<u32, ParseError> {
  return match move u64.checkedToU32(value) {
    Option<u32>.None => outOfRange<u32>()
    Option<u32>.Some { value: narrowed } => succeed<u32, ParseError>(narrowed)
  }
}

fn narrowUsize(value: u64) -> Result<usize, ParseError> {
  return match move u64.checkedToUsize(value) {
    Option<usize>.None => outOfRange<usize>()
    Option<usize>.Some { value: narrowed } => succeed<usize, ParseError>(narrowed)
  }
}

fn narrowI8(value: i64) -> Result<i8, ParseError> {
  return match move i64.checkedToI8(value) {
    Option<i8>.None => outOfRange<i8>()
    Option<i8>.Some { value: narrowed } => succeed<i8, ParseError>(narrowed)
  }
}

fn narrowI16(value: i64) -> Result<i16, ParseError> {
  return match move i64.checkedToI16(value) {
    Option<i16>.None => outOfRange<i16>()
    Option<i16>.Some { value: narrowed } => succeed<i16, ParseError>(narrowed)
  }
}

fn narrowI32(value: i64) -> Result<i32, ParseError> {
  return match move i64.checkedToI32(value) {
    Option<i32>.None => outOfRange<i32>()
    Option<i32>.Some { value: narrowed } => succeed<i32, ParseError>(narrowed)
  }
}

fn narrowIsize(value: i64) -> Result<isize, ParseError> {
  return match move i64.checkedToIsize(value) {
    Option<isize>.None => outOfRange<isize>()
    Option<isize>.Some { value: narrowed } => succeed<isize, ParseError>(narrowed)
  }
}

/// Reads complete decimal text as a `u8`, rejecting a value above `u8.MAX`.
pub fn u8Value(text: string) -> Result<u8, ParseError> {
  return match move unsignedValue(text) {
    Result<u64, ParseError>.Success { value } => narrowU8(value)
    Result<u64, ParseError>.Failure { error } => failResult<u8, ParseError>(move error)
  }
}

/// Reads complete decimal text as a `u16`, rejecting a value above `u16.MAX`.
pub fn u16Value(text: string) -> Result<u16, ParseError> {
  return match move unsignedValue(text) {
    Result<u64, ParseError>.Success { value } => narrowU16(value)
    Result<u64, ParseError>.Failure { error } => failResult<u16, ParseError>(move error)
  }
}

/// Reads complete decimal text as a `u32`, rejecting a value above `u32.MAX`.
pub fn u32Value(text: string) -> Result<u32, ParseError> {
  return match move unsignedValue(text) {
    Result<u64, ParseError>.Success { value } => narrowU32(value)
    Result<u64, ParseError>.Failure { error } => failResult<u32, ParseError>(move error)
  }
}

/// Reads complete decimal text as a `u64`, rejecting a value above `u64.MAX`.
pub fn u64Value(text: string) -> Result<u64, ParseError> {
  return unsignedValue(text)
}

/// Reads complete decimal text as a `usize`, rejecting a value the target's pointer width cannot
/// hold.
pub fn usizeValue(text: string) -> Result<usize, ParseError> {
  return match move unsignedValue(text) {
    Result<u64, ParseError>.Success { value } => narrowUsize(value)
    Result<u64, ParseError>.Failure { error } => failResult<usize, ParseError>(move error)
  }
}

/// Reads complete decimal text as an `i8`, rejecting a value outside `i8.MIN`–`i8.MAX`.
pub fn i8Value(text: string) -> Result<i8, ParseError> {
  return match move signedValue(text) {
    Result<i64, ParseError>.Success { value } => narrowI8(value)
    Result<i64, ParseError>.Failure { error } => failResult<i8, ParseError>(move error)
  }
}

/// Reads complete decimal text as an `i16`, rejecting a value outside `i16.MIN`–`i16.MAX`.
pub fn i16Value(text: string) -> Result<i16, ParseError> {
  return match move signedValue(text) {
    Result<i64, ParseError>.Success { value } => narrowI16(value)
    Result<i64, ParseError>.Failure { error } => failResult<i16, ParseError>(move error)
  }
}

/// Reads complete decimal text as an `i32`, rejecting a value outside `i32.MIN`–`i32.MAX`.
pub fn i32Value(text: string) -> Result<i32, ParseError> {
  return match move signedValue(text) {
    Result<i64, ParseError>.Success { value } => narrowI32(value)
    Result<i64, ParseError>.Failure { error } => failResult<i32, ParseError>(move error)
  }
}

/// Reads complete decimal text as an `i64`, rejecting a value outside `i64.MIN`–`i64.MAX`.
pub fn i64Value(text: string) -> Result<i64, ParseError> {
  return signedValue(text)
}

/// Reads complete decimal text as an `isize`, rejecting a value the target's pointer width cannot
/// hold.
pub fn isizeValue(text: string) -> Result<isize, ParseError> {
  return match move signedValue(text) {
    Result<i64, ParseError>.Success { value } => narrowIsize(value)
    Result<i64, ParseError>.Failure { error } => failResult<isize, ParseError>(move error)
  }
}
