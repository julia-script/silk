//! Pointer-width signed integers for offsets whose range follows the selected compilation target.
//!
//! # When to use
//! Use `isize` for offsets paired with target-sized counts or addresses. Use a fixed-width integer
//! for files, protocols, persistent data, or any value that must mean the same thing on 32-bit and
//! 64-bit targets.
//!
//! # Details
//! [`BITS`], [`MIN`], and [`MAX`] are selected from the target. Ordinary arithmetic, narrowing
//! conversions, division by zero, and invalid shift counts trap. `checked*` returns [`Option`],
//! `wrapping*` uses arithmetic modulo the target width, and `saturating*` clamps at the target bound.
//!
//! Decimal [`parse`] and [`toText`] use the selected target range; formatting allocates owned text.
//!
//! # Gotchas
//! Code that succeeds at a 64-bit boundary may fail or trap when compiled for a 32-bit target.

import silk.option { Option }

/// The largest isize selected for the compilation target.
///
/// # Details
///
/// This is 2147483647 on a 32-bit target and 9223372036854775807 on a 64-bit target. Checked
/// arithmetic rejects results above it.
pub const MAX: isize = Target.isizeMax

/// The smallest isize. The checked arithmetic intrinsics reject every result below this bound. It
/// is -2147483648 on a 32-bit target and -9223372036854775808 on a 64-bit one.
pub const MIN: isize = Target.isizeMin

/// The width of isize in bits, which is the selected target's pointer width.
pub const BITS: u32 = Target.pointerBits

/// Calls the concrete isize negate primitive.
pub fn negate(value: isize) -> isize {
  return Intrinsic.isizeNegate(value)
}

/// Calls the concrete isize wrappingNegate primitive.
pub fn wrappingNegate(value: isize) -> isize {
  return Intrinsic.isizeWrappingNegate(value)
}

/// Calls the concrete isize saturatingNegate primitive.
pub fn saturatingNegate(value: isize) -> isize {
  return Intrinsic.isizeSaturatingNegate(value)
}

