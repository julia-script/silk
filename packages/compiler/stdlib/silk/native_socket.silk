  }
  const IPV4_FAMILY: i32 = 2
  const IPV6_FAMILY: i32 = 10
  const UNIX_FAMILY: i32 = 1
  const STREAM_SOCKET: i32 = 1
  const SOCKET_LEVEL: i32 = 1
  const SOCKET_ERROR: i32 = 4
