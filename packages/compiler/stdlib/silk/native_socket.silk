  const SOCKET_NO_SIGPIPE: i32 = -1
  const NONBLOCK: i32 = 2048
  const CLOSE_ON_EXEC: i32 = 524288
  const AGAIN: i32 = 11
  const IN_PROGRESS: i32 = 115
  const CONNECTION_REFUSED: i32 = 111
  const NETWORK_UNREACHABLE: i32 = 101
