  }
  const IPV4_FAMILY: i32 = 2
  const IPV6_FAMILY: i32 = 30
  const UNIX_FAMILY: i32 = 1
  const STREAM_SOCKET: i32 = 1
  const SOCKET_LEVEL: i32 = 65535
  const SOCKET_ERROR: i32 = 4103
  const SOCKET_LINGER: i32 = 128
  const SOCKET_NO_SIGPIPE: i32 = 4130
  const NONBLOCK: i32 = 4
  const GET_STATUS_FLAGS: i32 = 3
  const SET_STATUS_FLAGS: i32 = 4
  const GET_DESCRIPTOR_FLAGS: i32 = 1
  const SET_DESCRIPTOR_FLAGS: i32 = 2
  const CLOSE_ON_EXEC: i32 = 1
  const AGAIN: i32 = 35
  const IN_PROGRESS: i32 = 36
  const CONNECTION_REFUSED: i32 = 61
  const NETWORK_UNREACHABLE: i32 = 51
  const ADDRESS_UNAVAILABLE: i32 = 49
