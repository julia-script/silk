  unsafe extern "C" fn __errno_location() -> *mut i32
  unsafe extern "C" fn closeSocket(fd: i32) -> i32 as "close"
  unsafe extern "C" fn poll(fds: [*]mut PollFd, count: usize, timeout: i32) -> i32 with Intrinsic.foreign(noCapture: ("fds",))
  unsafe fn currentError() -> i32 { unsafe { return Pointer.read<i32>(__errno_location()) } }
