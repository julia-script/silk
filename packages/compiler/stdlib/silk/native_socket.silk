//! Scoped nonblocking TCP and pathname-Unix connections over ByteDuplex.
//!
//! # When to use
//!
//! Use connectResolvedOwned for ordered numeric endpoints or connectUnixOwned for one absolute
//! pathname. Each operation returns one affine Connection. The connectResolved and connectUnix
//! helpers consume the same owner into a protected callback scope.
//!
//! # Details
//!
//! Every native syscall is nonblocking. Temporary unavailability uses zero-time poll followed by a
//! positive MonotonicClock wait. One acquisition deadline is shared by every sequential candidate.
//! Socket flush means kernel acceptance, not delivery to the peer.
//!
//! # Gotchas
//!
//! Timer polling trades readiness latency for a bounded idle poll rate. A None deadline may wait
//! indefinitely. Structured Effect exits close once; fatal traps carry no cleanup guarantee.
//! Darwin setup is single-threaded and does not promise cross-thread fork safety.

static if (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText("libc") == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
import silk.byte_duplex {ByteDuplex, ByteIoError, ByteIoOperation, ReadTransfer}
import silk.effect {Effect}
import silk.i16
import silk.i32
import silk.i64
import silk.isize
import silk.monotonic_clock {MonotonicClock}
import silk.network_address {Endpoint, IpAddress, Ipv4Address, Ipv6Address, Port}
import silk.option {Option}
import silk.pointer {Pointer}
import silk.result {Result}
import silk.system_clock {Instant, SystemClock}
import silk.u16
import silk.u32
import silk.u64
import silk.usize

/// The visible directional lifetime of one native connection.
pub enum ConnectionPhase {
  Connecting,
  Open,
  WriteClosed,
  Closed,
}

/// The native boundary that produced a socket failure.
pub enum NativeSocketOperation {
  Socket,
  Configure,
  Connect,
  Poll,
  GetSocketOption,
  Read,
  Write,
  ShutdownWrite,
  Close,
}

/// The rejected ConnectOptions field.
pub enum ConnectOptionsReason {
  PollInterval,
  MaxAttempts,
}

/// A typed ConnectOptions admission failure.
pub struct ConnectOptionsError {
  pub reason: ConnectOptionsReason
  pub value: u64
}

/// The rejected endpoint or pathname condition.
pub enum InvalidEndpointReason {
  EmptyEndpoints,
  TooManyEndpoints,
  EmptyPath,
  RelativePath,
  NulPath,
  PathTooLong,
  AbstractPath,
}

/// One nonrecursive failure retained when the attempt budget is exhausted.
pub union AttemptFailure {
  ConnectionRefused,
  NetworkUnreachable,
  AddressUnavailable,
  NativeFailure {
    pub operation: NativeSocketOperation,
    pub errno: i32,
  },
}

/// A native socket acquisition or explicit lifecycle failure.
pub union NativeSocketError {
  AttemptsExhausted {
    pub attempted: usize,
    pub last: AttemptFailure,
  },
  TimeRangeError,
  InvalidEndpoint {
    pub reason: InvalidEndpointReason,
    pub offset: usize,
    pub limit: usize,
  },
  FamilyUnsupported,
  PermissionDenied,
  ConnectionRefused,
  NetworkUnreachable,
  AddressUnavailable,
  SystemResources,
  Timeout,
  Closed,
  WriteClosed,
  InvalidTransferCount {
    pub operation: ByteIoOperation,
    pub count: usize,
    pub limit: usize,
  },
  NativeFailure {
    pub operation: NativeSocketOperation,
    pub errno: i32,
  },
}

/// Namespace anchor for the selected native socket actor.
pub struct NativeSocket {}

/// Finite readiness and attempt policy copied into one connection.
pub struct ConnectOptions {
  noDelayValue: bool
  pollIntervalNanoseconds: u64
  maxAttemptsValue: usize
}

impl Copy for ConnectOptionsError {}
impl Copy for AttemptFailure {}
impl Copy for NativeSocketError {}
impl Copy for ConnectOptions {}

impl ConnectOptions {
  /// Admits a 1..1,000,000,000ns interval and 1..1024 native attempts.
  pub fn make(
    noDelay: bool,
    pollIntervalNanoseconds: u64,
    maxAttempts: usize,
  ) -> Result<ConnectOptions, ConnectOptionsError> {
    if pollIntervalNanoseconds == 0 || pollIntervalNanoseconds > 1000000000 {
      return Result.failResult<ConnectOptions, ConnectOptionsError>(ConnectOptionsError {
        reason: ConnectOptionsReason.PollInterval,
        value: pollIntervalNanoseconds,
      })
    }
    if maxAttempts == usize.ZERO || maxAttempts > 1024 {
      return Result.failResult<ConnectOptions, ConnectOptionsError>(ConnectOptionsError {
        reason: ConnectOptionsReason.MaxAttempts,
        value: usize.toU64(maxAttempts),
      })
    }
    return Result.succeed<ConnectOptions, ConnectOptionsError>(ConnectOptions {
      noDelayValue: noDelay,
      pollIntervalNanoseconds: pollIntervalNanoseconds,
      maxAttemptsValue: maxAttempts,
    })
  }

  /// Selects Nagle, a one-millisecond readiness interval, and 64 attempts.
  pub fn defaults() -> ConnectOptions {
    return ConnectOptions {
      noDelayValue: false,
      pollIntervalNanoseconds: 1000000,
      maxAttemptsValue: 64,
    }
  }

  pub fn noDelay(self: &Self) -> bool { return self.noDelayValue }
  pub fn pollInterval(self: &Self) -> u64 { return self.pollIntervalNanoseconds }
  pub fn maxAttempts(self: &Self) -> usize { return self.maxAttemptsValue }
}

extern "C" struct SockAddr {}
extern "C" struct Linger {
