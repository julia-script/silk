//! Foundational allocation and standard-output services used by higher standard-library actors.
//!
//! # When to use
//! Provide [`Allocator`] to operations that may create owned storage, normally with
//! [`SystemAllocator`]. Use [`StandardStreams`] for complete byte messages to stdout or stderr;
//! structured logging belongs in `silk.logging`.
//!
//! # Details
//! Both capabilities are ordinary source-declared services. Their requirements remain in an
//! Effect until a caller supplies a provider, so tests and applications can replace process-backed
//! implementations lexically. Allocation failure is typed as [`OutOfMemoryError`], and stream failure as
//! [`StreamWriteError`].

import silk.layout { Layout as LayoutValue }

/// Reports that an allocator could not satisfy a storage request.
pub struct OutOfMemoryError {}

/// Fails immediately with [`OutOfMemoryError`], for translating checked sizing failures.
pub effect fn outOfMemory() -> never ! OutOfMemoryError {
  fail OutOfMemoryError {}
}

/// Mutable service for acquiring owned storage described by a layout.
pub service Allocator {
  /// Acquires one allocation or fails without returning partial storage.
  effect fn allocate(layout: LayoutValue) -> Allocation ! OutOfMemoryError ? &mut Allocator
}

/// Constructs the process-backed allocation provider.
pub struct SystemAllocator {}

/// Constructs a process-backed allocator provider with no allocation of its own.
pub fn make() -> SystemAllocator {
  return SystemAllocator {}
}

effect fn allocate(self: &mut SystemAllocator, layout: LayoutValue) -> Allocation ! OutOfMemoryError {
  return run Intrinsic.systemAllocationAcquire(move layout)
}

impl Allocator for SystemAllocator {
  allocate: SystemAllocator.allocate
}

/// Failure to commit one complete stream message.
pub struct StreamWriteError {}

impl Report for StreamWriteError {}

/// Portable complete-message output contract.
pub service StandardStreams {
  /// Commits one complete immutable byte sequence to the selected destination.
  effect fn writeAll(
    destination: bool,
    bytes: &[u8]
  ) -> () ! StreamWriteError ? &mut StandardStreams
}

/// Process-backed standard-stream provider.
pub struct NativeStandardStreams {}

/// Selects the process standard-output destination.
pub fn stdout() -> bool {
  return false
}

/// Selects the process standard-error destination.
pub fn stderr() -> bool {
  return true
}

/// Constructs the process-backed standard-stream provider.
pub fn native() -> NativeStandardStreams {
  return NativeStandardStreams {}
}

effect fn nativeWriteAll(
  self: &NativeStandardStreams,
  destination: bool,
  bytes: &[u8]
) -> () ! StreamWriteError {
  return run Intrinsic.standardStreamWrite(destination, bytes)
}

impl StandardStreams for NativeStandardStreams {
  writeAll: NativeStandardStreams.nativeWriteAll
}

/// Builds one complete-write service effect.
pub effect fn send(
  destination: bool,
  bytes: &[u8]
) -> () ! StreamWriteError ? &mut StandardStreams {
  return run StandardStreams.writeAll(move destination, bytes)
}
