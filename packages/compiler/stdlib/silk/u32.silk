//! Thirty-two-bit unsigned integers for fixed-width counts, masks, and binary fields.
//!
//! # When to use
//! Use `u32` when an unsigned 32-bit representation is part of the contract, including masks and
//! encoded fields. Use `usize` for collection positions and allocation sizes tied to the target.
//!
//! # Details
//! Ordinary arithmetic, narrowing conversions, division by zero, and invalid shift counts trap.
//! `checked*` returns [`Option`], `wrapping*` computes modulo 2^32, and `saturating*` clamps at
//! [`MIN`] or [`MAX`]. Right shift is logical and inserts zero bits.
//!
//! Decimal [`parse`] requires a complete unsigned representation and reports malformed input
//! separately from overflow. [`toText`] allocates owned text.

import silk.bool as bool
import silk.core { Allocator }
import silk.core { OutOfMemoryError }
import silk.f32 as f32
import silk.f64 as f64
import silk.format as Format
import silk.format { ParseError }
import silk.i16 as i16
import silk.i32 as i32
import silk.i64 as i64
import silk.i8 as i8
import silk.isize as isize
import silk.option { Option }
import silk.result { Result }
import silk.string { String }
import silk.u16 as u16
import silk.u64 as u64
import silk.u8 as u8
import silk.usize as usize

/// The largest `u32` value.
pub const MAX: u32 = 4294967295

/// The smallest `u32` value.
pub const MIN: u32 = 0

/// The width of u32 in bits.
pub const BITS: u32 = 32

/// Converts `value` to `u8` and traps if `u8` cannot represent it.
pub fn toU8(value: u32) -> u8 {
  return Intrinsic.u32ToU8(value)
}

/// Converts `value` to `u8`, or returns `None` if `u8` cannot represent it.
pub fn checkedToU8(value: u32) -> Option<u8> {
  return Intrinsic.u32CheckedToU8(value)
}

/// Converts `value` to `u16` and traps if `u16` cannot represent it.
pub fn toU16(value: u32) -> u16 {
  return Intrinsic.u32ToU16(value)
}

/// Converts `value` to `u16`, or returns `None` if `u16` cannot represent it.
pub fn checkedToU16(value: u32) -> Option<u16> {
  return Intrinsic.u32CheckedToU16(value)
}

/// Returns `value` unchanged as `u32`.
pub fn toU32(value: u32) -> u32 {
  return Intrinsic.u32ToU32(value)
}

/// Returns `Some` with `value` unchanged as `u32`.
pub fn checkedToU32(value: u32) -> Option<u32> {
  return Intrinsic.u32CheckedToU32(value)
}

/// Converts `value` to `u64` and traps if `u64` cannot represent it.
pub fn toU64(value: u32) -> u64 {
  return Intrinsic.u32ToU64(value)
}

/// Converts `value` to `u64`, or returns `None` if `u64` cannot represent it.
pub fn checkedToU64(value: u32) -> Option<u64> {
  return Intrinsic.u32CheckedToU64(value)
}

/// Converts `value` to `usize` and traps if `usize` cannot represent it.
pub fn toUsize(value: u32) -> usize {
  return Intrinsic.u32ToUsize(value)
}

/// Converts `value` to `usize`, or returns `None` if `usize` cannot represent it.
pub fn checkedToUsize(value: u32) -> Option<usize> {
  return Intrinsic.u32CheckedToUsize(value)
}

/// Converts `value` to `i8` and traps if `i8` cannot represent it.
pub fn toI8(value: u32) -> i8 {
  return Intrinsic.u32ToI8(value)
}

/// Converts `value` to `i8`, or returns `None` if `i8` cannot represent it.
pub fn checkedToI8(value: u32) -> Option<i8> {
  return Intrinsic.u32CheckedToI8(value)
}

/// Converts `value` to `i16` and traps if `i16` cannot represent it.
pub fn toI16(value: u32) -> i16 {
  return Intrinsic.u32ToI16(value)
}

/// Converts `value` to `i16`, or returns `None` if `i16` cannot represent it.
pub fn checkedToI16(value: u32) -> Option<i16> {
  return Intrinsic.u32CheckedToI16(value)
}

/// Converts `value` to `i32` and traps if `i32` cannot represent it.
pub fn toI32(value: u32) -> i32 {
  return Intrinsic.u32ToI32(value)
}

/// Converts `value` to `i32`, or returns `None` if `i32` cannot represent it.
pub fn checkedToI32(value: u32) -> Option<i32> {
  return Intrinsic.u32CheckedToI32(value)
}

/// Converts `value` to `i64` and traps if `i64` cannot represent it.
pub fn toI64(value: u32) -> i64 {
  return Intrinsic.u32ToI64(value)
}

/// Converts `value` to `i64`, or returns `None` if `i64` cannot represent it.
pub fn checkedToI64(value: u32) -> Option<i64> {
  return Intrinsic.u32CheckedToI64(value)
}

/// Converts `value` to `isize` and traps if `isize` cannot represent it.
pub fn toIsize(value: u32) -> isize {
  return Intrinsic.u32ToIsize(value)
}

/// Converts `value` to `isize`, or returns `None` if `isize` cannot represent it.
pub fn checkedToIsize(value: u32) -> Option<isize> {
  return Intrinsic.u32CheckedToIsize(value)
}

/// Converts `value` to the nearest `f32` value, with ties to even.
pub fn toF32(value: u32) -> f32 {
  return Intrinsic.u32ToF32(value)
}

/// Converts `value` to the nearest `f64` value, with ties to even.
pub fn toF64(value: u32) -> f64 {
  return Intrinsic.u32ToF64(value)
}

/// Returns `left + right` and traps if the result is outside the `u32` range.
pub fn add(left: u32, right: u32) -> u32 {
  return Intrinsic.u32Add(left, right)
}

/// Returns `left - right` and traps if the result is outside the `u32` range.
pub fn subtract(left: u32, right: u32) -> u32 {
  return Intrinsic.u32Subtract(left, right)
}

/// Returns `left * right` and traps if the result is outside the `u32` range.
pub fn multiply(left: u32, right: u32) -> u32 {
  return Intrinsic.u32Multiply(left, right)
}

/// Returns `left / right`. Traps if `right` is zero.
pub fn divide(left: u32, right: u32) -> u32 {
  return Intrinsic.u32Divide(left, right)
}

/// Returns the remainder of `left / right`. Traps if `right` is zero.
pub fn remainder(left: u32, right: u32) -> u32 {
  return Intrinsic.u32Remainder(left, right)
}

/// Returns the bitwise AND of `left` and `right`.
pub fn bitAnd(left: u32, right: u32) -> u32 {
  return Intrinsic.u32BitAnd(left, right)
}

/// Returns the bitwise OR of `left` and `right`.
pub fn bitOr(left: u32, right: u32) -> u32 {
  return Intrinsic.u32BitOr(left, right)
}

/// Returns the bitwise exclusive OR of `left` and `right`.
pub fn bitXor(left: u32, right: u32) -> u32 {
  return Intrinsic.u32BitXor(left, right)
}

/// Returns `value` with each bit inverted.
pub fn bitNot(value: u32) -> u32 {
  return Intrinsic.u32BitNot(value)
}

/// Shifts `left` bits left by `right` positions. Traps if `right` is negative or not less than
/// [`BITS`].
pub fn shiftLeft(left: u32, right: u32) -> u32 {
  return Intrinsic.u32ShiftLeft(left, right)
}

/// Shifts `left` bits right by `right` positions and inserts zero bits. Traps if `right` is
/// not less than [`BITS`].
pub fn shiftRight(left: u32, right: u32) -> u32 {
  return Intrinsic.u32ShiftRight(left, right)
}

/// Rotates the bits of `left` left by `right` positions.
pub fn rotateLeft(left: u32, right: u32) -> u32 {
  return Intrinsic.u32RotateLeft(left, right)
}

/// Rotates the bits of `left` right by `right` positions.
pub fn rotateRight(left: u32, right: u32) -> u32 {
  return Intrinsic.u32RotateRight(left, right)
}

/// Returns `left + right`, wrapped to the `u32` range.
pub fn wrappingAdd(left: u32, right: u32) -> u32 {
  return Intrinsic.u32WrappingAdd(left, right)
}

/// Returns `left - right`, wrapped to the `u32` range.
pub fn wrappingSubtract(left: u32, right: u32) -> u32 {
  return Intrinsic.u32WrappingSubtract(left, right)
}

/// Returns `left * right`, wrapped to the `u32` range.
pub fn wrappingMultiply(left: u32, right: u32) -> u32 {
  return Intrinsic.u32WrappingMultiply(left, right)
}

/// Returns `left + right`, clamped to [`MIN`] or [`MAX`].
pub fn saturatingAdd(left: u32, right: u32) -> u32 {
  return Intrinsic.u32SaturatingAdd(left, right)
}

/// Returns `left - right`, clamped to [`MIN`] or [`MAX`].
pub fn saturatingSubtract(left: u32, right: u32) -> u32 {
  return Intrinsic.u32SaturatingSubtract(left, right)
}

/// Returns `left * right`, clamped to [`MIN`] or [`MAX`].
pub fn saturatingMultiply(left: u32, right: u32) -> u32 {
  return Intrinsic.u32SaturatingMultiply(left, right)
}

/// Returns `Some` with `left + right`, or `None` if the result is outside the `u32` range.
pub fn checkedAdd(left: u32, right: u32) -> Option<u32> {
  return Intrinsic.u32CheckedAdd(left, right)
}

/// Returns `Some` with `left - right`, or `None` if the result is outside the `u32` range.
pub fn checkedSubtract(left: u32, right: u32) -> Option<u32> {
  return Intrinsic.u32CheckedSubtract(left, right)
}

/// Returns `Some` with `left * right`, or `None` if the result is outside the `u32` range.
pub fn checkedMultiply(left: u32, right: u32) -> Option<u32> {
  return Intrinsic.u32CheckedMultiply(left, right)
}

/// Returns `Some` with `left / right`, or `None` if `right` is zero.
pub fn checkedDivide(left: u32, right: u32) -> Option<u32> {
  return Intrinsic.u32CheckedDivide(left, right)
}

/// Returns `Some` with the remainder, or `None` if `right` is zero.
pub fn checkedRemainder(left: u32, right: u32) -> Option<u32> {
  return Intrinsic.u32CheckedRemainder(left, right)
}

/// Returns `true` when `left` and `right` are equal.
pub fn equals(left: u32, right: u32) -> bool {
  return Intrinsic.u32Equals(left, right)
}

/// Returns `true` when `left` and `right` are not equal.
pub fn notEquals(left: u32, right: u32) -> bool {
  return Intrinsic.u32NotEquals(left, right)
}

/// Returns `true` when `left` is less than `right`.
pub fn lessThan(left: u32, right: u32) -> bool {
  return Intrinsic.u32LessThan(&left, &right)
}

/// Returns `true` when `left` is less than or equal to `right`.
pub fn lessOrEqual(left: u32, right: u32) -> bool {
  return Intrinsic.u32LessOrEqual(left, right)
}

/// Returns `true` when `left` is greater than `right`.
pub fn greaterThan(left: u32, right: u32) -> bool {
  return Intrinsic.u32GreaterThan(left, right)
}

/// Returns `true` when `left` is greater than or equal to `right`.
pub fn greaterOrEqual(left: u32, right: u32) -> bool {
  return Intrinsic.u32GreaterOrEqual(left, right)
}

/// Renders the value as decimal text in freshly owned storage.
pub effect fn toText(value: u32) -> String ! OutOfMemoryError ? &mut Allocator {
  return run Format.unsignedText(toU64(value))
}

/// Reads complete decimal text as a `u32`, or reports why the text is not one.
pub fn parse(text: string) -> Result<u32, ParseError> {
  return Format.u32Value(text)
}
