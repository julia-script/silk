//! Thirty-two-bit unsigned integers for fixed-width counts, masks, and binary fields.
//!
//! # When to use
//! Use `u32` when an unsigned 32-bit representation is part of the contract, including masks and
//! encoded fields. Use `usize` for collection positions and allocation sizes tied to the target.
//!
//! # Details
//! Ordinary arithmetic, narrowing conversions, division by zero, and invalid shift counts trap.
//! `checked*` returns [`Option`], `wrapping*` computes modulo 2^32, and `saturating*` clamps at
//! [`MIN`] or [`MAX`]. Right shift is logical and inserts zero bits.
//!
//! Decimal [`parse`] requires a complete unsigned representation and reports malformed input
//! separately from overflow. [`toText`] allocates owned text.

import silk.bool as bool
import silk.core { Allocator }
import silk.core { OutOfMemoryError }
import silk.f32 as f32
import silk.f64 as f64
import silk.format as Format
import silk.format { ParseError }
import silk.i16 as i16
import silk.i32 as i32
import silk.i64 as i64
import silk.i8 as i8
import silk.isize as isize
import silk.option { Option }
import silk.result { Result }
import silk.string { String }
import silk.u16 as u16
import silk.u64 as u64
import silk.u8 as u8
import silk.usize as usize

/// The largest u32. The checked arithmetic intrinsics reject every result above this bound.
pub const MAX: u32 = 4294967295

/// The smallest u32. The checked arithmetic intrinsics reject every result below this bound.
pub const MIN: u32 = 0

/// The width of u32 in bits.
pub const BITS: u32 = 32

/// Calls the concrete u32 toU8 primitive.
pub fn toU8(value: u32) -> u8 {
  return Intrinsic.u32ToU8(value)
}

/// Calls the concrete u32 checkedToU8 primitive.
pub fn checkedToU8(value: u32) -> Option<u8> {
  return Intrinsic.u32CheckedToU8(value)
}

/// Calls the concrete u32 toU16 primitive.
pub fn toU16(value: u32) -> u16 {
  return Intrinsic.u32ToU16(value)
}

/// Calls the concrete u32 checkedToU16 primitive.
pub fn checkedToU16(value: u32) -> Option<u16> {
  return Intrinsic.u32CheckedToU16(value)
}

/// Calls the concrete u32 toU32 primitive.
pub fn toU32(value: u32) -> u32 {
