//! Native ownership context for one-shot HTTP fetch operations.
//!
//! # Details
//!
//! The context retains one immutable proxy policy through [`NativeRedirectClient`]. Fresh
//! attempts therefore recompute the sealed route for every current URI before contact. An
//! optional native pool handle is copied explicitly, sharing only its preallocated slot state and
//! bounded immutable direct-route context.
//!
//! # Gotchas
//!
//! The delivered native pool accepts direct TCP and Unix keys only. A fetch adapter must reject a
//! configured pool when proxy recomputation selects forwarding or tunneling; it must not silently
//! bypass the selected proxy or publish proxy credentials to a direct pool.

import silk.allocator {Allocator, OutOfMemoryError}
import silk.byte_duplex {ByteDuplex}
import silk.http_client {ClientError, Exchange, Limits, RouteTransport}
import silk.http_client_native {
  NativeClientError,
  NativeRedirectClient,
  NativeRouteProvider,
  NativeTransport,
  Options,
}
import silk.http_connection_pool {ConnectionKey, Handle}
import silk.http_connection_pool_native as NativePool
import silk.http_proxy {ProxyError, Route}
import silk.http_redirect as Redirect {
  AttemptClient,
  AttemptHandler,
  AttemptRequest,
  HybridAttempt,
}
import silk.http_request {RequestError}
import silk.http_transport {HttpTransport}
import silk.http_origin {OriginError}
import silk.http {Method, ValueError}
import silk.https_identity {IdentityError}
import silk.monotonic_clock {MonotonicClock}
import silk.option {Option}
import silk.random {Random}
import silk.resolver {ResolverError}
import silk.system_clock {Instant, SystemClock}
import silk.tls_connection {ConnectionError}
import silk.trust_source {TrustSource}
import silk.trust_snapshot {TrustSourceError}

/// An immutable native route/acquisition context and optional compatible direct-pool capability.
///
/// # Details
///
/// [`make`] consumes all fresh-acquisition settings without allocation. [`makeWithPool`] first
/// constructs that exact fresh context, then fallibly copies the supplied pool handle. A failed
/// copy publishes no partially initialized context and leaves the source handle valid.
pub struct Context<'configuration> {
  routeValue: Route<'configuration>
  optionsValue: Options
  limitsValue: Limits
  poolValue: Option<
    Handle<ConnectionKey, NativeTransport, NativePool.Context>,
  >
}

impl<'configuration> Context<'configuration> {
  /// Owns one native fresh-acquisition context without a connection pool.
  pub fn make(
    route: Route<'configuration>,
    options: Options,
    limits: Limits,
  ) -> Context<'configuration> {
    return Context<'configuration> {
      routeValue: route,
      optionsValue: move options,
      limitsValue: limits,
      poolValue: Option.none<
        Handle<ConnectionKey, NativeTransport, NativePool.Context>,
      >(),
    }
  }

  /// Owns one native fresh-acquisition context and a copied direct-pool capability.
  ///
  /// The copied handle retains the pool's already bounded immutable transport, HTTP, TLS, ALPN,
  /// and trust context. Route compatibility remains a per-attempt pre-contact admission check.
  pub effect fn makeWithPool(
    route: Route<'configuration>,
    options: Options,
    limits: Limits,
    pool: &Handle<ConnectionKey, NativeTransport, NativePool.Context>,
  ) -> Context<'configuration>
  ! TrustSourceError | OutOfMemoryError
  ? &mut Allocator {
    let copied = run NativePool.copyHandle(pool)
    return Context<'configuration> {
      routeValue: route,
      optionsValue: move options,
      limitsValue: limits,
      poolValue: Option.some<
        Handle<ConnectionKey, NativeTransport, NativePool.Context>,
      >(move copied),
    }
  }

  /// Returns whether this context owns an explicit direct native pool capability.
  pub fn hasPool(self: &Self) -> bool {
    return match & self.poolValue {
      Option.None => false
      Option.Some {value} => true
    }
  }
}

fn copyInstant(value: &Instant) -> Instant {
  return SystemClock.make(SystemClock.seconds(value), SystemClock.nanoseconds(value))
}

fn copyDeadline(value: &Option<Instant>) -> Option<Instant> {
  return match & value.* {
    Option.None => Option.none<Instant>()
    Option.Some {value: present} => Option.some<Instant>(copyInstant(&present))
  }
}

fn attemptOptions(options: &Options, deadline: &Option<Instant>) -> Options {
  return Options {
    maximumAddresses: options.maximumAddresses,
    family: options.family,
    noDelay: options.noDelay,
    pollIntervalNanoseconds: options.pollIntervalNanoseconds,
    maximumAttempts: options.maximumAttempts,
    deadline: copyDeadline(deadline),
    handshakeNanoseconds: options.handshakeNanoseconds,
    tls: options.tls,
    trust: options.trust,
    alpn: options.alpn,
  }
}

struct RoutedAttemptUse {}

impl<
  'policy,
  A,
  HandlerError,
  ?HandlerRequirements,
> RoutedAttemptUse {
  effect<'call> fn handle<
    'call,
    'exchangeView: 'call,
    'transport: 'exchangeView,
    'provider: 'transport,
    'tunnel: 'provider,
  >(
    use: Self,
    request: &'call AttemptRequest<'policy>,
    method: Method<'call>,
    exchange: &'call mut Exchange<
      'exchangeView,
      RouteTransport<'transport, 'provider, 'tunnel, NativeRouteProvider>
    >,
  ) -> A
  ! HandlerError
  ? HandlerRequirements | &mut HybridAttempt<
    'policy,
    NativeRouteProvider,
    NativeTransport,
    A,
    HandlerError ? HandlerRequirements
  > {
    drop use
    return run HybridAttempt<
      'policy,
      NativeRouteProvider,
      NativeTransport,
      A,
      HandlerError ? HandlerRequirements
    >.handleRouted(request, method, move exchange)
  }
}

impl<
  'policy,
  A,
  HandlerError,
  ?HandlerRequirements,
> AttemptHandler<
  'policy,
  NativeRouteProvider,
  A,
  HandlerError ? HandlerRequirements | &mut HybridAttempt<
    'policy,
    NativeRouteProvider,
    NativeTransport,
    A,
    HandlerError ? HandlerRequirements
  >
> for RoutedAttemptUse {
  handle: RoutedAttemptUse.handle
}

static if (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText(
  "libc",
) == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText(
  "libc",
) == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
  import silk.native_socket {NativeSocketError}

  effect fn withFreshRouted<
    'configuration,
    'policy,
    A,
    HandlerError,
    ?HandlerRequirements,
  >(
    route: Route<'configuration>,
    options: Options,
    limits: Limits,
    request: AttemptRequest<'policy>,
    deadline: Option<Instant>,
  ) -> A
  ! HandlerError
    | ProxyError
    | RequestError
    | ValueError
    | OriginError
    | ClientError
    | NativeClientError
    | ResolverError
    | NativeSocketError
    | ConnectionError
    | IdentityError
    | TrustSourceError
    | OutOfMemoryError
  ? HandlerRequirements
    | &mut HybridAttempt<
      'policy,
      NativeRouteProvider,
      NativeTransport,
      A,
      HandlerError ? HandlerRequirements
    >
    | &mut Allocator
    | &mut MonotonicClock
    | &mut SystemClock
    | &mut Random
    | &mut TrustSource
  where HandlerRequirements in Without<HandlerRequirements, ByteDuplex>,
    HandlerRequirements in Without<HandlerRequirements, HttpTransport> {
    let mut fresh = NativeRedirectClient.make(route, move options, limits)
    return run AttemptClient<
      'policy,
      NativeRouteProvider,
      A,
      HandlerError,
      ProxyError
        | RequestError
        | ValueError
        | OriginError
        | ClientError
        | NativeClientError
        | ResolverError
        | NativeSocketError
        | ConnectionError
        | IdentityError
        | TrustSourceError
        | OutOfMemoryError,
      HandlerRequirements | &mut HybridAttempt<
        'policy,
        NativeRouteProvider,
        NativeTransport,
        A,
        HandlerError ? HandlerRequirements
      >,
      &mut Allocator
        | &mut MonotonicClock
        | &mut SystemClock
        | &mut Random
        | &mut TrustSource,
      RoutedAttemptUse,
    >.withAttempt(&mut fresh, move request, move deadline, RoutedAttemptUse {})
  }
}
