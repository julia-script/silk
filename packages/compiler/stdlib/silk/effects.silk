// Familiar channel transformations derived from the closed compiler core. The core executes one
// Effect into Result data and binds one typed requirement; everything here is ordinary Silk.

import silk.result { Result, Success, Failure }
import silk.logging { LogError, LogLevel, Logger }

/// Dispatches one complete Info message through the explicitly provided Logger.
pub effect fn log(
  message: string
) -> () ! LogError ? &mut Logger {
  return run Logger.log(LogLevel.info(), message)
}

/// Dispatches one complete message at the selected level through the provided Logger.
pub effect fn logAt(
  level: LogLevel,
  message: string
) -> () ! LogError ? &mut Logger {
  return run Logger.log(move level, message)
}

/// Reifies one Effect execution into Result data while preserving its requirements.
pub effect fn result<A, !E, ?R>(
  protected: once Effect<A ! E ? R>
) -> Result<A, Row<!E>> ? R {
  return run Intrinsic.effectResult(move protected)
}

effect fn raise<!E>(error: Row<!E>) -> never ! E {
  fail move error
}

/// Transforms both the success and typed-failure channels of an Effect.
pub effect fn mapBoth<A, B, !E, !F, ?R>(
  self: once Effect<A ! E ? R>,
  onSuccess: once fn(A) -> B,
  onFailure: once fn(Row<!E>) -> Row<!F>
) -> B ! F ? R {
  let completed = run result(move self)
  return match move completed {
    Result<A, Row<!E>> { value: outcome } => match move outcome {
      Success<A> { value: success } => onSuccess(move success)
      Failure<Row<!E>> { error } => run raise(onFailure(move error))
    }
  }
}

/// Transforms the success channel of an Effect.
pub effect fn map<A, B, !E, ?R>(
  self: once Effect<A ! E ? R>,
  onSuccess: once fn(A) -> B
) -> B ! E ? R {
  let completed = run result(move self)
  return match move completed {
    Result<A, Row<!E>> { value: outcome } => match move outcome {
      Success<A> { value: success } => onSuccess(move success)
      Failure<Row<!E>> { error } => run raise(move error)
    }
  }
}

/// Transforms the typed-failure channel of an Effect.
pub effect fn mapError<A, !E, !F, ?R>(
  self: once Effect<A ! E ? R>,
  onFailure: once fn(Row<!E>) -> Row<!F>
) -> A ! F ? R {
  let completed = run result(move self)
  return match move completed {
    Result<A, Row<!E>> { value: outcome } => match move outcome {
      Success<A> { value: success } => move success
      Failure<Row<!E>> { error } => run raise(onFailure(move error))
    }
  }
}

/// Continues an Effect with an effectful success callback.
pub effect fn flatMap<A, B, !E, !F, ?R, ?S>(
  self: once Effect<A ! E ? R>,
  onSuccess: once fn(A) -> Effect<B ! F ? S>
) -> B ! E | F ? R | S {
  let completed = run result(move self)
  return match move completed {
    Result<A, Row<!E>> { value: outcome } => match move outcome {
      Success<A> { value: success } => run onSuccess(move success)
      Failure<Row<!E>> { error } => run raise(move error)
    }
  }
}

/// Removes one Effect layer from a nested Effect.
pub effect fn flatten<A, !E, !F, ?R, ?S>(
  self: once Effect<Effect<A ! F ? S> ! E ? R>
) -> A ! E | F ? R | S {
  let inner = run self
  return run inner
}

/// Runs an effectful callback while preserving its returned success value.
pub effect fn tap<A, !E, !F, ?R, ?S>(
  self: once Effect<A ! E ? R>,
  callback: once fn(A) -> Effect<A ! F ? S>
) -> A ! E | F ? R | S {
  let completed = run result(move self)
  return match move completed {
    Result<A, Row<!E>> { value: outcome } => match move outcome {
      Success<A> { value: success } => run callback(move success)
      Failure<Row<!E>> { error } => run raise(move error)
    }
  }
}

/// Recovers every typed failure with another Effect.
pub effect fn catchAll<A, !E, !F, ?R, ?S>(
  self: once Effect<A ! E ? R>,
  onFailure: once fn(Row<!E>) -> Effect<A ! F ? S>
) -> A ! F ? R | S {
  let completed = run result(move self)
  return match move completed {
    Result<A, Row<!E>> { value: outcome } => match move outcome {
      Success<A> { value: success } => move success
      Failure<Row<!E>> { error } => run onFailure(move error)
    }
  }
}

/// Recovers every typed failure with another Effect.
pub effect fn catch<A, !E, !F, ?R, ?S>(
  self: once Effect<A ! E ? R>,
  onFailure: once fn(Row<!E>) -> Effect<A ! F ? S>
) -> A ! F ? R | S {
  return run catchAll(move self, move onFailure)
}

/// Runs a finalizer after the Effect completes, whatever its outcome, and preserves that outcome.
///
/// The protected Effect is reified into Result data before the finalizer runs, which is what fixes
/// the order: a typed failure reaches this body as data rather than as a propagation, so the
/// protected Effect's own frame — and every local it cleans up — is already gone by the time the
/// finalizer starts. The finalizer therefore exits last, in reverse acquisition order against the
/// cleanup it wraps. The original success value or the original typed failure is only handed on
/// afterwards, so a recovering caller never observes the outcome before the finalizer has run.
///
/// The finalizer is typed `! never`: it cannot fail, so there is no second outcome to reconcile
/// with the one being preserved. A caller with fallible cleanup recovers it into `! never` first
/// — for example with `Effect.catch` — and decides there what a failed release means.
///
/// A trap is not an outcome. It bypasses the finalizer exactly as it bypasses `Effect.catch` and
/// every Drop hook.
pub effect fn ensuring<A, !E, ?R, ?S>(
  self: once Effect<A ! E ? R>,
  finalizer: once Effect<() ! never ? S>
) -> A ! E ? R | S {
  let completed = run result(move self)
  let finalized = run move finalizer
  return match move completed {
    Result<A, Row<!E>> { value: outcome } => match move outcome {
      Success<A> { value: success } => move success
      Failure<Row<!E>> { error } => run raise(move error)
    }
  }
}

/// Runs exactly one of two suspended branches, selected by a condition.
///
/// The arms are suspended rather than pre-built: each is a `once fn()` that produces its branch's
/// Effect, and only the selected arm is invoked. The branch not taken is therefore never
/// constructed, which is a stronger guarantee than merely not being run — construction-time work
/// inside an arm never happens, and an arm whose body is only well-defined under the condition is
/// safe to write. Two pre-built `Effect` arguments would instead be evaluated at the call site,
/// before either was chosen.
///
/// The unselected arm is released here with an explicit `drop move`, so the affine obligation for
/// the arm that is never invoked is discharged in this source rather than left to a generated
/// release.
///
/// The result's failure and requirement rows are the union of the two arms', so the caller
/// discharges whatever either branch could need without knowing which one will be selected. Both
/// arms must agree on the success type.
///
/// The name is `ifThenElse` rather than `if` because `if` is a keyword and Silk has no
/// raw-identifier form, so the declaration itself could not be spelled `if`.
pub effect fn ifThenElse<A, !E, !F, ?R, ?S>(
  condition: bool,
  onTrue: once fn() -> Effect<A ! E ? R>,
  onFalse: once fn() -> Effect<A ! F ? S>
) -> A ! E | F ? R | S {
  if condition {
    drop move onFalse
    return run onTrue()
  }
  drop move onTrue
  return run onFalse()
}

effect fn retryFailure<A, !E, ?R>(
  self: mut Effect<A ! E ? R>,
  error: Row<!E>,
  retries: usize
) -> A ! E ? R {
  if retries == 0 {
    return run raise(move error)
  }
  return run retryLoop(self, retries - 1)
}

effect fn retryLoop<A, !E, ?R>(
  self: mut Effect<A ! E ? R>,
  retries: usize
) -> A ! E ? R {
  let completed = run result(self)
  return match move completed {
    Result<A, Row<!E>> { value: outcome } => match move outcome {
      Success<A> { value: success } => move success
      Failure<Row<!E>> { error } => run retryFailure(self, move error, retries)
    }
  }
}

/// Repeats a reusable Effect after typed failure up to the requested count.
pub effect fn retry<A, !E, ?R>(
  self: mut Effect<A ! E ? R>,
  retries: usize
) -> A ! E ? R {
  return run retryLoop(self, retries)
}

/// Satisfies one typed service requirement with an existing provider.
pub effect fn bindRequirement<A, C, P, !E, ?R>(
  self: once Effect<A ! E ? &C | R>,
  provider: &P
) -> A ! E ? R {
  let bound = Intrinsic.bindRequirement(move self, provider)
  return run bound
}

/// Satisfies one typed service requirement with an existing provider.
pub effect fn provide<A, C, P, !E, ?R>(
  self: once Effect<A ! E ? &C | R>,
  provider: &P
) -> A ! E ? R {
  return run bindRequirement(move self, provider)
}

/// Satisfies one typed service requirement with an existing exclusive provider.
pub effect fn provideMut<A, C, P, !E, ?R>(
  self: once Effect<A ! E ? &mut C | R>,
  provider: &mut P
) -> A ! E ? R {
  let bound = Intrinsic.bindRequirement(move self, provider)
  return run bound
}

effect fn acquireProvider<A, C, !E, !F, ?R, ?S>(
  self: once Effect<A ! E ? &mut C | R>,
  acquire: Effect<C ! F ? S>
) -> Result<A, Row<!E>> ! F ? R | S {
  let mut provider = run acquire
  let bound = Intrinsic.bindRequirement(result(move self), &mut provider)
  return run bound
}

/// Acquires and lexically provides one typed service requirement.
///
/// The acquisition runs inside this body, so every execution acquires its own provider and a
/// retried attempt never reuses an earlier one. The provider is released when `acquireProvider`
/// returns, which is why the provided Effect is reified into Result data before it is bound: a
/// typed failure then reaches this body as data rather than as a propagation that would leave
/// the frame — and the acquired provider — behind. The failure is re-raised only after the
/// provider is gone, so a recovering caller never observes it.
pub effect fn provideWith<A, C, !E, !F, ?R, ?S>(
  self: once Effect<A ! E ? &mut C | R>,
  acquire: Effect<C ! F ? S>
) -> A ! E | F ? R | S {
  let completed = run acquireProvider(move self, acquire)
  return match move completed {
    Result<A, Row<!E>> { value: outcome } => match move outcome {
      Success<A> { value: success } => move success
      Failure<Row<!E>> { error } => run raise(move error)
    }
  }
}
