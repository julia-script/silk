pub fn divide(left: f32, right: f32) -> f32 {
  return Intrinsic.f32Divide(left, right)
}

/// Calls the concrete f32 remainder primitive.
pub fn remainder(left: f32, right: f32) -> f32 {
  return Intrinsic.f32Remainder(left, right)
}

/// Calls the concrete f32 equals primitive.
pub fn equals(left: f32, right: f32) -> bool {
