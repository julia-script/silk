//! Owned arbitrary bytes for file contents, process output, and other encoding-neutral data.
//!
//! # When to use
//! Use [`Bytes`] when every octet must round-trip unchanged. Use `silk.string.String` instead when
//! the value is known to be valid UTF-8 and callers need text operations.
//!
//! # Details
//! [`make`] creates an empty value without allocating, while [`zeroed`], [`copy`], and [`append`]
//! may require an [`Allocator`]. Shared and exclusive views borrow only the initialized prefix;
//! later appends can reallocate, so do not retain a view across a mutation.

import silk.core { Allocator }
import silk.core { OutOfMemoryError }
import silk.u8 as u8
import silk.usize as usize
import silk.vector {
  Vector,
  make as vectorMake,
  append as vectorAppend,
  appendBytes as vectorAppendBytes,
  length as vectorLength,
  asSlice as vectorAsSlice,
  asMutSlice as vectorAsMutSlice
}

/// An owned encoding-neutral sequence of arbitrary octets.
pub struct Bytes {
  values: Vector<u8>
}

/// Constructs empty Bytes without allocating.
pub fn make() -> Bytes {
  return Bytes { values: vectorMake<u8>() }
}

/// Allocates an owned initialized byte buffer of exactly `length` zero octets.
pub effect fn zeroed(length: usize) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut result = make()
  let mut index = usize.ZERO
  while index < length {
    let appended = run vectorAppend<u8>(&mut result.values, u8.toU8(0))
    index = index + usize.ONE
  }
  return move result
}

/// Returns the initialized byte count.
pub fn length(self: &Bytes) -> usize {
  return vectorLength<u8>(&self.values)
}

/// Copies one borrowed byte sequence into independently owned storage.
pub effect fn copy(values: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut result = make()
  let appended = run append(&mut result, values)
  return move result
}

/// Appends one complete borrowed byte sequence in source order with one bulk copy.
pub effect fn append(self: &mut Bytes, values: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  let appended = run vectorAppendBytes(&mut self.values, values)
  return ()
}

/// Borrows the initialized octets as one shared lexical slice.
pub fn asSlice(self: &Bytes) -> &[u8] {
  return vectorAsSlice<u8>(&self.values)
}

/// Borrows the initialized octets as one exclusive lexical slice.
pub fn asMutSlice(self: &mut Bytes) -> &mut [u8] {
  return vectorAsMutSlice<u8>(&mut self.values)
}
