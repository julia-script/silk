// A growable owned sequence over the allocation substrate. Ordinary Silk: no compiler phase
// knows this type, and every capability it uses is available to user code.
//
// The storage union keeps the empty vector allocation-free; Intrinsic.replace moves it out and back
// through &mut self without a partial move, and the Drop hook destroys exactly the
// initialized elements before the backing buffer releases.

pub struct Empty<T> {
  anchor: [T; 0]
}

pub struct Full<T> {
  buffer: RawBuffer<T>
}

pub struct Vector<T> {
  storage: Empty<T> | Full<T>
  length: usize
  capacity: usize
}

// A usize-typed literal anchor: parameters drive literal typing, so bare counts stay explicit.
fn counted(value: usize) -> usize {
  return value
}

// Diverges on the arms the surrounding logic has already proven impossible.
fn absurd<T>() -> T {
  let boom = 1 / 0
  return absurd<T>()
}

pub fn make<T>() -> Vector<T> {
  return Vector<T> { storage: Empty<T> { anchor: [] }, length: counted(0), capacity: counted(0) }
}

pub fn length<T>(self: &Vector<T>) -> usize {
  return self.length
}

pub fn capacity<T>(self: &Vector<T>) -> usize {
  return self.capacity
}

fn emptySlice<T>(anchor: &[T]) -> &[T] {
  return anchor
}

fn emptyMutSlice<T>(anchor: &mut [T]) -> &mut [T] {
  return anchor
}

/// Borrows the initialized elements as one shared lexical slice.
pub fn asSlice<T>(self: &Vector<T>) -> &[T] {
  return match &self.storage {
    Empty<T> { anchor } => emptySlice<T>(&anchor)
    Full<T> { buffer } => RawBuffer.view<T>(&buffer, counted(0), self.length)
  }
}

/// Borrows the initialized elements as one exclusive lexical slice.
pub fn asMutSlice<T>(self: &mut Vector<T>) -> &mut [T] {
  return match &mut self.storage {
    Empty<T> { anchor } => emptyMutSlice<T>(&mut anchor)
    Full<T> { buffer } => RawBuffer.viewMut<T>(&mut buffer, counted(0), self.length)
  }
}

impl<T> Drop for Vector<T> {
  fn drop(self: &mut Vector<T>) -> () {
    let storage = Intrinsic.replace(self.storage, Empty<T> { anchor: [] })
    let count = Intrinsic.replace(self.length, counted(0))
    return match move storage {
      Empty<T> nothing => ()
      Full<T> full => releaseFull<T>(move full, count)
    }
  }
}

fn releaseFull<T>(full: Full<T>, length: usize) -> () {
  return match move full {
    Full<T> { buffer } => releaseBuffer<T>(move buffer, length)
  }
}

fn releaseBuffer<T>(buffer: RawBuffer<T>, length: usize) -> () {
  unsafe {
    let mut owned = move buffer
    let mut index = counted(0)
    while index < length {
      let selected = RawBuffer.slot(&mut owned, index)
      let cleared = Slot.dropValue(move selected)
      index = index + counted(1)
    }
    drop owned
  }
  return ()
}

// Growth is atomic: the replacement buffer exists and holds every element before the vector's
// storage commits, so a failed allocation leaves the original untouched.
pub effect fn append<T>(self: &mut Vector<T>, value: T) -> () ! OutOfMemory ? &mut Allocator {
  if self.length == self.capacity {
    let mut next = self.capacity + self.capacity
    if self.capacity == counted(0) {
      next = counted(4)
    }
    let element = Layout.of<T>()
    let plan = Layout.repeat(move element, next)
    let layout = match move plan {
      Layout ready => ready
      LayoutOverflow overflow => run overflowed()
    }
    let recipe = Allocator.allocate(move layout)
    let allocation = run recipe
    let storage = Intrinsic.replace(self.storage, Empty<T> { anchor: [] })
    let moved = match move storage {
      Empty<T> nothing => Full<T> { buffer: freshBuffer<T>(move allocation, next) }
      Full<T> full => Full<T> { buffer: migrate<T>(move full, move allocation, self.length, next) }
    }
    self.storage = move moved
    self.capacity = next
  }
  let storage = Intrinsic.replace(self.storage, Empty<T> { anchor: [] })
  let stored = match move storage {
    Empty<T> nothing => absurd<Full<T>>()
    Full<T> full => writeAt<T>(move full, self.length, move value)
  }
  self.storage = move stored
  self.length = self.length + counted(1)
  return ()
}

/// Inserts one owned value at an index, shifting later elements without requiring T to be Copy.
pub effect fn insert<T>(
  self: &mut Vector<T>,
  index: usize,
  value: T
) -> () ! OutOfMemory ? &mut Allocator {
  if self.length == self.capacity {
    let mut next = self.capacity + self.capacity
    if self.capacity == counted(0) {
      next = counted(4)
    }
    let element = Layout.of<T>()
    let plan = Layout.repeat(move element, next)
    let layout = match move plan {
      Layout ready => ready
      LayoutOverflow overflow => run overflowed()
    }
    let recipe = Allocator.allocate(move layout)
    let allocation = run recipe
    let storage = Intrinsic.replace(self.storage, Empty<T> { anchor: [] })
    let moved = match move storage {
      Empty<T> nothing => Full<T> { buffer: freshBuffer<T>(move allocation, next) }
      Full<T> full => Full<T> { buffer: migrate<T>(move full, move allocation, self.length, next) }
    }
    self.storage = move moved
    self.capacity = next
  }
  let storage = Intrinsic.replace(self.storage, Empty<T> { anchor: [] })
  let stored = match move storage {
    Empty<T> nothing => absurd<Full<T>>()
    Full<T> full => insertInto<T>(move full, index, self.length, move value)
  }
  self.storage = move stored
  self.length = self.length + counted(1)
  return ()
}

fn insertInto<T>(full: Full<T>, index: usize, length: usize, value: T) -> Full<T> {
  return match move full {
    Full<T> { buffer } => Full<T> { buffer: insertBuffer<T>(move buffer, index, length, move value) }
  }
}

fn insertBuffer<T>(buffer: RawBuffer<T>, index: usize, length: usize, value: T) -> RawBuffer<T> {
  unsafe {
    let mut owned = move buffer
    let mut cursor = length
    while index < cursor {
      let source = RawBuffer.slot(&mut owned, cursor - counted(1))
      let shifted = Slot.take(move source)
      let target = RawBuffer.slot(&mut owned, cursor)
      let written = Slot.write(move target, move shifted)
      cursor = cursor - counted(1)
    }
    let selected = RawBuffer.slot(&mut owned, index)
    let written = Slot.write(move selected, move value)
    return move owned
  }
  return absurd<RawBuffer<T>>()
}

effect fn overflowed() -> Layout ! OutOfMemory {
  return run AllocationFailure.outOfMemory()
}

fn freshBuffer<T>(allocation: Allocation, count: usize) -> RawBuffer<T> {
  unsafe {
    let made = RawBuffer.from<T>(move allocation, count)
    return move made
  }
  return absurd<RawBuffer<T>>()
}

fn migrate<T>(full: Full<T>, allocation: Allocation, length: usize, count: usize) -> RawBuffer<T> {
  return match move full {
    Full<T> { buffer } => migrateBuffer<T>(move buffer, move allocation, length, count)
  }
}

fn migrateBuffer<T>(old: RawBuffer<T>, allocation: Allocation, length: usize, count: usize) -> RawBuffer<T> {
  let mut target = freshBuffer<T>(move allocation, count)
  unsafe {
    let mut source = move old
    let mut index = counted(0)
    while index < length {
      let sourceSlot = RawBuffer.slot(&mut source, index)
      let element = Slot.take(move sourceSlot)
      let targetSlot = RawBuffer.slot(&mut target, index)
      let written = Slot.write(move targetSlot, move element)
      index = index + counted(1)
    }
    drop source
  }
  return move target
}

fn writeAt<T>(full: Full<T>, index: usize, value: T) -> Full<T> {
  return match move full {
    Full<T> { buffer } => Full<T> { buffer: writeSlot<T>(move buffer, index, move value) }
  }
}

fn writeSlot<T>(buffer: RawBuffer<T>, index: usize, value: T) -> RawBuffer<T> {
  unsafe {
    let mut owned = move buffer
    let selected = RawBuffer.slot(&mut owned, index)
    let written = Slot.write(move selected, move value)
    return move owned
  }
  return absurd<RawBuffer<T>>()
}

struct Read<T> {
  value: T
}

// Checked read for Copy element types: out-of-range access traps identically on every engine.
pub fn get<T>(self: &Vector<T>, index: usize) -> T {
  if self.length <= index {
    let boom = 1 / 0
  }
  let read = match &self.storage {
    Empty<T> nothing => absurd<Read<T>>()
    Full<T> { buffer } => Read<T> { value: readAt<T>(&buffer, index) }
  }
  return match move read {
    Read<T> { value } => move value
  }
}

fn readAt<T>(buffer: &RawBuffer<T>, index: usize) -> T {
  unsafe {
    return RawBuffer.read<T>(buffer, index)
  }
  return absurd<T>()
}
