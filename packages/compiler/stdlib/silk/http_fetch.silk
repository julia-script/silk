/// Whether connection acquisition may use the compatible pool retained by the client context.
pub enum PoolMode {
  /// Uses a compatible context pool when present and otherwise opens a fresh connection.
  UseContextPool,
  /// Always opens a fresh connection and never checks out or publishes through a pool.
  Fresh,
}

/// Whether acquisition uses configured routing or bypasses it for this operation.
pub enum ProxyMode {
  /// Recomputes only the explicit client-context proxy policy for every redirect origin.
  InheritContext,
  /// Uses direct routing without environment lookup.
  Direct,
}

/// The one-shot operation phase associated with bounded fetch-owned context.
pub enum FetchPhase {
  /// Semantic URI admission or copying.
  Uri,
  /// Per-origin route selection.
  Route,
  /// Pool checkout, resolution, connection, or TLS acquisition.
  Connect,
  /// Request preparation or upload.
  Request,
  /// Redirect policy and intermediate-response handling.
  Redirect,
  /// Final response-head selection or copying.
  Head,
  /// Content selection, decoding, framing, or trailer validation.
  Decode,
  /// Sink, collection, or discard delivery.
  Destination,
  /// Explicit response completion and reuse decision.
  Finish,
}

/// The independent finite fetch resource that rejected a value.
pub enum FetchLimit {
  /// Deframed representation input accepted by the content layer.
  EncodedBodyBytes,
  /// Representation bytes successfully accepted by the destination.
  DeliveredBodyBytes,
  /// URI, head, and trailer payload plus owned index storage.
  OwnedMetadataBytes,
  /// The positive scratch buffer used for response delivery.
  BufferedBytes,
  /// Bytes retained by a collection destination.
  CollectionBytes,
  /// Bytes validated by a discard destination.
  DiscardBytes,
}

/// An owned isomorphic form of a content failure whose unsupported token cannot borrow the head.
pub union FetchContentReason {
  /// A content configuration or byte count exceeds its admitted range.
  InvalidLimit { pub limit: ContentLimitKind, pub allowed: u64, pub attempted: u64 },
  /// A Content-Encoding element is empty or malformed.
  CodingSyntax { pub position: CodingPosition },
  /// A valid coding name has no selected decoder; the exact token is independently owned.
  UnsupportedCoding { pub position: CodingPosition, pub token: Bytes },
  /// A partial response selected a nonidentity decoder.
  PartialResponse { pub position: CodingPosition },
  /// The response body is a protocol tunnel rather than a representation.
  Tunnel,
  /// HTTP framing rejected the response body.
  Body { pub error: BodyError },
  /// Buffered input or its transport failed.
  Buffer { pub error: BufferError },
  /// Gzip or zlib decoding failed.
  Inflate { pub stage: usize, pub wireIndex: usize, pub error: DecodeError },
  /// Zstandard decoding failed.
  Zstandard { pub stage: usize, pub wireIndex: usize, pub error: ZstdError },
  /// A finished coding stream had additional encoded bytes.
  TrailingEncodedData { pub stage: usize, pub wireIndex: usize },
  /// Checked content accounting overflowed.
  ArithmeticOverflow,
  /// The content reader was already failed or abandoned.
  InvalidState,
}

/// Exact owned content-failure coordinates safe to return after the response head is released.
pub struct FetchContentError {
  /// The owned failure category and original lower-level cause.
  pub reason: FetchContentReason
  /// Bytes written into the current provisional output chunk.
  pub written: usize
  /// Cumulative deframed encoded bytes accepted.
  pub totalEncoded: u64
  /// Cumulative nonfinal decoder-stage output.
  pub totalIntermediate: u64
  /// Cumulative selected-representation output.
  pub totalDecoded: u64
}

/// A fetch-owned admission, limit, or unsupported-response reason.
pub union FetchReason {
  /// One or more finite options are inconsistent or outside their admitted domain.
  InvalidOptions,
  /// The supplied HTTP connection limits failed their owning client's pre-contact admission.
  InvalidHttpOptions { pub error: ClientError },
  /// HTTP value copying failed while Fetch owned the final-head boundary.
  HttpValue { pub error: ValueError },
  /// HTTP body or trailer validation failed after final-response selection.
  HttpBody { pub error: BodyError },
  /// The streaming client failed inside Fetch's final-response delivery boundary.
  HttpClient { pub error: ClientError },
  /// Checked accounting cannot represent the required total.
  SizeOverflow,
  /// A caller-defined sink rejected the current offered chunk.
  DestinationRejected,
  /// Content selection failed; borrowed coding tokens are copied into bounded owned storage.
  Content { pub error: FetchContentError },
  /// One independent finite resource would exceed its inclusive limit.
  LimitExceeded {
    /// The resource whose bound was reached.
    pub limit: FetchLimit,
    /// The inclusive admitted maximum.
    pub allowed: u64,
    /// The rejected cumulative value.
    pub attempted: u64,
  },
  /// The final response would require transferring duplex protocol authority.
  UnsupportedSwitchingResponse {
    /// The final protocol-switching or successful CONNECT status.
    pub status: Status,
  },
}

/// Safe independently owned failure context added by the one-shot boundary.
pub struct FetchError {
  /// The operation phase that rejected the value or observed the failure.
  pub phase: FetchPhase
  /// The stable fetch-owned failure category.
  pub reason: FetchReason
  /// Final status when it is known without retaining the response owner.
  pub status: Option<Status>
  /// Independently copied current URI when bounded context is available.
  pub uri: Option<OwnedUri>
  /// Bytes accepted by the destination before the failing operation.
  pub deliveredBodyBytes: u64
  /// Current chunk length offered to a failing destination, otherwise zero.
  pub offeredBodyBytes: usize
}

/// A typed sink failure paired with only fetch-known delivery progress.
pub struct DestinationFailure<E> {
  /// The original caller-defined sink failure.
  pub error: E
  /// Bounded destination context excluding claims about partial external effects.
  pub context: FetchError
}

/// Representation policy selected from the final wire response.
pub struct RepresentationMetadata {
  /// The exact applied Raw or Decode plan and coding counts.
  pub applied: AppliedPlan
  /// Whether framing and every selected content stage completed successfully.
  pub completed: bool
  /// Final delivered representation bytes, available only after completion.
  pub deliveredBytes: Option<u64>
}

/// Immutable owned header-only metadata lent before each body chunk.
pub struct ResponseMetadata {
  /// The independently owned final URI.
  pub finalUri: OwnedUri
  /// The independently owned final status, reason, and ordered wire headers.
  pub head: OwnedResponseHead
  /// Content-plan provenance separate from unchanged wire headers.
  pub representation: RepresentationMetadata
  /// Counted URI and head payload plus owned index storage.
  pub ownedBytes: usize
}

/// One verified completed response without retained body bytes.
pub struct FetchResult {
  /// Final owned header metadata.
  pub metadata: ResponseMetadata
  /// Final ordered trailers copied only after content completion.
  pub trailers: Option<OwnedTrailers>
  /// Number of redirects followed before this response.
  pub redirectCount: usize
  /// Deframed encoded representation bytes accepted by the content layer.
  pub encodedBodyBytes: u64
  /// Representation bytes successfully accepted by the destination.
  pub deliveredBodyBytes: u64
  /// URI, head, and trailer payload plus owned index storage.
  pub ownedMetadataBytes: usize
}

/// One atomically published bounded in-memory response.
pub struct CollectedResponse {
  /// The verified completed response metadata and counters.
  pub result: FetchResult
  /// The complete selected representation body.
  pub body: Bytes
}

union RequestHeaders<'headers> {
  Empty,
  Borrowed {headers: Headers<'headers>},
}

/// A semantic request whose body authority is supplied by one source-specific operation.
pub struct FetchRequest<'uri, 'method, 'headers, 'policy> {
  uriValue: Uri<'uri>
  methodValue: Method<'method>
  headersValue: RequestHeaders<'headers>
  headerPolicyValue: HeaderPolicy<'policy>
  versionValue: Version
  continuePolicyValue: ContinuePolicy
  limitsValue: HeaderLimits
  maxHeadBytesValue: usize
  maxCredentialBytesValue: usize
}

impl<'uri, 'method, 'headers, 'policy> FetchRequest<'uri, 'method, 'headers, 'policy> {
  /// Constructs a semantic request while preserving its explicit method and ordered headers.
  pub fn make(
    uri: Uri<'uri>,
    method: Method<'method>,
    headers: Headers<'headers>,
    headerPolicy: HeaderPolicy<'policy>,
    version: Version,
    continuePolicy: ContinuePolicy,
    limits: HeaderLimits,
    maxHeadBytes: usize,
    maxCredentialBytes: usize,
  ) -> Self {
    return FetchRequest<'uri, 'method, 'headers, 'policy> {
      uriValue: uri,
      methodValue: method,
      headersValue: RequestHeaders<'headers>.Borrowed {headers: headers},
      headerPolicyValue: headerPolicy,
      versionValue: version,
      continuePolicyValue: move continuePolicy,
      limitsValue: limits,
      maxHeadBytesValue: maxHeadBytes,
      maxCredentialBytesValue: maxCredentialBytes,
    }
  }
}

impl<'uri> FetchRequest<'uri, 'static, 'static, 'static> {
  /// Constructs GET with empty caller headers and the standard request policy and limits.
  pub fn get(uri: Uri<'uri>) -> Self {
    let limits = Client.Limits.defaults().head.values
    return FetchRequest<'uri, 'static, 'static, 'static> {
      uriValue: uri,
      methodValue: Method.get(),
      headersValue: RequestHeaders<'static>.Empty,
      headerPolicyValue: HeaderPolicy<'static>.defaults(),
      versionValue: Version.Http11,
      continuePolicyValue: ContinuePolicy.Disabled,
      limitsValue: limits,
      maxHeadBytesValue: 65536,
      maxCredentialBytesValue: 8192,
    }
  }
}

/// Finite one-shot policies admitted before route selection or transport contact.
pub struct FetchOptions {
  /// Redirect policy, including Manual or Follow behavior and intermediate-response bounds.
  pub redirect: RedirectPolicy
  /// Raw or decoded representation selection.
  pub content: Content.Mode
  /// Compatible context-pool or forced-fresh acquisition.
  pub pool: PoolMode
  /// Explicit client-context routing or forced direct routing.
  pub proxy: ProxyMode
  /// One optional absolute operation deadline, never renewed between phases or hops.
  pub deadline: Option<Instant>
  /// Existing finite HTTP parser, framing, trailer, and transport-buffer limits.
  pub http: Client.Limits
  /// Existing finite content planning and codec limits.
  pub contentLimits: Content.Limits
  /// Additional inclusive encoded representation allowance.
  pub maxEncodedBodyBytes: u64
  /// Inclusive representation bytes accepted by any destination.
  pub maxDeliveredBodyBytes: u64
  /// Inclusive owned URI, head, and trailer payload-plus-index allowance.
  pub maxOwnedMetadataBytes: usize
  /// Positive per-read response delivery scratch capacity.
  pub maxBufferedBytes: usize
}

impl FetchOptions {
  /// Returns Manual, Raw, context-pool, inherited-route policy with finite standard limits.
  pub fn defaults() -> FetchOptions {
    let maxBody = u64.toU64(16777216)
    return FetchOptions {
      redirect: RedirectPolicy.defaults(),
      content: Content.Mode.Raw,
      pool: PoolMode.UseContextPool,
      proxy: ProxyMode.InheritContext,
      deadline: Option.none<Instant>(),
      http: Client.Limits.defaults(),
      contentLimits: Content.Limits {
        maxEncoded: maxBody,
        maxIntermediate: maxBody,
        maxDecoded: maxBody,
        maxOwned: 2097152,
        maxDepth: 4,
        intermediateCapacity: 16384,
        inflate: InflateLimits {
          maxInputBytes: maxBody,
          maxOutputBytes: maxBody,
          maxMembers: 1024,
          maxHeaderBytes: 65536,
          maxMemoryBytes: INFLATE_MEMORY_BOUND,
        },
        zstd: ZstdLimits.make(),
      },
      maxEncodedBodyBytes: maxBody,
      maxDeliveredBodyBytes: maxBody,
      maxOwnedMetadataBytes: 278528,
      maxBufferedBytes: 16384,
    }
  }

  /// Checks local capacities and content configuration without allocation or provider access.
  pub fn validate(self: &Self) -> Result<(), FetchError> {
    if self.maxBufferedBytes == usize.ZERO {
      return Result.failResult<(), FetchError>(fetchFailure(
        FetchPhase.Destination,
        FetchReason.InvalidOptions,
      ))
    }
    if let Result<(), ClientError>.Failure {error} = move Client.validateLimits(&self.http) {
      let phase = match & error {
        ClientError.Head {error: _} => FetchPhase.Head
        _ => FetchPhase.Connect
      }
      return Result.failResult<(), FetchError>(fetchFailure(
        phase,
        FetchReason.InvalidHttpOptions {error: move error},
      ))
    }
    if let Result<(), ContentError<'static>>.Failure {error} = move Content.validateLimits(
      &self.contentLimits,
    ) {
      return Result.failResult<(), FetchError>(contentOptionFailure(move error))
    }
    return Result.succeed<(), FetchError>(())
  }
}

/// An owned target-neutral facade around one explicit acquisition context.
pub struct Fetch<C> {
  client: C
}

impl<C> Fetch<C> {
  /// Seals one caller-supplied client context into a fetch facade.
  pub fn make(client: C) -> Fetch<C> { return Fetch<C> {client: move client} }
}

/// A sequential effectful destination whose metadata and current chunk loans cannot escape.
pub interface Sink<E, ?R> {
  /// Accepts the complete offered chunk under the unchanged operation deadline.
  ///
  /// `deadline` is the original absolute fetch deadline. `None` permits an unbounded wait. The
  /// callback must return before Fetch reads or offers another chunk.
  effect<'call> fn write<'call>(
    sink: &mut Self,
    metadata: &'call ResponseMetadata,
    chunk: &'call [u8],
    deadline: &'call Option<Instant>,
  ) -> () ! E ? R
}

/// Target-neutral routed or pooled acquisition for one current redirect attempt.
///
/// # Details
///
/// Implementations admit options before contact, recompute routes for the current request URI, and
/// lend exactly one scoped exchange. `deadline` is the unchanged operation deadline. `Fresh` never
/// consults a pool, and `Direct` never consults configured or ambient proxy policy.
pub interface FetchClient<
  'policy,
  RoutedP,
  DirectP,
  A,
  HandlerError,
  AcquisitionError,
  ?HandlerRequirements,
  ?AcquisitionRequirements,
> {
  /// Rebuilds and drives one scoped request under the selected acquisition modes.
  effect fn withAttempt(
    client: &mut Self,
    request: AttemptRequest<'policy>,
    httpLimits: Client.Limits,
    poolMode: PoolMode,
    proxyMode: ProxyMode,
    deadline: Option<Instant>,
  ) -> A ! HandlerError | AcquisitionError ? HandlerRequirements | AcquisitionRequirements | &mut HybridAttempt<
    'policy,
    RoutedP,
    DirectP,
    A,
    HandlerError ? HandlerRequirements
  > where
    HandlerRequirements in Without<HandlerRequirements, ByteDuplex>,
    HandlerRequirements in Without<HandlerRequirements, HttpTransport>
}

interface Destination<A, E, ?R> {
  effect<'call> fn accept<'call>(
    destination: &mut Self,
    metadata: &'call ResponseMetadata,
    chunk: &'call [u8],
    deadline: &'call Option<Instant>,
    deliveredBefore: u64,
  ) -> () ! E ? R
  fn publish(destination: Self, result: FetchResult) -> A
}

struct SinkDestination<S> {
  sink: S
}

impl<S, SinkError, ?SinkRequirements, S: Sink<SinkError ? SinkRequirements>> SinkDestination<S> {
  effect<'call> fn accept<'call>(
    self: &mut Self,
    metadata: &'call ResponseMetadata,
    chunk: &'call [u8],
    deadline: &'call Option<Instant>,
    deliveredBefore: u64,
  ) -> () ! DestinationFailure<SinkError> ? SinkRequirements {
    let attempted = run Effect.result(
      Sink<SinkError ? SinkRequirements>.write(&mut self.sink, metadata, chunk, deadline),
    )
    return match move attempted {
      Result.Success {value} => move value
      Result.Failure {error} => {
        let context = metadataFailure(
          FetchPhase.Destination,
          FetchReason.DestinationRejected,
          metadata,
          deliveredBefore,
          chunk.length,
        )
        fail DestinationFailure<SinkError> {
          error: move error,
          context: move context,
        }
      }
    }
  }

  fn publish(self: Self, result: FetchResult) -> FetchResult {
    drop self
    return move result
  }
}

struct FetchAttemptAdapter<'client, C> {
  client: &'client mut C
  httpLimits: Client.Limits
  poolMode: PoolMode
  proxyMode: ProxyMode
}

impl<
  'client,
  'policy,
  C,
  RoutedP,
  DirectP,
  A,
  HandlerError,
  AcquisitionError,
  ?HandlerRequirements,
  ?AcquisitionRequirements,
  C: FetchClient<
    'policy,
    RoutedP,
    DirectP,
    A,
    HandlerError,
    AcquisitionError,
    HandlerRequirements,
    AcquisitionRequirements,
  >,
> FetchAttemptAdapter<'client, C> {
  effect fn withAttempt(
    self: &mut Self,
    request: AttemptRequest<'policy>,
    deadline: Option<Instant>,
  ) -> A ! HandlerError | AcquisitionError ? HandlerRequirements | AcquisitionRequirements | &mut HybridAttempt<
    'policy,
    RoutedP,
    DirectP,
    A,
    HandlerError ? HandlerRequirements
  > where
    HandlerRequirements in Without<HandlerRequirements, ByteDuplex>,
    HandlerRequirements in Without<HandlerRequirements, HttpTransport> {
    return run FetchClient<
      'policy,
      RoutedP,
      DirectP,
      A,
      HandlerError,
      AcquisitionError,
      HandlerRequirements,
      AcquisitionRequirements,
    >.withAttempt(
      &mut self.client.*,
      move request,
      self.httpLimits,
      self.poolMode,
      self.proxyMode,
      move deadline,
    )
  }
}

impl<
  'client,
  'policy,
  C,
  RoutedP,
  DirectP,
  A,
  HandlerError,
  AcquisitionError,
  ?HandlerRequirements,
  ?AcquisitionRequirements,
  C: FetchClient<
    'policy,
    RoutedP,
    DirectP,
    A,
    HandlerError,
    AcquisitionError,
    HandlerRequirements,
    AcquisitionRequirements,
  >,
> HybridAttemptClient<
  'policy,
  RoutedP,
  DirectP,
  A,
  HandlerError,
  AcquisitionError,
  HandlerRequirements,
  AcquisitionRequirements,
> for FetchAttemptAdapter<'client, C> {
  withAttempt: FetchAttemptAdapter.withAttempt
}

impl<S, SinkError, ?SinkRequirements, S: Sink<SinkError ? SinkRequirements>> Destination<
  FetchResult,
  DestinationFailure<SinkError>,
  SinkRequirements,
> for SinkDestination<S> {
  accept: SinkDestination.accept
  publish: SinkDestination.publish
}

struct CollectDestination {
  body: Bytes
  maximum: usize
}

impl CollectDestination {
  effect<'call> fn accept<'call>(
    self: &mut Self,
    metadata: &'call ResponseMetadata,
    chunk: &'call [u8],
    deadline: &'call Option<Instant>,
    deliveredBefore: u64,
  ) -> () ! FetchError | OutOfMemoryError ? &mut Allocator {
    drop deadline
    let attempted = match move usize.checkedAdd(Bytes.length(&self.body), chunk.length) {
      Option.None => {
        fail metadataFailure(
          FetchPhase.Destination,
          FetchReason.SizeOverflow,
          metadata,
          deliveredBefore,
          chunk.length,
        )
      }
      Option.Some {value} => value
    }
    if attempted > self.maximum {
      fail metadataFailure(
        FetchPhase.Destination,
        FetchReason.LimitExceeded {
          limit: FetchLimit.CollectionBytes,
          allowed: usize.toU64(self.maximum),
          attempted: usize.toU64(attempted),
        },
        metadata,
        deliveredBefore,
        chunk.length,
      )
    }
    return run Bytes.append(&mut self.body, chunk)
  }

  fn publish(self: Self, result: FetchResult) -> CollectedResponse {
    return CollectedResponse {result: move result, body: move self.body}
  }
}

impl Destination<CollectedResponse, FetchError | OutOfMemoryError, &mut Allocator> for CollectDestination {
  accept: CollectDestination.accept
  publish: CollectDestination.publish
}

struct DiscardDestination {
  maximum: u64
}

impl DiscardDestination {
  effect<'call> fn accept<'call>(
    self: &mut Self,
    metadata: &'call ResponseMetadata,
    chunk: &'call [u8],
    deadline: &'call Option<Instant>,
    deliveredBefore: u64,
  ) -> () ! FetchError {
    drop deadline
    let attempted = match move u64.checkedAdd(deliveredBefore, usize.toU64(chunk.length)) {
      Option.None => {
        fail metadataFailure(
          FetchPhase.Destination,
          FetchReason.SizeOverflow,
          metadata,
          deliveredBefore,
          chunk.length,
        )
      }
      Option.Some {value} => value
    }
    if attempted > self.maximum {
      fail metadataFailure(
        FetchPhase.Destination,
        FetchReason.LimitExceeded {
          limit: FetchLimit.DiscardBytes,
          allowed: self.maximum,
          attempted: attempted,
        },
        metadata,
        deliveredBefore,
        chunk.length,
      )
    }
    return ()
  }

  fn publish(self: Self, result: FetchResult) -> FetchResult {
    drop self
    return move result
  }
}

impl Destination<FetchResult, FetchError, never> for DiscardDestination {
  accept: DiscardDestination.accept
  publish: DiscardDestination.publish
}

interface SemanticRequestHandler<'policy, A, E, ?R> {
  effect<'call> fn handle<'call>(
    handler: Self,
    request: Redirect.Request<'call, 'call, 'call, 'policy>,
  ) -> A ! E ? R
}

fn redirectRequest<'call, 'policy>(
  uri: Uri<'call>,
  method: Method<'call>,
  headers: Headers<'call>,
  headerPolicy: HeaderPolicy<'policy>,
  version: Version,
  continuePolicy: ContinuePolicy,
  limits: HeaderLimits,
  maxHeadBytes: usize,
  maxCredentialBytes: usize,
) -> Redirect.Request<'call, 'call, 'call, 'policy> {
  return Redirect.Request<'call, 'call, 'call, 'policy> {
    uri: uri,
    method: method,
    headers: headers,
    headerPolicy: headerPolicy,
    version: version,
    continuePolicy: move continuePolicy,
    limits: limits,
    maxHeadBytes: maxHeadBytes,
    maxCredentialBytes: maxCredentialBytes,
  }
}

effect fn withSemanticRequest<
  'uri,
  'method,
  'headers,
  'policy,
  A,
  E,
  ?R,
  H: SemanticRequestHandler<'policy, A, E ? R>,
>(
  request: FetchRequest<'uri, 'method, 'headers, 'policy>,
  handler: H,
) -> A ! E | ValueError ? R {
  let FetchRequest<'uri, 'method, 'headers, 'policy> {
    uriValue,
    methodValue,
    headersValue,
    headerPolicyValue,
    versionValue,
    continuePolicyValue,
    limitsValue,
    maxHeadBytesValue,
    maxCredentialBytesValue,
  } = move request
  return match move headersValue {
    RequestHeaders.Empty => {
      let empty: [Header<'static>; 0] = []
      let headers = match move Headers.make(&empty, limitsValue) {
        Result.Failure {error} => {
          fail move error
        }
        Result.Success {value} => value
      }
      let selected = redirectRequest(
        uriValue,
        methodValue,
        headers,
        headerPolicyValue,
        versionValue,
        copyContinuePolicy(&continuePolicyValue),
        limitsValue,
        maxHeadBytesValue,
        maxCredentialBytesValue,
      )
      run SemanticRequestHandler<'policy, A, E ? R>.handle(move handler, move selected)
    }
    RequestHeaders.Borrowed {headers} => {
      let selected = redirectRequest(
        uriValue,
        methodValue,
        headers,
        headerPolicyValue,
        versionValue,
        move continuePolicyValue,
        limitsValue,
        maxHeadBytesValue,
        maxCredentialBytesValue,
      )
      run SemanticRequestHandler<'policy, A, E ? R>.handle(move handler, move selected)
    }
  }
}

struct HeaderMetadata {
  uri: OwnedUri
  head: OwnedResponseHead
  ownedBytes: usize
}

fn checkedMetadataAdd(phase: FetchPhase, left: usize, right: usize) -> usize ! FetchError {
  return match move usize.checkedAdd(left, right) {
    Option.None => {
      fail fetchFailure(phase, FetchReason.SizeOverflow)
    }
    Option.Some {value} => value
  }
}

effect fn copyHeaderMetadata<'uri, 'head>(
  uri: &Uri<'uri>,
  head: &ResponseHead<'head>,
  limits: HeaderLimits,
  maximum: usize,
) -> HeaderMetadata ! FetchError | ValueError | OutOfMemoryError ? &mut Allocator {
  let uriBytes = String.byteLength(Uri.format(uri))
  let fields = head.headers()
  let headerBytes = match move Headers.requiredOwnedBytes(&fields) {
    Result.Failure {error} => {
      fail move error
    }
    Result.Success {value} => value
  }
  let reasonBytes = match move head.reason() {
    Option.None => usize.ZERO
    Option.Some {value} => value.length
  }
  let withHeaders = checkedMetadataAdd(FetchPhase.Head, uriBytes, headerBytes)
  let total = checkedMetadataAdd(FetchPhase.Head, withHeaders, reasonBytes)
  if total > maximum {
    fail limitFailure(
      FetchPhase.Head,
      FetchLimit.OwnedMetadataBytes,
      usize.toU64(maximum),
      usize.toU64(total),
      u64.MIN,
      usize.ZERO,
    )
  }
  let mut headLimits = limits
  headLimits.maxOwnedBytes = maximum - uriBytes
  let copiedHead = match move run head.copy(headLimits) {
    Result.Failure {error} => {
      fail move error
    }
    Result.Success {value} => move value
  }
  let copiedUri = run Uri.copy(uri)
  return HeaderMetadata {uri: move copiedUri, head: move copiedHead, ownedBytes: total}
}

effect fn copyFinalTrailers<'trailers>(
  trailers: Option<Trailers<'trailers>>,
  limits: HeaderLimits,
  metadataUsed: usize,
  metadataMaximum: usize,
) -> Option<OwnedTrailers> ! FetchError | BodyError | OutOfMemoryError ? &mut Allocator {
  return match move trailers {
    Option.None => Option.none<OwnedTrailers>()
    Option.Some {value} => {
      let required = match move Trailers.requiredOwnedBytes(&value) {
        Result.Failure {error} => {
          fail move error
        }
        Result.Success {value: bytes} => bytes
      }
      let total = checkedMetadataAdd(FetchPhase.Decode, metadataUsed, required)
      if total > metadataMaximum {
        fail limitFailure(
          FetchPhase.Decode,
          FetchLimit.OwnedMetadataBytes,
          usize.toU64(metadataMaximum),
          usize.toU64(total),
          u64.MIN,
          usize.ZERO,
        )
      }
      let mut trailerLimits = limits
      trailerLimits.maxOwnedBytes = metadataMaximum - metadataUsed
      let copied = match move run Trailers.copy(&value, trailerLimits) {
        Result.Failure {error} => {
          fail move error
        }
        Result.Success {value: owned} => move owned
      }
      Option.some<OwnedTrailers>(move copied)
    }
  }
}

struct DeliveryResponseHandler<D> {
  destination: Option<D>
  content: Content.Mode
  contentLimits: Content.Limits
  responseValueLimits: HeaderLimits
  maxEncodedBodyBytes: u64
  maxDeliveredBodyBytes: u64
  maxOwnedMetadataBytes: usize
  maxBufferedBytes: usize
  deadline: Option<Instant>
}

effect fn deliverResponse<
  'call,
  'exchangeView: 'call,
  P,
  A,
  DestinationError,
  ?DestinationRequirements,
  D: Destination<A, DestinationError ? DestinationRequirements>,
>(
  handler: &mut DeliveryResponseHandler<D>,
  uri: Uri<'call>,
  hop: usize,
  exchange: &'call mut Exchange<'exchangeView, P>,
) -> A
! FetchError | ValueError | BodyError | DestinationError | ClientError | OutOfMemoryError
? DestinationRequirements | &mut Allocator | &mut MonotonicClock | &mut Random
where
  &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut P provides &HttpTransport from &mut HttpTransport {
    let stored = Intrinsic.replace(handler.destination, Option.none<D>())
    let destination = match move stored {
      Option.Some {value} => move value
      Option.None => unavailable<D>()
    }
    let content = handler.content
    let contentLimits = handler.contentLimits
    let responseValueLimits = handler.responseValueLimits
    let maxEncodedBodyBytes = handler.maxEncodedBodyBytes
    let maxDeliveredBodyBytes = handler.maxDeliveredBodyBytes
    let maxOwnedMetadataBytes = handler.maxOwnedMetadataBytes
    let maxBufferedBytes = handler.maxBufferedBytes
    let deadline = copyDeadline(&handler.deadline)
    let mut selectedDestination = move destination
    let head = match move run Effect.result(exchange.head()) {
      Result.Success {value} => value
      Result.Failure {error} => {
        fail fetchFailure(FetchPhase.Head, FetchReason.HttpClient {error: move error})
      }
    }
    let status = head.status()
    if exchange.phase() == Client.ExchangePhase.Tunnel {
      fail run borrowedResponseFailure(
        FetchPhase.Head,
        FetchReason.UnsupportedSwitchingResponse {status: status},
        Option.some<Status>(status),
        &uri,
        u64.MIN,
        usize.ZERO,
      )
    }
    let copied = match move run Effect.result(copyHeaderMetadata(
      &uri,
      &head,
      responseValueLimits,
      maxOwnedMetadataBytes,
    )) {
      Result.Success {value} => value
      Result.Failure {error} => match move error {
        FetchError cause => {
          fail enrichResponseStatus(move cause, status)
        }
        ValueError cause => {
          let contextual = fetchFailure(
            FetchPhase.Head,
            FetchReason.HttpValue {error: move cause},
          )
          fail enrichResponseStatus(move contextual, status)
        }
        OutOfMemoryError cause => { fail move cause }
      }
    }
    drop head
    let mut selectedContentLimits = move contentLimits
    if maxEncodedBodyBytes < selectedContentLimits.maxEncoded {
      selectedContentLimits.maxEncoded = maxEncodedBodyBytes
    }
    let selected = run Effect.result(
      Client.beginContent(exchange, content, move selectedContentLimits),
    )
    let applied = match move selected {
      Result.Success {value} => value
      Result.Failure {error} => match move error {
        ClientError cause => {
          fail ownedResponseFailure(
            FetchPhase.Decode,
            FetchReason.HttpClient {error: move cause},
            Option.some<Status>(status),
            move copied.uri,
            u64.MIN,
            usize.ZERO,
          )
        }
        OutOfMemoryError cause => {
          fail move cause
        }
        ContentError cause => {
          let owned = match move run Effect.result(ownContentError(
            move cause,
            copied.ownedBytes,
            maxOwnedMetadataBytes,
          )) {
            Result.Success {value} => value
            Result.Failure {error} => match move error {
              FetchError nested => {
                fail enrichResponseFailure(
                  move nested,
                  status,
                  move copied.uri,
                  u64.MIN,
                  usize.ZERO,
                )
              }
              OutOfMemoryError nested => { fail move nested }
            }
          }
          fail ownedResponseFailure(
            FetchPhase.Decode,
            FetchReason.Content {error: move owned},
            Option.some<Status>(status),
            move copied.uri,
            u64.MIN,
            usize.ZERO,
          )
        }
      }
    }
    let metadata = ResponseMetadata {
      finalUri: move copied.uri,
      head: move copied.head,
      representation: RepresentationMetadata {
        applied: applied,
        completed: false,
        deliveredBytes: Option.none<u64>(),
      },
      ownedBytes: copied.ownedBytes,
    }
    let mut buffer = run Bytes.zeroed(maxBufferedBytes)
    let mut delivered = u64.MIN
    let mut encoded = u64.MIN
    while true {
      let output = Bytes.asMutSlice(&mut buffer)
      let progress = match move run Effect.result(Client.readContentSome(exchange, move output)) {
        Result.Success {value} => value
        Result.Failure {error} => match move error {
          ClientError cause => {
            fail ownedMetadataFailure(
              FetchPhase.Decode,
              FetchReason.HttpClient {error: move cause},
              move metadata,
              delivered,
              usize.ZERO,
            )
          }
          OutOfMemoryError cause => { fail move cause }
        }
      }
      encoded = progress.totalEncoded
      if encoded > maxEncodedBodyBytes {
        fail ownedMetadataFailure(
          FetchPhase.Decode,
          FetchReason.LimitExceeded {
            limit: FetchLimit.EncodedBodyBytes,
            allowed: maxEncodedBodyBytes,
            attempted: encoded,
          },
          move metadata,
          delivered,
          progress.written,
        )
      }
      if progress.written > usize.ZERO {
        let attempted = match move u64.checkedAdd(delivered, usize.toU64(progress.written)) {
          Option.None => {
            fail ownedMetadataFailure(
              FetchPhase.Destination,
              FetchReason.SizeOverflow,
              move metadata,
              delivered,
              progress.written,
            )
          }
          Option.Some {value} => value
        }
        if attempted > maxDeliveredBodyBytes {
          fail ownedMetadataFailure(
            FetchPhase.Destination,
            FetchReason.LimitExceeded {
              limit: FetchLimit.DeliveredBodyBytes,
              allowed: maxDeliveredBodyBytes,
              attempted: attempted,
            },
            move metadata,
            delivered,
            progress.written,
          )
        }
        let chunk = Slice.view<u8>(Bytes.asSlice(&buffer), usize.ZERO, progress.written)
        run Destination<A, DestinationError ? DestinationRequirements>.accept(
          &mut selectedDestination,
          &metadata,
          chunk,
          &deadline,
          delivered,
        )
        delivered = attempted
      }
      if progress.state == ContentProgressState.End { break }
    }
    let trailerView = match move run Effect.result(Client.trailers(exchange)) {
      Result.Success {value} => value
      Result.Failure {error} => {
        fail ownedMetadataFailure(
          FetchPhase.Decode,
          FetchReason.HttpClient {error: move error},
          move metadata,
          delivered,
          usize.ZERO,
        )
      }
    }
    let trailers = match move run Effect.result(copyFinalTrailers(
      move trailerView,
      responseValueLimits,
      metadata.ownedBytes,
      maxOwnedMetadataBytes,
    )) {
      Result.Success {value} => value
      Result.Failure {error} => match move error {
        FetchError cause => {
          fail enrichMetadataFailure(move cause, move metadata, delivered, usize.ZERO)
        }
        BodyError cause => {
          fail ownedMetadataFailure(
            FetchPhase.Decode,
            FetchReason.HttpBody {error: move cause},
            move metadata,
            delivered,
            usize.ZERO,
          )
        }
        OutOfMemoryError cause => { fail move cause }
      }
    }
    let trailerBytes = match & trailers {
      Option.None => usize.ZERO
      Option.Some {value} => OwnedTrailers.ownedBytes(&value)
    }
    let totalMetadata = match move run Effect.result(checkedMetadataAdd(
      FetchPhase.Decode,
      metadata.ownedBytes,
      trailerBytes,
    )) {
      Result.Success {value} => value
      Result.Failure {error} => {
        fail enrichMetadataFailure(move error, move metadata, delivered, usize.ZERO)
      }
    }
    match move run Effect.result(Client.finishResponse(exchange)) {
      Result.Success {value} => { drop value }
      Result.Failure {error} => {
        fail ownedMetadataFailure(
          FetchPhase.Finish,
          FetchReason.HttpClient {error: move error},
          move metadata,
          delivered,
          usize.ZERO,
        )
      }
    }
    let result = FetchResult {
      metadata: ResponseMetadata {
        finalUri: move metadata.finalUri,
        head: move metadata.head,
        representation: RepresentationMetadata {
          applied: applied,
          completed: true,
          deliveredBytes: Option.some<u64>(delivered),
        },
        ownedBytes: metadata.ownedBytes,
      },
      trailers: move trailers,
      redirectCount: hop,
      encodedBodyBytes: encoded,
      deliveredBodyBytes: delivered,
      ownedMetadataBytes: totalMetadata,
    }
  return Destination<A, DestinationError ? DestinationRequirements>.publish(
    move selectedDestination,
    move result,
  )
}

impl<
  RoutedP,
  DirectP,
  A,
  DestinationError,
  ?DestinationRequirements,
  D: Destination<A, DestinationError ? DestinationRequirements>,
> DeliveryResponseHandler<D> {
  effect<'call> fn handleRouted<
    'call,
    'exchangeView: 'call,
    'transport: 'exchangeView,
    'provider: 'transport,
    'tunnel: 'provider,
  >(
    handler: &mut Self,
    uri: Uri<'call>,
    hop: usize,
    exchange: &'call mut Exchange<
      'exchangeView,
      RouteTransport<'transport, 'provider, 'tunnel, RoutedP>
    >,
  ) -> A
  ! FetchError | ValueError | BodyError | DestinationError | ClientError | OutOfMemoryError
  ? DestinationRequirements | &mut Allocator | &mut MonotonicClock | &mut Random
  where
    &mut RoutedP provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut RoutedP provides &HttpTransport from &mut HttpTransport,
    &mut RoutedP provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut RoutedP provides &ByteDuplex from &mut ByteDuplex {
    return run deliverResponse(handler, uri, hop, exchange)
  }

  effect<'call> fn handleDirect<'call, 'exchangeView: 'call>(
    handler: &mut Self,
    uri: Uri<'call>,
    hop: usize,
    exchange: &'call mut Exchange<'exchangeView, DirectP>,
  ) -> A
  ! FetchError | ValueError | BodyError | DestinationError | ClientError | OutOfMemoryError
  ? DestinationRequirements | &mut Allocator | &mut MonotonicClock | &mut Random
  where
    &mut DirectP provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut DirectP provides &HttpTransport from &mut HttpTransport {
    return run deliverResponse(handler, uri, hop, exchange)
  }
}

impl<
  RoutedP,
  DirectP,
  A,
  DestinationError,
  ?DestinationRequirements,
  D: Destination<A, DestinationError ? DestinationRequirements>,
> HybridResponseHandler<
  RoutedP,
  DirectP,
  A,
  FetchError | ValueError | BodyError | DestinationError | ClientError | OutOfMemoryError,
  DestinationRequirements | &mut Allocator | &mut MonotonicClock | &mut Random,
> for DeliveryResponseHandler<D> {
  handleRouted: DeliveryResponseHandler.handleRouted
  handleDirect: DeliveryResponseHandler.handleDirect
}

struct EmptyOperation<'fetch, 'policy, C, D> {
  fetch: &'fetch mut Fetch<C>
  policyAnchor: [&'policy (); 0]
  options: FetchOptions
  destination: D
}

impl<
  'fetch,
  'policy,
  C,
  D,
  RoutedP,
  DirectP,
  A,
  DestinationError,
  AcquisitionError,
  ?DestinationRequirements,
  ?AcquisitionRequirements,
  D: Destination<A, DestinationError ? DestinationRequirements>,
  C: FetchClient<
    'policy,
    RoutedP,
    DirectP,
    Redirect.AttemptStep<'policy, A>,
    RedirectError | FetchError | ValueError | BodyError | DestinationError | ClientError | OutOfMemoryError,
    AcquisitionError,
    DestinationRequirements | &mut Redirect.SelectedBody<never, never> | &mut MonotonicClock | &mut Allocator | &mut Random,
    AcquisitionRequirements,
  >,
> EmptyOperation<'fetch, 'policy, C, D> {
  effect<'call> fn handle<'call>(
    operation: Self,
    request: Redirect.Request<'call, 'call, 'call, 'policy>,
  ) -> A
  ! RedirectError | FetchError | ValueError | BodyError | DestinationError | ClientError | OutOfMemoryError | AcquisitionError
  ? DestinationRequirements | AcquisitionRequirements | &mut MonotonicClock | &mut Allocator | &mut Random
  where
    DestinationRequirements in Without<DestinationRequirements, ByteDuplex>,
    DestinationRequirements in Without<DestinationRequirements, HttpTransport>,
    AcquisitionRequirements in Without<AcquisitionRequirements, ByteDuplex>,
    AcquisitionRequirements in Without<AcquisitionRequirements, HttpTransport> {
    let EmptyOperation<'fetch, 'policy, C, D> {fetch, policyAnchor, options, destination} = move operation
    drop policyAnchor
    let FetchOptions {
      redirect,
      content,
      pool,
      proxy,
      deadline,
      http,
      contentLimits,
      maxEncodedBodyBytes,
      maxDeliveredBodyBytes,
      maxOwnedMetadataBytes,
      maxBufferedBytes,
    } = move options
    let mut adapter = FetchAttemptAdapter<'fetch, C> {
      client: &mut fetch.client,
      httpLimits: http,
      poolMode: pool,
      proxyMode: proxy,
    }
    let mut scratch: [u8; 0] = []
    let response = DeliveryResponseHandler<D> {
      destination: Option.some<D>(move destination),
      content: content,
      contentLimits: move contentLimits,
      responseValueLimits: http.responseBody.trailerValues,
      maxEncodedBodyBytes: maxEncodedBodyBytes,
      maxDeliveredBodyBytes: maxDeliveredBodyBytes,
      maxOwnedMetadataBytes: maxOwnedMetadataBytes,
      maxBufferedBytes: maxBufferedBytes,
      deadline: copyDeadline(&deadline),
    }
    return run mapSwitching(Redirect.withEmptyHybridResponse(
      &mut adapter,
      move request,
      &redirect,
      copyDeadline(&deadline),
      &mut scratch,
      move response,
    ))
  }
}

impl<
  'fetch,
  'policy,
  C,
  D,
  RoutedP,
  DirectP,
  A,
  DestinationError,
  AcquisitionError,
  ?DestinationRequirements,
  ?AcquisitionRequirements,
  D: Destination<A, DestinationError ? DestinationRequirements>,
  C: FetchClient<
    'policy,
    RoutedP,
    DirectP,
    Redirect.AttemptStep<'policy, A>,
    RedirectError | FetchError | ValueError | BodyError | DestinationError | ClientError | OutOfMemoryError,
    AcquisitionError,
    DestinationRequirements | &mut Redirect.SelectedBody<never, never> | &mut MonotonicClock | &mut Allocator | &mut Random,
    AcquisitionRequirements,
  >,
> SemanticRequestHandler<
  'policy,
  A,
  RedirectError | FetchError | ValueError | BodyError | DestinationError | ClientError | OutOfMemoryError | AcquisitionError
  ? DestinationRequirements | AcquisitionRequirements | &mut MonotonicClock | &mut Allocator | &mut Random,
> for EmptyOperation<'fetch, 'policy, C, D> {
  handle: EmptyOperation.handle
}

effect fn admit(options: &FetchOptions) -> () ! FetchError {
  return match move FetchOptions.validate(options) {
    Result.Success {value} => move value
    Result.Failure {error} => {
      fail move error
    }
  }
}

/// Executes a body-free request and sequentially offers the selected representation to `sink`.
pub effect fn toSinkEmpty<
  'fetch,
  'uri,
  'method,
  'headers,
  'policy,
  C,
  S,
  RoutedP,
  DirectP,
  SinkError,
  AcquisitionError,
  ?SinkRequirements,
  ?AcquisitionRequirements,
  S: Sink<SinkError ? SinkRequirements>,
  C: FetchClient<
    'policy,
    RoutedP,
    DirectP,
    Redirect.AttemptStep<'policy, FetchResult>,
    RedirectError | FetchError | ValueError | BodyError | DestinationFailure<SinkError> | ClientError | OutOfMemoryError,
    AcquisitionError,
    SinkRequirements | &mut Redirect.SelectedBody<never, never> | &mut MonotonicClock | &mut Allocator | &mut Random,
    AcquisitionRequirements,
  >,
>(
  fetch: &'fetch mut Fetch<C>,
  request: FetchRequest<'uri, 'method, 'headers, 'policy>,
  options: FetchOptions,
  sink: S,
) -> FetchResult
! RedirectError | FetchError | ValueError | BodyError | DestinationFailure<SinkError> | ClientError | OutOfMemoryError | AcquisitionError
? SinkRequirements | AcquisitionRequirements | &mut MonotonicClock | &mut Allocator | &mut Random
where
  SinkRequirements in Without<SinkRequirements, ByteDuplex>,
  SinkRequirements in Without<SinkRequirements, HttpTransport>,
  AcquisitionRequirements in Without<AcquisitionRequirements, ByteDuplex>,
  AcquisitionRequirements in Without<AcquisitionRequirements, HttpTransport> {
  run admit(&options)
  let operation = EmptyOperation<'fetch, 'policy, C, SinkDestination<S>> {
    fetch: move fetch,
    policyAnchor: [],
    options: move options,
    destination: SinkDestination<S> {sink: move sink},
  }
  return run withSemanticRequest(move request, move operation)
}

/// Executes a body-free request and atomically publishes a bounded in-memory body.
pub effect fn collectEmpty<
  'fetch,
  'uri,
  'method,
  'headers,
  'policy,
  C,
  RoutedP,
  DirectP,
  AcquisitionError,
  ?AcquisitionRequirements,
  C: FetchClient<
    'policy,
    RoutedP,
    DirectP,
    Redirect.AttemptStep<'policy, CollectedResponse>,
    RedirectError | FetchError | ValueError | BodyError | ClientError | OutOfMemoryError,
    AcquisitionError,
    &mut Redirect.SelectedBody<never, never> | &mut MonotonicClock | &mut Allocator | &mut Random,
    AcquisitionRequirements,
  >,
>(
  fetch: &'fetch mut Fetch<C>,
  request: FetchRequest<'uri, 'method, 'headers, 'policy>,
  options: FetchOptions,
  maxBodyBytes: usize,
) -> CollectedResponse
! RedirectError | FetchError | ValueError | BodyError | ClientError | OutOfMemoryError | AcquisitionError
? AcquisitionRequirements | &mut MonotonicClock | &mut Allocator | &mut Random
where
  AcquisitionRequirements in Without<AcquisitionRequirements, ByteDuplex>,
  AcquisitionRequirements in Without<AcquisitionRequirements, HttpTransport> {
  run admit(&options)
  let operation = EmptyOperation<'fetch, 'policy, C, CollectDestination> {
    fetch: move fetch,
    policyAnchor: [],
    options: move options,
    destination: CollectDestination {body: Bytes.make(), maximum: maxBodyBytes},
  }
  return run withSemanticRequest(move request, move operation)
}

/// Executes a body-free request and validates an explicitly bounded discarded representation.
pub effect fn discardEmpty<
  'fetch,
  'uri,
  'method,
  'headers,
  'policy,
  C,
  RoutedP,
  DirectP,
  AcquisitionError,
  ?AcquisitionRequirements,
  C: FetchClient<
    'policy,
    RoutedP,
    DirectP,
    Redirect.AttemptStep<'policy, FetchResult>,
    RedirectError | FetchError | ValueError | BodyError | ClientError | OutOfMemoryError,
    AcquisitionError,
    &mut Redirect.SelectedBody<never, never> | &mut MonotonicClock | &mut Allocator | &mut Random,
    AcquisitionRequirements,
  >,
>(
  fetch: &'fetch mut Fetch<C>,
  request: FetchRequest<'uri, 'method, 'headers, 'policy>,
  options: FetchOptions,
  maxDiscardBytes: u64,
) -> FetchResult
! RedirectError | FetchError | ValueError | BodyError | ClientError | OutOfMemoryError | AcquisitionError
? AcquisitionRequirements | &mut MonotonicClock | &mut Allocator | &mut Random
where
  AcquisitionRequirements in Without<AcquisitionRequirements, ByteDuplex>,
  AcquisitionRequirements in Without<AcquisitionRequirements, HttpTransport> {
  run admit(&options)
  let operation = EmptyOperation<'fetch, 'policy, C, DiscardDestination> {
    fetch: move fetch,
    policyAnchor: [],
    options: move options,
    destination: DiscardDestination {maximum: maxDiscardBytes},
  }
  return run withSemanticRequest(move request, move operation)
}

struct BytesOperation<'fetch, 'bytes, 'policy, C, D> {
  fetch: &'fetch mut Fetch<C>
  bytes: &'bytes [u8]
  policyAnchor: [&'policy (); 0]
  options: FetchOptions
  destination: D
}

impl<
  'fetch,
  'bytes,
  'policy,
  C,
  D,
  RoutedP,
  DirectP,
  A,
  DestinationError,
  AcquisitionError,
  ?DestinationRequirements,
  ?AcquisitionRequirements,
  D: Destination<A, DestinationError ? DestinationRequirements>,
  C: FetchClient<
    'policy,
    RoutedP,
    DirectP,
    Redirect.AttemptStep<'policy, A>,
    RedirectError | FetchError | ValueError | BodyError | DestinationError | ClientError | OutOfMemoryError,
    AcquisitionError,
    DestinationRequirements | &mut Redirect.SelectedBody<never, never> | &mut MonotonicClock | &mut Allocator | &mut Random,
    AcquisitionRequirements,
  >,
> BytesOperation<'fetch, 'bytes, 'policy, C, D> {
  effect<'call> fn handle<'call>(
    operation: Self,
    request: Redirect.Request<'call, 'call, 'call, 'policy>,
  ) -> A
  ! RedirectError | FetchError | ValueError | BodyError | DestinationError | ClientError | OutOfMemoryError | AcquisitionError
  ? DestinationRequirements | AcquisitionRequirements | &mut MonotonicClock | &mut Allocator | &mut Random
  where
    DestinationRequirements in Without<DestinationRequirements, ByteDuplex>,
    DestinationRequirements in Without<DestinationRequirements, HttpTransport>,
    AcquisitionRequirements in Without<AcquisitionRequirements, ByteDuplex>,
    AcquisitionRequirements in Without<AcquisitionRequirements, HttpTransport> {
    let BytesOperation<'fetch, 'bytes, 'policy, C, D> {
      fetch,
      bytes,
      policyAnchor,
      options,
      destination,
    } = move operation
    drop policyAnchor
    let FetchOptions {
      redirect,
      content,
      pool,
      proxy,
      deadline,
      http,
      contentLimits,
      maxEncodedBodyBytes,
      maxDeliveredBodyBytes,
      maxOwnedMetadataBytes,
      maxBufferedBytes,
    } = move options
    let mut adapter = FetchAttemptAdapter<'fetch, C> {
      client: &mut fetch.client,
      httpLimits: http,
      poolMode: pool,
      proxyMode: proxy,
    }
    let mut scratch = run Bytes.zeroed(http.writeCapacity)
    let response = DeliveryResponseHandler<D> {
      destination: Option.some<D>(move destination),
      content: content,
      contentLimits: move contentLimits,
      responseValueLimits: http.responseBody.trailerValues,
      maxEncodedBodyBytes: maxEncodedBodyBytes,
      maxDeliveredBodyBytes: maxDeliveredBodyBytes,
      maxOwnedMetadataBytes: maxOwnedMetadataBytes,
      maxBufferedBytes: maxBufferedBytes,
      deadline: copyDeadline(&deadline),
    }
    return run mapSwitching(Redirect.withBytesHybridResponse(
      &mut adapter,
      move request,
      &redirect,
      bytes,
      copyDeadline(&deadline),
      Bytes.asMutSlice(&mut scratch),
      move response,
    ))
  }
}

