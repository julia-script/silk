  AcquisitionRequirements in Without<AcquisitionRequirements, ByteDuplex>,
  AcquisitionRequirements in Without<AcquisitionRequirements, HttpTransport> {
  run admit(&options)
  let operation = ReplayOperation<'fetch, 'policy, C, CollectDestination, Factory, Producer> {
    fetch: move fetch,
    factory: move factory,
    policyAnchor: [],
    options: move options,
    destination: CollectDestination {body: Bytes.make(), maximum: maxBodyBytes},
  }
  return run withSemanticRequest(move request, move operation)
}

/// Executes a replay-factory request and validates bounded discarded content.
pub effect fn discardReplay<
  'fetch,
  'uri,
  'method,
  'headers,
  'policy,
  C,
  Factory,
  Producer,
  RoutedP,
  DirectP,
  FactoryError,
  ProducerError,
  AcquisitionError,
  ?FactoryRequirements,
  ?ProducerRequirements,
  ?AcquisitionRequirements,
  Factory: ReplayFactory<Producer, FactoryError, FactoryRequirements>,
  Producer: BodyProducer<ProducerError ? ProducerRequirements>,
  C: FetchClient<
    'policy,
    RoutedP,
    DirectP,
    Redirect.AttemptStep<'policy, FetchResult>,
    RedirectError | FetchError | ValueError | BodyError | ProducerError | ClientError | OutOfMemoryError,
    AcquisitionError,
    ProducerRequirements | &mut Redirect.SelectedBody<ProducerError, ProducerRequirements> | &mut MonotonicClock | &mut Allocator | &mut Random,
    AcquisitionRequirements,
  >,
>(
  fetch: &'fetch mut Fetch<C>,
  request: FetchRequest<'uri, 'method, 'headers, 'policy>,
  factory: Factory,
  options: FetchOptions,
  maxDiscardBytes: u64,
) -> FetchResult
! RedirectError | FetchError | ValueError | BodyError | FactoryError | ProducerError | ClientError | OutOfMemoryError | AcquisitionError
? FactoryRequirements | ProducerRequirements | AcquisitionRequirements | &mut MonotonicClock | &mut Allocator | &mut Random
where
  FactoryRequirements in Without<FactoryRequirements, ByteDuplex>,
  FactoryRequirements in Without<FactoryRequirements, HttpTransport>,
  ProducerRequirements in Without<ProducerRequirements, ByteDuplex>,
  ProducerRequirements in Without<ProducerRequirements, HttpTransport>,
  AcquisitionRequirements in Without<AcquisitionRequirements, ByteDuplex>,
  AcquisitionRequirements in Without<AcquisitionRequirements, HttpTransport> {
  run admit(&options)
  let operation = ReplayOperation<'fetch, 'policy, C, DiscardDestination, Factory, Producer> {
    fetch: move fetch,
    factory: move factory,
    policyAnchor: [],
    options: move options,
    destination: DiscardDestination {maximum: maxDiscardBytes},
  }
  return run withSemanticRequest(move request, move operation)
}

fn copyInstant(value: &Instant) -> Instant {
  return SystemClock.make(SystemClock.seconds(value), SystemClock.nanoseconds(value))
}

fn copyDeadline(value: &Option<Instant>) -> Option<Instant> {
  return match & value.* {
    Option.None => Option.none<Instant>()
    Option.Some {value: present} => Option.some<Instant>(copyInstant(&present))
  }
}

fn fetchFailure(phase: FetchPhase, reason: FetchReason) -> FetchError {
  return FetchError {
    phase: phase,
    reason: move reason,
    status: Option.none<Status>(),
    uri: Option.none<OwnedUri>(),
    deliveredBodyBytes: u64.MIN,
    offeredBodyBytes: usize.ZERO,
  }
}

fn ownedResponseFailure(
  phase: FetchPhase,
  reason: FetchReason,
  status: Option<Status>,
  uri: OwnedUri,
  delivered: u64,
  offered: usize,
) -> FetchError {
  return FetchError {
    phase: phase,
    reason: move reason,
    status: move status,
    uri: Option.some<OwnedUri>(move uri),
    deliveredBodyBytes: delivered,
    offeredBodyBytes: offered,
  }
}

fn enrichResponseStatus(error: FetchError, status: Status) -> FetchError {
  let FetchError {
    phase,
    reason,
    status: priorStatus,
    uri,
    deliveredBodyBytes,
    offeredBodyBytes,
  } = move error
  drop priorStatus
  return FetchError {
    phase: phase,
    reason: move reason,
    status: Option.some<Status>(status),
    uri: move uri,
    deliveredBodyBytes: deliveredBodyBytes,
    offeredBodyBytes: offeredBodyBytes,
  }
}

effect fn borrowedResponseFailure<'uri>(
  phase: FetchPhase,
  reason: FetchReason,
  status: Option<Status>,
  uri: &Uri<'uri>,
  delivered: u64,
  offered: usize,
) -> FetchError ! OutOfMemoryError ? &mut Allocator {
  return ownedResponseFailure(
    phase,
    move reason,
    move status,
    run Uri.copy(uri),
    delivered,
    offered,
  )
}

fn metadataFailure(
  phase: FetchPhase,
  reason: FetchReason,
  metadata: &ResponseMetadata,
  delivered: u64,
  offered: usize,
) -> FetchError {
  let head = metadata.head.view()
  let status = head.status()
  drop head
  return FetchError {
    phase: phase,
    reason: move reason,
    status: Option.some<Status>(status),
    uri: Option.none<OwnedUri>(),
    deliveredBodyBytes: delivered,
    offeredBodyBytes: offered,
  }
}

fn ownedMetadataFailure(
  phase: FetchPhase,
  reason: FetchReason,
  metadata: ResponseMetadata,
  delivered: u64,
  offered: usize,
) -> FetchError {
  let ResponseMetadata {finalUri, head, representation, ownedBytes} = move metadata
  let headView = head.view()
  let status = headView.status()
  drop headView
  drop head
  drop representation
  drop ownedBytes
  return ownedResponseFailure(
    phase,
    move reason,
    Option.some<Status>(status),
    move finalUri,
    delivered,
    offered,
  )
}

fn enrichResponseFailure(
  error: FetchError,
  status: Status,
  uri: OwnedUri,
  delivered: u64,
  offered: usize,
) -> FetchError {
  let FetchError {
    phase,
    reason,
    status: priorStatus,
    uri: priorUri,
    deliveredBodyBytes,
    offeredBodyBytes,
  } = move error
  drop priorStatus
  drop priorUri
  drop deliveredBodyBytes
  drop offeredBodyBytes
  return ownedResponseFailure(
    phase,
    move reason,
    Option.some<Status>(status),
    move uri,
    delivered,
    offered,
  )
}

fn enrichMetadataFailure(
  error: FetchError,
  metadata: ResponseMetadata,
  delivered: u64,
  offered: usize,
) -> FetchError {
  let FetchError {phase, reason, status, uri, deliveredBodyBytes, offeredBodyBytes} = move error
  drop status
  drop uri
  drop deliveredBodyBytes
  drop offeredBodyBytes
  return ownedMetadataFailure(phase, move reason, move metadata, delivered, offered)
}

fn contentOptionFailure(error: ContentError<'static>) -> FetchError {
  let ContentError<'static> {reason, written, totalEncoded, totalIntermediate, totalDecoded} =
    move error
  return match move reason {
    ContentReason.InvalidLimit {limit, allowed, attempted} => FetchError {
      phase: FetchPhase.Decode,
      reason: FetchReason.Content {
        error: FetchContentError {
          reason: FetchContentReason.InvalidLimit {
            limit: limit,
            allowed: allowed,
            attempted: attempted,
          },
          written: written,
          totalEncoded: totalEncoded,
          totalIntermediate: totalIntermediate,
          totalDecoded: totalDecoded,
        },
      },
      status: Option.none<Status>(),
      uri: Option.none<OwnedUri>(),
      deliveredBodyBytes: u64.MIN,
      offeredBodyBytes: usize.ZERO,
    }
    _ => fetchFailure(FetchPhase.Decode, FetchReason.InvalidOptions)
  }
}

fn switchingFailure() -> FetchError {
  let status = match move Status.fromCode(101) {
    Result.Failure {error} => {
      drop error
      return unavailable<FetchError>()
    }
    Result.Success {value} => value
  }
  return FetchError {
    phase: FetchPhase.Head,
    reason: FetchReason.UnsupportedSwitchingResponse {status: status},
    status: Option.some<Status>(status),
    uri: Option.none<OwnedUri>(),
    deliveredBodyBytes: u64.MIN,
    offeredBodyBytes: usize.ZERO,
  }
}

effect fn mapSwitching<'env, A, E, ?R>(
  attempted: once Effect<'env; A ! E | ClientError ? R>,
) -> A ! E | ClientError | FetchError ? R {
  let outcome = run Effect.result(move attempted)
  return match move outcome {
    Result.Success {value} => move value
    Result.Failure {error} => match move error {
      ClientError.UnsupportedUpgrade => {
        fail switchingFailure()
      }
      ClientError cause => {
        fail move cause
      }
      _ => {
        fail move error
      }
    }
  }
}

fn limitFailure(
  phase: FetchPhase,
  limit: FetchLimit,
  allowed: u64,
  attempted: u64,
  delivered: u64,
  offered: usize,
) -> FetchError {
  return FetchError {
    phase: phase,
    reason: FetchReason.LimitExceeded {limit: limit, allowed: allowed, attempted: attempted},
    status: Option.none<Status>(),
    uri: Option.none<OwnedUri>(),
    deliveredBodyBytes: delivered,
    offeredBodyBytes: offered,
  }
}

fn copyContinuePolicy(value: &ContinuePolicy) -> ContinuePolicy {
  return match value {
    ContinuePolicy.Disabled => ContinuePolicy.Disabled
    ContinuePolicy.Require100 {deadline} => ContinuePolicy.Require100 {
      deadline: copyInstant(&deadline),
    }
  }
}

effect fn ownContentError<'head>(
  error: ContentError<'head>,
  metadataUsed: usize,
  metadataLimit: usize,
) -> FetchContentError ! FetchError | OutOfMemoryError ? &mut Allocator {
  let ContentError<'head> {reason, written, totalEncoded, totalIntermediate, totalDecoded} = move error
  let ownedReason = match move reason {
    ContentReason.InvalidLimit {limit, allowed, attempted} => FetchContentReason.InvalidLimit {
      limit: limit,
      allowed: allowed,
      attempted: attempted,
    }
    ContentReason.CodingSyntax {position} => FetchContentReason.CodingSyntax {position: position}
    ContentReason.UnsupportedCoding {position, token} => {
      let total = match move usize.checkedAdd(metadataUsed, token.length) {
        Option.None => {
          fail fetchFailure(FetchPhase.Decode, FetchReason.SizeOverflow)
        }
        Option.Some {value} => value
      }
      if total > metadataLimit {
        fail limitFailure(
          FetchPhase.Decode,
          FetchLimit.OwnedMetadataBytes,
          usize.toU64(metadataLimit),
          usize.toU64(total),
          u64.MIN,
          usize.ZERO,
        )
      }
      FetchContentReason.UnsupportedCoding {position: position, token: run Bytes.copy(token)}
    }
    ContentReason.PartialResponse {position} => FetchContentReason.PartialResponse {
      position: position,
    }
    ContentReason.Tunnel => FetchContentReason.Tunnel
    ContentReason.Body {error: cause} => FetchContentReason.Body {error: move cause}
    ContentReason.Buffer {error: cause} => FetchContentReason.Buffer {error: move cause}
    ContentReason.Inflate {stage, wireIndex, error: cause} => FetchContentReason.Inflate {
      stage: stage,
      wireIndex: wireIndex,
      error: move cause,
    }
    ContentReason.Zstandard {stage, wireIndex, error: cause} => FetchContentReason.Zstandard {
      stage: stage,
      wireIndex: wireIndex,
      error: move cause,
    }
    ContentReason.TrailingEncodedData {stage, wireIndex} => {
      FetchContentReason.TrailingEncodedData {stage: stage, wireIndex: wireIndex}
    }
    ContentReason.ArithmeticOverflow => FetchContentReason.ArithmeticOverflow
    ContentReason.InvalidState => FetchContentReason.InvalidState
  }
  return FetchContentError {
    reason: move ownedReason,
    written: written,
    totalEncoded: totalEncoded,
    totalIntermediate: totalIntermediate,
    totalDecoded: totalDecoded,
  }
}
