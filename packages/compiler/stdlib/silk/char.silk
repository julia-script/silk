//! Checked construction, integer inspection, equality, and ordering for Unicode scalar `char`
//! values.
//!
//! # When to use
//! Prefer comparison operators in direct expressions. Import these functions when comparison must
//! be passed by name or when the Unicode scalar ordering should be explicit at a call site.
//!
//! # Details
//! Ordering compares scalar values, not locale collation, normalization, grapheme clusters, or UTF-8
//! byte sequences. These allocation-free functions call the same primitives as the corresponding
//! operators and introduce no Effect channels.

import silk.option { Option }

/// Converts an integer to a Unicode scalar, returning None for surrogates or out-of-range values.
pub fn fromU32(value: u32) -> Option<char> {
  return Intrinsic.charFromU32(value)
}

/// Returns the exact integer value of an already valid Unicode scalar.
pub fn toU32(value: char) -> u32 {
  return Intrinsic.charToU32(value)
}

/// Calls the concrete char equals primitive.
pub fn equals(left: char, right: char) -> bool {
  return Intrinsic.charEquals(left, right)
}

/// Calls the concrete char notEquals primitive.
pub fn notEquals(left: char, right: char) -> bool {
  return Intrinsic.charNotEquals(left, right)
}

/// Calls the concrete char lessThan primitive, which orders by Unicode scalar value.
pub fn lessThan(left: char, right: char) -> bool {
  return Intrinsic.charLessThan(&left, &right)
}

/// Calls the concrete char lessOrEqual primitive, which orders by Unicode scalar value.
pub fn lessOrEqual(left: char, right: char) -> bool {
  return Intrinsic.charLessOrEqual(left, right)
}

/// Calls the concrete char greaterThan primitive, which orders by Unicode scalar value.
pub fn greaterThan(left: char, right: char) -> bool {
  return Intrinsic.charGreaterThan(left, right)
}

/// Calls the concrete char greaterOrEqual primitive, which orders by Unicode scalar value.
pub fn greaterOrEqual(left: char, right: char) -> bool {
  return Intrinsic.charGreaterOrEqual(left, right)
}
