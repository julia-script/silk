struct DecodeError {}
struct ExtraError {}
service Clock {}
struct Schema {}

interface Decoder<S> {
  effect fn decode(self: &S, encoded: i32) -> bool ! DecodeError ? &Clock
}

effect fn decode(self: &Schema, encoded: i32) -> bool ! ExtraError ? &mut Clock {
  return true
}

impl Decoder<Schema> for Schema {
  decode: Schema.decode
}
