interface Ready<T> {
  fn ready(value: T) -> i32
}

interface Renderer<'env, T, F: fn<'env>(i32) -> i32> {
  fn render(value: &T) -> i32
}

struct Box<'env, S, F: fn<'env>(i32) -> i32> {
  source: S
  operation: F
}

fn render<'env, S: Ready<S>, F: fn<'env>(i32) -> i32>(value: &Box<'env, S, F>) -> i32 {
  return 1
}

impl<'env, S: Ready<S>, F: fn<'env>(i32) -> i32> Renderer<'env, Box<'env, S, F>, F> for Box<'env, S, F> {
  render: Box.render
}
