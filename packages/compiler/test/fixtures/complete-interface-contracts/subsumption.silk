struct DecodeError {}
struct ExtraError {}
service Clock {}
service Logger {}
struct Schema {}

interface Decoder<S, !E, ?R> {
  effect fn decode(self: &mut S, encoded: i32) -> bool ! E ? R
}

fn decode(self: &Schema, encoded: i32) -> bool {
  return true
}

impl Decoder<Schema ! DecodeError | ExtraError ? &mut Clock | &Logger> for Schema {
  decode: Schema.decode
}

fn generic<T: Decoder<T ! DecodeError | ExtraError ? &mut Clock | &Logger>>(value: T) -> T {
  return move value
}
