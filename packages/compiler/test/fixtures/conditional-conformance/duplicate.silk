interface Decoder<T> { fn decode(value: T) -> i32 }
struct Wrapper<S> { source: S }
fn first<S: Decoder>(value: &Wrapper<S>) -> i32 { return Decoder.decode(value.source) }
fn second<T: Decoder>(value: &Wrapper<T>) -> i32 { return Decoder.decode(value.source) }
impl<S: Decoder<S>> Decoder<Wrapper<S>> for Wrapper<S> { decode: Wrapper.first }
impl<T: Decoder<T>> Decoder<Wrapper<T>> for Wrapper<T> { decode: Wrapper.second }
pub fn main() -> i32 { return 0 }
