import silk.allocator as Allocator
import silk.effect as Effect
import silk.local_scheduler as LocalScheduler
import silk.scheduler as Scheduler

struct RootProblem { code: i32 }

fn successStarted() -> () { return () }
fn failureStarted() -> () { return () }

effect fn success() -> i32 ? &mut Scheduler.Scheduler {
  successStarted()
  return 42
}

effect fn failure() -> bool ! RootProblem ? &mut Scheduler.Scheduler {
  failureStarted()
  fail RootProblem { code: 7 }
}

effect fn recoverFailure(
  error: RootProblem | Allocator.OutOfMemoryError | LocalScheduler.StalledError,
) -> bool {
  return match move error {
    RootProblem { code } => code == 7
    Allocator.OutOfMemoryError {} => false
    LocalScheduler.StalledError {} => false
  }
}

effect fn scenario() -> i32 ! Allocator.OutOfMemoryError | LocalScheduler.StalledError {
  let mut scheduler = LocalScheduler.make()
  let value = run LocalScheduler.execute(&mut scheduler, success())
  let failed = run Effect.catchAll(
    LocalScheduler.execute(&mut scheduler, failure()),
    recoverFailure,
  )
  if value == 42 && failed { return 42 }
  return -1
}

effect fn recoverScenario(
  error: Allocator.OutOfMemoryError | LocalScheduler.StalledError,
) -> i32 {
  drop error
  return -2
}

pub fn main() -> i32 {
  return run Effect.catchAll(scenario(), recoverScenario)
}
