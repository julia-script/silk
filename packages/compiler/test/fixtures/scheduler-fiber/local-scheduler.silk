import silk.allocator as Allocator
import silk.effect as Effect
import silk.fiber as Fiber
import silk.local_scheduler as LocalScheduler
import silk.scheduler as Scheduler

struct RootProblem { code: i32 }

fn rootStarted() -> () { return () }
fn childStarted() -> () { return () }
fn forkReturned() -> () { return () }
fn rootResumed() -> () { return () }

effect fn child() -> i32 ? &mut Scheduler.Scheduler {
  childStarted()
  return 42
}

effect fn success() -> i32
! Allocator.OutOfMemoryError | Scheduler.TaskIdExhaustedError | Fiber.Cancelled
? &mut Scheduler.Scheduler {
  rootStarted()
  let handle = run Fiber.forkChild(child())
  forkReturned()
  let value = run Fiber.join(move handle)
  rootResumed()
  return value
}

effect fn failure() -> bool
! RootProblem
? &mut Scheduler.Scheduler {
  fail RootProblem { code: 7 }
}

effect fn runSuccess(scheduler: &mut LocalScheduler.LocalScheduler) -> i32
! Allocator.OutOfMemoryError | Scheduler.TaskIdExhaustedError | Fiber.Cancelled | LocalScheduler.StalledError {
  return run LocalScheduler.execute(move scheduler, success())
}

effect fn runFailure(scheduler: &mut LocalScheduler.LocalScheduler) -> bool
! RootProblem | Allocator.OutOfMemoryError | LocalScheduler.StalledError {
  return run LocalScheduler.execute(move scheduler, failure())
}

effect fn recoverFailure(
  error: RootProblem | Allocator.OutOfMemoryError | LocalScheduler.StalledError,
) -> bool {
  return match move error {
    RootProblem { code } => code == 7
    Allocator.OutOfMemoryError {} => false
    LocalScheduler.StalledError {} => false
  }
}

effect fn scenario() -> i32
! Allocator.OutOfMemoryError | Scheduler.TaskIdExhaustedError | Fiber.Cancelled | LocalScheduler.StalledError {
  let mut scheduler = LocalScheduler.make()
  let value = run runSuccess(&mut scheduler)
  let failed = run Effect.catchAll(runFailure(&mut scheduler), recoverFailure)
  if value == 42 && failed { return 42 }
  return -1
}

effect fn recoverScenario(
  error: Allocator.OutOfMemoryError | Scheduler.TaskIdExhaustedError | Fiber.Cancelled | LocalScheduler.StalledError,
) -> i32 {
  drop error
  return -2
}

pub fn main() -> i32 {
  return run Effect.catchAll(scenario(), recoverScenario)
}
