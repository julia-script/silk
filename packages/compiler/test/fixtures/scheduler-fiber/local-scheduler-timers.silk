import silk.allocator as Allocator
import silk.effect as Effect
import silk.fiber as Fiber
import silk.local_scheduler as LocalScheduler
import silk.monotonic_clock as MonotonicClock
import silk.scheduler as Scheduler
import silk.shared as Shared
import silk.system_clock as SystemClock
import silk.system_clock { Instant }

struct Audit {
  nextEvent: i32
  siblingEvent: i32
  firstTimerEvent: i32
  secondTimerEvent: i32
  earlyTimerEvent: i32
  middleTimerEvent: i32
  lateTimerEvent: i32
  cancellationEarlyTimerEvent: i32
  cancellationLateTimerEvent: i32
  outerSiblingEvent: i32
  innerTimerEvent: i32
  resolutionReads: i32
  markReads: i32
  absoluteWaits: i32
  waitedSeconds: i64
  waitedNanoseconds: i64
  cachedReadsEqual: bool
  spinnerSteps: i32
  fairnessTimerStep: i32
}

fn recordResolution(self: &mut Audit) -> () {
  self.resolutionReads = self.resolutionReads + 1
  return ()
}

fn recordMark(self: &mut Audit) -> () {
  self.markReads = self.markReads + 1
  return ()
}

fn recordWait(self: &mut Audit, deadline: &Instant) -> () {
  self.absoluteWaits = self.absoluteWaits + 1
  self.waitedSeconds = SystemClock.seconds(deadline)
  self.waitedNanoseconds = SystemClock.nanoseconds(deadline)
  return ()
}

fn recordSibling(self: &mut Audit) -> () {
  self.nextEvent = self.nextEvent + 1
  self.siblingEvent = self.nextEvent
  return ()
}

fn recordFirstTimer(self: &mut Audit) -> () {
  self.nextEvent = self.nextEvent + 1
  self.firstTimerEvent = self.nextEvent
  return ()
}

fn recordSecondTimer(self: &mut Audit) -> () {
  self.nextEvent = self.nextEvent + 1
  self.secondTimerEvent = self.nextEvent
  return ()
}

fn recordEarlyTimer(self: &mut Audit) -> () {
  self.nextEvent = self.nextEvent + 1
  self.earlyTimerEvent = self.nextEvent
  return ()
}

fn recordMiddleTimer(self: &mut Audit) -> () {
  self.nextEvent = self.nextEvent + 1
  self.middleTimerEvent = self.nextEvent
  return ()
}

fn recordLateTimer(self: &mut Audit) -> () {
  self.nextEvent = self.nextEvent + 1
  self.lateTimerEvent = self.nextEvent
  return ()
}

fn recordCancellationEarlyTimer(self: &mut Audit) -> () {
  self.nextEvent = self.nextEvent + 1
  self.cancellationEarlyTimerEvent = self.nextEvent
  return ()
}

fn recordCancellationLateTimer(self: &mut Audit) -> () {
  self.nextEvent = self.nextEvent + 1
  self.cancellationLateTimerEvent = self.nextEvent
  return ()
}

fn recordOuterSibling(self: &mut Audit) -> () {
  self.nextEvent = self.nextEvent + 1
  self.outerSiblingEvent = self.nextEvent
  return ()
}

fn recordInnerTimer(self: &mut Audit) -> () {
  self.nextEvent = self.nextEvent + 1
  self.innerTimerEvent = self.nextEvent
  return ()
}

fn recordCachedReads(self: &mut Audit, equal: bool) -> () {
  self.cachedReadsEqual = equal
  return ()
}

fn beforeCachedReads() -> () { return () }
fn afterCachedReads() -> () { return () }
fn beforeRelativeWait() -> () { return () }
fn afterRelativeWait() -> () { return () }
fn beforeImmediateWaits() -> () { return () }
fn afterImmediateWaits() -> () { return () }
fn cancelledMiddleTimerActivated() -> () { return () }
fn cancelledMiddleTimerReleased() -> () { return () }
fn cancelledMiddleTimerResumed() -> () { return () }

struct CancelledMiddleTimerLifetime { kind: i32 }

impl Drop for CancelledMiddleTimerLifetime {
  fn drop(self: &mut CancelledMiddleTimerLifetime) -> () {
    if self.kind == 1 { cancelledMiddleTimerReleased() }
    return ()
  }
}

struct ScriptedParentClock {
  mark: Instant
  audit: Shared.Shared<Audit>
  advanceOnRead: bool
}

fn advanceMark(mark: &Instant) -> Instant {
  let seconds = SystemClock.seconds(mark)
  let nanoseconds = SystemClock.nanoseconds(mark)
  if nanoseconds == 999999999 { return SystemClock.make(seconds + 1, 0) }
  return SystemClock.make(seconds, nanoseconds + 1)
}

effect fn parentNow(self: &mut ScriptedParentClock) -> Instant {
  let recorded = Shared.withMut(&self.audit, recordMark)
  if self.advanceOnRead { self.mark = advanceMark(&self.mark) }
  return SystemClock.make(
    SystemClock.seconds(&self.mark),
    SystemClock.nanoseconds(&self.mark),
  )
}

effect fn parentResolution(self: &mut ScriptedParentClock) -> u64 {
  let recorded = Shared.withMut(&self.audit, recordResolution)
  return 1
}

effect fn parentWaitUntil(self: &mut ScriptedParentClock, deadline: Instant) -> () {
  let recorded = Shared.withMut(&self.audit, recordWait(&deadline))
  self.mark = move deadline
  return ()
}

effect fn parentWaitFor(self: &mut ScriptedParentClock, duration: u64) -> () {
  let deadline = MonotonicClock.deadlineAfter(&self.mark, duration)
  return run parentWaitUntil(move self, move deadline)
}

impl MonotonicClock.MonotonicClock for ScriptedParentClock {
  now: ScriptedParentClock.parentNow
  getResolution: ScriptedParentClock.parentResolution
  waitUntil: ScriptedParentClock.parentWaitUntil
  waitFor: ScriptedParentClock.parentWaitFor
}

effect fn firstTimer(audit: Shared.Shared<Audit>) -> i32
? &mut Scheduler.Scheduler | &mut MonotonicClock.MonotonicClock {
  beforeRelativeWait()
  run MonotonicClock.waitFor(1000000000)
  afterRelativeWait()
  let recorded = Shared.withMut(&audit, recordFirstTimer)
  drop audit
  return 20
}

effect fn secondTimer(audit: Shared.Shared<Audit>) -> i32
? &mut Scheduler.Scheduler | &mut MonotonicClock.MonotonicClock {
  run MonotonicClock.waitUntil(SystemClock.make(1, 0))
  let recorded = Shared.withMut(&audit, recordSecondTimer)
  drop audit
  return 21
}

effect fn readySibling(audit: Shared.Shared<Audit>) -> i32 {
  let recorded = Shared.withMut(&audit, recordSibling)
  drop audit
  return 1
}

effect fn schedulerOnlyChild() -> i32 ? &mut Scheduler.Scheduler {
  run Fiber.yieldNow()
  return 0
}

effect fn earlyTimer(audit: Shared.Shared<Audit>) -> i32
? &mut Scheduler.Scheduler | &mut MonotonicClock.MonotonicClock {
  run MonotonicClock.waitUntil(SystemClock.make(2, 0))
  let recorded = Shared.withMut(&audit, recordEarlyTimer)
  drop audit
  return 10
}

effect fn middleTimer(audit: Shared.Shared<Audit>) -> i32
? &mut Scheduler.Scheduler | &mut MonotonicClock.MonotonicClock {
  run MonotonicClock.waitUntil(SystemClock.make(3, 0))
  let recorded = Shared.withMut(&audit, recordMiddleTimer)
  drop audit
  return 11
}

effect fn lateTimer(audit: Shared.Shared<Audit>) -> i32
? &mut Scheduler.Scheduler | &mut MonotonicClock.MonotonicClock {
  run MonotonicClock.waitUntil(SystemClock.make(4, 0))
  let recorded = Shared.withMut(&audit, recordLateTimer)
  drop audit
  return 12
}

effect fn outOfOrderTimersRoot(audit: Shared.Shared<Audit>) -> i32
! Allocator.OutOfMemoryError | Scheduler.TaskIdExhaustedError | Fiber.Cancelled
? &mut Scheduler.Scheduler | &mut MonotonicClock.MonotonicClock {
  let late = run Fiber.forkChild<i32, never>(
    lateTimer(Shared.clone<Audit>(&audit)),
  )
  let early = run Fiber.forkChild<i32, never>(
    earlyTimer(Shared.clone<Audit>(&audit)),
  )
  let middle = run Fiber.forkChild<i32, never>(
    middleTimer(Shared.clone<Audit>(&audit)),
  )
  let lateValue = run Fiber.join<i32, never>(move late)
  let earlyValue = run Fiber.join<i32, never>(move early)
  let middleValue = run Fiber.join<i32, never>(move middle)
  drop audit
  return lateValue + earlyValue + middleValue
}

effect fn cancellationEarlyTimer(audit: Shared.Shared<Audit>) -> i32
? &mut Scheduler.Scheduler | &mut MonotonicClock.MonotonicClock {
  run MonotonicClock.waitUntil(SystemClock.make(6, 0))
  let recorded = Shared.withMut(&audit, recordCancellationEarlyTimer)
  drop audit
  return 10
}

effect fn cancelledMiddleTimer() -> i32
? &mut Scheduler.Scheduler | &mut MonotonicClock.MonotonicClock {
  let lifetime = CancelledMiddleTimerLifetime { kind: 1 }
  cancelledMiddleTimerActivated()
  run MonotonicClock.waitUntil(SystemClock.make(7, 0))
  drop lifetime
  cancelledMiddleTimerResumed()
  return -100
}

effect fn cancellingTimerParent() -> i32
! Allocator.OutOfMemoryError | Scheduler.TaskIdExhaustedError
? &mut Scheduler.Scheduler | &mut MonotonicClock.MonotonicClock {
  let timer = run Fiber.forkChild<i32, never>(cancelledMiddleTimer())
  drop timer
  run Fiber.yieldNow()
  run Fiber.yieldNow()
  return 0
}

effect fn cancellationLateTimer(audit: Shared.Shared<Audit>) -> i32
? &mut Scheduler.Scheduler | &mut MonotonicClock.MonotonicClock {
  run Fiber.yieldNow()
  run MonotonicClock.waitUntil(SystemClock.make(8, 0))
  let recorded = Shared.withMut(&audit, recordCancellationLateTimer)
  drop audit
  return 32
}

effect fn indexedTimerCancellationRoot(audit: Shared.Shared<Audit>) -> i32
! Allocator.OutOfMemoryError | Scheduler.TaskIdExhaustedError | Fiber.Cancelled
? &mut Scheduler.Scheduler | &mut MonotonicClock.MonotonicClock {
  let early = run Fiber.forkChild<i32, never>(
    cancellationEarlyTimer(Shared.clone<Audit>(&audit)),
  )
  let parent = run Fiber.forkChild<
    i32,
    Allocator.OutOfMemoryError | Scheduler.TaskIdExhaustedError,
  >(cancellingTimerParent())
  let late = run Fiber.forkChild<i32, never>(
    cancellationLateTimer(Shared.clone<Audit>(&audit)),
  )
  let earlyValue = run Fiber.join<i32, never>(move early)
  let parentValue = run Fiber.join<
    i32,
    Allocator.OutOfMemoryError | Scheduler.TaskIdExhaustedError,
  >(move parent)
  let lateValue = run Fiber.join<i32, never>(move late)
  drop audit
  return earlyValue + parentValue + lateValue
}

effect fn root(audit: Shared.Shared<Audit>) -> i32
! Allocator.OutOfMemoryError | Scheduler.TaskIdExhaustedError | Fiber.Cancelled
? &mut Scheduler.Scheduler | &mut MonotonicClock.MonotonicClock {
  beforeCachedReads()
  let firstRead = run MonotonicClock.now()
  let secondRead = run MonotonicClock.now()
  let cachedResolution = run MonotonicClock.getResolution()
  let equal = SystemClock.seconds(&firstRead) == SystemClock.seconds(&secondRead)
    && SystemClock.nanoseconds(&firstRead) == SystemClock.nanoseconds(&secondRead)
    && cachedResolution == 1
  let cached = Shared.withMut(&audit, recordCachedReads(equal))
  drop firstRead
  drop secondRead
  afterCachedReads()

  beforeImmediateWaits()
  run MonotonicClock.waitFor(0)
  run MonotonicClock.waitUntil(SystemClock.make(-1, 999999999))
  afterImmediateWaits()

  let first = run Fiber.forkChild<i32, never>(
    firstTimer(Shared.clone<Audit>(&audit)),
  )
  let second = run Fiber.forkChild<i32, never>(
    secondTimer(Shared.clone<Audit>(&audit)),
  )
  let sibling = run Fiber.forkChild<i32, never>(
    readySibling(Shared.clone<Audit>(&audit)),
  )
  let schedulerOnly = run Fiber.forkChild<i32, never>(schedulerOnlyChild())
  let siblingValue = run Fiber.join<i32, never>(move sibling)
  let schedulerOnlyValue = run Fiber.join<i32, never>(move schedulerOnly)
  let firstValue = run Fiber.join<i32, never>(move first)
  let secondValue = run Fiber.join<i32, never>(move second)
  drop audit
  return siblingValue + schedulerOnlyValue + firstValue + secondValue
}

effect fn innerRoot(audit: Shared.Shared<Audit>) -> i32
? &mut Scheduler.Scheduler | &mut MonotonicClock.MonotonicClock {
  run MonotonicClock.waitFor(1000000000)
  let recorded = Shared.withMut(&audit, recordInnerTimer)
  drop audit
  return 41
}

effect fn nestedScheduler(audit: Shared.Shared<Audit>) -> i32
! Allocator.OutOfMemoryError | LocalScheduler.StalledError
? &mut Scheduler.Scheduler | &mut MonotonicClock.MonotonicClock {
  let mut inner = LocalScheduler.make()
  return run LocalScheduler.execute(&mut inner, innerRoot(move audit))
}

effect fn outerSibling(audit: Shared.Shared<Audit>) -> i32 {
  let recorded = Shared.withMut(&audit, recordOuterSibling)
  drop audit
  return 1
}

effect fn nestedOuterRoot(audit: Shared.Shared<Audit>) -> i32
! Allocator.OutOfMemoryError
  | Scheduler.TaskIdExhaustedError
  | Fiber.Cancelled
  | LocalScheduler.StalledError
? &mut Scheduler.Scheduler | &mut MonotonicClock.MonotonicClock {
  let inner = run Fiber.forkChild<
    i32,
    Allocator.OutOfMemoryError | LocalScheduler.StalledError,
  >(nestedScheduler(Shared.clone<Audit>(&audit)))
  let sibling = run Fiber.forkChild<i32, never>(
    outerSibling(Shared.clone<Audit>(&audit)),
  )
  let siblingValue = run Fiber.join<i32, never>(move sibling)
  let innerValue = run Fiber.join<
    i32,
    Allocator.OutOfMemoryError | LocalScheduler.StalledError,
  >(move inner)
  drop audit
  return siblingValue + innerValue
}

fn recordSpinnerStep(self: &mut Audit) -> () {
  self.spinnerSteps = self.spinnerSteps + 1
  return ()
}

fn recordFairnessTimer(self: &mut Audit) -> () {
  self.fairnessTimerStep = self.spinnerSteps
  return ()
}

effect fn fairnessTimer(audit: Shared.Shared<Audit>) -> i32
? &mut Scheduler.Scheduler | &mut MonotonicClock.MonotonicClock {
  run MonotonicClock.waitFor(5)
  let recorded = Shared.withMut(&audit, recordFairnessTimer)
  drop audit
  return 40
}

effect fn readySpinner(audit: Shared.Shared<Audit>) -> i32 {
  let mut remaining = 10
  while remaining > 0 {
    let recorded = Shared.withMut(&audit, recordSpinnerStep)
    run Fiber.yieldNow()
    remaining = remaining - 1
  }
  drop audit
  return 2
}

effect fn fairnessRoot(audit: Shared.Shared<Audit>) -> i32
! Allocator.OutOfMemoryError | Scheduler.TaskIdExhaustedError | Fiber.Cancelled
? &mut Scheduler.Scheduler | &mut MonotonicClock.MonotonicClock {
  let timer = run Fiber.forkChild<i32, never>(
    fairnessTimer(Shared.clone<Audit>(&audit)),
  )
  let spinner = run Fiber.forkChild<i32, never>(
    readySpinner(Shared.clone<Audit>(&audit)),
  )
  let timerValue = run Fiber.join<i32, never>(move timer)
  let spinnerValue = run Fiber.join<i32, never>(move spinner)
  drop audit
  return timerValue + spinnerValue
}

fn auditResult(self: &Audit, value: i32) -> i32 {
  if value != 42 { return -1 }
  if !self.cachedReadsEqual { return -2 }
  if self.resolutionReads != 5 { return -3 }
  if self.absoluteWaits != 7 { return -4 }
  if self.waitedSeconds != 9 || self.waitedNanoseconds != 0 { return -5 }
  if self.siblingEvent != 1 { return -6 }
  if self.firstTimerEvent != 2 { return -7 }
  if self.secondTimerEvent != 3 { return -8 }
  if self.markReads < 2 { return -9 }
  if self.earlyTimerEvent != 4 { return -10 }
  if self.middleTimerEvent != 5 { return -11 }
  if self.lateTimerEvent != 6 { return -12 }
  if self.cancellationEarlyTimerEvent != 7 { return -13 }
  if self.cancellationLateTimerEvent != 8 { return -14 }
  if self.outerSiblingEvent != 9 { return -15 }
  if self.innerTimerEvent != 10 { return -16 }
  if self.fairnessTimerStep <= 0 { return -17 }
  if self.fairnessTimerStep >= 10 { return -18 }
  if self.spinnerSteps != 10 { return -19 }
  return 42
}

effect fn scenario() -> i32
! Allocator.OutOfMemoryError | Scheduler.TaskIdExhaustedError | Fiber.Cancelled | LocalScheduler.StalledError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let audit = run Shared.make<Audit>(Audit {
    nextEvent: 0,
    siblingEvent: 0,
    firstTimerEvent: 0,
    secondTimerEvent: 0,
    earlyTimerEvent: 0,
    middleTimerEvent: 0,
    lateTimerEvent: 0,
    cancellationEarlyTimerEvent: 0,
    cancellationLateTimerEvent: 0,
    outerSiblingEvent: 0,
    innerTimerEvent: 0,
    resolutionReads: 0,
    markReads: 0,
    absoluteWaits: 0,
    waitedSeconds: -1,
    waitedNanoseconds: -1,
    cachedReadsEqual: false,
    spinnerSteps: 0,
    fairnessTimerStep: 0,
  }) |> Effect.provideMut<Allocator.Allocator>(&mut allocator)
  let mut clock = ScriptedParentClock {
    mark: SystemClock.make(0, 0),
    audit: Shared.clone<Audit>(&audit),
    advanceOnRead: false,
  }
  let mut scheduler = LocalScheduler.make()
  let program = LocalScheduler.execute(
    &mut scheduler,
    root(Shared.clone<Audit>(&audit)),
  ) |> Effect.provideMut<MonotonicClock.MonotonicClock>(&mut clock)
  let value = run move program
  let orderedProgram = LocalScheduler.execute(
    &mut scheduler,
    outOfOrderTimersRoot(Shared.clone<Audit>(&audit)),
  ) |> Effect.provideMut<MonotonicClock.MonotonicClock>(&mut clock)
  let orderedValue = run move orderedProgram
  let cancellationProgram = LocalScheduler.execute(
    &mut scheduler,
    indexedTimerCancellationRoot(Shared.clone<Audit>(&audit)),
  ) |> Effect.provideMut<MonotonicClock.MonotonicClock>(&mut clock)
  let cancellationValue = run move cancellationProgram
  let nestedProgram = LocalScheduler.execute(
    &mut scheduler,
    nestedOuterRoot(Shared.clone<Audit>(&audit)),
  ) |> Effect.provideMut<MonotonicClock.MonotonicClock>(&mut clock)
  let nestedValue = run move nestedProgram
  clock.advanceOnRead = true
  let fairnessProgram = LocalScheduler.execute(
    &mut scheduler,
    fairnessRoot(Shared.clone<Audit>(&audit)),
  ) |> Effect.provideMut<MonotonicClock.MonotonicClock>(&mut clock)
  let fairnessValue = run move fairnessProgram
  drop clock
  let result = Shared.with<Audit, i32>(
    &audit,
    auditResult(value + orderedValue + cancellationValue + nestedValue + fairnessValue - 159),
  )
  drop audit
  return result
}

effect fn recover(
  error: Allocator.OutOfMemoryError
    | Scheduler.TaskIdExhaustedError
    | Fiber.Cancelled
    | LocalScheduler.StalledError,
) -> i32 {
  drop error
  return -99
}

pub fn main() -> i32 { return run Effect.catchAll(scenario(), recover) }
