import silk.allocator as Allocator
import silk.effect as Effect
import silk.fiber as Fiber
import silk.local_scheduler as LocalScheduler
import silk.scheduler as Scheduler

struct ChildProblem { code: i32 }

fn firstForkReturned() -> () { return () }
fn firstSiblingActivated() -> () { return () }
fn secondForkReturned() -> () { return () }
fn secondSiblingActivated() -> () { return () }
fn thirdForkReturned() -> () { return () }
fn thirdSiblingActivated() -> () { return () }
fn fifoRootTerminating() -> () { return () }

fn rootBeforeYield() -> () { return () }
fn yieldingChildStarted() -> () { return () }
fn rootBetweenYields() -> () { return () }
fn yieldingChildResumedOnce() -> () { return () }
fn rootAfterYields() -> () { return () }
fn yieldingChildResumedTwice() -> () { return () }
fn yieldingChildJoined() -> () { return () }

fn completedChildStarted() -> () { return () }
fn beforeCompletedJoin() -> () { return () }
fn afterCompletedJoin() -> () { return () }

fn nestedStarted() -> () { return () }
fn nestedForkReturned() -> () { return () }
fn nestedLeafStarted() -> () { return () }
fn nestedLeafJoined() -> () { return () }
fn nestedFailureObserved() -> () { return () }
fn cancelledChildActivated() -> () { return () }
fn cancelledOutcomeObserved() -> () { return () }

effect fn firstSibling() -> i32 {
  firstSiblingActivated()
  return 1
}

effect fn secondSibling() -> i32 {
  secondSiblingActivated()
  return 2
}

effect fn thirdSibling() -> i32 {
  thirdSiblingActivated()
  return 3
}

effect fn fifoRoot() -> i32
! Allocator.OutOfMemoryError | Scheduler.TaskIdExhausted
? &mut Scheduler.Scheduler {
  let first = run Fiber.forkChild<i32, never>(firstSibling())
  drop first
  firstForkReturned()
  let second = run Fiber.forkChild<i32, never>(secondSibling())
  drop second
  secondForkReturned()
  let third = run Fiber.forkChild<i32, never>(thirdSibling())
  drop third
  thirdForkReturned()
  run Fiber.yieldNow()
  fifoRootTerminating()
  return 6
}

effect fn yieldingChild() -> i32 {
  yieldingChildStarted()
  run Fiber.yieldNow()
  yieldingChildResumedOnce()
  run Fiber.yieldNow()
  yieldingChildResumedTwice()
  return 20
}

effect fn yieldingRoot() -> i32
! Allocator.OutOfMemoryError | Scheduler.TaskIdExhausted | Fiber.Cancelled
? &mut Scheduler.Scheduler {
  let child = run Fiber.forkChild<i32, never>(yieldingChild())
  rootBeforeYield()
  run Fiber.yieldNow()
  rootBetweenYields()
  run Fiber.yieldNow()
  rootAfterYields()
  let value = run Fiber.join<i32, never>(move child)
  yieldingChildJoined()
  return value
}

effect fn completedChild() -> i32 {
  completedChildStarted()
  return 9
}

effect fn completionBeforeJoinRoot() -> i32
! Allocator.OutOfMemoryError | Scheduler.TaskIdExhausted | Fiber.Cancelled
? &mut Scheduler.Scheduler {
  let child = run Fiber.forkChild<i32, never>(completedChild())
  run Fiber.yieldNow()
  beforeCompletedJoin()
  let value = run Fiber.join<i32, never>(move child)
  afterCompletedJoin()
  return value
}

effect fn nestedLeaf() -> i32 {
  nestedLeafStarted()
  return 7
}

effect fn nestedFailure() -> i32
! ChildProblem | Allocator.OutOfMemoryError | Scheduler.TaskIdExhausted | Fiber.Cancelled
? &mut Scheduler.Scheduler {
  nestedStarted()
  let child = run Fiber.forkChild<i32, never>(nestedLeaf())
  nestedForkReturned()
  let value = run Fiber.join<i32, never>(move child)
  nestedLeafJoined()
  fail ChildProblem { code: value }
}

effect fn recoverNestedFailure(
  error: ChildProblem
    | Allocator.OutOfMemoryError
    | Scheduler.TaskIdExhausted
    | Fiber.Cancelled,
) -> i32 {
  return match move error {
    ChildProblem { code } => observeNestedFailure(code)
    Allocator.OutOfMemoryError {} => -1
    Scheduler.TaskIdExhausted {} => -2
    Fiber.Cancelled {} => -3
  }
}

fn observeNestedFailure(code: i32) -> i32 {
  nestedFailureObserved()
  return code
}

effect fn nestedRoot() -> i32
! Allocator.OutOfMemoryError | Scheduler.TaskIdExhausted
? &mut Scheduler.Scheduler {
  let child = run Fiber.forkChild<
    i32,
    ChildProblem
      | Allocator.OutOfMemoryError
      | Scheduler.TaskIdExhausted
      | Fiber.Cancelled,
  >(nestedFailure())
  return run Effect.catchAll(
    Fiber.join<
      i32,
      ChildProblem
        | Allocator.OutOfMemoryError
        | Scheduler.TaskIdExhausted
        | Fiber.Cancelled,
    >(move child),
    recoverNestedFailure,
  )
}

effect fn cancelledChild() -> i32 {
  cancelledChildActivated()
  return 5
}

effect fn escapeCancelledChild() -> Fiber.Fiber<i32, never>
! Allocator.OutOfMemoryError | Scheduler.TaskIdExhausted
? &mut Scheduler.Scheduler {
  return run Fiber.forkChild<i32, never>(cancelledChild())
}

fn isCancelled(outcome: Fiber.Outcome<i32, never>) -> bool {
  let Fiber.Outcome<i32, never> { value } = move outcome
  return match move value {
    Fiber.Success<i32> { value: success } => false
    Fiber.Failure<never> { error } => move error
    Fiber.Cancelled {} => recordCancellation()
  }
}

fn recordCancellation() -> bool {
  cancelledOutcomeObserved()
  return true
}

effect fn observeCancelled(fiber: Fiber.Fiber<i32, never>) -> bool
? &mut Scheduler.Scheduler {
  return isCancelled(run Fiber.await<i32, never>(move fiber))
}

effect fn scenario() -> i32
! Allocator.OutOfMemoryError | Scheduler.TaskIdExhausted | Fiber.Cancelled | LocalScheduler.Stalled {
  let mut scheduler = LocalScheduler.make()
  let fifo = run LocalScheduler.execute(&mut scheduler, fifoRoot())
  let yielded = run LocalScheduler.execute(&mut scheduler, yieldingRoot())
  let completed = run LocalScheduler.execute(&mut scheduler, completionBeforeJoinRoot())
  let nested = run LocalScheduler.execute(&mut scheduler, nestedRoot())
  let escaped = run LocalScheduler.execute(&mut scheduler, escapeCancelledChild())
  let cancelled = run LocalScheduler.execute(&mut scheduler, observeCancelled(move escaped))
  if fifo == 6 && yielded == 20 && completed == 9 && nested == 7 && cancelled { return 42 }
  return -42
}

effect fn recoverScenario(
  error: Allocator.OutOfMemoryError
    | Scheduler.TaskIdExhausted
    | Fiber.Cancelled
    | LocalScheduler.Stalled,
) -> i32 {
  drop error
  return -99
}

pub fn main() -> i32 {
  return run Effect.catchAll(scenario(), recoverScenario)
}
