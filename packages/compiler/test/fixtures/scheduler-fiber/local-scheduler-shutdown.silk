import silk.allocator as Allocator
import silk.effect as Effect
import silk.execution as Execution
import silk.fiber as Fiber
import silk.local_scheduler as LocalScheduler
import silk.monotonic_clock as MonotonicClock
import silk.scheduler as Scheduler
import silk.system_clock as SystemClock
import silk.system_clock { Instant }

struct ParentClock { mark: Instant }
effect fn parentNow(self: &mut ParentClock) -> Instant {
  return SystemClock.make(SystemClock.seconds(&self.mark), SystemClock.nanoseconds(&self.mark))
}
effect fn parentResolution(self: &mut ParentClock) -> u64 { return 1 }
effect fn parentWaitUntil(self: &mut ParentClock, deadline: Instant) -> () {
  self.mark = move deadline
  return ()
}
effect fn parentWaitFor(self: &mut ParentClock, duration: u64) -> () {
  let deadline = MonotonicClock.deadlineAfter(&self.mark, duration)
  return run parentWaitUntil(move self, move deadline)
}
impl MonotonicClock.MonotonicClock for ParentClock {
  now: ParentClock.parentNow
  getResolution: ParentClock.parentResolution
  waitUntil: ParentClock.parentWaitUntil
  waitFor: ParentClock.parentWaitFor
}

struct RootProblem { code: i32 }
struct ParkGuard {}

fn successHandleDropped() -> () { return () }
fn completedSiblingHandleDropped() -> () { return () }
fn completedSiblingActivated() -> () { return () }
fn completedSiblingReleased() -> () { return () }
fn successChildActivated() -> () { return () }
fn successLeafActivated() -> () { return () }
fn successChildReleased() -> () { return () }
fn successLeafReleased() -> () { return () }
fn successTerminating() -> () { return () }
fn successReturned() -> () { return () }

fn failureHandleDropped() -> () { return () }
fn failureChildActivated() -> () { return () }
fn failureChildReleased() -> () { return () }
fn failureTerminating() -> () { return () }
fn failureRecovered() -> () { return () }

fn escapedChildActivated() -> () { return () }
fn escapeTerminating() -> () { return () }
fn escapedReturned() -> () { return () }
fn escapedCancelled() -> () { return () }

fn stalledRegistered() -> () { return () }
fn stalledRootReleased() -> () { return () }
fn stalledRecovered() -> () { return () }

fn freshStarted() -> () { return () }
fn freshReturned() -> () { return () }
fn resumedUnexpectedly() -> () { return () }

struct Lifetime { kind: i32 }

impl Drop for Lifetime {
  fn drop(self: &mut Lifetime) -> () {
    if self.kind == 1 { successChildReleased() return () }
    if self.kind == 2 { successLeafReleased() return () }
    if self.kind == 3 { failureChildReleased() return () }
    if self.kind == 6 { completedSiblingReleased() return () }
    stalledRootReleased()
    return ()
  }
}

fn neverWake(wake: Intrinsic.Wake) -> ParkGuard {
  drop wake
  return ParkGuard {}
}

effect fn parkedLeaf(lifetime: Lifetime) -> i32 {
  successLeafActivated()
  run Execution.park(neverWake)
  drop lifetime
  resumedUnexpectedly()
  return -1
}

effect fn nestedSuccessChild() -> i32
! Allocator.OutOfMemoryError | Scheduler.TaskIdExhaustedError
? &mut Scheduler.Scheduler | &mut MonotonicClock.MonotonicClock {
  let lifetime = Lifetime { kind: 1 }
  successChildActivated()
  let leaf = run Fiber.forkChild<i32, never>(parkedLeaf(Lifetime { kind: 2 }))
  drop leaf
  run MonotonicClock.waitFor(1000000000000)
  drop lifetime
  resumedUnexpectedly()
  return -2
}

effect fn completedSibling() -> i32 {
  let lifetime = Lifetime { kind: 6 }
  completedSiblingActivated()
  drop lifetime
  return 7
}

effect fn failureChild() -> i32
? &mut Scheduler.Scheduler | &mut MonotonicClock.MonotonicClock {
  let lifetime = Lifetime { kind: 3 }
  failureChildActivated()
  run MonotonicClock.waitFor(1000000000000)
  drop lifetime
  resumedUnexpectedly()
  return -3
}

effect fn escapedChild() -> i32 {
  escapedChildActivated()
  run Execution.park(neverWake)
  resumedUnexpectedly()
  return -4
}

effect fn successRoot() -> i32
! Allocator.OutOfMemoryError | Scheduler.TaskIdExhaustedError
? &mut Scheduler.Scheduler | &mut MonotonicClock.MonotonicClock {
  let child = run Fiber.forkChild<
    i32,
    Allocator.OutOfMemoryError | Scheduler.TaskIdExhaustedError,
  >(nestedSuccessChild())
  drop child
  successHandleDropped()
  let completed = run Fiber.forkChild<i32, never>(completedSibling())
  drop completed
  completedSiblingHandleDropped()
  run Fiber.yieldNow()
  successTerminating()
  return 11
}

effect fn failureRoot() -> i32
! RootProblem | Allocator.OutOfMemoryError | Scheduler.TaskIdExhaustedError
? &mut Scheduler.Scheduler | &mut MonotonicClock.MonotonicClock {
  let child = run Fiber.forkChild<i32, never>(failureChild())
  drop child
  failureHandleDropped()
  run Fiber.yieldNow()
  failureTerminating()
  fail RootProblem { code: 7 }
}

effect fn escapeRoot() -> Fiber.Fiber<i32, never>
! Allocator.OutOfMemoryError | Scheduler.TaskIdExhaustedError
? &mut Scheduler.Scheduler | &mut MonotonicClock.MonotonicClock {
  let child = run Fiber.forkChild<i32, never>(escapedChild())
  escapeTerminating()
  return move child
}

effect fn stalledRoot() -> i32 ? &mut Scheduler.Scheduler | &mut MonotonicClock.MonotonicClock {
  let lifetime = Lifetime { kind: 5 }
  stalledRegistered()
  run Execution.park(neverWake)
  drop lifetime
  resumedUnexpectedly()
  return -5
}

effect fn freshRoot() -> i32 ? &mut Scheduler.Scheduler | &mut MonotonicClock.MonotonicClock {
  freshStarted()
  return 42
}

effect fn recoverFailure(
  error: RootProblem
    | Allocator.OutOfMemoryError
    | Scheduler.TaskIdExhaustedError
    | LocalScheduler.StalledError,
) -> i32 {
  return match move error {
    RootProblem { code } => recoverRootProblem(code)
    Allocator.OutOfMemoryError {} => 0
    Scheduler.TaskIdExhaustedError {} => 0
    LocalScheduler.StalledError {} => 0
  }
}

fn recoverRootProblem(code: i32) -> i32 {
  if code == 7 { return 1 }
  return 0
}

effect fn recoverStalled(
  error: Allocator.OutOfMemoryError | LocalScheduler.StalledError,
) -> i32 {
  return match move error {
    Allocator.OutOfMemoryError {} => 0
    LocalScheduler.StalledError {} => 1
  }
}

fn observeEscaped(outcome: Fiber.Outcome<i32, never>) -> bool {
  let Fiber.Outcome<i32, never> { value } = move outcome
  return match move value {
    Fiber.Success<i32> { value: success } => false
    Fiber.Failure<never> { error } => move error
    Fiber.Cancelled {} => observeCancelled()
  }
}

fn observeCancelled() -> bool {
  escapedCancelled()
  return true
}

effect fn observeEscapedRoot(fiber: Fiber.Fiber<i32, never>) -> bool
? &mut Scheduler.Scheduler | &mut MonotonicClock.MonotonicClock {
  return observeEscaped(run Fiber.await<i32, never>(move fiber))
}

effect fn scenario() -> i32
! Allocator.OutOfMemoryError | Scheduler.TaskIdExhaustedError | LocalScheduler.StalledError
? &mut MonotonicClock.MonotonicClock {
  let mut scheduler = LocalScheduler.make()

  let success = run LocalScheduler.execute(&mut scheduler, successRoot())
  successReturned()

  let failure = run Effect.catchAll(
    LocalScheduler.execute(&mut scheduler, failureRoot()),
    recoverFailure,
  )
  failureRecovered()

  let escaped = run LocalScheduler.execute(&mut scheduler, escapeRoot())
  escapedReturned()
  let cancelled = run LocalScheduler.execute(
    &mut scheduler,
    observeEscapedRoot(move escaped),
  )

  let stalled = run Effect.catchAll(
    LocalScheduler.execute(&mut scheduler, stalledRoot()),
    recoverStalled,
  )
  stalledRecovered()

  let fresh = run LocalScheduler.execute(&mut scheduler, freshRoot())
  freshReturned()

  if success == 11
    && failure == 1
    && cancelled
    && stalled == 1
    && fresh == 42 { return 42 }
  return -42
}

effect fn recoverScenario(
  error: Allocator.OutOfMemoryError | Scheduler.TaskIdExhaustedError | LocalScheduler.StalledError,
) -> i32 {
  drop error
  return -99
}

pub fn main() -> i32 {
  let mut clock = ParentClock { mark: SystemClock.make(0, 0) }
  let program = Effect.catchAll(scenario(), recoverScenario)
    |> Effect.provideMut<MonotonicClock.MonotonicClock>(&mut clock)
  return run move program
}
