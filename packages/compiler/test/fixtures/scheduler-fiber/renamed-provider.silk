import silk.allocator as Allocator
import silk.effect as Effect
import silk.monotonic_clock as MonotonicClock
import silk.scheduler as RuntimePolicy

struct RenamedDispatcher { calls: i32 }

fn renamedPrepareCalled() -> () { return () }

effect fn prepare<A, E>(
  self: &mut RenamedDispatcher,
  child: once Effect<
    A
    ! E
    ? &mut RuntimePolicy.Scheduler | &mut MonotonicClock.MonotonicClock
  >,
) -> RuntimePolicy.PendingPublication<A, E>
! Allocator.OutOfMemoryError | RuntimePolicy.TaskIdExhaustedError {
  drop child
  self.calls = self.calls + 1
  renamedPrepareCalled()
  fail RuntimePolicy.TaskIdExhaustedError {}
}

impl RuntimePolicy.Scheduler for RenamedDispatcher {
  prepare: RenamedDispatcher.prepare
}

effect fn child() -> i32
? &mut RuntimePolicy.Scheduler | &mut MonotonicClock.MonotonicClock {
  return 1
}

effect fn request() -> i32
! Allocator.OutOfMemoryError | RuntimePolicy.TaskIdExhaustedError
? &mut RuntimePolicy.Scheduler {
  let pending = run RuntimePolicy.prepare<i32, never>(child())
  drop pending
  return 0
}

effect fn refused(
  error: Allocator.OutOfMemoryError | RuntimePolicy.TaskIdExhaustedError,
) -> i32 {
  drop error
  return 42
}

pub fn main() -> i32 {
  let provider = RenamedDispatcher { calls: 0 }
  let bound = Effect.bindRequirementOwned<RuntimePolicy.Scheduler>(request(), move provider)
  return run Effect.catchAll(move bound, refused)
}
