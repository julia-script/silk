struct SelectionProblem {
  code: i32
}

struct DecodeProblem {
  code: i32
}

service Pulse {
  effect fn tick() -> i32 ? &Pulse
}

struct FixedPulse {}

effect fn fixedTick(self: &FixedPulse) -> i32 {
  return 0
}

impl Pulse for FixedPulse {
  tick: FixedPulse.fixedTick
}

interface Reader<T> {
  fn decode(value: &T) -> i32
}

interface CompleteReader<S, Arguments, A, !E, ?R> {
  effect fn decode(self: &S, arguments: Arguments) -> A ! E ? R
}

struct ScalarPlan {
  value: i32
}

fn numberDecode(value: &ScalarPlan) -> i32 {
  return value.value
}

effect fn completeNumberDecode(self: &ScalarPlan, encoded: i32) -> i32
! DecodeProblem
? &Pulse {
  return self.value + encoded + run Pulse.tick()
}

impl Reader<ScalarPlan> for ScalarPlan {
  decode: ScalarPlan.numberDecode
}

impl CompleteReader<ScalarPlan, i32, i32 ! DecodeProblem ? &Pulse> for ScalarPlan {
  decode: ScalarPlan.completeNumberDecode
}

fn pendingComplete<T: CompleteReader<T, i32, i32 ! DecodeProblem ? &Pulse>>(value: &T) -> Effect<i32 ! DecodeProblem ? &Pulse> {
  return CompleteReader.decode(value, 0)
}

struct ConvertedPlan<S, F: fn(i32) -> i32> {
  source: S
  transform: F
}

fn mappedDecode<S: Reader<S>, F: fn(i32) -> i32>(value: &ConvertedPlan<S, F>) -> i32 {
  return value.transform(Reader.decode(&value.source))
}

impl<S: Reader<S>, F: fn(i32) -> i32> Reader<ConvertedPlan<S, F>> for ConvertedPlan<S, F> {
  decode: ConvertedPlan.mappedDecode
}

fn add(value: i32, amount: i32) -> i32 {
  return value + amount
}

fn makeTransform(amount: i32) -> some<F: fn(i32) -> i32> F {
  return add(amount)
}

fn exactTransform() -> typeof(add) {
  return add
}

struct Guard {
  value: i32
  storage: Allocation
}

impl Drop for Guard {
  fn drop(self: &mut Guard) -> () {
    if self.value == 0 {
      let boom = 1 / 0
      return ()
    }
    self.value = 0
    return ()
  }
}

struct Deferred<A, !E, ?R, F: once Effect<A ! E ? R>> {
  operation: F
}

fn defer<A, !E, ?R, F: once Effect<A ! E ? R>>(operation: F) -> Deferred<A, E, R, F> {
  return Deferred<A, E, R> {operation: move operation}
}

effect fn guarded(guard: Guard) -> i32 {
  return guard.value
}

effect fn delayed(guard: Guard) -> i32
! OutOfMemory
? &mut Allocator {
  let base = run Effect.suspend(
    effect {
      return 0
    },
  )
  return base + guard.value
}

effect fn selectionFailure() -> i32
! SelectionProblem {
  fail SelectionProblem {code: 20}
}

effect fn recoverSelection(problem: SelectionProblem) -> i32 {
  return problem.code
}

effect fn decodeFailure() -> i32
! DecodeProblem {
  fail DecodeProblem {code: 30}
}

effect fn recoverDecode(problem: DecodeProblem) -> i32 {
  return problem.code
}

struct ExecuteNode {
  value: i32
}

struct DescribeNode {}

struct ChooseFaultNode {}

struct ReadFaultNode {}

struct DeferredDropNode {
  value: i32
}

struct InvokedDropNode {
  value: i32
}

struct SuspendedNode {
  value: i32
}

struct DescriptionLeaf {
  code: i32
}

struct DescriptionPair<L, R> {
  left: L
  right: R
}

fn chooseNode() -> ExecuteNode | DescribeNode | ChooseFaultNode | ReadFaultNode | DeferredDropNode | InvokedDropNode | SuspendedNode {
  return ExecuteNode {value: 40}
}

fn commitAction(value: i32) -> i32 {
  return value
}

fn describeNode() -> i32 {
  let tree = DescriptionPair<DescriptionLeaf, DescriptionLeaf> {
    left: DescriptionLeaf {code: 4},
    right: DescriptionLeaf {code: 6},
  }
  return tree.left.code + tree.right.code
}

fn executeNode(value: i32) -> i32 {
  let schema = ConvertedPlan<ScalarPlan> {source: ScalarPlan {value: value}, transform: add(2)}
  let opaque = makeTransform(1)
  let exact = exactTransform()
  let clock = FixedPulse {}
  let complete = run Effect.catch(
    pendingComplete<ScalarPlan>(&schema.source)
      |> Effect.provide(&clock),
    recoverDecode,
  )
  return commitAction(opaque(exact(mappedDecode(&schema), complete - value) - 1))
}

effect fn uncalledCleanupCase(value: i32) -> i32
! OutOfMemory
? &mut Allocator {
  let storage = run Allocator.allocate(Layout.of<i32>())
  let guard = Guard {value: value, storage: move storage}
  let deferred = defer(guarded(move guard))
  return 40
}

effect fn calledCleanupCase(value: i32) -> i32
! OutOfMemory
? &mut Allocator {
  let storage = run Allocator.allocate(Layout.of<i32>())
  let guard = Guard {value: value, storage: move storage}
  let deferred = defer(guarded(move guard))
  return run deferred.operation
}

effect fn suspensionCase(value: i32) -> i32
! OutOfMemory
? &mut Allocator {
  let storage = run Allocator.allocate(Layout.of<i32>())
  let guard = Guard {value: value, storage: move storage}
  let deferred = defer(delayed(move guard))
  return run deferred.operation
}

effect fn routeNode(
  request: ExecuteNode | DescribeNode | ChooseFaultNode | ReadFaultNode | DeferredDropNode | InvokedDropNode | SuspendedNode,
) -> i32
! OutOfMemory
? &mut Allocator {
  return match move request {
    ExecuteNode {value} => executeNode(value)
    DescribeNode {} => describeNode()
    ChooseFaultNode {} => run Effect.catch(selectionFailure(), recoverSelection)
    ReadFaultNode {} => run Effect.catch(decodeFailure(), recoverDecode)
    DeferredDropNode {value} => run uncalledCleanupCase(value)
    InvokedDropNode {value} => run calledCleanupCase(value)
    SuspendedNode {value} => run suspensionCase(value)
  }
}

effect fn recoverOutOfMemory(error: OutOfMemory) -> i32 {
  return 0
}

pub fn main() -> i32 {
  let mut allocator = SystemAllocator.make()
  return run Effect.catch(
    routeNode(chooseNode())
      |> Effect.provideMut(&mut allocator),
    recoverOutOfMemory,
  )
}
