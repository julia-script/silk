{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frozen spike-local Effect suspension continuation schema",
  "version": 1,
  "status": "spike-local-only",
  "outcome": {
    "tags": ["Success", "TypedFailure", "OutOfMemoryError"],
    "payloadLane": "i32"
  },
  "continuations": [
    {
      "id": "suspend.one",
      "resumeId": 1,
      "deferredRunner": "child.one",
      "reached": true,
      "live": [
        { "name": "owner.one", "type": "AffineOwner", "access": "move" },
        { "name": "scalar.one", "type": "i32", "access": "copy" }
      ],
      "cleanup": ["owner.one", "continuation.one"]
    },
    {
      "id": "suspend.two",
      "resumeId": 2,
      "deferredRunner": "child.two",
      "reached": true,
      "live": [
        { "name": "owner.two", "type": "AffineOwner", "access": "move" },
        { "name": "scalar.two", "type": "i32", "access": "copy" }
      ],
      "cleanup": ["owner.two", "continuation.two"]
    },
    {
      "id": "suspend.untaken",
      "resumeId": 3,
      "deferredRunner": "child.untaken",
      "reached": false,
      "live": [],
      "cleanup": []
    }
  ],
  "scenarios": [
    "untaken",
    "success",
    "typed-failure",
    "refuse-1",
    "refuse-2",
    "teardown-1",
    "teardown-2"
  ],
  "notes": [
    "This is not production MIR and is not a serialized compiler contract.",
    "Each reached boundary owns one complete target allocation before publication.",
    "Harness-only teardown observes private reclaim and intentionally reports no source cleanup."
  ]
}
