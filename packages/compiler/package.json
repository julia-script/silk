{
  "name": "@silk-effect/compiler",
  "version": "0.0.0",
  "description": "Byte-oriented bootstrap compiler primitives for Silk Effect.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julia-script/silk-effect.git",
    "directory": "packages/compiler"
  },
  "homepage": "https://github.com/julia-script/silk-effect#readme",
  "bugs": {
    "url": "https://github.com/julia-script/silk-effect/issues"
  },
  "keywords": [
    "compiler",
    "lexer",
    "effect",
    "typescript"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./Analysis": {
      "types": "./dist/Analysis.d.ts",
      "import": "./dist/Analysis.js"
    },
    "./Backend": {
      "types": "./dist/Backend.d.ts",
      "import": "./dist/Backend.js"
    },
    "./BootstrapEvaluation": {
      "types": "./dist/BootstrapEvaluation.d.ts",
      "import": "./dist/BootstrapEvaluation.js"
    },
    "./NativeToolchain": {
      "types": "./dist/NativeToolchain.d.ts",
      "import": "./dist/NativeToolchain.js"
    },
    "./SourceFile": {
      "types": "./dist/SourceFile.d.ts",
      "import": "./dist/SourceFile.js"
    },
    "./SourceSpan": {
      "types": "./dist/SourceSpan.d.ts",
      "import": "./dist/SourceSpan.js"
    },
    "./Token": {
      "types": "./dist/Token.d.ts",
      "import": "./dist/Token.js"
    },
    "./DeclarationIndex": {
      "types": "./dist/DeclarationIndex.d.ts",
      "import": "./dist/DeclarationIndex.js"
    },
    "./Driver": {
      "types": "./dist/Driver.d.ts",
      "import": "./dist/Driver.js"
    },
    "./Diagnostic": {
      "types": "./dist/Diagnostic.d.ts",
      "import": "./dist/Diagnostic.js"
    },
    "./Instances": {
      "types": "./dist/Instances.d.ts",
      "import": "./dist/Instances.js"
    },
    "./Layout": {
      "types": "./dist/Layout.d.ts",
      "import": "./dist/Layout.js"
    },
    "./Lexer": {
      "types": "./dist/Lexer.d.ts",
      "import": "./dist/Lexer.js"
    },
    "./Lower": {
      "types": "./dist/Lower.d.ts",
      "import": "./dist/Lower.js"
    },
    "./Mir": {
      "types": "./dist/Mir.d.ts",
      "import": "./dist/Mir.js"
    },
    "./ModuleClosure": {
      "types": "./dist/ModuleClosure.d.ts",
      "import": "./dist/ModuleClosure.js"
    },
    "./SyntaxFile": {
      "types": "./dist/SyntaxFile.d.ts",
      "import": "./dist/SyntaxFile.js"
    },
    "./SyntaxTree": {
      "types": "./dist/SyntaxTree.d.ts",
      "import": "./dist/SyntaxTree.js"
    },
    "./Ownership": {
      "types": "./dist/Ownership.d.ts",
      "import": "./dist/Ownership.js"
    },
    "./Parser": {
      "types": "./dist/Parser.d.ts",
      "import": "./dist/Parser.js"
    },
    "./Elaboration": {
      "types": "./dist/Elaboration.d.ts",
      "import": "./dist/Elaboration.js"
    },
    "./Hir": {
      "types": "./dist/Hir.d.ts",
      "import": "./dist/Hir.js"
    },
    "./ToolchainPlan": {
      "types": "./dist/ToolchainPlan.d.ts",
      "import": "./dist/ToolchainPlan.js"
    },
    "./Target": {
      "types": "./dist/Target.d.ts",
      "import": "./dist/Target.js"
    },
    "./WasmBackend": {
      "types": "./dist/WasmBackend.d.ts",
      "import": "./dist/WasmBackend.js"
    }
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lexer:bench": "pnpm build && node scripts/lexer-benchmark.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@silk-effect/llvm": "workspace:*",
    "@silk-effect/wasm": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "^24.10.1"
  }
}
