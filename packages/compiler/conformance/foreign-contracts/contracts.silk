import silk.pointer { Pointer }

unsafe extern "C" fn writeRenamed(value: &mut i32) -> () as "fixture_write_renamed"
  with Intrinsic.foreign(memory: "write", locality: "arguments", borrow: ("value",))
unsafe extern "C" fn readRenamed(value: &i32) -> i32 as "fixture_read_renamed"
  with Intrinsic.foreign(memory: "read", locality: "arguments", borrow: ("value",))
unsafe extern "C" fn aliasRenamed(value: *mut i32) -> *mut i32 as "fixture_alias_renamed"
  with Intrinsic.foreign(memory: "none", returned: "value")
unsafe extern "C" fn noCapture(value: *mut i32) -> () as "fixture_nocapture"
  with Intrinsic.foreign(memory: "write", locality: "arguments", noCapture: ("value",))
unsafe extern "C" fn failRenamed() -> i32 as "fixture_operation_renamed"
unsafe extern "C" fn statusRenamed() -> *mut i32 as "fixture_accessor_renamed"
unsafe extern "C" fn changeRenamed() -> () as "fixture_intervening_renamed"
unsafe extern "C" fn foreignThrow() -> () as "fixture_throw"

export "C" fn silk_contracts() -> i32 {
  let mut value = 1
  unsafe {
    writeRenamed(&mut value)
    if value != 42 || readRenamed(&value) != 42 { return 1 }
    let pointer = Intrinsic.pointerFromMutRef<i32>(&mut value)
    let alias = aliasRenamed(pointer)
    noCapture(alias)
    if value != 73 { return 2 }
    if failRenamed() != -1 { return 3 }
    let first = Pointer.read(statusRenamed())
    changeRenamed()
    let second = Pointer.read(statusRenamed())
    if first != 17 || second != 29 { return 4 }
    return 0
  }
}

export "C" fn silk_throw() -> () { unsafe { foreignThrow() } }

unsafe extern "C" fn stop() -> () as "fixture_stop" with Intrinsic.foreign(noReturn: true)
export "C" fn silk_stop() -> i32 { unsafe { stop() } return 99 }
