import silk.raw_mapping {Mapping}

import silk.raw_process_inputs {ProcessInputs}

import silk.raw_linux { RawLinux }

import silk.pointer {Pointer}

import silk.result {Result}

import silk.usize

static if Intrinsic.targetArchitecture() == "x86_64" {
  const GETPID: usize = 39
} else {
  const GETPID: usize = 172
}

pub fn main(inputs: &ProcessInputs) -> i32 {
  unsafe {
    let pid = RawLinux.syscall0(GETPID)
    if RawLinux.error(pid) != 0 || pid == 0 {
      return 20
    }
    if RawLinux.syscall1(GETPID, 0) != pid {
      return 21
    }
    if RawLinux.syscall2(GETPID, 0, 0) != pid {
      return 22
    }
    if RawLinux.syscall3(GETPID, 0, 0, 0) != pid {
      return 23
    }
    if RawLinux.syscall4(GETPID, 0, 0, 0, 0) != pid {
      return 24
    }
    if RawLinux.syscall5(GETPID, 0, 0, 0, 0, 0) != pid {
      return 25
    }
    if RawLinux.syscall6(GETPID, 0, 0, 0, 0, 0, 0) != pid {
      return 26
    }
    let missing: [usize; 5] = [0, 0, 0, 0, 0]
    let words = Intrinsic.pointerRequalify<?[*]const usize, [*]const usize>(
      Pointer.fromSlice<usize>(&missing),
    )
    let decoded = ProcessInputs.decode(words)
    let rejected = match move decoded {
      Result<ProcessInputs, usize>.Success {value} => false
      Result<ProcessInputs, usize>.Failure {error} => error == 22
    }
    if rejected == false {
      return 27
    }
  }
  if ProcessInputs.argc(inputs) != 2 {
    return 1
  }
  let argument = unsafe ProcessInputs.argument(inputs, 1)
  unsafe {
    let bytes = Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(argument)
    if Pointer.read<u8>(Pointer.at<u8>(bytes, 0)) != 65 {
      return 2
    }
    if Pointer.read<u8>(Pointer.at<u8>(bytes, 1)) != 0 {
      return 3
    }
  }
  if ProcessInputs.envc(inputs) == 0 {
    return 4
  }
  if RawLinux.error(18446744073709547520) != 0 {
    return 5
  }
  if RawLinux.error(18446744073709547521) != 4095 {
    return 6
  }
  if RawLinux.error(usize.MAX) != 1 {
    return 7
  }
  let invalid = Mapping.allocate(usize.MAX, 16, ProcessInputs.pageSize(inputs))
  let rejected = match move invalid {
    Result<Mapping, usize>.Success {value} => false
    Result<Mapping, usize>.Failure {error} => error == 22
  }
  if rejected == false {
    return 8
  }
  let allocation = Mapping.allocate(42, 131072, ProcessInputs.pageSize(inputs))
  match move allocation {
    Result<Mapping, usize>.Success {value} => {
      let mut mapping = move value
      let address = unsafe Mapping.pointer(&mut mapping)
      if Pointer.addressMany<u8>(address) % 131072 != 0 {
        return 9
      }
      if Mapping.length(&mapping) != 42 {
        return 10
      }
      unsafe {
        let bytes = Intrinsic.pointerRequalify<?[*]mut u8, [*]mut u8>(address)
        if Pointer.read<u8>(Pointer.at<u8>(bytes, 0)) != 0 {
          return 11
        }
        if Pointer.read<u8>(Pointer.at<u8>(bytes, 41)) != 0 {
          return 12
        }
        Pointer.write<u8>(Pointer.atMut<u8>(bytes, 41), 65)
        if Pointer.read<u8>(Pointer.at<u8>(bytes, 41)) != 65 {
          return 13
        }
      }
      if Mapping.release(move mapping) != 0 {
        return 14
      }
    }
    Result<Mapping, usize>.Failure {error} => {
      return 15
    }
  }
  let mut input: [u8; 1] = [17]
  if RawLinux.read(0, &mut input) != 0 {
    return 16
  }
  if input[0] != 17 {
    return 17
  }
  if RawLinux.error(RawLinux.write(usize.MAX, b"x")) != 9 {
    return 18
  }
  if RawLinux.write(1, b"raw\n") != 4 {
    return 19
  }
  return 42
}
