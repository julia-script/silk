import silk.os_writer { StderrWriter }
import silk.os_writer { StdoutWriter }
import silk.writer { Writer, WriterError }
import silk.os_standard_input { OsStandardInput }
import silk.standard_input { StandardInput, StreamReadError }
import silk.effect { Effect }
import silk.u8 as u8

effect fn writeFailed(error: WriterError) -> i32 { return 7 }
effect fn readFailed(error: StreamReadError) -> i32 { return 7 }

effect fn writeStdout(empty: bool, flush: bool) -> i32 ! WriterError {
  let mut output = StdoutWriter.make()
  if flush {
    run Writer.flush() |> Effect.provideMut<Writer>(&mut output)
  } else {
    if empty {
      run Writer.writeAll(b"") |> Effect.provideMut<Writer>(&mut output)
    } else {
      run Writer.writeAll(b"abcdef") |> Effect.provideMut<Writer>(&mut output)
    }
  }
  return 42
}
effect fn writeStderr() -> i32 ! WriterError {
  let mut output = StderrWriter.make()
  run Writer.writeAll(b"abcdef") |> Effect.provideMut<Writer>(&mut output)
  return 42
}
export "C" fn stdout_fixture(empty: i32, flush: i32) -> i32 {
  return run Effect.catchAll(writeStdout(empty != 0, flush != 0), writeFailed)
}
export "C" fn stderr_fixture() -> i32 {
  return run Effect.catchAll(writeStderr(), writeFailed)
}

effect fn readInput(ended: bool) -> i32 ! StreamReadError {
  let mut input = OsStandardInput.make()
  let mut buffer = [u8.toU8(9), u8.toU8(9), u8.toU8(9), u8.toU8(9)]
  let first = run StandardInput.receive(&mut buffer) |> Effect.provideMut<StandardInput>(&mut input)
  if ended {
    if StandardInput.isEndOfInput(&first) == false { return 1 }
    let second = run StandardInput.receive(&mut buffer) |> Effect.provideMut<StandardInput>(&mut input)
    if StandardInput.isEndOfInput(&second) == false { return 2 }
    if buffer[0] != u8.toU8(9) { return 3 }
  } else {
    if StandardInput.count(&first) != 2 { return 4 }
    if buffer[0] != u8.toU8(1) { return 5 }
    if buffer[1] != u8.toU8(2) { return 6 }
    if buffer[2] != u8.toU8(9) { return 8 }
    if buffer[3] != u8.toU8(9) { return 9 }
  }
  return 42
}
export "C" fn read_fixture(ended: i32) -> i32 {
  return run Effect.catchAll(readInput(ended != 0), readFailed)
}

effect fn readEmpty(ended: bool) -> i32 ! StreamReadError {
  let mut input = OsStandardInput.make()
  if ended {
    let mut one = [u8.toU8(9)]
    let first = run StandardInput.receive(&mut one) |> Effect.provideMut<StandardInput>(&mut input)
    if StandardInput.isEndOfInput(&first) == false { return 1 }
  }
  let mut empty: [u8; 0] = []
  let result = run StandardInput.receive(&mut empty) |> Effect.provideMut<StandardInput>(&mut input)
  if StandardInput.isEndOfInput(&result) { return 2 }
  if StandardInput.count(&result) != 0 { return 3 }
  return 42
}
export "C" fn empty_read_fixture(ended: i32) -> i32 {
  return run Effect.catchAll(readEmpty(ended != 0), readFailed)
}
