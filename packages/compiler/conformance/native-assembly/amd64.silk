export "C" fn sum(left: u64, right: u64) -> u64 { return unsafe Intrinsic.assembly<u64>("addq $2, $0", "={rax},0,{rdi}", "flags", "none", false, false, (left, right)) }
export "C" fn store(pointer: *mut u64, value: u64) -> () { return unsafe Intrinsic.assembly<()>("movq $1, ($0)", "{rdi},{rsi}", "", "write", true, false, (pointer, value)) }
export "C" fn load(pointer: *const u64) -> u64 { return unsafe Intrinsic.assembly<u64>("movq ($1), $0", "={rax},{rdi}", "", "read", false, false, (pointer,)) }
export "C" fn syscall(number: u64) -> u64 { return unsafe Intrinsic.assembly<u64>("syscall", "={rax},0", "rcx,r11,flags", "readwrite", true, false, (number,)) }
export "C" fn terminal() -> () { return unsafe Intrinsic.assembly<()>("ud2", "", "", "none", true, true, ()) }
unsafe export "C" fn entry() -> () as "native_entry" with Intrinsic.machine(naked: true, noReturn: true) { return unsafe Intrinsic.assembly<()>("movq %rsp, %rdi\ncall native_entry_probe\nud2", "", "", "readwrite", true, true, ()) }
export "C" fn sum7(a: u64, b: u64, c: u64, d: u64, e: u64, f: u64, g: u64) -> u64 { return unsafe Intrinsic.assembly<u64>("addq $2, $0\naddq $3, $0\naddq $4, $0\naddq $5, $0\naddq $6, $0\naddq $7, $0", "={rax},0,{rdi},{rsi},{rdx},{r10},{r8},{r9}", "flags", "none", false, false, (a, b, c, d, e, f, g)) }
export "C" fn alias(pointer: *mut u64) -> *mut u64 { return unsafe Intrinsic.assembly<*mut u64>("movq $1, $0", "={rax},{rdi}", "", "none", false, false, (pointer,)) }
