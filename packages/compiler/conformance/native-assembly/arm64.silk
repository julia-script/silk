export "C" fn sum(left: u64, right: u64) -> u64 { return unsafe Intrinsic.assembly<u64>("add $0, $0, $2", "={x0},0,{x1}", "flags", "none", false, false, (left, right)) }
export "C" fn store(pointer: *mut u64, value: u64) -> () { return unsafe Intrinsic.assembly<()>("str $1, [$0]", "{x0},{x1}", "", "write", true, false, (pointer, value)) }
export "C" fn load(pointer: *const u64) -> u64 { return unsafe Intrinsic.assembly<u64>("ldr $0, [$1]", "={x0},{x1}", "", "read", false, false, (pointer,)) }
export "C" fn syscall(number: u64) -> u64 { return unsafe Intrinsic.assembly<u64>("svc #0", "={x0},{x8}", "flags", "readwrite", true, false, (number,)) }
export "C" fn terminal() -> () { return unsafe Intrinsic.assembly<()>("brk #0", "", "", "none", true, true, ()) }
unsafe export "C" fn entry() -> () as "native_entry" with Intrinsic.machine(naked: true, noReturn: true) { return unsafe Intrinsic.assembly<()>("mov x0, sp\nbl native_entry_probe\nbrk #0", "", "", "readwrite", true, true, ()) }
export "C" fn sum7(a: u64, b: u64, c: u64, d: u64, e: u64, f: u64, g: u64) -> u64 { return unsafe Intrinsic.assembly<u64>("add $0, $0, $2\nadd $0, $0, $3\nadd $0, $0, $4\nadd $0, $0, $5\nadd $0, $0, $6\nadd $0, $0, $7", "={x0},0,{x1},{x2},{x3},{x4},{x5},{x8}", "flags", "none", false, false, (a, b, c, d, e, f, g)) }
export "C" fn alias(pointer: *mut u64) -> *mut u64 { return unsafe Intrinsic.assembly<*mut u64>("mov $0, $1", "={x0},{x1}", "", "none", false, false, (pointer,)) }
