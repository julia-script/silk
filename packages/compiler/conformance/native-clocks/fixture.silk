import silk.os_monotonic_clock { OsMonotonicClock }
import silk.os_system_clock { OsSystemClock }
import silk.monotonic_clock { MonotonicClock }
import silk.system_clock { SystemClock }
import silk.effect { Effect }
import silk.i64 as i64

export "C" fn construct_fixture() -> i32 {
  let system = OsSystemClock.make()
  let monotonic = OsMonotonicClock.make()
  return 42
}
export "C" fn read_fixture(monotonic: i32, seconds: i64, nanoseconds: i64) -> i32 {
  if monotonic == 0 {
    let mut provider = OsSystemClock.make()
    let result = run SystemClock.now() |> Effect.provideMut<SystemClock>(&mut provider)
    if SystemClock.seconds(&result) != seconds { return 1 }
    if SystemClock.nanoseconds(&result) != nanoseconds { return 2 }
  } else {
    let mut provider = OsMonotonicClock.make()
    let result = run MonotonicClock.now() |> Effect.provideMut<MonotonicClock>(&mut provider)
    if SystemClock.seconds(&result) != seconds { return 3 }
    if SystemClock.nanoseconds(&result) != nanoseconds { return 4 }
  }
  return 42
}
export "C" fn resolution_fixture(monotonic: i32) -> u64 {
  if monotonic == 0 {
    let mut provider = OsSystemClock.make()
    return run SystemClock.getResolution() |> Effect.provideMut<SystemClock>(&mut provider)
  }
  let mut provider = OsMonotonicClock.make()
  return run MonotonicClock.getResolution() |> Effect.provideMut<MonotonicClock>(&mut provider)
}
export "C" fn wait_fixture(seconds: i64, nanoseconds: i64) -> i32 {
  let mut provider = OsMonotonicClock.make()
  run MonotonicClock.waitUntil(SystemClock.make(seconds, nanoseconds)) |> Effect.provideMut<MonotonicClock>(&mut provider)
  return 42
}
export "C" fn relative_fixture(duration: u64) -> i32 {
  let mut provider = OsMonotonicClock.make()
  run MonotonicClock.waitFor(duration) |> Effect.provideMut<MonotonicClock>(&mut provider)
  return 42
}
