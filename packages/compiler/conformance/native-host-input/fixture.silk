import silk.native_host_input { NativeHostInput }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.host_input { HostInput, HostInputError }
import silk.os_host_input { OsHostInput }
import silk.effect { Effect }
import silk.option { Option }
import silk.bytes { Bytes }

unsafe extern "C" fn mutate_inputs() -> ()

fn length(found: Option<usize>) -> usize {
  return match move found {
    Option<usize>.Some { value } => value
    Option<usize>.None => 999
  }
}

effect fn exercise(argc: i32, argv: [*]const ?[*]const u8, envp: [*]const ?[*]const u8) -> i32 ! HostInputError | OutOfMemoryError ? &mut Allocator {
  let inputs = run unsafe NativeHostInput.capture(argc, argv, envp)
  let environment = run unsafe NativeHostInput.environmentSnapshot()
  if NativeHostInput.argumentCount(&environment) != 0 { return 15 }
  let environmentName = b"SILK_INPUT_SNAPSHOT"
  let mut environmentValue: [u8; 3] = [90, 90, 90]
  if length(NativeHostInput.variable(&environment, &environmentName, &mut environmentValue)) != 2 { return 16 }
  if environmentValue[0] != 111 || environmentValue[1] != 107 || environmentValue[2] != 90 { return 17 }
  unsafe mutate_inputs()
  if NativeHostInput.argumentCount(&inputs) != 3 { return 1 }
  let mut bytes: [u8; 6] = [90, 90, 90, 90, 90, 90]
  if length(NativeHostInput.argument(&inputs, 1, &mut bytes)) != 4 { return 2 }
  if bytes[0] != 255 || bytes[1] != 32 || bytes[2] != 128 || bytes[3] != 61 || bytes[4] != 90 { return 3 }
  if length(NativeHostInput.argument(&inputs, 2, &mut bytes)) != 0 || bytes[0] != 255 { return 4 }
  if length(NativeHostInput.argument(&inputs, 3, &mut bytes)) != 999 || bytes[4] != 90 { return 5 }
  let mut short: [u8; 2] = [90, 90]
  if length(NativeHostInput.argument(&inputs, 1, &mut short)) != 4 || short[0] != 255 || short[1] != 32 { return 6 }
  let name = b"A"
  if length(NativeHostInput.variable(&inputs, &name, &mut bytes)) != 3 { return 7 }
  if bytes[0] != 128 || bytes[1] != 61 || bytes[2] != 255 || bytes[3] != 61 { return 8 }
  let empty = b"EMPTY"
  if length(NativeHostInput.variable(&inputs, &empty, &mut bytes)) != 0 || bytes[0] != 128 { return 9 }
  let missing = b"MISSING"
  if length(NativeHostInput.variable(&inputs, &missing, &mut bytes)) != 999 { return 10 }
  let invalid = b"A="
  if length(NativeHostInput.variable(&inputs, &invalid, &mut bytes)) != 999 { return 11 }
  let cwd = run NativeHostInput.workingDirectory()
  if Bytes.length(&cwd) == 0 { return 12 }
  let mut cwdPrefix: [u8; 1] = [90]
  let total = run NativeHostInput.workingDirectoryCopy(&mut cwdPrefix)
  if total != Bytes.length(&cwd) || cwdPrefix[0] != Bytes.asSlice(&cwd)[0] { return 13 }
  let mut provider = OsHostInput.make(move inputs)
  let count = run Effect.provideMut(HostInput.argumentCount(), &mut provider)
  if count != 3 { return 18 }
  let owned = run Effect.provideMut(HostInput.argument(1), &mut provider)
  match move owned {
    Option<Bytes>.Some { value } => {
      if Bytes.length(&value) != 4 || Bytes.asSlice(&value)[0] != 255 { return 19 }
    }
    Option<Bytes>.None => { return 20 }
  }
  return 42
}

effect fn recover(error: HostInputError | OutOfMemoryError) -> i32 { return 14 }
export "C" fn input_probe(argc: i32, argv: [*]const ?[*]const u8, envp: [*]const ?[*]const u8) -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(exercise(argc, argv, envp), recover)
    |> Effect.provideMut<Allocator>(&mut allocator)
}
