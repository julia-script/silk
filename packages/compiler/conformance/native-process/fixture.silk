import silk.child_process {ChildProcess, ProcessError, ProcessOutcome}

import silk.os_child_process {OsChildProcess}

import silk.allocator {Allocator, OutOfMemoryError}

import silk.filesystem {Path, FileError}

import silk.effect {Effect}

import silk.option {Option}

effect fn shell(command: &[u8]) -> ProcessOutcome
! FileError | OutOfMemoryError | ProcessError
? &mut Allocator {
  let path = run Path.make("/bin/sh")
  let directory = run Path.make("/")
  let mut request = run ChildProcess.requestWithin(&path, &directory)
  run ChildProcess.addArgument(&mut request, b"-c")
  run ChildProcess.addArgument(&mut request, command)
  run ChildProcess.setVariable(&mut request, b"SILK_PROCESS_FIXTURE", b"present")
  let mut provider = OsChildProcess.make()
  return run ChildProcess.submit(&request)
    |> Effect.provideMut<ChildProcess>(&mut provider)
}

effect fn missing() -> i32 ! FileError | OutOfMemoryError | ProcessError ? &mut Allocator {
  let path = run Path.make("/silk-nonexistent-process-fixture")
  let request = run ChildProcess.request(&path)
  let mut provider = OsChildProcess.make()
  let outcome = run ChildProcess.submit(&request)
    |> Effect.provideMut<ChildProcess>(&mut provider)
  return 10
}

effect fn missingError(error: ProcessError) -> i32 {
  if error.operation.code != 0 {
    return 11
  }
  match move ChildProcess.providerCode(&error) {
    Option<i32>.Some {value} => {
      if value == 2 {
        return 0
      }
    }
    Option<i32>.None => {}
  }
  return 12
}

effect fn exercise() -> i32 ! FileError | OutOfMemoryError | ProcessError ? &mut Allocator {
  let path = run Path.make("/bin/sh")
  let mut request = run ChildProcess.request(&path)
  run ChildProcess.addArgument(&mut request, b"-c")
  run ChildProcess.addArgument(&mut request, b"printf out; printf err >&2; exit 7")
  let mut provider = OsChildProcess.make()
  let outcome = run ChildProcess.submit(&request)
    |> Effect.provideMut<ChildProcess>(&mut provider)
  let output = ChildProcess.outputBytes(&outcome)
  let errors = ChildProcess.errorBytes(&outcome)
  if output.length != 3 || errors.length != 3 {
    return 1
  }
  if output[0] != 111 || errors[0] != 101 {
    return 2
  }
  match move ChildProcess.exitCode(&outcome) {
    Option<i32>.Some {value} => {
      if value != 7 {
        return 3
      }
    }
    Option<i32>.None => {
      return 4
    }
  }
  let missingResult = run Effect.catch<ProcessError>(missing(), missingError)
  if missingResult != 0 {
    return missingResult
  }
  let legitimate = run shell(b"exit 127")
  match move ChildProcess.exitCode(&legitimate) {
    Option<i32>.Some {value} => {
      if value != 127 {
        return 13
      }
    }
    Option<i32>.None => {
      return 14
    }
  }
  let signaled = run shell(b"kill -TERM $$")
  match move ChildProcess.terminatingSignal(&signaled) {
    Option<i32>.Some {value} => {
      if value != 15 {
        return 15
      }
    }
    Option<i32>.None => {
      return 16
    }
  }
  let inputs = run shell(
    b"[ \"$PWD\" = / ] && [ \"$SILK_PROCESS_FIXTURE\" = present ] && ! read line && printf inputs",
  )
  if ChildProcess.outputBytes(&inputs).length != 6 {
    return 17
  }
  let rawPath = run Path.make("/bin/sh")
  let mut rawRequest = run ChildProcess.request(&rawPath)
  run ChildProcess.addArgument(&mut rawRequest, b"-c")
  run ChildProcess.addArgument(&mut rawRequest, b"printf '%s' \"$1\"")
  run ChildProcess.addArgument(&mut rawRequest, b"fixture")
  let argument: [u8; 4] = [255, 32, 39, 128]
  run ChildProcess.addArgument(&mut rawRequest, &argument)
  let raw = run ChildProcess.submit(&rawRequest)
    |> Effect.provideMut<ChildProcess>(&mut provider)
  let preserved = ChildProcess.outputBytes(&raw)
  if preserved.length != 4 {
    return 20
  }
  if preserved[0] != 255 || preserved[1] != 32 || preserved[2] != 39 || preserved[3] != 128 {
    return 21
  }
  let large = run shell(
    b"(i=0; while [ $i -lt 4096 ]; do printf 0123456789abcdef0123456789abcdef; i=$((i+1)); done) & (i=0; while [ $i -lt 4096 ]; do printf fedcba9876543210fedcba9876543210 >&2; i=$((i+1)); done) & wait",
  )
  let stdout = ChildProcess.outputBytes(&large)
  let stderr = ChildProcess.errorBytes(&large)
  if stdout.length != 131072 || stderr.length != 131072 {
    return 18
  }
  if stdout[131071] != 102 || stderr[131071] != 48 {
    return 19
  }
  return 42
}

effect fn program() -> i32 ! FileError | OutOfMemoryError | ProcessError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run exercise()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn recover(error: FileError | OutOfMemoryError | ProcessError) -> i32 {
  return 5
}

export "C" fn process_real_fixture() -> i32 {
  return run Effect.catchAll(program(), recover)
}
