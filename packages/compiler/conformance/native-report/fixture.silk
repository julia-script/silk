import silk.native_report { NativeReport }

export "C" fn report_probe(mode: i32) -> i32 {
  let mut bytes: usize = 1024
  if mode == 2 { bytes = 10 }
  let mut frames: usize = 8
  if mode == 6 { frames = 0 }
  let mut report = NativeReport.make(2, bytes, frames)
  if mode == 1 {
    let primary = run NativeReport.fatal(&mut report, "division by zero", "app.origin")
  } else {
    let primary = run NativeReport.unhandled(&mut report, "app.Failure", "app.origin")
  }
  let frame = run NativeReport.frame(&mut report, "app.caller")
  if mode != 1 {
    let cause = run NativeReport.cause(&mut report, "app.Cause", "app.cause")
  }
  if NativeReport.succeeded(&report) { return 42 }
  return 2
}
