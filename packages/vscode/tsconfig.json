{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // The extension host loads extensions with require, so this package compiles to CommonJS;
    // verbatim module syntax would forbid ESM import statements in a CJS output.
    "module": "Node16",
    "moduleResolution": "Node16",
    "verbatimModuleSyntax": false,
    "types": ["node", "vscode"]
  },
  "include": ["src/**/*.ts"]
}
