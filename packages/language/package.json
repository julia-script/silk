{
  "name": "@silk-effect/language",
  "version": "0.0.0",
  "description": "Editor language support for Silk Effect: lexer-driven CodeMirror highlighting and the Silk TextMate grammar.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julia-script/silk-effect.git",
    "directory": "packages/language"
  },
  "homepage": "https://github.com/julia-script/silk-effect#readme",
  "bugs": {
    "url": "https://github.com/julia-script/silk-effect/issues"
  },
  "keywords": [
    "silk",
    "codemirror",
    "textmate",
    "syntax-highlighting"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./CodeMirror": {
      "types": "./dist/CodeMirror.d.ts",
      "import": "./dist/CodeMirror.js"
    },
    "./TextMate": {
      "types": "./dist/TextMate.d.ts",
      "import": "./dist/TextMate.js"
    }
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "sync:vscode": "node scripts/sync-vscode.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@silk-effect/compiler": "workspace:*",
    "@silk-effect/documentation": "workspace:*"
  },
  "peerDependencies": {
    "@codemirror/language": "^6.12.0",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/highlight": "^1.2.0"
  },
  "devDependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@lezer/highlight": "^1.2.3",
    "@types/node": "^24.10.1",
    "shiki": "^4.4.2"
  }
}
