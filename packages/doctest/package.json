{
  "name": "@silk-effect/doctest",
  "version": "0.0.0",
  "private": true,
  "description": "Compiles the fenced Silk examples carried by Silk Effect documentation JSON and reports each failure with its source position.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julia-script/silk-effect.git",
    "directory": "packages/doctest"
  },
  "homepage": "https://github.com/julia-script/silk-effect#readme",
  "bugs": {
    "url": "https://github.com/julia-script/silk-effect/issues"
  },
  "keywords": [
    "silk",
    "documentation",
    "doctest",
    "effect"
  ],
  "type": "module",
  "bin": {
    "silk-doctest": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bin": "./dist/bin.js",
    "./Doctest": {
      "types": "./dist/Doctest.d.ts",
      "import": "./dist/Doctest.js"
    },
    "./Example": {
      "types": "./dist/Example.d.ts",
      "import": "./dist/Example.js"
    },
    "./Report": {
      "types": "./dist/Report.d.ts",
      "import": "./dist/Report.js"
    },
    "./Sources": {
      "types": "./dist/Sources.d.ts",
      "import": "./dist/Sources.js"
    },
    "./Stdlib": {
      "types": "./dist/Stdlib.d.ts",
      "import": "./dist/Stdlib.js"
    }
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.103",
    "@silk-effect/compiler": "workspace:*",
    "@silk-effect/documentation": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "^24.10.1"
  }
}
