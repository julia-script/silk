{
  "name": "@silk-effect/inspector",
  "version": "0.0.0",
  "description": "Compiler-phase view projections for Silk Effect inspectors: the view registry and row models shared by the docs workbench and the language server.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julia-script/silk-effect.git",
    "directory": "packages/inspector"
  },
  "homepage": "https://github.com/julia-script/silk-effect#readme",
  "bugs": {
    "url": "https://github.com/julia-script/silk-effect/issues"
  },
  "keywords": [
    "silk",
    "inspector",
    "compiler",
    "effect"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./Registry": {
      "types": "./dist/Registry.d.ts",
      "import": "./dist/Registry.js"
    },
    "./Row": {
      "types": "./dist/Row.d.ts",
      "import": "./dist/Row.js"
    },
    "./FlowModel": {
      "types": "./dist/FlowModel.d.ts",
      "import": "./dist/FlowModel.js"
    },
    "./ProjectSyntax": {
      "types": "./dist/ProjectSyntax.d.ts",
      "import": "./dist/ProjectSyntax.js"
    },
    "./ProjectBackend": {
      "types": "./dist/ProjectBackend.d.ts",
      "import": "./dist/ProjectBackend.js"
    },
    "./Panels": {
      "types": "./dist/Panels.d.ts",
      "import": "./dist/Panels.js"
    }
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@silk-effect/compiler": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^24.10.1"
  }
}
